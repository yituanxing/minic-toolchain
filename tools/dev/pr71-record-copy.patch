+static bool add_record_copy_assignments(MinicParser *parser,
+                                        MinicExpressionId target_id,
+                                        MinicExpressionId source_id,
+                                        MinicSourceSpan span) {
+    const MinicExpression *target;
+    const MinicExpression *source;
