diff --git a/src/frontend/parser_statement.c b/src/frontend/parser_statement.c
--- a/src/frontend/parser_statement.c
+++ b/src/frontend/parser_statement.c
@@ -1269,6 +1269,9 @@ bool minic_parser_parse_statement(MinicParser *parser, bool allow_declaration) {
