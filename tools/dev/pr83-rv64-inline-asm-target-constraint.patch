+static int clobber_reservation(int left, int right) {
+    int result;
+
+    __asm__ __volatile__("add %0, %1, %2"
+                         : "=r"(result)
+                         : "r"(left), "r"(right)
+                         : "t3");
+    return result;
+}
+
