 print("staged &=, |=, unary bitwise-not, and fixed-call int-to-double conversion")
+
+# cJSON CreateFloatArray explicitly casts float elements to double. Complete this path through
+# parsed cast compatibility, normalized conversion, scalar RV64 access, and fcvt.d.s lowering.
+replace_once(
+    "src/frontend/type.c",
+    """    if (minic_type_is_double(target) && minic_type_is_integer(source)) {
+        return true;
+    }
+""",
