+                (size_t)statement->expression,
+                (int)value->kind);
+        return false;
+    }
+    if (fprintf(file, "  addi sp, sp, -16\n  sd a0, 0(sp)\n") < 0) {
+        return false;
+    }
+    if (!minic_riscv64_emit_lvalue_address(
