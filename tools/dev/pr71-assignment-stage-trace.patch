+                (int)target->kind);
+        return false;
+    }
+    if (fprintf(file, "  ld t0, 0(sp)\n  addi sp, sp, 16\n") < 0) {
+        return false;
+    }
+    if (!minic_riscv64_emit_scalar_store(file, target->type, "t0", "a0")) {
+        fprintf(stderr, "ASSIGN_FAIL store target=%zu\n",
+                (size_t)statement->target_expression);
+        return false;
+    }
+    return true;
 }
