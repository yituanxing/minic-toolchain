# Linux 6.6.143 MiniC multi-ISA first-pass COMMON feature policy.
# One KCONFIG_ALLCONFIG miniconfig, applied by GNU Kbuild allnoconfig to
# x86_64, AArch64 and LoongArch64. Dependencies are resolved per target.
# This tests shared C/IR capability; hardware boot profiles are separate.
# Do not put ARCH_, CPU, platform, target ABI or ISA-specific symbols here.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_EXT4_FS=y
CONFIG_TTY=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
