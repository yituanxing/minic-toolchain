/* Complete-placement feedback loop for static target relaxations.
 *
 * InputGraph and the canonical WorkSection identities were fixed before this
 * phase.  Machine targets may rematerialize original input bytes, relocation
 * offsets and canonical source symbols from their own snapshots after seeing
 * the final addresses of one trial.  Only layout-derived script definitions
 * and script-generated BYTE-only work sections are rolled back between
 * trials.  Replaying a linker script without that rollback is not idempotent.
 * The final Target relocation fill/apply and ELF projection happen exactly
 * once, after a trial reports no further size/offset changes. */

typedef struct MiniLdScriptSymbolCheckpoint {
    size_t index;
    MiniLdResolvedSymbol value;
} MiniLdScriptSymbolCheckpoint;

typedef struct MiniLdScriptLayoutCheckpoint {
    size_t section_count;
    size_t symbol_count;
    size_t global_count;
    MiniLdScriptSymbolCheckpoint *script_symbols;
    size_t script_symbol_count;
    size_t script_symbol_capacity;
} MiniLdScriptLayoutCheckpoint;

static bool static_script_checkpoint_name(
    MiniLdState *state, MiniLdScriptLayoutCheckpoint *checkpoint,
    const char *name) {
    size_t index = symbol_resolver_lookup(&state->resolver, name);
    size_t i;
    MiniLdScriptSymbolCheckpoint *next;
    size_t capacity;

    /* Absent names are added by the script, so restoring resolver.count and
     * its global hash table will remove them on a following trial. */
    if (index == SIZE_MAX) {
        return true;
    }
    for (i = 0U; i < checkpoint->script_symbol_count; ++i) {
        if (checkpoint->script_symbols[i].index == index) {
            return true;
        }
    }
    if (checkpoint->script_symbol_count ==
        checkpoint->script_symbol_capacity) {
        capacity = checkpoint->script_symbol_capacity == 0U
                       ? 32U : checkpoint->script_symbol_capacity * 2U;
        if (capacity < checkpoint->script_symbol_capacity ||
            capacity > SIZE_MAX / sizeof(*next)) {
            return false;
        }
        next = realloc(checkpoint->script_symbols,
                       capacity * sizeof(*next));
        if (next == NULL) {
            return false;
        }
        checkpoint->script_symbols = next;
        checkpoint->script_symbol_capacity = capacity;
    }
    checkpoint->script_symbols[checkpoint->script_symbol_count].index = index;
    checkpoint->script_symbols[checkpoint->script_symbol_count].value =
        state->resolver.entries[index];
    ++checkpoint->script_symbol_count;
    return true;
}

static bool static_script_checkpoint_begin(
    MiniLdState *state, const MiniLdScript *script,
    MiniLdScriptLayoutCheckpoint *checkpoint) {
    size_t i;

    memset(checkpoint, 0, sizeof(*checkpoint));
    checkpoint->section_count = state->work.count;
    checkpoint->symbol_count = state->resolver.count;
    checkpoint->global_count = state->resolver.global_count;
    if (script == NULL) {
        return true;
    }
    for (i = 0U; i < script->command_count; ++i) {
        const MiniLdScriptCommand *command = &script->commands[i];
        size_t j;

        if (command->kind == MINILD_SCRIPT_DEFINE_SYMBOL &&
            !static_script_checkpoint_name(
                state, checkpoint, command->value.symbol.name)) {
            return false;
        }
        if (command->kind != MINILD_SCRIPT_OUTPUT_SECTION) {
            continue;
        }
        for (j = 0U; j < command->value.section.item_count; ++j) {
            const MiniLdScriptSectionItem *item =
                &command->value.section.items[j];
            if (item->kind == MINILD_SCRIPT_SECTION_DEFINE_SYMBOL &&
                !static_script_checkpoint_name(
                    state, checkpoint, item->value.symbol.name)) {
                return false;
            }
        }
    }
    return true;
}

static bool static_script_checkpoint_rollback(
    MiniLdState *state, const MiniLdScriptLayoutCheckpoint *checkpoint) {
    size_t i;

    if (state->work.count < checkpoint->section_count ||
        state->resolver.count < checkpoint->symbol_count) {
        fprintf(state->diagnostics,
                "minic-ld: static-layout-owner-identity-changed\n");
        return false;
    }
    for (i = checkpoint->section_count; i < state->work.count; ++i) {
        free(state->work.sections[i].name);
        free(state->work.sections[i].data);
        memset(&state->work.sections[i], 0,
               sizeof(state->work.sections[i]));
    }
    if (state->work.count != checkpoint->section_count) {
        state->work.count = checkpoint->section_count;
        if (state->work.index_capacity == 0U ||
            !work_sections_rebuild_index(&state->work,
                                         state->work.index_capacity)) {
            fprintf(state->diagnostics,
                    "minic-ld: static-layout-work-index-rollback-failed\n");
            return false;
        }
    }
    for (i = checkpoint->symbol_count;
         i < state->resolver.count; ++i) {
        free(state->resolver.entries[i].name);
        memset(&state->resolver.entries[i], 0,
               sizeof(state->resolver.entries[i]));
    }
    if (state->resolver.count != checkpoint->symbol_count) {
        state->resolver.count = checkpoint->symbol_count;
        state->resolver.global_count = checkpoint->global_count;
        if (state->resolver.global_capacity == 0U ||
            !symbol_resolver_rebuild_globals(
                &state->resolver, state->resolver.global_capacity)) {
            fprintf(state->diagnostics,
                    "minic-ld: static-layout-symbol-index-rollback-failed\n");
            return false;
        }
    }
    for (i = 0U; i < checkpoint->script_symbol_count; ++i) {
        const MiniLdScriptSymbolCheckpoint *binding =
            &checkpoint->script_symbols[i];
        state->resolver.entries[binding->index] = binding->value;
    }
    return true;
}

static bool static_run_layout_to_fixed_point(
    MiniLdState *state, const MiniLdScript *script, MiniLdLayout *layout,
    MiniLdStaticTargetPlan *plan) {
    MiniLdScriptLayoutCheckpoint checkpoint;
    const unsigned max_rounds = 32U;
    unsigned round;
    bool ok = false;

    if (!static_script_checkpoint_begin(state, script, &checkpoint)) {
        fprintf(state->diagnostics,
                "minic-ld: out-of-memory:static-layout-checkpoint\n");
        free(checkpoint.script_symbols);
        return false;
    }
    state->static_canonical_work_count = checkpoint.section_count;
    state->script_forward_allow = script != NULL;
    for (round = 0U; round < max_rounds; ++round) {
        bool changed;
        bool target_changed = false;
        size_t placed_sections;
        size_t placed_symbols;

        state->script_forward_changed = false;
        if (!(script != NULL
                  ? static_build_script_layout(state, script, layout, 0U)
                  : static_build_layout(state, layout))) {
            goto done;
        }
        changed = state->script_forward_changed;
        placed_sections = state->work.count;
        placed_symbols = state->resolver.count;
        if (state->target->replan_static_layout != NULL) {
            if (!state->target->replan_static_layout(
                    state, layout, plan, &target_changed)) {
                goto done;
            }
            changed = changed || target_changed;
        }
        /* Replanning may rewrite bytes and relocation coordinates only.
         * New work-section or canonical-symbol identities must be reserved
         * before layout; otherwise rolling back script BYTE placeholders
         * would silently destroy a target-created veneer or symbol. */
        if (state->work.count != placed_sections ||
            state->resolver.count != placed_symbols) {
            fprintf(state->diagnostics,
                    "minic-ld: target-replan-mutated-section-or-symbol-ids:%s\n",
                    state->target->emulation);
            goto done;
        }
        if (!changed) {
            ok = true;
            goto done;
        }
        minild_layout_destroy(layout);
        if (!static_script_checkpoint_rollback(state, &checkpoint)) {
            goto done;
        }
    }
    fprintf(state->diagnostics,
            "minic-ld: %s:%s:rounds=%u\n",
            state->script_forward_guess_count != 0U ?
                "script-forward-layout-did-not-converge" :
                "target-static-layout-did-not-converge",
            state->target->emulation, max_rounds);
done:
    state->script_forward_allow = false;
    free(checkpoint.script_symbols);
    return ok;
}
