@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_next_owner.c"}
/* Linux 6.6 original failure-owner forms. Privileged instructions are
 * compile/assemble-only: the test never executes either far jumps or fences. */
struct real_mode_header {
    unsigned int machine_real_restart_asm;
};

void linux_real_mode_restart(struct real_mode_header *header,
    unsigned int restart_type) {
    asm volatile("ljmpl *%0" : :
        "m" (header->machine_real_restart_asm), "D" (restart_type));
    asm volatile("375:\n\t"
        ".pushsection .discard.unreachable\n\t"
        ".long 375b - .\n\t"
        ".popsection\n\t" : : "i" (375));
}

void linux_weak_wrmsr_fence(void) {
    asm volatile(
        "# ALT: oldnstr\n"
        "661:\n\tmfence; lfence\n"
        "662:\n# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b)) > 0) * "
        "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte (((1 << 0) << 16) | ((11*32+27)))\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\t\n6651:\n"
        ".popsection\n" : : : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_next_owner_smap.c"}
/* Linux's complete feature-gated STAC/CLAC records, compile-only. */
#define SMAP_ALTERNATIVE(replacement) \
    "# ALT: oldnstr\n" "661:\n\t" "" "\n662:\n" \
    "# ALT: padding\n" \
    ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " \
    "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" \
    "663" ":\n" \
    ".pushsection .altinstructions,\"a\"\n" \
    " .long 661b - .\n" \
    " .long " "664""1""f - .\n" \
    " .4byte " "( 9*32+20)" "\n" \
    " .byte " "663""b-661b" "\n" \
    " .byte " "665""1""f-""664""1""f" "\n" \
    ".popsection\n" \
    ".pushsection .altinstr_replacement, \"ax\"\n" \
    "# ALT: replacement " "1" "\n" \
    "664""1"":\n\t" replacement "\n" "665""1" ":\n" \
    ".popsection\n"

void linux_owner_clac(void) {
    asm volatile(SMAP_ALTERNATIVE(".byte 0x0f,0x01,0xca") : : : "memory");
}

void linux_owner_stac(void) {
    asm volatile(SMAP_ALTERNATIVE(".byte 0x0f,0x01,0xcb") : : : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_paravirt_indirect_call.c"}
/* Linux 6.6 paravirt indirect call: compile/assemble only. The indirect
 * target and metadata are real patching ABI, never executed in userland. */
struct pv_ops {
    struct {
        void (*io_delay)(void);
    } cpu;
};
extern struct pv_ops pv_ops;
register unsigned long current_stack_pointer asm("rsp");

void test_paravirt_io_delay(void) {
    unsigned long __edi = __edi, __esi = __esi, __edx = __edx;
    unsigned long __ecx = __ecx;
    asm volatile("771:\n\t"
        "999:\n\t"
        ".pushsection .discard.retpoline_safe\n\t"
        ".long 999b\n\t"
        ".popsection\n\t"
        "call *%[paravirt_opptr];\n"
        "772:\n"
        ".pushsection .parainstructions,\"a\"\n"
        " .balign 8 \n"
        " .quad 771b\n"
        " .byte %c[paravirt_typenum]\n"
        " .byte 772b-771b\n"
        " .balign 8 \n"
        ".popsection\n"
        : "=D" (__edi), "=S" (__esi), "=d" (__edx), "=c" (__ecx),
          "+r" (current_stack_pointer)
        : [paravirt_typenum] "i" (0),
          [paravirt_opptr] "m" (pv_ops.cpu.io_delay)
        : "memory", "cc", "rax", "r8", "r9", "r10", "r11");
}
