@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_put_user_call.c"}
/* Original Linux x86 __put_user_N helper calling convention. Compile-only;
 * it needs an in-kernel exception-fixup helper and must not run in userland. */
register unsigned long current_stack_pointer asm("rsp");

int linux_put_user_byte(unsigned char *address, unsigned char value) {
    int err;
    void *user = address;
    register unsigned char payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}

int linux_put_user_half(unsigned short *address, unsigned short value) {
    int err;
    void *user = address;
    register unsigned short payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}

int linux_put_user_word(unsigned int *address, unsigned int value) {
    int err;
    void *user = address;
    register unsigned int payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}

int linux_put_user_quad(unsigned long *address, unsigned long value) {
    int err;
    void *user = address;
    register unsigned long payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}

/* FPU signal frames and other nocheck accessors share the same kernel
 * RCX/RAX/RSP/EBX ABI but select __put_user_nocheck_N helpers. */
int linux_put_user_nocheck_half(unsigned short *address,
                               unsigned short value) {
    int err;
    void *user = address;
    register unsigned short payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_nocheck_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}

int linux_put_user_nocheck_word(unsigned int *address,
                               unsigned int value) {
    int err;
    void *user = address;
    register unsigned int payload asm("%rax");
    payload = value;
    asm volatile("call __put_user_nocheck_%c[size]"
        : "=c" (err), "+r" (current_stack_pointer)
        : "0" (user), "r" (payload), [size] "i" (sizeof(*address)) : "ebx");
    return err;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_qspinlock_bitcc.c"}
/* The original Linux qspinlock queued_fetch_set_pending_acquire pattern:
 * the SMP patch entry must relocate to LOCK BTSL, not to SETC. */
unsigned int minic_linux_qspinlock_bitcc(unsigned int *word) {
    _Bool carry;
    __asm__ __volatile__(
        ".pushsection .smp_locks,\"a\"\n"
        ".balign 4\n"
        ".long 671f - .\n"
        ".popsection\n"
        "671:\n"
        "\n\tlock; "
#if MINIC_QSPINLOCK_BITCC_NEGATIVE == 4
        "btrl"
#else
        "btsl"
#endif
        " %[val], %[var]"
        "\n\t/* output condition code c */\n"
        : [var] "+m" (*word),
#if MINIC_QSPINLOCK_BITCC_NEGATIVE == 1
          "=@ccz"
#else
          "=@ccc"
#endif
          (carry)
        : [val] "I" (
#if MINIC_QSPINLOCK_BITCC_NEGATIVE == 2
          (0 + 9)
#else
          (0 + 8)
#endif
          )
#if MINIC_QSPINLOCK_BITCC_NEGATIVE != 3
        : "memory"
#endif
    );
    return (unsigned int)carry * (1U << 8);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_qspinlock_bitcc_driver.c"}
extern unsigned int minic_linux_qspinlock_bitcc(unsigned int *);

int main(void) {
    unsigned int word = 0U;
    if (minic_linux_qspinlock_bitcc(&word) != 0U || word != 256U)
        return 1;
    if (minic_linux_qspinlock_bitcc(&word) != 256U || word != 256U)
        return 2;
    word = 0xfeed00ffU;
    if (minic_linux_qspinlock_bitcc(&word) != 0U || word != 0xfeed01ffU)
        return 3;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_rep_string_io.c"}
/* Original Linux lib/iomap.c port-string I/O hardware constraints.  Never
 * execute these functions in user space: IN/OUT is privileged hardware I/O. */
typedef unsigned short u16;
typedef unsigned long usize;

#define DEFINE_OUT(name, suffix)                                           \
__attribute__((noinline)) usize name(u16 port, const void *src, usize n) { \
    const void *cursor = src;                                              \
    asm volatile("rep; outs" suffix : "+S"(cursor), "+c"(n) : "d"(port)   \
        : "memory");                                                      \
    return (usize)cursor + n;                                              \
}

#define DEFINE_IN(name, suffix)                                           \
__attribute__((noinline)) usize name(u16 port, void *dst, usize n) {      \
    void *cursor = dst;                                                     \
    asm volatile("rep; ins" suffix : "+D"(cursor), "+c"(n) : "d"(port)    \
        : "memory");                                                      \
    return (usize)cursor + n;                                              \
}

DEFINE_OUT(x86_rep_outsb,"b")
DEFINE_OUT(x86_rep_outsw,"w")
DEFINE_OUT(x86_rep_outsl,"l")
DEFINE_IN(x86_rep_insb,"b")
DEFINE_IN(x86_rep_insw,"w")
DEFINE_IN(x86_rep_insl,"l")

#ifdef MINIC_NEGATIVE_TEMPLATE
void invalid_template(u16 p, const void *a, usize n) {
    asm volatile("rep; outsb; cli" : "+S"(a), "+c"(n) : "d"(p) : "memory");
}
#endif
#ifdef MINIC_NEGATIVE_CONSTRAINT
void invalid_constraint(u16 p, const void *a, usize n) {
    asm volatile("rep; outsb" : "+D"(a), "+c"(n) : "d"(p) : "memory");
}
#endif
#ifdef MINIC_NEGATIVE_PORT
void invalid_port(u16 p, const void *a, usize n) {
    asm volatile("rep; outsb" : "+S"(a), "+c"(n) : "r"(p) : "memory");
}
#endif
#ifdef MINIC_NEGATIVE_MEMORY
void invalid_memory(u16 p, const void *a, usize n) {
    asm volatile("rep; outsb" : "+S"(a), "+c"(n) : "d"(p));
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_rng_flag.c"}
/* Linux rdrand_long/rdseed_long: the CF flag output and data result are
 * independent GNU outputs. Do not run without checking CPU capabilities. */
int linux_rdrand_long(unsigned long *result) {
    _Bool succeeded;
    asm volatile("rdrand %[out]"
        "\n\t/* output condition code " "c" "*/\n"
        : "=@cc" "c"(succeeded), [out] "=r"(*result));
    return succeeded;
}

int linux_rdseed_long(unsigned long *result) {
    _Bool succeeded;
    asm volatile("rdseed %[out]"
        "\n\t/* output condition code " "c" "*/\n"
        : "=@cc" "c"(succeeded), [out] "=r"(*result));
    return succeeded;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_save_flags_inline.c"}
/* Linux 6.6.143 arch/x86/include/asm/irqflags.h native_save_fl(). */
extern inline __attribute__((__gnu_inline__, __always_inline__))
unsigned long native_save_fl(void) {
    unsigned long flags;
    asm volatile("# __raw_save_flags\n\tpushf ; pop %0"
                 : "=rm"(flags) : : "memory");
    return flags;
}

static inline __attribute__((__always_inline__))
unsigned long arch_local_save_flags(void) {
    return native_save_fl();
}

unsigned long sample_flags(void) {
    return arch_local_save_flags();
}
