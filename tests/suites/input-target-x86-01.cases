@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_thread_state.c"}
/* Linux 6.6 x86 process_64.i privileged FSGSBASE, LKGS and loadsegment
 * exception-table contracts. Assemble only; none are safe in user mode. */
typedef unsigned short u16;
typedef unsigned long u64;

u64 linux_rdfsbase(void) {
    u64 v;
    asm volatile("rdfsbase %0" : "=r" (v) : : "memory");
    return v;
}
u64 linux_rdgsbase(void) {
    u64 v;
    asm volatile("rdgsbase %0" : "=r" (v) : : "memory");
    return v;
}
void linux_wrfsbase(u64 v) {
    asm volatile("wrfsbase %0" : : "r" (v) : "memory");
}
void linux_wrgsbase(u64 v) {
    asm volatile("wrgsbase %0" : : "r" (v) : "memory");
}

/* The register-table GNU macro is intentionally included verbatim: Linux
 * exception metadata must stay part of the exact source contract. */
#define EXTABLE_REGISTER_TABLE \
    ".macro extable_type_reg type:req reg:req\n" \
    ".set .Lfound, 0\n" \
    ".set .Lregnr, 0\n" \
    ".irp rs,rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15\n" \
    ".ifc \\reg, %%\\rs\n" \
    ".set .Lfound, .Lfound+1\n" \
    ".long \\type + (.Lregnr << 8)\n" \
    ".endif\n" \
    ".set .Lregnr, .Lregnr+1\n" \
    ".endr\n" \
    ".set .Lregnr, 0\n" \
    ".irp rs,eax,ecx,edx,ebx,esp,ebp,esi,edi,r8d,r9d,r10d,r11d,r12d,r13d,r14d,r15d\n" \
    ".ifc \\reg, %%\\rs\n" \
    ".set .Lfound, .Lfound+1\n" \
    ".long \\type + (.Lregnr << 8)\n" \
    ".endif\n" \
    ".set .Lregnr, .Lregnr+1\n" \
    ".endr\n" \
    ".if (.Lfound != 1)\n" \
    ".error \"extable_type_reg: bad register argument\"\n" \
    ".endif\n" \
    ".endm\n"

void linux_lkgs_with_register_fixup(u16 selector) {
    u16 sel = selector;
    asm __inline volatile("1: " " " ".byte 0xf2,0x0f,0x00,0xf7 ;" " "
        " .pushsection \"__ex_table\",\"a\"\n"
        " .balign 4\n"
        " .long (1b) - .\n"
        " .long (1b) - .\n"
        EXTABLE_REGISTER_TABLE
        "extable_type_reg reg=" "%k[sel]" ", type=" "(17 | ((0) << 16))" " \n"
        ".purgem extable_type_reg\n"
        " .popsection\n" : [sel] "+D" (sel));
}

#define LOAD_SEGMENT_WITH_REG_FIXUP(seg, selector) \
    asm volatile("\t\t\t\t\t\t\n" \
        "1:\tmovl %k0,%%" seg "\t\t\n" \
        " .pushsection \"__ex_table\",\"a\"\n" \
        " .balign 4\n" \
        " .long (1b) - .\n" \
        " .long (1b) - .\n" \
        EXTABLE_REGISTER_TABLE \
        "extable_type_reg reg=" "%k0" ", type=" "(17 | ((0) << 16))" " \n" \
        ".purgem extable_type_reg\n" \
        " .popsection\n" : "+r" (selector) : : "memory")

void linux_load_es_register(u16 v) { LOAD_SEGMENT_WITH_REG_FIXUP("es", v); }
void linux_load_ds_register(u16 v) { LOAD_SEGMENT_WITH_REG_FIXUP("ds", v); }
void linux_load_ss_register(u16 v) { LOAD_SEGMENT_WITH_REG_FIXUP("ss", v); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_three_call_alternative.c"}
/* Linux 6.6 clear_page: two alternative CALLs and an RSP +r output.
 * This is a privileged kernel patch-table contract: compile and assemble,
 * then inspect genuine ELF relocation records; never execute the code. */
register unsigned long current_stack_pointer asm("rsp");
void clear_page_orig(void *page);
void clear_page_rep(void *page);
void clear_page_erms(void *page);

#define TEST_ALT_MAX \
    "((6651f-6641f)^(((6651f-6641f)^(6652f-6642f))&-(-((6651f-6641f)<(6652f-6642f)))))"
#define TEST_ALT_SKIP \
    ".skip -( (" TEST_ALT_MAX " - (662b-661b)) > 0) * (" \
    TEST_ALT_MAX " - (662b-661b)), 0x90\n"

void clear_page(void *page) {
    asm volatile(
        "# ALT: oldinstr2\n"
        "661:\n\t"
        "call %c[old]\n"
        "662:\n"
        "# ALT: padding2\n"
        TEST_ALT_SKIP
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte ( 3*32+16)\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        " .long 661b - .\n"
        " .long 6642f - .\n"
        " .4byte ( 9*32+ 9)\n"
        " .byte 663b-661b\n"
        " .byte 6652f-6642f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\t"
        "call %c[new1]\n"
        "6651:\n"
        "# ALT: replacement 2\n"
        "6642:\n\t"
        "call %c[new2]\n"
        "6652:\n"
        ".popsection\n"
        : "=D" (page), "+r" (current_stack_pointer)
        : [old] "i" (clear_page_orig),
          [new1] "i" (clear_page_rep),
          [new2] "i" (clear_page_erms),
          "0" (page)
        : "cc", "memory", "rax", "rcx");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_usercopy_lfence.c"}
/* Linux user_access_begin's original no-op -> LFENCE mitigation patch. */
int linux_user_access_lfence(int can_access) {
    if (!can_access) return 0;
    asm volatile(
        "# ALT: oldnstr\n" "661:\n\t" "" "\n662:\n"
        "# ALT: padding\n"
        ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * "
        "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n"
        "663" ":\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long " "664""1""f - .\n"
        " .4byte " "(20*32+ 2)" "\n"
        " .byte " "663""b-661b" "\n"
        " .byte " "665""1""f-""664""1""f" "\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement " "1" "\n"
        "664""1"":\n\t" "lfence" "\n" "665""1" ":\n"
        ".popsection\n" : : : "memory");
    return 1;
}
