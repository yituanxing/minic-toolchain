@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_load_unaligned_zeropad.c"}
/* Linux's original type-20 unaligned word load. The exception handler is
 * kernel-only; userspace runtime tests exercise only mapped memory. */
unsigned long linux_load_unaligned_zeropad(const void *addr) {
    unsigned long result;
    asm volatile(
        "1:\tmov %[mem], %[ret]\n"
        "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n"
        " .balign 4\n"
        " .long (" "1b" ") - .\n"
        " .long (" "2b" ") - .\n"
        " .long " "20" " \n"
        " .popsection\n"
        : [ret] "=r"(result)
        : [mem] "m"(*(unsigned long *)addr));
    return result;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_lock_and_sign.c"}
/* Original Linux arch_clear_bit_unlock_is_negative_byte: the signed result
 * belongs to the same locked byte memory RMW that gets an SMP patch record. */
typedef _Bool bool;

#if defined(MINIC_LOCK_AND_SIGN_NEGATIVE) && MINIC_LOCK_AND_SIGN_NEGATIVE == 1
#define MINIC_LOCK_SIGN_OPCODE "orb %2,%1"
#else
#define MINIC_LOCK_SIGN_OPCODE "andb %2,%1"
#endif

#if defined(MINIC_LOCK_AND_SIGN_NEGATIVE) && MINIC_LOCK_AND_SIGN_NEGATIVE == 2
#define MINIC_LOCK_SIGN_CC "=@ccc"
#else
#define MINIC_LOCK_SIGN_CC "=@ccs"
#endif

#if defined(MINIC_LOCK_AND_SIGN_NEGATIVE) && MINIC_LOCK_AND_SIGN_NEGATIVE == 3
#define MINIC_LOCK_SIGN_CLOBBER "cc"
#else
#define MINIC_LOCK_SIGN_CLOBBER "memory"
#endif

#if defined(MINIC_LOCK_AND_SIGN_NEGATIVE) && MINIC_LOCK_AND_SIGN_NEGATIVE == 4
#define MINIC_LOCK_SIGN_INPUT "r"
#else
#define MINIC_LOCK_SIGN_INPUT "ir"
#endif

#if defined(MINIC_LOCK_AND_SIGN_NEGATIVE) && MINIC_LOCK_AND_SIGN_NEGATIVE == 5
#define MINIC_LOCK_SIGN_COMMENT "\n\t/* output condition code z */\n"
#else
#define MINIC_LOCK_SIGN_COMMENT "\n\t/* output condition code s */\n"
#endif

__attribute__((noinline)) bool minic_lock_and_sign(
    long nr, volatile unsigned long *addr) {
    bool negative;
    asm volatile(".pushsection .smp_locks,\"a\"\n"
                 ".balign 4\n"
                 ".long 671f - .\n"
                 ".popsection\n"
                 "671:\n\tlock; " MINIC_LOCK_SIGN_OPCODE
                 MINIC_LOCK_SIGN_COMMENT
        : MINIC_LOCK_SIGN_CC (negative), "+m" (*(volatile char *)addr)
        : MINIC_LOCK_SIGN_INPUT ((char)~(1 << nr))
        : MINIC_LOCK_SIGN_CLOBBER);
    return negative;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_lock_and_sign_driver.c"}
#include <stdint.h>
#include <stdio.h>

_Bool minic_lock_and_sign(long, volatile unsigned long *);

int main(void) {
    unsigned int bit, value;
    for (bit = 0U; bit != 8U; ++bit) {
        for (value = 0U; value != 256U; ++value) {
            const unsigned char expected = (unsigned char)
                (value & ~(1U << bit));
            volatile unsigned long memory = 0x1234567800000000UL | value;
            const _Bool sign = minic_lock_and_sign((long)bit,&memory);
            if ((unsigned char)memory != expected ||
                sign != ((_Bool)((expected & 0x80U) != 0U))) {
                fprintf(stderr,"lock and sign: bit=%u initial=%u result=%lx sign=%u\n",
                    bit,value,memory,(unsigned int)sign);
                return 1;
            }
            if ((memory & ~0xffUL) != 0x1234567800000000UL)
                return 2;
        }
    }
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_membuf_abi.c"}
/* Linux ptrace struct membuf: two INTEGER SysV eightbytes (pointer+size_t).
 * Both an incoming aggregate and an outgoing aggregate call are exercised. */
struct linux_membuf {
    void *p;
    unsigned long left;
};

unsigned long minic_linux_membuf_sum(struct linux_membuf buffer) {
    return (unsigned long)buffer.p + buffer.left;
}

unsigned long minic_linux_membuf_call(void *pointer, unsigned long length) {
    struct linux_membuf buffer;
    buffer.p = pointer;
    buffer.left = length;
    return minic_linux_membuf_sum(buffer);
}

/* Linux inode_get_ctime(): two signed INTEGER eightbytes returned in
 * RAX/RDX and passed in the SysV GPR pair, not a hidden sret pointer. */
struct linux_timespec64 {
    long long tv_sec;
    long tv_nsec;
};

struct linux_timespec64 minic_linux_timespec_return(
    long long seconds, long nanos) {
    struct linux_timespec64 result;
    result.tv_sec = seconds;
    result.tv_nsec = nanos;
    return result;
}

long long minic_linux_timespec_sum(struct linux_timespec64 value) {
    return value.tv_sec + value.tv_nsec;
}

long long minic_linux_timespec_roundtrip(long long seconds, long nanos) {
    struct linux_timespec64 ts = minic_linux_timespec_return(seconds, nanos);
    return minic_linux_timespec_sum(ts);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_membuf_driver.c"}
/* GNU caller -> MiniC aggregate parameter and MiniC -> MiniC aggregate
 * parameter. No kernel or privileged operation is involved in this test. */
struct linux_membuf {
    void *p;
    unsigned long left;
};

extern unsigned long minic_linux_membuf_sum(struct linux_membuf);
extern unsigned long minic_linux_membuf_call(void *, unsigned long);

struct linux_timespec64 {
    long long tv_sec;
    long tv_nsec;
};
extern struct linux_timespec64 minic_linux_timespec_return(long long, long);
extern long long minic_linux_timespec_sum(struct linux_timespec64);
extern long long minic_linux_timespec_roundtrip(long long, long);

int main(void) {
    struct linux_membuf buffer;
    buffer.p = (void *)0x12340000UL;
    buffer.left = 0x5678UL;
    if (minic_linux_membuf_sum(buffer) != 0x12345678UL) return 1;
    if (minic_linux_membuf_call(buffer.p, buffer.left) != 0x12345678UL)
        return 2;
    {
        struct linux_timespec64 ts =
            minic_linux_timespec_return(-1000, 987654321);
        if (ts.tv_sec != -1000 || ts.tv_nsec != 987654321) return 3;
        if (minic_linux_timespec_sum(ts) != 987653321) return 4;
        if (minic_linux_timespec_roundtrip(-400, 890) != 490) return 5;
    }
    return 0;
}
