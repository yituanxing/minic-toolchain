@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_get_user_call.c"}
/* Linux x86 exception-table checked and nocheck get_user helper ABI.
 * Assembly-only: helpers require kernel privilege and kernel fixup tables. */
register unsigned long current_stack_pointer asm("rsp");

int linux_get_user_byte(const unsigned char *user, unsigned char *out) {
    int error;
    register unsigned char value asm("%rdx");
    asm volatile("call __get_user_%c[size]"
        : "=a" (error), "=r" (value), "+r" (current_stack_pointer)
        : "0" (user), [size] "i" (sizeof(*user)));
    *out = value;
    return error;
}

int linux_get_user_half(const unsigned short *user, unsigned short *out) {
    int error;
    register unsigned short value asm("%rdx");
    asm volatile("call __get_user_%c[size]"
        : "=a" (error), "=r" (value), "+r" (current_stack_pointer)
        : "0" (user), [size] "i" (sizeof(*user)));
    *out = value;
    return error;
}

int linux_get_user_word(const unsigned int *user, unsigned int *out) {
    int error;
    register unsigned int value asm("%rdx");
    asm volatile("call __get_user_nocheck_%c[size]"
        : "=a" (error), "=r" (value), "+r" (current_stack_pointer)
        : "0" (user), [size] "i" (sizeof(*user)));
    *out = value;
    return error;
}

int linux_get_user_quad(const unsigned long *user, unsigned long *out) {
    int error;
    register unsigned long value asm("%rdx");
    asm volatile("call __get_user_nocheck_%c[size]"
        : "=a" (error), "=r" (value), "+r" (current_stack_pointer)
        : "0" (user), [size] "i" (sizeof(*user)));
    *out = value;
    return error;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_idle_and_segments.c"}
/* Original Linux x86 6.6 selector-snapshot and idle hardware contracts.
 * Compile and inspect only: privileged instructions must never be run. */
struct linux_thread_selectors {
    unsigned short es, ds;
};

void linux_copy_thread_segments(struct linux_thread_selectors *thread) {
    asm("mov %%es,%0" : "=r" (thread->es) : : "memory");
    asm("mov %%ds,%0" : "=r" (thread->ds) : : "memory");
}

void linux_monitor(const void *address, unsigned long extensions,
                   unsigned long hints) {
    asm volatile(".byte 0x0f, 0x01, 0xc8;"
                 : : "a" (address), "c" (extensions), "d" (hints));
}

void linux_monitorx(const void *address, unsigned long extensions,
                    unsigned long hints) {
    asm volatile(".byte 0x0f, 0x01, 0xfa;"
                 : : "a" (address), "c" (extensions), "d" (hints));
}

void linux_mwait(unsigned long eax, unsigned long ecx) {
    asm volatile(".byte 0x0f, 0x01, 0xc9;" : : "a" (eax), "c" (ecx));
}

void linux_mwaitx(unsigned long eax, unsigned long ebx,
                 unsigned long ecx) {
    asm volatile(".byte 0x0f, 0x01, 0xfb;"
                 : : "a" (eax), "b" (ebx), "c" (ecx));
}

void linux_sti_mwait(unsigned long eax, unsigned long ecx) {
    asm volatile("sti; .byte 0x0f, 0x01, 0xc9;"
                 : : "a" (eax), "c" (ecx));
}

/* Linux also uses 32-bit hint/extension operands. MachineIR must bind the
 * corresponding 32-bit A/B/C/D parts without losing a 64-bit address or
 * treating RBX as caller-saved. */
void linux_monitor_u32(const void *address, unsigned int ext,
                       unsigned int hints) {
    asm volatile(".byte 0x0f, 0x01, 0xc8;"
                 : : "a" (address), "c" (ext), "d" (hints));
}

void linux_mwaitx_u32(unsigned int eax, unsigned int ebx,
                      unsigned int ecx) {
    asm volatile(".byte 0x0f, 0x01, 0xfb;"
                 : : "a" (eax), "b" (ebx), "c" (ecx));
}

/* Linux's wider XSAVE/ptrace selectors use zero-extended 32-bit registers,
 * including FS/GS forms without an explicit compiler memory fence. */
void linux_read_segments_u32(unsigned int *dst) {
    asm("movl %%fs,%0" : "=r" (dst[0]));
    asm("movl %%gs,%0" : "=r" (dst[1]));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_idle_clflush_alt.c"}
/* Linux 6.6 x86 MWAIT idle CLFLUSH patch record. Compile-only. */
void linux_idle_clflush_alternative(const void *address) {
    asm volatile(
        "# ALT: oldnstr\n"
        "661:\n\t"
        "\n662:\n"
        "# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b)) > 0) * "
              "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte (22*32 + (7))\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\t"
        "clflush (%[addr])\n"
        "6651:\n"
        ".popsection\n"
        : : "i" (0), [addr] "a" (address));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_iomem_copy_tied.c"}
/* Original Linux arch/x86/lib/iomem.c GNU register contracts. In particular
 * the outputs are updated C lvalues and the inputs use numeric ties. */
typedef unsigned long usize;

__attribute__((noinline)) static int rep_movs(void *dest,
    const void *src, usize bytes) {
    unsigned long count, out_dest, out_src;
    __asm__ volatile("rep ; movsl\n\t"
        "testb $2,%b4\n\t"
        "je 1f\n\t"
        "movsw\n"
        "1:\ttestb $1,%b4\n\t"
        "je 2f\n\t"
        "movsb\n"
        "2:"
        : "=&c"(count), "=&D"(out_dest), "=&S"(out_src)
        : "0"(bytes / 4U), "q"(bytes),
          "1"((long)dest), "2"((long)src)
        : "memory");
    return count == 0UL && out_dest == (unsigned long)dest + bytes &&
        out_src == (unsigned long)src + bytes;
}

__attribute__((noinline)) static int copy_one_byte(
    unsigned char *dest, const unsigned char *src) {
    unsigned char *end_dest = dest;
    const unsigned char *end_src = src;
    __asm__ volatile("movsb" : "=&D"(end_dest), "=&S"(end_src)
        : "0"(end_dest), "1"(end_src) : "memory");
    return end_dest == dest + 1 && end_src == src + 1;
}

__attribute__((noinline)) static int copy_one_word(
    unsigned char *dest, const unsigned char *src) {
    unsigned char *end_dest = dest;
    const unsigned char *end_src = src;
    __asm__ volatile("movsw" : "=&D"(end_dest), "=&S"(end_src)
        : "0"(end_dest), "1"(end_src) : "memory");
    return end_dest == dest + 2 && end_src == src + 2;
}

int main(void) {
    unsigned char src[32], dest[32];
    unsigned long n, i;
    for (i = 0UL; i < 32UL; ++i) src[i] = (unsigned char)(i * 7UL + 3UL);
    for (n = 0UL; n <= 31UL; ++n) {
        for (i = 0UL; i < 32UL; ++i) dest[i] = 0x5aU;
        if (!rep_movs(dest, src, n)) return 1;
        for (i = 0UL; i < n; ++i)
            if (dest[i] != src[i]) return 2;
        for (; i < 32UL; ++i)
            if (dest[i] != 0x5aU) return 3;
    }
    dest[0] = dest[1] = 0;
    if (!copy_one_byte(dest, src) || dest[0] != src[0]) return 4;
    if (!copy_one_word(dest, src) ||
        dest[0] != src[0] || dest[1] != src[1]) return 5;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_ipv6_checksum.c"}
/* Exact Linux csum_ipv6_magic GNU ADD/ADC form: two 128-bit addresses and
 * a tied scalar checksum accumulator. */
typedef unsigned long long u64;
struct minic_ipv6_words { u64 q[2]; };

#if defined(MINIC_IPV6_CSUM_NEGATIVE) && MINIC_IPV6_CSUM_NEGATIVE == 1
#define MINIC_IPV6_CSUM_DADC "\taddq (%[daddr]),%[sum]\n"
#else
#define MINIC_IPV6_CSUM_DADC "\tadcq (%[daddr]),%[sum]\n"
#endif

#if defined(MINIC_IPV6_CSUM_NEGATIVE) && MINIC_IPV6_CSUM_NEGATIVE == 2
#define MINIC_IPV6_CSUM_SADDR_CONSTRAINT "m"
#else
#define MINIC_IPV6_CSUM_SADDR_CONSTRAINT "r"
#endif

#if defined(MINIC_IPV6_CSUM_NEGATIVE) && MINIC_IPV6_CSUM_NEGATIVE == 3
#define MINIC_IPV6_CSUM_QUALIFIER volatile
#else
#define MINIC_IPV6_CSUM_QUALIFIER
#endif

#if defined(MINIC_IPV6_CSUM_NEGATIVE) && MINIC_IPV6_CSUM_NEGATIVE == 4
#define MINIC_IPV6_CSUM_TIE "r"
#else
#define MINIC_IPV6_CSUM_TIE "[sum]"
#endif

__attribute__((noinline)) u64 minic_ipv6_checksum(
    u64 rest, const struct minic_ipv6_words *saddr,
    const struct minic_ipv6_words *daddr) {
    u64 sum64;
    __asm__ MINIC_IPV6_CSUM_QUALIFIER(
        "\taddq (%[saddr]),%[sum]\n"
        "\tadcq 8(%[saddr]),%[sum]\n"
        MINIC_IPV6_CSUM_DADC
        "\tadcq 8(%[daddr]),%[sum]\n"
        "\tadcq $0,%[sum]\n"
        : [sum] "=r" (sum64)
        : MINIC_IPV6_CSUM_TIE (rest),
          [saddr] MINIC_IPV6_CSUM_SADDR_CONSTRAINT (saddr),
          [daddr] "r" (daddr));
    return sum64;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_ipv6_checksum_driver.c"}
#include <stdint.h>
#include <stdio.h>

struct minic_ipv6_words { uint64_t q[2]; };
uint64_t minic_ipv6_checksum(uint64_t,
    const struct minic_ipv6_words *, const struct minic_ipv6_words *);

static uint64_t reference(uint64_t rest,
    const struct minic_ipv6_words *src,
    const struct minic_ipv6_words *dst) {
    uint64_t words[] = {src->q[0],src->q[1],dst->q[0],dst->q[1]};
    uint64_t carry = 0;
    unsigned int i;
    for (i = 0; i < 4; ++i) {
        const __uint128_t sum = (__uint128_t)rest + words[i] + carry;
        rest = (uint64_t)sum;
        carry = (uint64_t)(sum >> 64);
    }
    return rest + carry;
}

int main(void) {
    static const struct {
        uint64_t rest;
        struct minic_ipv6_words src,dst;
    } cases[] = {
        {0, {{0,0}}, {{0,0}}},
        {0x123456789abcdef0ULL,
            {{0x3333333333333333ULL,0x8888888888888888ULL}},
            {{0x5555555555555555ULL,0x9999999999999999ULL}}},
        {1, {{UINT64_MAX,UINT64_MAX}}, {{1,UINT64_MAX}}},
        {UINT64_MAX, {{UINT64_MAX,UINT64_MAX}},
            {{UINT64_MAX,UINT64_MAX}}},
        {0x1122334455667788ULL, {{UINT64_MAX,1}}, {{UINT64_MAX,1}}}
    };
    unsigned int i;
    for (i = 0; i < sizeof(cases)/sizeof(cases[0]); ++i) {
        const uint64_t got = minic_ipv6_checksum(
            cases[i].rest,&cases[i].src,&cases[i].dst);
        const uint64_t expected = reference(
            cases[i].rest,&cases[i].src,&cases[i].dst);
        if (got != expected) {
            fprintf(stderr,"IPv6 checksum case %u: got %llx expected %llx\n",
                i,(unsigned long long)got,(unsigned long long)expected);
            return 1;
        }
    }
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_irqentry_driver.c"}
typedef struct linux_irqentry_state {
    union { _Bool exit_rcu; _Bool lockdep; };
} linux_irqentry_state_t;

extern linux_irqentry_state_t linux_irqstate_make(_Bool);
extern int linux_irqstate_consume(linux_irqentry_state_t);
extern int linux_irqstate_roundtrip(int);
extern int linux_irqstate_from_gnu(int);

linux_irqentry_state_t gnu_irqstate_make(_Bool value) {
    linux_irqentry_state_t result;
    result.lockdep = value;
    return result;
}

int main(void) {
    linux_irqentry_state_t state = linux_irqstate_make(1);
    if (!state.exit_rcu || !state.lockdep) return 1;
    state = linux_irqstate_make(0);
    if (state.exit_rcu || state.lockdep) return 2;
    state = gnu_irqstate_make(1);
    if (linux_irqstate_consume(state) != 1) return 3;
    state = gnu_irqstate_make(0);
    if (linux_irqstate_consume(state) != 0) return 4;
    if (linux_irqstate_roundtrip(1) != 1 ||
        linux_irqstate_roundtrip(0) != 0) return 5;
    if (linux_irqstate_from_gnu(1) != 1 ||
        linux_irqstate_from_gnu(0) != 0) return 6;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_irqentry_state.c"}
/* Linux irqentry_state_t: one SysV INTEGER eightbyte with an anonymous
 * Boolean union. GCC returns/passes the entire record in AL/DIL. */
typedef struct linux_irqentry_state {
    union {
        _Bool exit_rcu;
        _Bool lockdep;
    };
} linux_irqentry_state_t;

linux_irqentry_state_t linux_irqstate_make(_Bool value) {
    linux_irqentry_state_t result;
    result.exit_rcu = value;
    return result;
}

int linux_irqstate_consume(linux_irqentry_state_t state) {
    return state.lockdep ? 1 : 0;
}

int linux_irqstate_roundtrip(int value) {
    return linux_irqstate_consume(linux_irqstate_make(value != 0));
}

extern linux_irqentry_state_t gnu_irqstate_make(_Bool);
int linux_irqstate_from_gnu(int value) {
    linux_irqentry_state_t state = gnu_irqstate_make(value != 0);
    return state.exit_rcu ? 1 : 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_jump_label.c"}
/* SPDX-License-Identifier: GPL-2.0 */
/* Linux x86 jump_label.h: GNU asm goto must retain the patch-site table,
 * both PREL32 entries, and the key+flags offset in the 8-byte third word. */
struct linux_static_key { unsigned long enabled; };
static struct linux_static_key branch_key;

int linux_static_branch_tagged(void) {
    asm goto("1:"
             "jmp %l[l_yes] # objtool NOPs this \n\t"
             ".pushsection __jump_table,  \"aw\" \n\t"
             " " ".balign 8" " " "\n\t"
             ".long 1b - . \n\t"
             ".long %l[l_yes] - . \n\t"
             " " ".quad" " " "%c0 + %c1 - .\n\t"
             ".popsection \n\t"
             : : "i" (&branch_key), "i" (2) : : l_yes);
    return 0;
l_yes:
    return 1;
}

int linux_static_branch_plain(void) {
    asm goto("1:"
             "jmp %l[l_yes]\n\t"
             ".pushsection __jump_table,  \"aw\" \n\t"
             " " ".balign 8" " " "\n\t"
             ".long 1b - . \n\t"
             ".long %l[l_yes] - . \n\t"
             " " ".quad" " " "%c0 + %c1 - .\n\t"
             ".popsection \n\t"
             : : "i" (&branch_key), "i" (1) : : l_yes);
    return 0;
l_yes:
    return 1;
}

/* Source-inline GNU operands are not necessarily constants until the
 * caller's always_inline symbolic/integer specialization has occurred.
 * This is the same producer shape used by the real Linux `arch_static_branch`
 * after preprocessor expansion; if lowered as an SSA pointer, GNU AS cannot
 * encode the required __jump_table third entry. */
static inline __attribute__((always_inline)) int
linux_inline_key_with_branch(struct linux_static_key *key, int branch) {
    asm goto("1:"
             "jmp %l[l_yes] # objtool NOPs this \n\t"
             ".pushsection __jump_table,  \"aw\" \n\t"
             " " ".balign 8" " " "\n\t"
             ".long 1b - . \n\t"
             ".long %l[l_yes] - . \n\t"
             " " ".quad" " " "%c0 + %c1 - .\n\t"
             ".popsection \n\t"
             : : "i" (key), "i" (2 | branch) : : l_yes);
    return 0;
l_yes:
    return 1;
}

int linux_static_branch_specialized(void) {
    return linux_inline_key_with_branch(&branch_key, 1);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_kernel_nofault_driver.c"}
/* Run ONLY the valid-pointer path. Fault recovery requires a kernel
 * __ex_table handler and is verified structurally in the ELF object. */
typedef unsigned char u8;
typedef unsigned short u16;
typedef unsigned int u32;
typedef unsigned long long u64;
extern int linux_nofault_get_b(const void *, u8 *);
extern int linux_nofault_get_w(const void *, u16 *);
extern int linux_nofault_get_l(const void *, u32 *);
extern int linux_nofault_get_q(const void *, u64 *);
extern int linux_nofault_put_b(void *, u8);
extern int linux_nofault_put_w(void *, u16);
extern int linux_nofault_put_l(void *, u32);
extern int linux_nofault_put_q(void *, u64);
extern int linux_nofault_put_ptr(void *, void *);

int main(void) {
    u64 memory = 0x1122334455667788ULL;
    u64 q;
    u32 l;
    u16 w;
    u8 b;
    if (linux_nofault_get_b(&memory, &b) || b != 0x88U) return 1;
    if (linux_nofault_get_w(&memory, &w) || w != 0x7788U) return 2;
    if (linux_nofault_get_l(&memory, &l) || l != 0x55667788U) return 3;
    if (linux_nofault_get_q(&memory, &q) || q != memory) return 4;
    if (linux_nofault_put_b(&memory, 0x99U) ||
        memory != 0x1122334455667799ULL) return 5;
    if (linux_nofault_put_w(&memory, 0xabbaU) ||
        memory != 0x112233445566abbaULL) return 6;
    if (linux_nofault_put_l(&memory, 0xd00dcafeU) ||
        memory != 0x11223344d00dcafeULL) return 7;
    if (linux_nofault_put_q(&memory, 0x123456789abcdef0ULL) ||
        memory != 0x123456789abcdef0ULL) return 8;
    {
        void *pointer = 0;
        if (linux_nofault_put_ptr(&pointer, &memory) || pointer != &memory)
            return 9;
    }
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_kernel_nofault_goto.c"}
/* Original Linux x86 kernel nofault MOV + GNU asm-goto recovery: the
 * second PREL32 __ex_table field must identify the C fault block, not a
 * synthetic fallthrough. Valid-pointer calls are safe in user mode. */
typedef unsigned char u8;
typedef unsigned short u16;
typedef unsigned int u32;
typedef unsigned long long u64;
struct __large_struct { unsigned long data[16]; };

#define NOFAULT_LOAD(width) \
    "\n1: mov" width " %[umem],%[output]\n" \
    " .pushsection \"__ex_table\",\"a\"\n" \
    " .balign 4\n" \
    " .long (1b) - .\n" \
    " .long (%l2) - .\n" \
    " .long 3\n" \
    " .popsection\n"

#define NOFAULT_STORE(width) \
    "\n1: mov" width " %0,%1\n" \
    " .pushsection \"__ex_table\",\"a\"\n" \
    " .balign 4\n" \
    " .long (1b) - .\n" \
    " .long (%l2) - .\n" \
    " .long 3\n" \
    " .popsection\n"

#define DEFINE_NOFAULT_GET(suffix, ctype, regconstraint, mnemonic) \
    int linux_nofault_get_##suffix(const void *p, ctype *out) { \
        ctype temp; \
        asm volatile goto(NOFAULT_LOAD(mnemonic) \
            : [output] regconstraint (temp) \
            : [umem] "m" (*(struct __large_struct *)p) : : bad); \
        *out = temp; \
        return 0; \
    bad: return -14; \
    }

#define DEFINE_NOFAULT_PUT(suffix, ctype, regconstraint, mnemonic) \
    int linux_nofault_put_##suffix(void *p, ctype value) { \
        asm goto(NOFAULT_STORE(mnemonic) \
            : : regconstraint (value), \
                "m" (*(struct __large_struct *)p) : : bad); \
        return 0; \
    bad: return -14; \
    }

DEFINE_NOFAULT_GET(b, u8,  "=q", "b")
DEFINE_NOFAULT_GET(w, u16, "=r", "w")
DEFINE_NOFAULT_GET(l, u32, "=r", "l")
DEFINE_NOFAULT_GET(q, u64, "=r", "q")
DEFINE_NOFAULT_PUT(b, u8,  "iq", "b")
DEFINE_NOFAULT_PUT(w, u16, "ir", "w")
DEFINE_NOFAULT_PUT(l, u32, "ir", "l")
DEFINE_NOFAULT_PUT(q, u64, "er", "q")

/* Signal frames store pointer-typed uc_link with the same 8-byte nofault
 * kernel MOV and exception-table goto branch; it is not an integer lvalue. */
int linux_nofault_put_ptr(void *p, void *value) {
    asm goto(NOFAULT_STORE("q")
        : : "er"(value), "m"(*(struct __large_struct *)p) : : bad);
    return 0;
bad:
    return -14;
}
@@@ end
