@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fpu_boot.c"}
/* Linux FPU discovery and interrupt/idle machine transitions. Compile and
 * GNU-assemble this fixture; NEVER execute the privileged CLI/STI/HLT
 * functions in a normal user process. The x87 status probes are a genuine
 * pair of 16-bit GNU +m output locations, not plain compiler barriers. */
typedef unsigned short minic_u16;

int minic_linux_x87_probe(minic_u16 *status, minic_u16 *control) {
    __asm__ volatile("fninit ; fnstsw %0 ; fnstcw %1"
                     : "+m"(*status), "+m"(*control));
    return *status == 0 && (*control & 0x103f) == 0x003f;
}

void minic_linux_x87_reset(void) {
    __asm__ volatile("fninit");
}

void minic_linux_native_irq_disable(void) {
    __asm__ volatile("cli" : : : "memory");
}

void minic_linux_native_irq_enable(void) {
    __asm__ volatile("sti" : : : "memory");
}

void minic_linux_native_safe_halt(void) {
    __asm__ volatile("sti; hlt" : : : "memory");
}

void minic_linux_native_halt(void) {
    __asm__ volatile("hlt");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fpu_userframe.c"}
/* Linux signal-frame FPU save/restore has two SMAP alternatives and a
 * type-15 uaccess fault record; this is not an unguarded FXSAVE. */
struct linux_fregs { unsigned char bytes[108]; };
struct linux_fxregs { unsigned char bytes[512]; };

#define SMAP_PATCH(replacement) \
    "# ALT: oldnstr\n" "661:\n\t" "" "\n662:\n" \
    "# ALT: padding\n" \
    ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " \
    "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" \
    "663" ":\n" \
    ".pushsection .altinstructions,\"a\"\n" \
    " .long 661b - .\n" \
    " .long " "664""1""f - .\n" \
    " .4byte " "( 9*32+20)" "\n" \
    " .byte " "663""b-661b" "\n" \
    " .byte " "665""1""f-""664""1""f" "\n" \
    ".popsection\n" \
    ".pushsection .altinstr_replacement, \"ax\"\n" \
    "# ALT: replacement " "1" "\n" \
    "664""1"":\n\t" replacement "\n" "665""1" ":\n" \
    ".popsection\n"

#define FPU_USER_FRAME(opcode) \
    SMAP_PATCH(".byte 0x0f,0x01,0xcb") \
    "\n1: " opcode "\n2: " \
    SMAP_PATCH(".byte 0x0f,0x01,0xca") \
    "\n" " .pushsection \"__ex_table\",\"a\"\n" \
    " .balign 4\n" " .long (" "1b" ") - .\n" \
    " .long (" "2b" ") - .\n" " .long " "15" " \n" \
    " .popsection\n"

int linux_fnsave_user(struct linux_fregs *p) {
    int err;
    asm volatile(FPU_USER_FRAME("fnsave %[fx]; fwait")
        : [err] "=a"(err), [fx] "=m"(*p) : "0"(0), "m"(*p));
    return err;
}
int linux_fxsave_user(struct linux_fxregs *p) {
    int err;
    asm volatile(FPU_USER_FRAME("fxsaveq %[fx]")
        : [err] "=a"(err), [fx] "=m"(*p) : "0"(0), "m"(*p));
    return err;
}
int linux_fxrstor_user(struct linux_fxregs *p) {
    int err;
    asm volatile(FPU_USER_FRAME("fxrstorq %[fx]")
        : [err] "=a"(err), [fx] "=m"(*p) : "0"(0), "m"(*p));
    return err;
}

/* A named *input* memory operand is GNU ordinal %3, not %1 (the output
 * memory operand). The real Linux fpu/signal.i uses this variant. */
int linux_fxrstor_named_input(struct linux_fxregs *p) {
    int err;
    asm volatile(FPU_USER_FRAME("fxrstorq %[fx]")
        : [err] "=a"(err), "=m"(*p)
        : "0"(0), [fx] "m"(*p));
    return err;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fsgsbase_reject.c"}
/* Target-qualified Linux FSGSBASE negative cases. Each mode must fail MiniC
 * -S before GNU AS: mismatched constraints, Source spelling, scalar width or
 * compiler memory ordering must never become an unchecked physical opcode. */
typedef unsigned long u64;

#if MINIC_FSGSBASE_NEGATIVE == 1
u64 wrong_read_output(void) {
    u64 value;
    asm volatile("rdfsbase %0" : "=m" (value) : : "memory");
    return value;
}
#elif MINIC_FSGSBASE_NEGATIVE == 2
void wrong_write_input(u64 value) {
    asm volatile("wrfsbase %0" : : "m" (value) : "memory");
}
#elif MINIC_FSGSBASE_NEGATIVE == 3
u64 forged_extra_instruction(void) {
    u64 value;
    asm volatile("rdfsbase %0; nop" : "=r" (value) : : "memory");
    return value;
}
#elif MINIC_FSGSBASE_NEGATIVE == 4
unsigned int narrowed_result(void) {
    unsigned int value;
    asm volatile("rdfsbase %0" : "=r" (value) : : "memory");
    return value;
}
#elif MINIC_FSGSBASE_NEGATIVE == 5
u64 missing_memory_barrier(void) {
    u64 value;
    asm volatile("rdgsbase %0" : "=r" (value));
    return value;
}
#else
#error unsupported FSGSBASE negative mode
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fxrstor_safe.c"}
/* Linux FXRSTORQ with type-17 register-specific -EFAULT exception table.
 * Only object/relocation inspection: the kernel handler is not in userspace. */
struct linux_fxregs_state { unsigned char bytes[512]; };

int linux_fxrstor_safe(struct linux_fxregs_state *p) {
    int error;
    asm volatile(
        "1:" "fxrstorq %[fx]" "\n\t" "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n"
        " .balign 4\n"
        " .long (" "1b" ") - .\n"
        " .long (" "2b" ") - .\n"
        ".macro extable_type_reg type:req reg:req\n"
        ".set .Lfound, 0\n"
        ".set .Lregnr, 0\n"
        ".irp rs,rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15\n"
        ".ifc \\reg, %%\\rs\n"
        ".set .Lfound, .Lfound+1\n"
        ".long \\type + (.Lregnr << 8)\n"
        ".endif\n"
        ".set .Lregnr, .Lregnr+1\n"
        ".endr\n"
        ".set .Lregnr, 0\n"
        ".irp rs,eax,ecx,edx,ebx,esp,ebp,esi,edi,r8d,r9d,r10d,r11d,r12d,r13d,r14d,r15d\n"
        ".ifc \\reg, %%\\rs\n"
        ".set .Lfound, .Lfound+1\n"
        ".long \\type + (.Lregnr << 8)\n"
        ".endif\n"
        ".set .Lregnr, .Lregnr+1\n"
        ".endr\n"
        ".if (.Lfound != 1)\n"
        ".error \"extable_type_reg: bad register argument\"\n"
        ".endif\n"
        ".endm\n"
        "extable_type_reg reg=" "%[err]" ", type="
            "(17 | ((-14) << 16))" " \n"
        ".purgem extable_type_reg\n"
        " .popsection\n"
        : [err] "=r"(error), "=m"(*p)
        : "0"(0), [fx] "m"(*p));
    return error;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fxsave.c"}
/* x86 Linux FPU state save contracts: both architecturally different pointer
 * encodings must preserve a 512-byte, 16-byte-aligned memory output. These
 * instructions can execute on supported user CPUs but tests only assemble. */
struct minic_test_fx_area {
    unsigned char image[512];
} __attribute__((aligned(16)));

static struct minic_test_fx_area minic_test_static_fx_area;

void minic_test_fxsave32(struct minic_test_fx_area *area) {
    __asm__ volatile("fxsave %0" : "+m"(*area));
}

void minic_test_fxsave64(struct minic_test_fx_area *area) {
    __asm__ volatile("fxsaveq %[fx]" : [fx] "=m"(*area));
}

void minic_test_fxsave_static(void) {
    __asm__ volatile("fxsave %0" : "+m"(minic_test_static_fx_area));
}
