@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_ds_regset.c"}
/* SPDX-License-Identifier: GPL-2.0 */
/* arch/x86/kernel/fpu/regset.c __convert_from_fxsr: a bare DS selector
 * snapshot is stored in a 32-bit legacy FPU save area, not a u16 local. */
struct linux_i387_env {
    unsigned int fos;
    unsigned short selector;
};

void linux_read_fpu_regset_ds(struct linux_i387_env *env) {
    asm("mov %%ds,%0" : "=r" (env->fos) : : "memory");
    asm("mov %%es,%0" : "=r" (env->selector) : : "memory");
    env->fos |= 0xffff0000U;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_efi_kernel_transfer.c"}
/* Real Linux EFI handoff: input #0 is a 64-bit entry address, and input #1
 * must be live in RSI when the hardware executes the indirect jump. */
void __attribute__((noreturn)) minic_efi_kernel_transfer(
#if MINIC_EFI_TRANSFER_NEGATIVE == 3
    unsigned int entry,
#else
    unsigned long entry,
#endif
    void *boot_params)
{
#if MINIC_EFI_TRANSFER_NEGATIVE == 1
    __asm__("jmp %0" : : "r" (entry), "S" (boot_params));
#elif MINIC_EFI_TRANSFER_NEGATIVE == 2
    __asm__("jmp *%0" : : "r" (entry), "D" (boot_params));
#else
    __asm__("jmp *%0" : : "r" (entry), "S" (boot_params));
#endif
    __builtin_unreachable();
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_fdiv_bug.c"}
/* SPDX-License-Identifier: GPL-2.0 */
/* Original arch/x86/kernel/fpu/bugs.c x87 probe, compiled but not run. */
static double x __attribute__((section(".init.data"))) = 4195835.0;
static double y __attribute__((section(".init.data"))) = 3145727.0;

int minic_linux_fpu_check_fdiv(void) {
    int fdiv_bug;
    __asm__("fninit\n\t"
            "fldl %1\n\t"
            "fdivl %2\n\t"
            "fmull %2\n\t"
            "fldl %1\n\t"
            "fsubp %%st,%%st(1)\n\t"
            "fistpl %0\n\t"
            "fwait\n\t"
            "fninit"
            : "=m" (fdiv_bug)
            : "m" (x), "m" (y));
    return fdiv_bug;
}
