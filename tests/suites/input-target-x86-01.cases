@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_segment_load_extable.c"}
/* Linux 6.6.143 loadsegment(): exact GNU extended ASM plus exception entry.
 * Kernel-only selector writes; assemble, never execute in userspace. */
typedef unsigned short u16;

#define LOADSEG(name, segment) \
void name(u16 selector) { \
    asm volatile("1: movw %0, %%" #segment "\n" \
        "2:\n" \
        " .pushsection \"__ex_table\",\"a\"\n" \
        " .balign 4\n" \
        " .long (1b) - .\n" \
        " .long (2b) - .\n" \
        " .long 5\n" \
        " .popsection\n" : : "rm"(selector) : "memory"); \
}

LOADSEG(load_fs,fs)
LOADSEG(load_gs,gs)
LOADSEG(load_ds,ds)
LOADSEG(load_es,es)
LOADSEG(load_ss,ss)
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_selector_lar.c"}
/* Linux force_valid_ss, including the actual ZF-dependent invalid selector
 * result. LAR reads access-right metadata rather than selector bits. */
typedef unsigned short u16;
typedef unsigned int u32;

u32 linux_read_ss_access_rights(u16 selector) {
    u32 access_rights;
    asm volatile("lar %[old_ss], %[ar]\n\t"
                 "jz 1f\n\t"
                 "xorl %[ar], %[ar]\n\t"
                 "1:"
        : [ar] "=r"(access_rights)
        : [old_ss] "rm"(selector));
    return access_rights;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_selector_lar_driver.c"}
typedef unsigned short u16;
typedef unsigned int u32;
extern u32 linux_read_ss_access_rights(u16);

static u32 gnu_read_ss_access_rights(u16 selector) {
    u32 access_rights;
    asm volatile("lar %1, %0\n\t"
                 "jz 1f\n\t"
                 "xorl %0, %0\n\t"
                 "1:"
        : "=r"(access_rights) : "rm"(selector));
    return access_rights;
}

int main(void) {
    u16 ss;
    asm volatile("movw %%ss, %0" : "=r"(ss));
    if (linux_read_ss_access_rights(0) != 0U) return 1;
    if (linux_read_ss_access_rights(1) != gnu_read_ss_access_rights(1))
        return 2;
    if (linux_read_ss_access_rights(ss) != gnu_read_ss_access_rights(ss))
        return 3;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_smap_rep_alternative.c"}
/* The actual Linux SMAP and REP MOVSB ALTERNATIVE section grammar.
 * These kernel instructions must only be assembled/inspected, not run. */
register unsigned long current_stack_pointer asm("rsp");

#define SMAP_ALTERNATIVE(replacement) \
    "# ALT: oldnstr\n" "661:\n\t" "" "\n662:\n" \
    "# ALT: padding\n" \
    ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " \
    "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" \
    "663" ":\n" \
    ".pushsection .altinstructions,\"a\"\n" \
    " .long 661b - .\n" \
    " .long " "664""1""f - .\n" \
    " .4byte " "( 9*32+20)" "\n" \
    " .byte " "663""b-661b" "\n" \
    " .byte " "665""1""f-""664""1""f" "\n" \
    ".popsection\n" \
    ".pushsection .altinstr_replacement, \"ax\"\n" \
    "# ALT: replacement " "1" "\n" \
    "664""1"":\n\t" replacement "\n" "665""1" ":\n" \
    ".popsection\n"

static inline void linux_clac(void) {
    asm volatile(SMAP_ALTERNATIVE(".byte 0x0f,0x01,0xca") : : : "memory");
}
static inline void linux_stac(void) {
    asm volatile(SMAP_ALTERNATIVE(".byte 0x0f,0x01,0xcb") : : : "memory");
}
unsigned long linux_smap_save(void) {
    unsigned long flags;
    asm volatile("# smap_save\n\t" SMAP_ALTERNATIVE(
        "pushf; pop %0; .byte 0x0f,0x01,0xca\n\t")
        : "=rm"(flags) : : "memory", "cc");
    return flags;
}
void linux_smap_restore(unsigned long flags) {
    asm volatile("# smap_restore\n\t" SMAP_ALTERNATIVE(
        "push %0; popf\n\t") : : "g"(flags) : "memory", "cc");
}
extern unsigned long rep_movs_alternative(void *, const void *, unsigned);
unsigned long linux_copy_user_generic(void *to, const void *from,
                                      unsigned long len) {
    linux_stac();
    asm volatile(
        "1:\n\t"
        "# ALT: oldnstr\n" "661:\n\t" "rep movsb" "\n662:\n" "# ALT: padding\n" ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" "663" ":\n" ".pushsection .altinstructions,\"a\"\n" " .long 661b - .\n" " .long " "664""1""f - .\n" " .4byte " "(((1 << 0) << 16) | ((18*32+ 4)))" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""1""f-""664""1""f" "\n" ".popsection\n" ".pushsection .altinstr_replacement, \"ax\"\n" "# ALT: replacement " "1" "\n" "664""1"":\n\t" "call rep_movs_alternative" "\n" "665""1" ":\n" ".popsection\n"
        "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n" " .balign 4\n" " .long (" "1b" ") - .\n" " .long (" "2b" ") - .\n" " .long " "3" " \n" " .popsection\n"
        : "+c"(len), "+D"(to), "+S"(from), "+r"(current_stack_pointer)
        : : "memory", "rax");
    linux_clac();
    return len;
}

extern unsigned long rep_stos_alternative(void *, unsigned long);
unsigned long linux_clear_user(void *address, unsigned long size) {
    asm volatile(
        "1:\n\t"
        "# ALT: oldnstr\n" "661:\n\t" "rep stosb" "\n662:\n" "# ALT: padding\n" ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" "663" ":\n" ".pushsection .altinstructions,\"a\"\n" " .long 661b - .\n" " .long " "664""1""f - .\n" " .4byte " "(((1 << 0) << 16) | ((12*32+11)))" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""1""f-""664""1""f" "\n" ".popsection\n" ".pushsection .altinstr_replacement, \"ax\"\n" "# ALT: replacement " "1" "\n" "664""1"":\n\t" "call rep_stos_alternative" "\n" "665""1" ":\n" ".popsection\n"
        "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n" " .balign 4\n" " .long (" "1b" ") - .\n" " .long (" "2b" ") - .\n" " .long " "3" " \n" " .popsection\n"
        : "+c"(size), "+D"(address), "+r"(current_stack_pointer)
        : "a"(0));
    return size;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_task_vdso.c"}
/* Privileged task selector and vDSO getcpu alternatives: never executed. */
void load_task_selector(unsigned short selector) {
    __asm__ __volatile__("ltr %w0" : : "q"(selector));
}
unsigned short store_task_selector16(void) {
    unsigned short value;
    __asm__ __volatile__("str %0" : "=r"(value));
    return value;
}
unsigned int store_task_selector32(void) {
    unsigned int value;
    __asm__ __volatile__("str %0" : "=r"(value));
    return value;
}
unsigned long store_task_selector64(void) {
    unsigned long value;
    __asm__ __volatile__("str %0" : "=r"(value));
    return value;
}
unsigned int vdso_getcpu_lsl(void) {
    unsigned int result;
    __asm__ __volatile__(
        "# ALT: oldnstr\n"
        "661:\n\tlsl %[seg],%[p]\n"
        "662:\n"
        "# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b))>0)*"
        "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        ".long 661b - .\n"
        ".long 6641f - .\n"
        ".4byte (16*32+22)\n"
        ".byte 663b - 661b\n"
        ".byte 6651f - 6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement,\"ax\"\n"
        "# ALT: replacement1\n"
        "6641:\n\t.byte 0xf3,0x0f,0xc7,0xf8\n"
        "6651:\n"
        ".popsection\n"
        : [p] "=a"(result) : "i"(0), [seg] "r"(123));
    return result;
}
