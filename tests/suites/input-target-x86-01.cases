@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_boot_flags.c"}
/* Compressed x86 cpuflags: constant/variable bit forms, CPUID ties, and
 * RFLAGS ID-bit probe. Compile only: do not execute CPU feature probes. */
_Bool linux_boot_test_bit(int number, const unsigned int *memory) {
    _Bool flag;
    asm("btl %2,%1" "\n\t/* output condition code " "c" "*/\n"
        : "=@cc" "c" (flag) : "m" (*memory), "Ir" (number));
    return flag;
}

void linux_boot_set_bit(int number, unsigned int *memory) {
    asm("btsl %1,%0" : "+m" (*memory) : "Ir" (number));
}

void linux_boot_cpuid(unsigned int leaf, unsigned int subleaf,
    unsigned int *a, unsigned int *b, unsigned int *c, unsigned int *d) {
    asm volatile("cpuid" : "=a" (*a), "=b" (*b), "=c" (*c), "=d" (*d)
        : "0" (leaf), "2" (subleaf));
}

int linux_boot_has_eflag(unsigned long mask) {
    unsigned long before, after;
    asm volatile("pushfq" "\t\n\t"
        "pushfq" "\t\n\t"
        "pop %0\t\n\t"
        "mov %0,%1\t\n\t"
        "xor %2,%1\t\n\t"
        "push %1\t\n\t"
        "popfq" "\t\n\t"
        "pushfq" "\t\n\t"
        "pop %1\t\n\t"
        "popfq"
        : "=&r" (before), "=&r" (after) : "ri" (mask));
    return !!((before ^ after) & mask);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_boot_segments.c"}
/* x86-64 Linux head64 startup selectors: inspect -S / GAS only.
 * The operation changes DS, SS and ES and is not safe in user mode. */
void minic_test_linux_boot_segments(void) {
    asm volatile("movl %%eax, %%ds\n"
                 "movl %%eax, %%ss\n"
                 "movl %%eax, %%es\n"
                 : : "a"(3 * 8) : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_boot_string.c"}
/* Linux 6.6 x86 boot string family: one exact GNU ABI for each instruction.
 * These instructions are safe in userspace and are verified at runtime. */
static int boot_memcmp(const void *left, const void *right,
    unsigned long count) {
    _Bool differs;
    asm("repe; cmpsb" "\n\t/* output condition code " "nz" "*/\n"
        : "=@cc" "nz" (differs), "+D" (left), "+S" (right), "+c" (count));
    return differs;
}

static unsigned int boot_divl(unsigned int lo, unsigned int hi,
    unsigned int divisor, unsigned int *remainder) {
    asm("divl %2" : "=a" (lo), "=d" (*remainder)
        : "rm" (divisor), "0" (lo), "1" (hi));
    return lo;
}

static void *boot_memcpy(void *dest, const void *source, unsigned long length) {
    long count, out_dest, out_source;
    asm volatile("rep ; movsq\n\t"
        "movq %4,%%rcx\n\t"
        "rep ; movsb\n\t"
        : "=&c" (count), "=&D" (out_dest), "=&S" (out_source)
        : "0" (length >> 3), "g" (length & 7), "1" (dest), "2" (source)
        : "memory");
    return dest;
}

int main(void) {
    unsigned char a[24], b[24];
    unsigned int rem = 99U;
    unsigned int quotient;
    unsigned int i;
    for (i = 0U; i < 24U; ++i) {
        a[i] = (unsigned char)(i * 7U + 3U);
        b[i] = 0U;
    }
    if (boot_memcmp(a,a,24U) != 0 || boot_memcmp(a,b,24U) == 0)
        return 1;
    quotient = boot_divl(0x00000005U,0x00000001U,3U,&rem);
    if (quotient != 0x55555557U || rem != 0U) return 2;
    if (boot_memcpy(b,a,21U) != b ||
        boot_memcmp(a,b,21U) != 0 || b[21] != 0U)
        return 3;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_bug_table_variants.c"}
/* Original Linux 6.6 BUG/WARN local-constant and metadata encodings. These
 * contain UD2 and must only be compiled/assembled; never execute them. */
struct bug_entry {
    int bug_addr;
    int file;
    unsigned short line;
    unsigned short flags;
};

void linux_bug_numeric_no_discard(void) {
    __auto_type __flags = 0;
    asm volatile("1:\t" ".byte 0x0f, 0x0b" "\n"
        ".pushsection __bug_table,\"aw\"\n"
        "2:\t" ".long " "1b" " - ." "\t# bug_entry::bug_addr\n"
        "\t" ".long " "%c0" " - ." "\t# bug_entry::file\n"
        "\t.word %c1" "\t# bug_entry::line\n"
        "\t.word %c2" "\t# bug_entry::flags\n"
        "\t.org 2b+%c3\n"
        ".popsection\n" ""
        : : "i"("fs/ext4/fsync.c"), "i"(150), "i"(__flags),
            "i"(sizeof(struct bug_entry)));
}

void linux_bug_numeric_reachable(void) {
    asm volatile("1:\t.byte 0x0f, 0x0b\n"
        ".pushsection __bug_table,\"aw\"\n"
        "2:\t.long 1b - .\n"
        ".long %c0 - .\n"
        ".word %c1\n"
        ".word %c2\n"
        ".org 2b+%c3\n"
        ".popsection\n"
        "998:\n"
        ".pushsection .discard.reachable\n"
        ".long 998b\n"
        ".popsection\n"
        : : "i"("drivers/gpu/drm/drm_blend.c"), "i"(89), "i"(0),
            "i"(sizeof(struct bug_entry)));
}

void linux_bug_named_no_discard(void) {
    asm volatile("1:\t.byte 0x0f, 0x0b\n"
        ".pushsection __bug_table,\"aw\"\n"
        "2:\t.long 1b - .\n"
        ".long %c[path] - .\n"
        ".word %c[ln]\n"
        ".word %c[fl]\n"
        ".org 2b+%c[sz]\n"
        ".popsection\n"
        : : [path] "i"("include/linux/bug.h"),
            [ln] "i"(111), [fl] "i"(0),
            [sz] "i"(sizeof(struct bug_entry)));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_control_register.c"}
/* Linux control registers: machine instruction, never a dummy C load. */
typedef unsigned long u64;
typedef unsigned int u32;

static u64 read_cr0(void) {
    u64 value;
    __asm__ volatile("mov %%cr0,%0\n\t" : "=r"(value) : "m"(*(u32 *)0x1000UL));
    return value;
}
static u64 read_cr2(void) {
    u64 value;
    __asm__ volatile("mov %%cr2,%0\n\t" : "=r"(value) : "m"(*(u32 *)0x1000UL));
    return value;
}
static u64 read_cr3(void) {
    u64 value;
    __asm__ volatile("mov %%cr3,%0\n\t" : "=r"(value) : "m"(*(u32 *)0x1000UL));
    return value;
}
static u64 read_cr4(void) {
    u64 value;
    __asm__ volatile("mov %%cr4,%0\n\t" : "=r"(value) : "m"(*(u32 *)0x1000UL));
    return value;
}
static void write_cr2(u64 value) {
    __asm__ volatile("mov %0,%%cr2" : : "r"(value) : "memory");
}
static void write_cr3(u64 value) {
    __asm__ volatile("mov %0,%%cr3" : : "r"(value) : "memory");
}

/* Kernel write_cr0/write_cr4 also use the single tied +r signature. */
static void write_cr0_tied(u64 value) {
    __asm__ volatile("mov %0,%%cr0" : "+r"(value) : : "memory");
}
static void write_cr4_tied(u64 value) {
    __asm__ volatile("mov %0,%%cr4" : "+r"(value) : : "memory");
}
static void write_cr0_plain(u64 value) {
    __asm__ volatile("mov %0,%%cr0" : : "r"(value));
}
static void write_cr4_plain(u64 value) {
    __asm__ volatile("mov %0,%%cr4" : : "r"(value));
}
/* Some early-boot reads omit the fake memory dependency altogether. */
static u64 read_cr0_plain(void) {
    u64 value;
    __asm__ volatile("mov %%cr0,%0" : "=r"(value));
    return value;
}

u64 minic_linux_cr_read_all(void) {
    return read_cr0() ^ read_cr2() ^ read_cr3() ^ read_cr4() ^
        read_cr0_plain();
}

void minic_linux_cr_write_pair(u64 a, u64 b) {
    write_cr2(a);
    write_cr3(b);
    write_cr0_tied(a);
    write_cr4_tied(b);
    write_cr0_plain(a);
    write_cr4_plain(b);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_cpu_buffer_clear.c"}
/* Linux 6.6 MDS buffer-clear and WBINVD cache-flush hardware effects.
 * Never execute on an unprivileged host. */
void linux_clear_cpu_buffers(void) {
    static const unsigned short ds = 3 * 8;
    asm volatile("verw %[ds]" : : [ds] "m" (ds) : "cc");
}

void linux_flush_cpu_caches(void) {
    asm volatile("wbinvd" : : : "memory");
}

void linux_swap_kernel_gs_base(void) {
    asm volatile("swapgs" : : : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_cpu_feature_goto.c"}
/* Linux _static_cpu_has-style asm goto. The frontend must specialize a
 * compile-time feature number, resolve the bit mask and byte offset as Core
 * constants, preserve both GNU C labels, and emit real x86 ELF alternative
 * patch records. The corresponding object may be inspected, not executed:
 * boot_cpu_data and the kernel alternative patcher are external contracts. */
extern unsigned int minic_test_boot_capability[24];

#define MINIC_TEST_ALT_MAX \
    "((6651f-6641f) ^ (((6651f-6641f) ^ (6652f-6642f)) & " \
    "-(-((6651f-6641f) < (6652f-6642f)))))"
#define MINIC_TEST_ALT_SKIP \
    ".skip -( (" MINIC_TEST_ALT_MAX " - (662b-661b)) > 0) * " \
    "(" MINIC_TEST_ALT_MAX " - (662b-661b)), 0x90\n"

static inline __attribute__((always_inline)) int
minic_test_cpu_has(unsigned short feature) {
    __asm__ goto(
        "# ALT: oldinstr2\n"
        "661:\n\t"
        "jmp 6f\n"
        "662:\n"
        "# ALT: padding2\n"
        MINIC_TEST_ALT_SKIP
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte (3*32+21)\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        " .long 661b - .\n"
        " .long 6642f - .\n"
        " .4byte %c[feature]\n"
        " .byte 663b-661b\n"
        " .byte 6652f-6642f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\t"
        "jmp %l[t_no]\n"
        "6651:\n"
        "# ALT: replacement 2\n"
        "6642:\n\t"
        "\n"
        "6652:\n"
        ".popsection\n"
        ".pushsection .altinstr_aux,\"ax\"\n"
        "6:\n"
        " testb %[bitnum],%P[cap_byte] (%% rip)\n"
        " jnz %l[t_yes]\n"
        " jmp %l[t_no]\n"
        ".popsection\n"
        : : [feature] "i" (feature),
            [bitnum] "i" (1 << (feature & 7)),
            [cap_byte] "i" (&((const char *)minic_test_boot_capability)[feature >> 3])
        : : t_yes, t_no);
t_yes:
    return 1;
t_no:
    return 0;
}

int minic_test_cpu_feature_bit_187(void) {
    return minic_test_cpu_has(187);
}

int minic_test_cpu_feature_bit_396(void) {
    return minic_test_cpu_has(396);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_debug_boot.c"}
/* Linux debugreg.h register family plus head64 data-segment reload.
 * Privileged instructions are compiled and assembled, never executed. */

#define DR_READ(number, name)                                    \
    unsigned long read_##name(void) {                            \
        unsigned long result;                                    \
        __asm__("mov %%db" #number ",%0" : "=r"(result));         \
        return result;                                           \
    }

#define DR_WRITE(number, name)                                   \
    void write_##name(unsigned long value) {                     \
        __asm__("mov %0,%%db" #number : : "r"(value));            \
    }

DR_READ(0, dr0)
DR_READ(1, dr1)
DR_READ(2, dr2)
DR_READ(3, dr3)
DR_READ(6, dr6)
DR_WRITE(0, dr0)
DR_WRITE(1, dr1)
DR_WRITE(2, dr2)
DR_WRITE(3, dr3)
DR_WRITE(6, dr6)

/* DR7's fake memory input must never be physically dereferenced. */
unsigned long read_dr7(void) {
    unsigned long result;
    __asm__ __volatile__("mov %%db7,%0" : "=r"(result) :
                         "m"(*(unsigned int *)0x1000UL));
    return result;
}

void write_dr7(unsigned long value) {
    __asm__ __volatile__("mov %0,%%db7" : : "r"(value),
                         "m"(*(unsigned int *)0x1000UL));
}

void linux_boot_segments(unsigned int selector) {
    __asm__ __volatile__(
        "movl %%eax, %%ds\n\t"
        "movl %%eax, %%ss\n\t"
        "movl %%eax, %%es"
        : : "a"(selector) : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_debug_register.c"}
/* Original Linux debugreg.h MOV DR forms: keep every legal debug register,
 * including DR7's fake memory dependency at address 0x1000. Kernel-only;
 * this fixture must be assembled/disassembled, never executed. */
typedef unsigned long u64;
typedef unsigned int u32;
typedef unsigned short u16;

u64 linux_read_dr0(void) { u64 v; asm("mov %%db0, %0" : "=r" (v)); return v; }
u64 linux_read_dr1(void) { u64 v; asm("mov %%db1, %0" : "=r" (v)); return v; }
u64 linux_read_dr2(void) { u64 v; asm("mov %%db2, %0" : "=r" (v)); return v; }
u64 linux_read_dr3(void) { u64 v; asm("mov %%db3, %0" : "=r" (v)); return v; }
u64 linux_read_dr6(void) { u64 v; asm("mov %%db6, %0" : "=r" (v)); return v; }
u64 linux_read_dr7(void) {
    u64 v;
    asm volatile("mov %%db7, %0" : "=r" (v) : "m" (*(u32 *)0x1000UL));
    return v;
}
void linux_write_dr0(u64 v) { asm("mov %0, %%db0" :: "r" (v)); }
void linux_write_dr1(u64 v) { asm("mov %0, %%db1" :: "r" (v)); }
void linux_write_dr2(u64 v) { asm("mov %0, %%db2" :: "r" (v)); }
void linux_write_dr3(u64 v) { asm("mov %0, %%db3" :: "r" (v)); }
void linux_write_dr6(u64 v) { asm("mov %0, %%db6" :: "r" (v)); }
void linux_write_dr7(u64 v) {
    asm volatile("mov %0, %%db7" :: "r" (v), "m" (*(u32 *)0x1000UL));
}

/* Long-mode segment selector snapshots and GS pointer slot writes are a
 * separate full ISA/ABI family; no CPU registers are touched at runtime. */
u16 linux_read_ss(void) {
    u16 v; asm("mov %%ss,%0" : "=r" (v) :: "memory"); return v;
}
u16 linux_read_cs(void) {
    u16 v; asm("mov %%cs,%0" : "=r" (v) :: "memory"); return v;
}
void linux_load_fs_with_fixup(u16 selector) {
    asm volatile("1: movw %0, %%fs\n"
        "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n"
        " .balign 4\n"
        " .long (1b) - .\n"
        " .long (2b) - .\n"
        " .long 5\n"
        " .popsection\n" : : "rm" (selector) : "memory");
}
void linux_load_gs_with_fixup(u16 selector) {
    asm volatile("1: movw %0, %%gs\n"
        "2:\n"
        " .pushsection \"__ex_table\",\"a\"\n"
        " .balign 4\n"
        " .long (1b) - .\n"
        " .long (2b) - .\n"
        " .long 5\n"
        " .popsection\n" : : "rm" (selector) : "memory");
}
struct task { unsigned long flags; };
extern struct task *linux_current_task;
void linux_store_percpu_pointer(struct task *t) {
    u64 raw = (u64)t;
    asm("movq %[val], %%gs:%[var]" : [var] "+m" (linux_current_task)
        : [val] "re" (raw));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_debug_register_smoke.c"}
/* Original Linux debugreg.h source forms. Assemble only; privileged ISA. */
typedef unsigned long u64;
typedef unsigned int u32;

u64 dr0_read(void) { u64 v; asm("mov %%db0, %0" : "=r"(v)); return v; }
u64 dr1_read(void) { u64 v; asm("mov %%db1, %0" : "=r"(v)); return v; }
u64 dr2_read(void) { u64 v; asm("mov %%db2, %0" : "=r"(v)); return v; }
u64 dr3_read(void) { u64 v; asm("mov %%db3, %0" : "=r"(v)); return v; }
u64 dr6_read(void) { u64 v; asm("mov %%db6, %0" : "=r"(v)); return v; }
u64 dr7_read(void) { u64 v; asm volatile("mov %%db7, %0" : "=r"(v) : "m"(*(u32 *)0x1000UL)); return v; }

void dr0_write(u64 v) { asm("mov %0, %%db0" :: "r"(v)); }
void dr1_write(u64 v) { asm("mov %0, %%db1" :: "r"(v)); }
void dr2_write(u64 v) { asm("mov %0, %%db2" :: "r"(v)); }
void dr3_write(u64 v) { asm("mov %0, %%db3" :: "r"(v)); }
void dr6_write(u64 v) { asm("mov %0, %%db6" :: "r"(v)); }
void dr7_write(u64 v) { asm volatile("mov %0, %%db7" :: "r"(v), "m"(*(u32 *)0x1000UL)); }
@@@ end
