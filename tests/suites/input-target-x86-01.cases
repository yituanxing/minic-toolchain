@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_vdso_pvclock_syscall.c"}
/* Linux 6.6.143 arch/x86/include/asm/pvclock.h and vDSO syscall fallback.
 * All templates and GNU operand constraints are kept at their original
 * spelling. The syscall paths are built, never executed by this probe. */
typedef unsigned long long u64;
typedef unsigned int u32;
typedef unsigned long ulong;

struct vdso_test_timespec {
    long tv_sec;
    long tv_nsec;
};

static u64 pvclock_scale_delta(u64 delta, u32 mul_frac, int shift) {
    u64 product;
    ulong tmp;
    if (shift < 0) delta >>= -shift;
    else delta <<= shift;
    __asm__("mulq %[mul_frac] ; shrd $32, %[hi], %[lo]"
        : [lo]"=a"(product), [hi]"=d"(tmp)
        : "0"(delta), [mul_frac]"rm"((u64)mul_frac));
    return product;
}

static u64 pvclock_scale_numeric(u64 delta, u64 mul_frac) {
    u64 product;
    ulong tmp;
    __asm__("mulq %3 ; shrd $32, %1, %0"
        : "=a"(product), "=d"(tmp) : "0"(delta), "rm"(mul_frac));
    return product;
}

long vdso_clock_gettime_fallback(int clockid, struct vdso_test_timespec *ts) {
    long ret;
    __asm__("syscall" : "=a"(ret), "=m"(*ts) :
        "0"(228), "D"(clockid), "S"(ts) : "rcx", "r11");
    return ret;
}

long vdso_gettimeofday_fallback(struct vdso_test_timespec *tv, void *tz) {
    long ret;
    __asm__("syscall" : "=a"(ret) :
        "0"(96), "D"(tv), "S"(tz) : "memory");
    return ret;
}

int main(void) {
    struct vdso_test_timespec ts = {0,0};
    return pvclock_scale_delta(1ULL << 32,0x40000000U,0) != 0x40000000ULL ||
           pvclock_scale_numeric(1ULL << 32,0x40000000ULL) != 0x40000000ULL ||
           vdso_clock_gettime_fallback(0,&ts) != 0 || ts.tv_sec <= 0 ||
           vdso_gettimeofday_fallback(&ts,0) != 0 || ts.tv_sec <= 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_xstate_alternatives.c"}
/* SPDX-License-Identifier: GPL-2.0 */
/* Linux 6.6.143 arch/x86/include/asm/fpu/api.h XSAVE/XRSTOR ALTERNATIVE
 * expansions, reduced to standalone register/address operands. Both full
 * templates must survive canonicalization into Core and GNU ELF sections. */
struct linux_xstate_image { unsigned char bytes[1024]; };

int linux_xsave_triple(struct linux_xstate_image *p,
                       unsigned int lmask, unsigned int hmask) {
    int err;
    asm volatile("# ALT: oldinstr3\n" "661:\n\t" ".byte " "0x48, " "0x0f,0xae,0x27" "\n662:\n" "# ALT: padding3\n" ".skip -((" "((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") ^ (((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") ^ (" "665""3""f-""664""3""f" ")) & -(-((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") < (" "665""3""f-""664""3""f" ")))))" " - (" "662b-661b" ")) > 0) * " "(" "((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") ^ (((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") ^ (" "665""3""f-""664""3""f" ")) & -(-((" "((" "665""1""f-""664""1""f" ") ^ (((" "665""1""f-""664""1""f" ") ^ (" "665""2""f-""664""2""f" ")) & -(-((" "665""1""f-""664""1""f" ") < (" "665""2""f-""664""2""f" ")))))" ") < (" "665""3""f-""664""3""f" ")))))" " - (" "662b-661b" ")), 0x90\n" "663" ":\n" ".pushsection .altinstructions,\"a\"\n" " .long 661b - .\n" " .long " "664""1""f - .\n" " .4byte " "(10*32+ 0)" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""1""f-""664""1""f" "\n" " .long 661b - .\n" " .long " "664""2""f - .\n" " .4byte " "(10*32+ 1)" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""2""f-""664""2""f" "\n" " .long 661b - .\n" " .long " "664""3""f - .\n" " .4byte " "(10*32+ 3)" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""3""f-""664""3""f" "\n" ".popsection\n" ".pushsection .altinstr_replacement, \"ax\"\n" "# ALT: replacement " "1" "\n" "664""1"":\n\t" ".byte " "0x48, " "0x0f,0xae,0x37" "\n" "665""1" ":\n" "# ALT: replacement " "2" "\n" "664""2"":\n\t" ".byte " "0x48, " "0x0f,0xc7,0x27" "\n" "665""2" ":\n" "# ALT: replacement " "3" "\n" "664""3"":\n\t" ".byte " "0x48, " "0x0f,0xc7,0x2f" "\n" "665""3" ":\n" ".popsection\n" "\n" "xor %[err], %[err]\n" "3:\n" " .pushsection \"__ex_table\",\"a\"\n" " .balign 4\n" " .long (" "661b" ") - .\n" " .long (" "3b" ") - .\n" ".macro extable_type_reg type:req reg:req\n" ".set .Lfound, 0\n" ".set .Lregnr, 0\n" ".irp rs,rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15\n" ".ifc \\reg, %%\\rs\n" ".set .Lfound, .Lfound+1\n" ".long \\type + (.Lregnr << 8)\n" ".endif\n" ".set .Lregnr, .Lregnr+1\n" ".endr\n" ".set .Lregnr, 0\n" ".irp rs,eax,ecx,edx,ebx,esp,ebp,esi,edi,r8d,r9d,r10d,r11d,r12d,r13d,r14d,r15d\n" ".ifc \\reg, %%\\rs\n" ".set .Lfound, .Lfound+1\n" ".long \\type + (.Lregnr << 8)\n" ".endif\n" ".set .Lregnr, .Lregnr+1\n" ".endr\n" ".if (.Lfound != 1)\n" ".error \"extable_type_reg: bad register argument\"\n" ".endif\n" ".endm\n" "extable_type_reg reg=" "%[err]" ", type=" "(17 | ((-14) << 16))" " \n" ".purgem extable_type_reg\n" " .popsection\n" : [err] "=r" (err) : "D" (p), "m" (*p), "a" (lmask), "d" (hmask) : "memory");
    return err;
}

void linux_xrstor_alternative(struct linux_xstate_image *p,
                              unsigned int lmask, unsigned int hmask) {
    asm volatile("# ALT: oldnstr\n" "661:\n\t" ".byte " "0x48, " "0x0f,0xae,0x2f" "\n662:\n" "# ALT: padding\n" ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * " "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n" "663" ":\n" ".pushsection .altinstructions,\"a\"\n" " .long 661b - .\n" " .long " "664""1""f - .\n" " .4byte " "(10*32+ 3)" "\n" " .byte " "663""b-661b" "\n" " .byte " "665""1""f-""664""1""f" "\n" ".popsection\n" ".pushsection .altinstr_replacement, \"ax\"\n" "# ALT: replacement " "1" "\n" "664""1"":\n\t" ".byte " "0x48, " "0x0f,0xc7,0x1f" "\n" "665""1" ":\n" ".popsection\n" "\n" "3:\n" " .pushsection \"__ex_table\",\"a\"\n" " .balign 4\n" " .long (" "661b" ") - .\n" " .long (" "3b" ") - .\n" " .long " "6" " \n" " .popsection\n" : : "D" (p), "m" (*p), "a" (lmask), "d" (hmask) : "memory");
}

