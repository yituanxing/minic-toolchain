@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_alternative_wrmsr.c"}
/* Linux ALTERNATIVE_WRMSR: native two-byte NOP baseline plus feature-gated
 * WRMSR replacement. This fixture must assemble with GNU AS but must never
 * execute in user mode (WRMSR is privileged). */
void minic_linux_feature_msr_write(unsigned int msr, unsigned long val) {
    __asm__ volatile(
        "# ALT: oldnstr\n"
        "661:\n\t\n"
        "662:\n"
        "# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b))>0) * "
              "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte %c[feature]\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\twrmsr\n"
        "6651:\n"
        ".popsection\n"
        : : "c"(msr), "a"((unsigned int)val),
            "d"((unsigned int)(val >> 32)), [feature] "i"(180)
        : "memory");
}

/* The feature is an admitted unsigned 32-bit ELF patch record, not the
 * historical literal 180. Linux's PRED_CMD site uses (7*32+21) == 245. */
void minic_linux_feature_msr_write_pred(unsigned int msr, unsigned long val) {
    __asm__ volatile(
        "# ALT: oldnstr\n"
        "661:\n\t\n"
        "662:\n"
        "# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b))>0) * "
              "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n"
        " .long 6641f - .\n"
        " .4byte %c[feature]\n"
        " .byte 663b-661b\n"
        " .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\twrmsr\n"
        "6651:\n"
        ".popsection\n"
        : : "c" (msr), "a" ((unsigned int)val),
            "d" ((unsigned int)(val >> 32)), [feature] "i" (245)
        : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_apic_amd_alt.c"}
/* The two original Linux APIC AMD alternatives are patchable ELF sites.
 * They must be assembled, never run as userspace instructions. */
#define APIC_AMD_ALTERNATIVE(fallback, replacement, feature) \
    "# ALT: oldnstr\n" \
    "661:\n\t" fallback "\n" \
    "662:\n" \
    "# ALT: padding\n" \
    ".skip -(((6651f-6641f)-(662b-661b)) > 0) * " \
           "((6651f-6641f)-(662b-661b)),0x90\n" \
    "663:\n" \
    ".pushsection .altinstructions,\"a\"\n" \
    " .long 661b - .\n" \
    " .long 6641f - .\n" \
    " .4byte " feature "\n" \
    " .byte 663b-661b\n" \
    " .byte 6651f-6641f\n" \
    ".popsection\n" \
    ".pushsection .altinstr_replacement, \"ax\"\n" \
    "# ALT: replacement 1\n" \
    "6641:\n\t" replacement "\n" \
    "6651:\n" \
    ".popsection\n"

int minic_linux_apic_mmio_amd_alt(int *address, int value) {
    __asm__ volatile(APIC_AMD_ALTERNATIVE("movl %0, %P1",
        "xchgl %0, %P1", "(22*32 + (5))")
        : "=r" (value), "=m" (*address)
        : "i" (0), "0" (value), "m" (*address));
    return value;
}

void minic_linux_apic_divider_amd_alt(void) {
    __asm__ volatile(APIC_AMD_ALTERNATIVE("", "div %2",
        "(22*32 + (1*32+1))")
        : : "a" (0), "d" (0), "r" (1));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_bool_atomic_xchg.c"}
/* Original Linux atomic_xchg family: a one-byte _Bool has real byte storage.
 * The typed MachineIR form must preserve the atomic memory RMW, not turn the
 * boolean into a register-only computation. */
int minic_linux_bool_atomic_xchg(_Bool *value)
{
    _Bool prior = 0;
    __asm__ __volatile__("xchgb %b0, %1\n"
        : "+q" (prior), "+m" (*value)
        : : "memory", "cc");
    return (int)prior;
}

#ifdef MINIC_BOOL_XCHG_NEGATIVE
int minic_bad_bool_atomic_xchg(_Bool *value)
{
    _Bool prior = 0;
    /* This version lacks Linux's required compiler memory barrier. */
    __asm__ __volatile__("xchgb %b0, %1\n"
        : "+q" (prior), "+m" (*value)
        : : "cc");
    return (int)prior;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/target/x86_64_linux_bool_atomic_xchg_driver.c"}
extern int minic_linux_bool_atomic_xchg(_Bool *value);

int main(void)
{
    _Bool value = 1;
    if (minic_linux_bool_atomic_xchg(&value) != 1 || value != 0)
        return 1;
    if (minic_linux_bool_atomic_xchg(&value) != 0 || value != 0)
        return 2;
    return 0;
}
