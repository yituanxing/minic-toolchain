@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/static_const_source_boundaries.c"}
/* A static wrapper can be specialized only when its original C identity is
 * not required by address-taking, a dynamic call, recursion, or source labels.
 * The helper's extern call is defined by the GNU owner during runtime diff. */
extern int external_guard_owner(int);
static __attribute__((always_inline)) inline int guarded_inline(int value) {
    if (value > 5)
        return external_guard_owner(value);
    return value + 1;
}

static int address_guard(int x) { return guarded_inline(x); }
static int (*volatile escaped_address_guard)(int) = address_guard;

static int mixed_guard(int x) { return guarded_inline(x) + 1; }
static int dynamic_mixed_guard(int x) { return mixed_guard(x); }

static int recursive_guard(int x) {
    if (x > 1)
        return recursive_guard(x - 1) + 1;
    return guarded_inline(x);
}

static int asm_guard(int x) {
    __asm__ __volatile__("nop" : : "i"(31));
    return guarded_inline(x);
}

static int label_guard(int x) {
    static void *const targets[] = {&&original_source_label};
    goto *targets[0];
original_source_label:
    return guarded_inline(x);
}

int main(void) {
    int total = 0;
    total += address_guard(3);
    total += escaped_address_guard(7);
    total += mixed_guard(2);
    total += dynamic_mixed_guard(6);
    total += recursive_guard(3);
    total += asm_guard(1);
    total += label_guard(2);
    return total == 44 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/static_field_typedef_array.c"}
/* Static initializer slot ownership for an array-typed record member.
 * Repeat the GNU-preprocessed source with all five MiniC targets; GNU and
 * MiniC x86 binaries must agree, including backward designated rewrites. */
typedef int Row3[3];
typedef unsigned char FourBytes[4];

struct RowHolder {
    int before;
    Row3 cells;
    int after;
};

static const struct RowHolder designated = {
    .after = 19,
    .cells = {[2] = 13, [0] = 5, [1] = 11},
    .before = 3,
};

static const struct RowHolder backward = {
    .cells[2] = 29,
    .after = 31,
    .cells[0] = 23,
    .before = 17,
    .cells[1] = 27,
};

static const struct RowHolder overwritten = {
    .cells[0] = 41,
    .after = 43,
    .cells[2] = 47,
    .cells[0] = 53,
};

union Overlay {
    Row3 cells;
    struct { int a; int b; int c; } members;
};

static union Overlay overlay = {
    .cells = {[2] = 73, [0] = 71, [1] = 79},
};

struct ByteHolder {
    int before;
    FourBytes bytes;
    int after;
};

static const struct ByteHolder byte_holder = {
    .bytes = {[3] = 89, [1] = 83, [0] = 81},
    .after = 97,
    .before = 101,
};

static int relocation_target = 103;
struct RelocHolder {
    int *slots[2];
    Row3 values;
};
static struct RelocHolder relocated = {
    .values = {[2] = 107, [0] = 109},
    .slots[1] = &relocation_target,
};

/* GNU complete zero-length member: the following field begins at the same
 * byte offset and a positional empty initializer consumes no element slot. */
struct ZeroRecord {
    int empty[0];
    int following;
};
static struct ZeroRecord zero_braced = {{}, 5};

int main(void)
{
    if (designated.before != 3 || designated.cells[0] != 5 ||
        designated.cells[1] != 11 || designated.cells[2] != 13 ||
        designated.after != 19) return 11;
    if (backward.before != 17 || backward.cells[0] != 23 ||
        backward.cells[1] != 27 || backward.cells[2] != 29 ||
        backward.after != 31) return 12;
    if (overwritten.cells[0] != 53 || overwritten.cells[1] != 0 ||
        overwritten.cells[2] != 47 || overwritten.after != 43) return 13;
    if (overlay.cells[0] != 71 || overlay.cells[1] != 79 ||
        overlay.cells[2] != 73 ||
        overlay.members.a != 71 || overlay.members.c != 73) return 14;
    if (byte_holder.before != 101 || byte_holder.bytes[0] != 81 ||
        byte_holder.bytes[1] != 83 || byte_holder.bytes[2] != 0 ||
        byte_holder.bytes[3] != 89 || byte_holder.after != 97) return 15;
    if (relocated.slots[0] != 0 || relocated.slots[1] != &relocation_target ||
        *relocated.slots[1] != 103 || relocated.values[0] != 109 ||
        relocated.values[1] != 0 || relocated.values[2] != 107) return 16;
    if (sizeof(designated.cells) != 3U * sizeof(int) ||
        sizeof(byte_holder.bytes) != 4U * sizeof(unsigned char)) return 17;
    if (zero_braced.following != 5 || sizeof(zero_braced.empty) != 0U ||
        (char *)&zero_braced.following - (char *)&zero_braced.empty != 0)
        return 18;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/static_field_typedef_array_negative.c"}
/* All cases are illegal under GNU C as well as the MiniC source policy. */
#if CASE == 1
typedef int Row3[3];
struct R { Row3 cells; };
static struct R item = { .cells = {[3] = 7} };
#elif CASE == 2
typedef int Row3[3];
struct R { Row3 cells; };
static struct R item = { .cells = {[0] = 1, [4] = 9} };
#elif CASE == 3
typedef int Row3[3];
struct R { Row3 cells; };
static struct R item = { .cells[0].missing = 1 };
#elif CASE == 4
typedef int Row3[3];
struct R { Row3 cells; };
static struct R item = { .invalid = {1, 2, 3} };
#elif CASE == 5
typedef int Row3[3];
struct R { Row3 cells; };
int bad(void) { struct R item = {{1, 2, 3}}; item.cells = item.cells; return 0; }
#elif CASE == 6
struct R { int flexible[]; int after; };
static struct R item = { .after = 3 };
#elif CASE == 7
typedef int Row3[3];
struct R { Row3 cells; };
static const struct R item = { .cells = {1, 2, 3} };
int bad(void) { item.cells[0] = 7; return 0; }
#elif CASE == 8
struct Z { int empty[0]; int following; };
static struct Z item = {{1}, 5}; /* Complete GNU zero array has no slots. */
#else
#error unknown static field typedef array negative CASE
#endif
