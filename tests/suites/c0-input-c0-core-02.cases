@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_rhs_no_cfg_snapshot.c"}
/* A non-branching RHS can reuse an already evaluated Core SSA LHS without
 * creating an extra temporary object. CFG-producing RHS forms still need
 * their historical cross-block snapshot. Check both paths against GNU C. */
static volatile int lhs_reads;
static volatile int rhs_reads;
static volatile int branch_effects;

__attribute__((noinline)) static int read_left(void)
{
    ++lhs_reads;
    return 11;
}

__attribute__((noinline)) static int read_right(void)
{
    ++rhs_reads;
    return 7;
}

static int straightline_rhs(int value, int index, int *array)
{
    return read_left() + ((array[index] ^ value) & 63);
}

static int conditional_rhs(int value, int choose)
{
    return value + (choose ? (++branch_effects + 3) : (branch_effects + 5));
}

static int shortcircuit_rhs(int value, int condition)
{
    return value + (condition && ++branch_effects);
}

static int statement_rhs(int value)
{
    return value + ({ int temporary = 6; temporary + 3; });
}

static int call_rhs(void)
{
    return read_left() + read_right();
}

int main(void)
{
    int values[3] = {5, 9, 12};
    if (straightline_rhs(3, 2, values) != 26 || lhs_reads != 1)
        return 1;
    if (conditional_rhs(10, 1) != 14 || branch_effects != 1)
        return 2;
    if (conditional_rhs(10, 0) != 16 || branch_effects != 1)
        return 3;
    if (shortcircuit_rhs(10, 0) != 10 || branch_effects != 1)
        return 4;
    if (shortcircuit_rhs(10, 1) != 11 || branch_effects != 2)
        return 5;
    if (statement_rhs(10) != 19)
        return 6;
    if (call_rhs() != 18 || lhs_reads != 2 || rhs_reads != 1)
        return 7;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_rv32_va_record_cursor.c"}
/* An 8-byte record consumes two RV32 linear va_list slots, not one. */
typedef __builtin_va_list MiniVaList;

typedef struct {
    unsigned int low;
    unsigned int high;
} Pair32;

typedef struct {
    unsigned long long value;
} WideAlign;

static unsigned int check_pair(unsigned int tag, ...) {
    MiniVaList ap;
    Pair32 pair;
    unsigned int tail;
    __builtin_va_start(ap, tag);
    pair = __builtin_va_arg(ap, Pair32);
    tail = __builtin_va_arg(ap, unsigned int);
    __builtin_va_end(ap);
    return pair.low == 0x12345678U && pair.high == 0x9abcdef0U &&
           tail == 0x2468ace0U;
}

static unsigned int check_aligned(unsigned int tag, ...) {
    MiniVaList ap;
    WideAlign wide;
    unsigned int tail;
    __builtin_va_start(ap, tag);
    wide = __builtin_va_arg(ap, WideAlign);
    tail = __builtin_va_arg(ap, unsigned int);
    __builtin_va_end(ap);
    return wide.value == 0x123456789abcdef0ULL && tail == 0x13579bdfU;
}

int main(void) {
    Pair32 pair;
    WideAlign wide;
    pair.low = 0x12345678U;
    pair.high = 0x9abcdef0U;
    wide.value = 0x123456789abcdef0ULL;
    if (!check_pair(1U, pair, 0x2468ace0U))
        return 1;
    if (!check_aligned(2U, wide, 0x13579bdfU))
        return 2;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_same_global_address_order.c"}
/* Linux 6.6.143 mm/ksm.c: STABLE_NODE_DUP_HEAD is the address of an
 * in-object member, not an unknown integer or an unrelated linker symbol. */
struct list_head {
    struct list_head *next;
    struct list_head *prev;
};
static struct list_head migrate_nodes;
static struct list_head unrelated_nodes;

extern void impossible_early_sentinel(void)
    __attribute__((error("member address must follow object start")));
extern void impossible_late_sentinel(void)
    __attribute__((error("member address must precede one-past object")));

int stable_node_guard(void) {
    if (!(!(((struct list_head *)&migrate_nodes.prev) <= &migrate_nodes)))
        impossible_early_sentinel();
    if (!(!(((struct list_head *)&migrate_nodes.prev) >= &migrate_nodes + 1)))
        impossible_late_sentinel();
    return 19;
}

/* Different objects have linker-owned relative addresses.  Never fold this
 * source-level comparison as if they were a single aggregate. */
int unrelated_global_order(void) {
    return &migrate_nodes < &unrelated_nodes;
}

int main(void) {
    return stable_node_guard() == 19 ? 0 : 1;
}
@@@ end
