@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_neon_vector64_lanes.c"}
/* All integer/polynomial D-register lane layouts share the same AAPCS64
 * eight-byte register carrier, but ADD must preserve element boundaries.
 * Keep each source identity distinct: no byte-vector ABI substitutions. */
typedef __Int8x8_t d8;
typedef __Int16x4_t d16;
typedef __Int32x2_t d32;
typedef __Int64x1_t d64;
typedef __Uint16x4_t u16;
typedef __Uint32x2_t u32;
typedef __Uint64x1_t u64;
typedef __Poly8x8_t p8;
typedef __Poly16x4_t p16;
typedef __Poly64x1_t p64;

d8 add8(d8 x, d8 y) { return x + y; }
d16 add16(d16 x, d16 y) { return x + y; }
d32 add32(d32 x, d32 y) { return x + y; }
d64 add64(d64 x, d64 y) { return x + y; }
u16 xor16(u16 x, u16 y) { return x ^ y; }
u32 xor32(u32 x, u32 y) { return x ^ y; }
u64 xor64(u64 x, u64 y) { return x ^ y; }
p8 pxor8(p8 x, p8 y) { return x ^ y; }
p16 pxor16(p16 x, p16 y) { return x ^ y; }
p64 pxor64(p64 x, p64 y) { return x ^ y; }

/* Ensure each ABI vector type is returned through v0, not GPR pairs. */
__attribute__((noinline)) d16 ninth16(
    d16 a, d16 b, d16 c, d16 d, d16 e, d16 f, d16 g, d16 h, d16 i) {
    return a + i;
}
__attribute__((noinline)) d32 invoke32(d32 (*fn)(d32,d32), d32 x, d32 y) {
    return fn(x,y);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_neon_vector_layout.c"}
/* The first executable-vector milestone must agree with GCC's actual
 * AAPCS64 declaration and object layout, before any NEON operation is added.
 * Do not replace a vector with an integer or a record as a false shortcut. */
typedef __Uint8x16_t uint8x16_t;
typedef __Uint64x2_t uint64x2_t;
typedef __Int8x16_t int8x16_t;
typedef __Poly8x16_t poly8x16_t;

_Static_assert(sizeof(uint8x16_t) == 16, "NEON byte vector storage");
_Static_assert(_Alignof(uint8x16_t) == 16, "NEON byte vector alignment");
_Static_assert(sizeof(uint64x2_t) == 16, "NEON 64-bit lane vector storage");
_Static_assert(_Alignof(uint64x2_t) == 16, "NEON 64-bit lane vector alignment");
_Static_assert(sizeof(int8x16_t) == 16, "NEON signed byte vector storage");
_Static_assert(_Alignof(int8x16_t) == 16, "NEON signed byte vector alignment");
_Static_assert(sizeof(poly8x16_t) == 16, "NEON polynomial byte vector storage");
_Static_assert(_Alignof(poly8x16_t) == 16, "NEON polynomial byte vector alignment");

struct neon_vector_layout {
    unsigned char tag;
    uint8x16_t first;
    uint64x2_t second;
};
_Static_assert(__builtin_offsetof(struct neon_vector_layout, first) == 16,
               "NEON first field alignment");
_Static_assert(__builtin_offsetof(struct neon_vector_layout, second) == 32,
               "NEON second field alignment");
_Static_assert(sizeof(struct neon_vector_layout) == 48,
               "NEON record layout");

int main(void) { return 0; }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_record_copy_conditional_machine_cfg.c"}
/* A long record copy emits a real out-of-line MachineCFG loop. The source
 * conditional immediately following it must branch through a physically
 * adjacent false auxiliary, even though the initial Core false block was
 * reserved before the copy loop was introduced. */
struct Record80 {
    unsigned long payload[10];
};

extern struct Record80 source_record;
extern struct Record80 destination_record;
extern int branch_result(int);

int aarch64_record_copy_then_branch(int condition) {
    destination_record = source_record;
    if (condition)
        return branch_result(17);
    return branch_result(23);
}
@@@ end
