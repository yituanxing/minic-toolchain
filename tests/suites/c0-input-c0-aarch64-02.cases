@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_neon_vector128_add_core.c"}
/* MiniC source-identity ADD test, distinct from the strict GNU ACLE header
 * differential. It exercises real V-register Core lowering without a fake
 * uint128/record surrogate. Cross-assembly/QEMU is a separate required gate. */
typedef __Uint64x2_t vector128_u64;
typedef __Uint8x16_t vector128_u8;

union lanes64 {
    vector128_u64 vec;
    unsigned long long word[2];
};

union lanes8 {
    vector128_u8 vec;
    unsigned char byte[16];
};

static union lanes64 left64, right64, out64;
static union lanes8 left8, right8, out8;

int main(void) {
    unsigned int i;
    left64.word[0] = 0x123456789abcdef0ULL;
    left64.word[1] = 0xdeadbeef00440088ULL;
    right64.word[0] = 0xff00ff00ff00ff00ULL;
    right64.word[1] = 0x0011223344556677ULL;
    out64.vec = left64.vec + right64.vec;
    if (out64.word[0] != (left64.word[0] + right64.word[0]) ||
        out64.word[1] != (left64.word[1] + right64.word[1])) return 1;

    for (i = 0; i < 16; ++i) {
        left8.byte[i] = (unsigned char)(i * 13U + 5U);
        right8.byte[i] = (unsigned char)(i * 7U + 9U);
    }
    out8.vec = left8.vec + right8.vec;
    for (i = 0; i < 16; ++i)
        if (out8.byte[i] != (unsigned char)(left8.byte[i] + right8.byte[i]))
            return 2;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_neon_vector128_lanes.c"}
/* Integer/polynomial Q-register lane families: exact lane arithmetic and
 * canonical bitwise XOR, with distinct AAPCS64 Q-register identities. */
typedef __Int16x8_t q16;
typedef __Int32x4_t q32;
typedef __Int64x2_t q64;
typedef __Uint16x8_t uq16;
typedef __Uint32x4_t uq32;
typedef __Uint64x2_t uq64;
typedef __Poly16x8_t pq16;
typedef __Poly64x2_t pq64;

q16 qadd16(q16 x, q16 y) { return x + y; }
q32 qadd32(q32 x, q32 y) { return x + y; }
q64 qadd64(q64 x, q64 y) { return x + y; }
uq16 qxor16(uq16 x, uq16 y) { return x ^ y; }
uq32 qxor32(uq32 x, uq32 y) { return x ^ y; }
uq64 qxor64(uq64 x, uq64 y) { return x ^ y; }
pq16 qpxor16(pq16 x, pq16 y) { return x ^ y; }
pq64 qpxor64(pq64 x, pq64 y) { return x ^ y; }

__attribute__((noinline)) q16 qninth16(
    q16 a, q16 b, q16 c, q16 d, q16 e, q16 f, q16 g, q16 h, q16 i) {
    return a + i;
}
