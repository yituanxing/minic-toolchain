@@@ {"id": "0edc19b02b00cd8c", "kind": "shared", "newline": true}
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
minic=${MINIC_CC:-"$root/build/release/bin/minic-cc"}
host_cc=${HOST_CC:-cc}
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-flat-global-payload.sh", "shared": "0edc19b02b00cd8c"}
#!/bin/sh
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
cat >"$work/input.c" <<'SRC'
static int targets[4] = {3, 5, 7, 11};
struct Flat { unsigned char a; int *p; unsigned short b; };
static struct Flat single = {17, &targets[1], 23};
static struct Flat array[4] = {
    {29, &targets[2], 31}, {37, &targets[3], 41}
};
struct Nested { union { int *p; unsigned long n; } u; int v; };
static struct Nested nested[2] = {
    { .u.p = &targets[0], .v = 43 }, { .u.n = 47, .v = 53 }
};
int main(void) {
    return !(single.a == 17 && single.p == &targets[1] && single.b == 23 &&
             array[0].a == 29 && array[0].p == &targets[2] && array[0].b == 31 &&
             array[1].a == 37 && array[1].p == &targets[3] && array[1].b == 41 &&
             array[2].a == 0 && array[2].p == 0 && array[2].b == 0 &&
             array[3].a == 0 && array[3].p == 0 && array[3].b == 0 &&
             nested[0].u.p == &targets[0] && nested[0].v == 43 &&
             nested[1].u.n == 47 && nested[1].v == 53);
}
SRC
"$host_cc" -std=gnu11 -no-pie "$work/input.c" -o "$work/gnu"
"$work/gnu"
"$host_cc" -E -P -std=gnu11 -x c "$work/input.c" -o "$work/input.i"
for target in x86_64 aarch64 loongarch64 riscv64 riscv32; do
    "$minic" --target="$target-linux" -S "$work/input.i" -o "$work/$target.s"
    test -s "$work/$target.s"
done
"$host_cc" -no-pie -x assembler "$work/x86_64.s" -o "$work/minic"
"$work/minic"
printf '%s\n' 'PASS flat-global-payload: standalone + array + implicit zero tail + recursive union; five target source output; GNU and MiniC x86 native'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-lp64-empty-record-call-abi.sh", "shared": "0edc19b02b00cd8c"}
#!/bin/sh
# Validate GNU empty-record parameter/result ABI from one target-independent
# source. Runtime GNU differential remains the responsibility of cross CI.
source="$root/tests/compiler/c0/lp64_empty_record_call_abi.c"
work=$(mktemp -d)
trap 'rm -r "$work"' EXIT HUP INT TERM

"$host_cc" -E -P -std=gnu11 -x c "$source" -o "$work/input.i"
for target in loongarch64-linux aarch64-linux; do
    "$minic" --target="$target" -S "$work/input.i" -o "$work/$target.s"
    test -s "$work/$target.s"
    for symbol in empty_middle empty_on_register_boundary \
                  call_empty_middle return_empty call_return_empty \
                  return_nonempty_with_empty_member \
                  call_nonempty_with_empty_member; do
        grep -Fq "$symbol:" "$work/$target.s"
    done
    printf 'LP64_EMPTY_RECORD_ABI=PASS target=%s empty-param=0GP/0stack nested-member=ignored empty-return=0B\n' "$target"
done
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-lp64-overaligned-stack-frame.sh", "shared": "0edc19b02b00cd8c"}
#!/bin/sh
# A source-level regression for true 32B local alignment, including a ninth
# stacked argument and dynamic alloca. The native ELF/QEMU campaign tests the
# generated machine instructions independently with GNU tools.
source="$root/tests/compiler/c0/lp64_overaligned_stack_frame.c"
work=$(mktemp -d)
trap 'rm -r "$work"' EXIT HUP INT TERM

"$host_cc" -E -P -std=gnu11 -x c "$source" -o "$work/input.i"
for target in loongarch64-linux aarch64-linux; do
    "$minic" --target="$target" -S "$work/input.i" -o "$work/$target.s"
    test -s "$work/$target.s"
    grep -Fq 'overalign_with_stack_argument:' "$work/$target.s"
    grep -Fq 'overalign_dynamic_stack:' "$work/$target.s"
    printf 'LP64_OVERALIGNED_FRAME_SOURCE=PASS target=%s local=32B incoming_stack=original_SP dynamic_alloca=1\n' "$target"
done

# LP64D must preserve entry SP separately from its aligned $s0 fixed base:
# merely changing an object-offset guard would never produce these actions.
grep -Fq '  addi.d $s0, $sp, 31' "$work/loongarch64-linux.s"
grep -Fq '  li.d $t3, -32' "$work/loongarch64-linux.s"
grep -Fq '  move $sp, $t0' "$work/loongarch64-linux.s"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-x86-msabi-definition-native.sh", "shared": "0edc19b02b00cd8c"}
#!/bin/sh
# GNU Win64-ABI caller + MiniC real function definition, including an outgoing
# SysV call which clobbers all registers Microsoft x64 requires preserved.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
impl="$root/tests/compiler/c0/x86_msabi_definition_native_impl.c"
driver="$root/tests/compiler/c0/x86_msabi_definition_native_driver.c"
negative="$root/tests/compiler/c0/x86_msabi_definition_native_negative.c"

test -x "$minic" || { echo 'MS_X64_DEFINITION=FAIL compiler missing' >&2; exit 1; }
"$host_cc" -E -P -std=gnu11 "$impl" -o "$work/impl.i"
MINIC_CORE_IR=strict "$minic" --target=x86_64-linux -S "$work/impl.i" \
    -o "$work/impl.s"
"$host_cc" -std=gnu11 -O2 -Wall -Wextra -Werror -no-pie \
    "$impl" "$driver" -o "$work/gnu-oracle"
"$host_cc" -std=gnu11 -O2 -Wall -Wextra -Werror -no-pie \
    "$work/impl.s" "$driver" -o "$work/minic-native"
"$work/gnu-oracle" >"$work/gnu.out"
"$work/minic-native" >"$work/minic.out"
cmp -s "$work/gnu.out" "$work/minic.out" || {
    echo 'MS_X64_DEFINITION=FAIL GNU/MiniC runtime differential' >&2
    exit 1
}
grep -F 'MS_X64_DEFINITION=PASS incoming=6 mixed_xmm=1 shadow=1 nonvolatile=12' \
    "$work/minic.out" >/dev/null
# One-source positional ABI: 5th/6th args are above the 32B incoming
# caller-allocated shadow area, and all Win64 nonvolatile vector regs save.
grep -F 'movq %rcx, %rax' "$work/impl.s" >/dev/null
grep -F 'movq %rdx, %rax' "$work/impl.s" >/dev/null
grep -F 'movq 48(%rbp), %rax' "$work/impl.s" >/dev/null
grep -F 'movq 56(%rbp), %rax' "$work/impl.s" >/dev/null
grep -F 'movdqu %xmm15,' "$work/impl.s" >/dev/null
grep -F ', %xmm15' "$work/impl.s" >/dev/null

for case_name in VARIADIC AGGREGATE INT128 LONG_DOUBLE; do
    "$host_cc" -E -P -std=gnu11 "-DNEG_DEF_$case_name" "$negative" \
        -o "$work/$case_name.i"
    if "$minic" --target=x86_64-linux -S "$work/$case_name.i" \
        -o "$work/$case_name.s" >"$work/$case_name.out" \
        2>"$work/$case_name.err"; then
        echo "MS_X64_DEFINITION=FAIL unsupported body accepted: $case_name" >&2
        exit 1
    fi
    grep -F 'ms_abi function definition requires supported fixed scalar signature' \
        "$work/$case_name.err" >/dev/null || {
        sed -n '1,8p' "$work/$case_name.err" >&2
        echo "MS_X64_DEFINITION=FAIL wrong negative stage: $case_name" >&2
        exit 1
    }
    test ! -e "$work/$case_name.s" || {
        echo "MS_X64_DEFINITION=FAIL partial assembly: $case_name" >&2
        exit 1
    }
done
echo 'MS_X64_DEFINITION_NATIVE=PASS gcc_oracle=1 incoming=6 xmm=1 nonvolatile=12 negative=4'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-msabi-scalar-native.sh", "shared": "0edc19b02b00cd8c"}
#!/bin/sh
# GCC-generated Win64 callees exercise MiniC's real SysV->MS_X64 bridge.
# All source/target phases must refuse unsupported ABI forms explicitly.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
client="$root/tests/compiler/c0/x86_msabi_scalar_native_client.c"
oracle="$root/tests/compiler/c0/x86_msabi_scalar_native_gnu.c"
reject="$root/tests/compiler/c0/x86_msabi_scalar_negative.c"

test -x "$minic" || { echo 'MS_X64_SCALAR=FAIL compiler missing' >&2; exit 1; }
"$host_cc" -E -P -std=gnu11 "$client" -o "$work/client.i"
MINIC_CORE_IR=strict "$minic" --target=x86_64-linux -S "$work/client.i" \
    -o "$work/client.s"

"$host_cc" -std=gnu11 -O2 -Wall -Wextra -Werror -no-pie \
    "$client" "$oracle" -o "$work/gnu-oracle"
"$host_cc" -std=gnu11 -O2 -Wall -Wextra -Werror -no-pie \
    "$work/client.s" "$oracle" -o "$work/minic-msabi"
"$work/gnu-oracle" >"$work/gnu.out"
"$work/minic-msabi" >"$work/minic.out"
cmp -s "$work/gnu.out" "$work/minic.out" || {
    echo 'MS_X64_SCALAR=FAIL MiniC/GCC runtime differential' >&2
    exit 1
}
grep -F 'MS_X64_SCALAR=PASS direct=6 indirect=6' "$work/minic.out"

# Every ABI call, including zero args, reserves 32 bytes shadow/home space;
# the first stack argument is precisely 32(%rsp), not SysV's 0(%rsp).
grep -F 'subq $32, %rsp' "$work/client.s" >/dev/null
grep -F '32(%rsp)' "$work/client.s" >/dev/null
grep -F '48(%rsp)' "$work/client.s" >/dev/null
grep -F 'call *%r11' "$work/client.s" >/dev/null

for case_name in VARARGS AGGREGATE INT128 LONG_DOUBLE; do
    "$host_cc" -E -P -std=gnu11 "-DNEG_$case_name" "$reject" \
        -o "$work/$case_name.i"
    if "$minic" --target=x86_64-linux -S "$work/$case_name.i" \
        -o "$work/$case_name.s" >"$work/$case_name.out" \
        2>"$work/$case_name.err"; then
        echo "MS_X64_SCALAR=FAIL unsupported case admitted: $case_name" >&2
        exit 1
    fi
    test ! -e "$work/$case_name.s" || {
        echo "MS_X64_SCALAR=FAIL partial output: $case_name" >&2
        exit 1
    }
    grep -Eq 'ms_abi.*(fixed.scalar|incoming ABI)' "$work/$case_name.err" || {
        sed -n '1,8p' "$work/$case_name.err" >&2
        echo "MS_X64_SCALAR=FAIL wrong rejection stage: $case_name" >&2
        exit 1
    }
done

echo 'MS_X64_SCALAR_NATIVE=PASS gcc_oracle=1 direct=6 indirect=6 negative=4 stack_shadow=1'
@@@ end
