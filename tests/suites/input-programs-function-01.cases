@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/programs/c0/function_two_parameters.c"}
int source(void)
{
    return 4;
}

int adjust(void)
{
    return 3;
}

int combine(int left, int right)
{
    return left * 10 + right;
}

int main(void)
{
    int saved = 5;
    return combine(source(), adjust()) + saved;
}
