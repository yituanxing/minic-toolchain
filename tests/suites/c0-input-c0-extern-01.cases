    return &irq_default_affinity[0];
}

unsigned long *select_row(unsigned int index) {
    return matrix[index];
}

int *values_ptr(void) {
    return values;
}

unsigned long matrix_size(void) {
    return sizeof(matrix);
}

unsigned long values_size(void) {
    return sizeof(values);
}
