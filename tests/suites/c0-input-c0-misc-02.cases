@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/lp64_empty_record_call_abi.c"}
/* GNU C zero-byte composites: AAPCS64 and LoongArch LP64D ignore an empty
 * named argument without shifting subsequent GP arguments. Both ABIs also
 * ignore empty members when classifying nonempty INTEGER-class records. */
struct Empty { };
struct Nested {
    unsigned long first;
    struct Empty ignored;
    unsigned long last;
};

unsigned long empty_middle(unsigned long first, struct Empty ignored,
                           unsigned long last) {
    (void)ignored;
    return first * 10UL + last;
}

unsigned long empty_on_register_boundary(unsigned long first,
                                         unsigned long second,
                                         unsigned long third,
                                         unsigned long fourth,
                                         unsigned long fifth,
                                         unsigned long sixth,
                                         unsigned long seventh,
                                         unsigned long eighth,
                                         struct Empty ignored,
                                         unsigned long ninth) {
    (void)ignored;
    return first + second + third + fourth + fifth + sixth +
           seventh + eighth + ninth;
}

unsigned long call_empty_middle(void) {
    struct Empty empty = { };
    return empty_middle(3UL, empty, 7UL) +
           empty_on_register_boundary(1UL, 2UL, 3UL, 4UL, 5UL,
                                      6UL, 7UL, 8UL, empty, 9UL);
}

struct Empty return_empty(void) {
    struct Empty empty = { };
    return empty;
}

void call_return_empty(void) {
    struct Empty empty = return_empty();
    (void)empty;
}

struct Nested return_nonempty_with_empty_member(unsigned long value) {
    struct Nested nested = { .first = value, .last = value + 1UL };
    return nested;
}

unsigned long call_nonempty_with_empty_member(void) {
    struct Nested nested = return_nonempty_with_empty_member(11UL);
    return nested.first + nested.last;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/lp64_overaligned_stack_frame.c"}
/* All AAPCS64/LP64D callers guarantee only 16B SP alignment. A local type
 * aligned(32) must be placed at a genuinely 32B address, and a ninth GP
 * argument must still load from the ORIGINAL incoming call stack. */
struct Aligned32 {
    unsigned long words[4];
} __attribute__((aligned(32)));

unsigned long overalign_with_stack_argument(
    unsigned long a, unsigned long b, unsigned long c, unsigned long d,
    unsigned long e, unsigned long f, unsigned long g, unsigned long h,
    unsigned long ninth) {
    struct Aligned32 value;
    value.words[0] = ninth;
    value.words[1] = a + b + c;
    value.words[2] = d + e + f;
    value.words[3] = g + h;
    return value.words[0] + value.words[1] + value.words[2] + value.words[3];
}

unsigned long overalign_dynamic_stack(unsigned long amount) {
    struct Aligned32 value;
    unsigned char *scratch = __builtin_alloca(amount + 16UL);
    scratch[0] = (unsigned char)amount;
    value.words[0] = amount;
    value.words[1] = scratch[0];
    value.words[2] = amount + 1UL;
    value.words[3] = amount + 2UL;
    return value.words[0] + value.words[1] + value.words[2] + value.words[3];
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/machine_operand_full_union_init.c"}
#include "target/common/machine_ir.h"

#include <stddef.h>
#include <stdint.h>
#include <string.h>

/* The first union alternative (physical) occupies only 16 bytes, while the
 * address and symbol alternatives carry fields beyond those first bytes.
 * Exercise the exact production MachineIR storage and its by-value return. */
static MinicMachineOperand address_operand(unsigned base) {
    MinicMachineOperand result;
    (void)memset(&result, 0, sizeof(result));
    result.kind = MINIC_MACHINE_OPERAND_ADDRESS;
    result.value.address.has_base = true;
    result.value.address.base.number = base;
    result.value.address.scale = 1U;
    result.value.address.displacement = -56;
    return result;
}

static MinicMachineOperand symbol_operand(void) {
    MinicMachineOperand result;
    (void)memset(&result, 0, sizeof(result));
    result.kind = MINIC_MACHINE_OPERAND_SYMBOL;
    result.value.symbol.name = "sample_symbol";
    result.value.symbol.relocation = 3U;
    return result;
}

static int check_address(unsigned base) {
    MinicMachineOperand operand = address_operand(base);
    return operand.kind == MINIC_MACHINE_OPERAND_ADDRESS &&
        operand.value.address.has_base &&
        operand.value.address.base.number == base &&
        operand.value.address.scale == 1U &&
        operand.value.address.displacement == -56 &&
        !operand.value.address.has_symbol &&
        operand.value.address.symbol == NULL &&
        operand.value.address.relocation == 0U &&
        operand.value.address.addend == 0;
}

int main(void) {
    MinicMachineOperand symbol = symbol_operand();
#if __SIZEOF_POINTER__ == 8
    if (sizeof(MinicMachineOperand) != 112U ||
        offsetof(MinicMachineOperand, value.address.has_symbol) != 64U ||
        offsetof(MinicMachineOperand, value.address.symbol) != 72U) return 3;
#endif
    if (!check_address(29U) || !check_address(31U)) return 1;
    if (symbol.kind != MINIC_MACHINE_OPERAND_SYMBOL ||
        symbol.value.symbol.name == NULL ||
        symbol.value.symbol.name[0] != 's' ||
        symbol.value.symbol.relocation != 3U ||
        symbol.value.symbol.addend != 0) return 2;
    return 0;
}
@@@ end
