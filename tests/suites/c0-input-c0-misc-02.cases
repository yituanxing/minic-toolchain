@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-a64-normalized-seal.c"}
/* Host unit probe of A64's Source-qualified -> normalized-machine seal.
 * Link with the ordinary MiniC object set (without tools/minic-cc/main.o).
 * This test does not need an A64 cross-assembler or QEMU. */
#include "target/aarch64/asm_contract.h"
#include "target/aarch64/asm_contract_source.h"
#include "frontend/ast.h"
#include "frontend/type.h"

#include <stdio.h>
#include <string.h>

typedef struct ProbeCase {
    MinicTargetInvocation invocation;
    MinicC0Program program;
    MinicExpression expr[2];
    MinicInlineAsm src;
    MinicInlineAsmOperand output;
    MinicInlineAsmOperand input[2];
    MinicTargetInlineAsmContract contract;
} ProbeCase;

static void set_operand(MinicInlineAsmOperand *op, const char *constraint,
                        MinicExpressionId expression,
                        MinicInlineAsmOperandAccess access) {
    memset(op, 0, sizeof(*op));
    op->constraint_text = (char *)constraint;
    op->constraint_length = strlen(constraint);
    op->expression = expression;
    op->access = access;
}

static bool initialize_case(ProbeCase *test, const char *source,
                            MinicType first, MinicType second,
                            bool acquire, bool raw) {
    memset(test, 0, sizeof(*test));
    if (!minic_target_invocation_begin(
            &test->invocation,
            minic_target_info_for_architecture(MINIC_TARGET_ARCH_AARCH64)))
        return false;
    test->program.expressions = test->expr;
    test->program.expression_count = 2U;
    test->expr[0].type = first;
    test->expr[0].value_category = MINIC_VALUE_LVALUE;
    test->expr[1].type = second;
    test->expr[1].value_category = acquire && !raw
        ? MINIC_VALUE_LVALUE : MINIC_VALUE_RVALUE;
    test->src.template_text = (char *)source;
    test->src.template_length = strlen(source);
    test->src.is_volatile = true;
    test->src.outputs = &test->output;
    test->src.output_count = 1U;
    test->src.inputs = test->input;
    test->src.input_count = 1U;
    test->src.has_memory_clobber = !raw;
    test->src.clobber_count = raw ? 0U : 1U;
    if (acquire) {
        set_operand(&test->output, "=r", 0U,
                    MINIC_INLINE_ASM_OPERAND_WRITE_ONLY);
        set_operand(&test->input[0], raw ? "r" : "Q", 1U,
                    MINIC_INLINE_ASM_OPERAND_READ_ONLY);
    } else if (!raw) {
        set_operand(&test->output, "=Q", 0U,
                    MINIC_INLINE_ASM_OPERAND_WRITE_ONLY);
        set_operand(&test->input[0], "rZ", 1U,
                    MINIC_INLINE_ASM_OPERAND_READ_ONLY);
    } else {
        test->src.output_count = 0U;
        test->src.input_count = 2U;
        set_operand(&test->input[0], "rZ", 0U,
                    MINIC_INLINE_ASM_OPERAND_READ_ONLY);
        set_operand(&test->input[1], "r", 1U,
                    MINIC_INLINE_ASM_OPERAND_READ_ONLY);
        test->expr[0].value_category = MINIC_VALUE_RVALUE;
    }
    return minic_aarch64_qualify_inline_asm(
        &test->invocation, &test->program, &test->src, &test->contract);
}

static bool check_normalization(ProbeCase *test, const char *machine,
                                uint32_t form, uint32_t width) {
    MinicTargetInlineAsmContract candidate = test->contract;
    if (!minic_aarch64_seal_normalized_inline_asm(
            &test->invocation, &test->program, &test->src, machine, strlen(machine),
            &candidate) ||
        candidate.target_machine_form_id != form ||
        candidate.target_machine_form_variant != width ||
        candidate.operand_count != test->contract.operand_count ||
        memcmp(candidate.kinds, test->contract.kinds,
               sizeof(candidate.kinds)) != 0 ||
        candidate.implicit_memory_effect !=
            test->contract.implicit_memory_effect)
        return false;
    return true;
}

static bool check_reject(ProbeCase *test, const char *wrong) {
    MinicTargetInlineAsmContract candidate = test->contract;
    return !minic_aarch64_seal_normalized_inline_asm(
        &test->invocation, &test->program, &test->src, wrong, strlen(wrong), &candidate);
}

int main(void) {
    static const char *const acquire[] = {
        "ldarb %w0, %1", "ldarh %w0, %1",
        "ldar %w0, %1", "ldar %0, %1"
    };
    static const char *const release[] = {
        "stlrb %w1, %0", "stlrh %w1, %0",
        "stlr %w1, %0", "stlr %x1, %0"
    };
    static const char *const raw_store[] = {
        "strb %w0, [%1]", "strh %w0, [%1]",
        "str %w0, [%1]", "str %x0, [%1]"
    };
    static const char *const raw_read_old[] = {
        "ldrb%w0,[%1]", "ldrh%w0,[%1]",
        "ldr%w0,[%1]", "ldr%0,[%1]"
    };
    static const char *const raw_read_new[] = {
        "ldarb%w0,[%1]", "ldarh%w0,[%1]",
        "ldar%w0,[%1]", "ldar%0,[%1]"
    };
    static const char middle[] =
        "662:.pushsection.altinstructions,\"a\""
        ".word661b-..word663f-..hword91"
        ".byte662b-661b.byte664f-663f"
        ".popsection.subsection1663:";
    static const char tail[] =
        "664:.org.-(664b-663b)+(662b-661b)"
        ".org.-(662b-661b)+(664b-663b).previous.endif";
    const MinicType widths[] = {
        minic_type_unsigned_char(), minic_type_unsigned_short(),
        minic_type_unsigned_int(), minic_type_unsigned_long_long()
    };
    MinicType address;
    size_t i;
    ProbeCase test;
    char raw_read[512];
    if (!minic_type_pointer_to(minic_type_unsigned_char(), &address))
        return 1;
    for (i = 0U; i < 4U; ++i) {
        const uint32_t width = (uint32_t)(1U << i);
        if (!initialize_case(&test, acquire[i], widths[i], widths[i],
                             true, false) ||
            !check_normalization(&test, acquire[i], 1U, width) ||
            !check_reject(&test, release[i]) ||
            !check_reject(&test, "ldar %w1, %0") ||
            !check_reject(&test, "ldar %w0, %1; dmb ish"))
            return (int)(10U + i);
        if (!initialize_case(&test, release[i], widths[i], widths[i],
                             false, false) ||
            !check_normalization(&test, release[i], 2U, width) ||
            !check_reject(&test, acquire[i]) ||
            !check_reject(&test, "stlr %w0, %1"))
            return (int)(20U + i);
        if (!initialize_case(&test, raw_store[i], widths[i], address,
                             false, true) ||
            !check_normalization(&test, raw_store[i], 4U, width) ||
            !check_reject(&test, "str %w1, [%0]") ||
            !check_reject(&test, "str %w0, [%1]; dmb ish"))
            return (int)(30U + i);
        if (snprintf(raw_read, sizeof(raw_read),
                ".if1==1661:%s%s%s%s", raw_read_old[i], middle,
                raw_read_new[i], tail) < 0 ||
            !initialize_case(&test, raw_read, widths[i], address,
                             true, true) ||
            !check_normalization(&test, raw_read, 3U, width) ||
            !check_reject(&test, "ldr %w0, [%1]"))
            return (int)(40U + i);
    }
    puts("PASS A64 LDAR/STLR/MMIO source-normalized seal widths=4 families=4 negatives=28");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-module-emit-preflight-contract.c"}
#include "target/common/program_emit.h"

#include <stdio.h>

/* The full-module writer's single preflight owns typed Module verification
 * and live-function arena identity. A discarded function's borrowed arena
 * is deliberately irrelevant: it is never emitted. */
int main(void) {
    MinicCoreTypeContext owned = {0}, foreign = {0};
    MinicCoreModuleFunctionSymbol symbols[2] = {
        {.name = "live", .is_defined = true,
         .alias_target_index = SIZE_MAX,
         .storage_owner_function_index = SIZE_MAX},
        {.name = "discarded", .is_defined = false,
         .alias_target_index = SIZE_MAX,
         .storage_owner_function_index = SIZE_MAX}
    };
    MinicCoreFunction functions[2] = {{0}, {0}};
    MinicCoreModuleFragment numeric = {
        .kind = MINIC_CORE_MODULE_FRAGMENT_BITS,
        .byte_count = 4U, .bits = 42U
    };
    MinicCoreModuleGlobal global = {
        .name = "forged", .emittable = true,
        .core_type_id = MINIC_CORE_TYPE_INVALID,
        .storage_alignment = 4U, .storage_size = 4U,
        .fragments = &numeric, .fragment_count = 1U,
        .alias_target_index = SIZE_MAX,
        .owner_function_index = SIZE_MAX
    };
    MinicCoreModule module = {
        .type_context = &owned, .finalized = true,
        .function_symbols = symbols, .function_count = 2U
    };
    functions[0].type_context = &owned;
    functions[1].type_context = &foreign;
    if (!minic_program_emit_module_preflight(&module, functions, 2U)) return 1;
    functions[0].type_context = &foreign;
    if (minic_program_emit_module_preflight(&module, functions, 2U)) return 2;
    functions[0].type_context = &owned;
    if (minic_program_emit_module_preflight(&module, NULL, 2U)) return 3;
    if (minic_program_emit_module_preflight(&module, functions, 1U)) return 4;
    module.finalized = false;
    if (minic_program_emit_module_preflight(&module, functions, 2U)) return 5;
    module.finalized = true;
    module.globals = &global;
    module.global_count = 1U;
    if (minic_program_emit_module_preflight(&module, functions, 2U)) return 6;
    module.globals = NULL;
    module.global_count = 0U;
    if (!minic_program_emit_module_preflight(&module, functions, 2U)) return 7;
    puts("MODULE_EMIT_PREFLIGHT_CONTRACT=PASS forged_finalized=1 alien_arena=1 dead_arena_exception=1 null_and_count=2 finalized=1");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-module-function-visitor.c"}
/* The machine visitor has exactly one declaration owner: sealed ModuleIR.
 * It never accepts C Program, including as a seemingly-unused argument. */
#include "target/common/program_visit.h"
#include <stdio.h>
#include <string.h>

typedef struct ProbeState {
    const MinicCoreModule *module;
    const MinicCoreModuleFunctionSymbol *symbol;
    bool expect_definition;
    size_t visited;
} ProbeState;

static size_t plan_builds;

bool minic_core_function_plan_build(
    const MinicCoreFunction *function, MinicCoreFunctionPlan *plan) {
    if (function == NULL || plan == NULL || plan->prepared) return false;
    ++plan_builds;
    plan->prepared = true;
    return true;
}

void minic_core_function_plan_destroy(MinicCoreFunctionPlan *plan) {
    if (plan != NULL) (void)memset(plan, 0, sizeof(*plan));
}

static bool inspect(FILE *out, const MinicCoreModule *module,
                    const MinicTargetInfo *target,
                    const MinicCoreModuleFunctionSymbol *symbol,
                    const MinicCoreFunction *function,
                    const MinicCoreFunctionFacts *facts,
                    const MinicCoreObjectStoragePlan *objects,
                    size_t index, bool sections, void *context) {
    ProbeState *state = context;
    (void)out;
    (void)target;
    (void)function;
    (void)sections;
    if (state == NULL || module != state->module || index != 0U ||
        symbol != state->symbol || symbol == NULL ||
        symbol->name == NULL || strcmp(symbol->name, "module_symbol") != 0 ||
        symbol->section_name == NULL ||
        strcmp(symbol->section_name, ".text.module_only") != 0 ||
        !symbol->is_weak || symbol->explicit_alignment != 32U ||
        symbol->is_defined != state->expect_definition ||
        (facts != NULL) != state->expect_definition ||
        (objects != NULL) != state->expect_definition)
        return false;
    ++state->visited;
    return true;
}

int main(void) {
    MinicCoreFunction function = {0};
    MinicCoreModuleFunctionSymbol symbol = {0};
    MinicCoreModule module = {0};
    MinicTargetInfo target = {0};
    ProbeState state = {0};
    FILE *out = tmpfile();
    if (out == NULL) return 1;

    symbol.name = "module_symbol";
    symbol.section_name = ".text.module_only";
    symbol.is_weak = true;
    symbol.explicit_alignment = 32U;
    symbol.is_defined = true;
    symbol.is_referenced = true;
    symbol.storage_owner_function_index = SIZE_MAX;
    module.function_symbols = &symbol;
    module.function_count = 1U;
    module.finalized = true;
    state.module = &module;
    state.symbol = &symbol;
    state.expect_definition = true;

    if (!minic_program_visit_prepared_functions_module(
            out, &module, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_LIVE_DEFINITIONS, false,
            inspect, &state) ||
        state.visited != 1U || plan_builds != 1U) return 2;

    /* Declarations do not prepare a Core plan. Definitions are selected
     * exclusively by the module symbol, including internal liveness. */
    symbol.is_defined = false;
    state.visited = 0U;
    state.expect_definition = false;
    if (!minic_program_visit_prepared_functions_module(
            out, &module, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_DECLARATIONS, false,
            inspect, &state) ||
        state.visited != 1U || plan_builds != 1U) return 3;
    state.visited = 0U;
    if (!minic_program_visit_prepared_functions_module(
            out, &module, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_LIVE_DEFINITIONS, false,
            inspect, &state) || state.visited != 0U) return 4;

    module.finalized = false;
    if (minic_program_visit_prepared_functions_module(
            out, &module, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_DECLARATIONS, false,
            inspect, &state)) return 5;
    module.finalized = true;
    module.function_count = 0U;
    if (minic_program_visit_prepared_functions_module(
            out, &module, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_DECLARATIONS, false,
            inspect, &state)) return 6;
    if (minic_program_visit_prepared_functions_module(
            out, NULL, &target, &function, 1U, false,
            MINIC_PROGRAM_FUNCTION_DECLARATIONS, false,
            inspect, &state)) return 7;
    if (fclose(out) != 0) return 8;
    puts("MINIC_MODULE_FUNCTION_OWNER=PASS sealed_module_only=1 definition=1 declaration=1 rollback=3");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-module-global-fragments.c"}
#define _GNU_SOURCE
#include "target/common/module_global_emit.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static const char *lp64_directive(size_t width) {
    return width == 1U ? ".byte" : width == 2U ? ".2byte" :
           width == 4U ? ".4byte" : width == 8U ? ".8byte" : NULL;
}

static bool emitted_matches(const MinicCoreModuleGlobal *global,
                            size_t relocation_width, const char *expected,
                            bool should_succeed, bool signed_spelling) {
    char *text = NULL;
    size_t length = 0U;
    FILE *out = open_memstream(&text, &length);
    bool success;
    if (out == NULL) return false;
    success = minic_multi_module_emit_global_fragments(
        out, global, lp64_directive, signed_spelling, relocation_width);
    if (fclose(out) != 0) success = false;
    if ((success != should_succeed) || text == NULL ||
        strcmp(text, expected) != 0) {
        free(text);
        return false;
    }
    free(text);
    return true;
}

int main(void) {
    MinicCoreModuleGlobal global = {.alias_target_index = SIZE_MAX};
    MinicCoreModuleFragment fragments[] = {
        {.kind = MINIC_CORE_MODULE_FRAGMENT_ZERO, .byte_offset = 0U,
         .byte_count = 3U},
        {.kind = MINIC_CORE_MODULE_FRAGMENT_BITS, .byte_offset = 3U,
         .byte_count = 1U, .bits = 0x1ffU},
        {.kind = MINIC_CORE_MODULE_FRAGMENT_RELOCATION, .byte_offset = 4U,
         .byte_count = 8U, .relocation_kind = MINIC_CORE_MODULE_RELOCATION_OBJECT,
         .relocation_symbol = "target_obj", .relocation_addend = -16},
        {.kind = MINIC_CORE_MODULE_FRAGMENT_ZERO, .byte_offset = 12U,
         .byte_count = 4U},
        {.kind = MINIC_CORE_MODULE_FRAGMENT_BITS, .byte_offset = 16U,
         .byte_count = 8U, .bits = UINT64_C(18446744073709551615)}
    };
    const char *expected =
        "  .zero 3\n  .byte 255\n  .8byte target_obj-16\n"
        "  .zero 4\n  .8byte 18446744073709551615\n";
    global.name = "test_obj";
    global.storage_size = 24U;
    global.storage_alignment = 8U;
    global.fragments = fragments;
    global.fragment_count = sizeof(fragments) / sizeof(*fragments);
    if (!emitted_matches(&global, 8U, expected, true, false) ||
        !emitted_matches(&global, 4U, "", false, false)) return 1;

    fragments[3].byte_offset = 11U;
    if (!emitted_matches(&global, 8U, "", false, false)) return 2;
    fragments[3].byte_offset = 12U;
    fragments[2].relocation_symbol = "bad\ninjected";
    if (!emitted_matches(&global, 8U, "", false, false)) return 3;
    fragments[2].relocation_symbol = "target_obj";
    fragments[2].byte_count = 16U;
    if (!emitted_matches(&global, 8U, "", false, false)) return 4;
    fragments[2].byte_count = 8U;

    global.storage_size = 0U;
    global.fragment_count = 0U;
    if (!emitted_matches(&global, 8U, "", true, false)) return 5;
    fragments[0].kind = MINIC_CORE_MODULE_FRAGMENT_ZERO;
    fragments[0].byte_count = 0U;
    global.fragment_count = 1U;
    if (!emitted_matches(&global, 8U, "", false, false)) return 6;
    global.fragment_count = 0U;

    fragments[0].kind = MINIC_CORE_MODULE_FRAGMENT_BITS;
    fragments[0].byte_offset = 0U;
    fragments[0].byte_count = 4U;
    fragments[0].bits = UINT64_C(0xffffffff);
    global.storage_size = 4U;
    global.fragment_count = 1U;
    if (!emitted_matches(&global, 0U, "  .4byte -1\n", true, true)) return 7;
    /* The same physical payload must serialize under both GNU dialects,
     * regardless of whether the C producer used signed, unsigned or float.
     * No source-type hint exists in the immutable Core fragment. */
    if (!emitted_matches(&global, 0U, "  .4byte 4294967295\n", true, false))
        return 17;
    fragments[0].bits = UINT64_C(0x80000000);
    if (!emitted_matches(&global, 0U, "  .4byte -2147483648\n", true, true) ||
        !emitted_matches(&global, 0U, "  .4byte 2147483648\n", true, false))
        return 18;
    fragments[0].byte_count = global.storage_size = 2U;
    fragments[0].bits = UINT64_C(0xffff);
    if (!emitted_matches(&global, 0U, "  .2byte -1\n", true, true) ||
        !emitted_matches(&global, 0U, "  .2byte 65535\n", true, false))
        return 19;
    fragments[0].byte_count = global.storage_size = 8U;
    fragments[0].bits = UINT64_MAX;
    if (!emitted_matches(&global, 0U, "  .8byte -1\n", true, true) ||
        !emitted_matches(&global, 0U, "  .8byte 18446744073709551615\n", true, false))
        return 20;
    fragments[0].byte_count = 1U;
    fragments[0].bits = UINT64_C(0x1ff);
    global.storage_size = 1U;
    if (!emitted_matches(&global, 0U, "  .byte 255\n", true, true)) return 8;
    fragments[0].kind = MINIC_CORE_MODULE_FRAGMENT_RELOCATION;
    fragments[0].byte_count = 4U;
    fragments[0].relocation_kind = MINIC_CORE_MODULE_RELOCATION_LABEL;
    fragments[0].relocation_symbol = ".Luser_23";
    global.storage_size = 4U;
    if (!emitted_matches(&global, 4U, "  .4byte .Luser_23\n", true, false))
        return 9;

    {
        char *text = NULL;
        size_t length = 0U;
        MinicModuleElfGlobalPlan plan;
        FILE *out = open_memstream(&text, &length);
        if (out == NULL) return 10;
        global.section_name = ".bss.test";
        global.visibility = MINIC_CORE_MODULE_VISIBILITY_HIDDEN;
        global.is_read_only = true;
        /* The preceding standalone relocation fragment is *not* a valid
         * ELF SHT_NOBITS payload. RV's explicit @progbits policy retains it. */
        if (minic_multi_module_elf_global_plan_build(
                &global, ".data", true, lp64_directive, false, 4U, &plan))
            return 11;
        if (!minic_multi_module_elf_global_plan_build(
                &global, ".data", false, lp64_directive, false, 4U, &plan) ||
            strcmp(plan.explicit_section_type, "progbits") != 0)
            return 12;
        fragments[0].kind = MINIC_CORE_MODULE_FRAGMENT_BITS;
        fragments[0].relocation_symbol = NULL;
        fragments[0].bits = 1U;
        if (minic_multi_module_elf_global_plan_build(
                &global, ".data", true, lp64_directive, false, 4U, &plan))
            return 13;
        /* Numeric data is interpreted by its physical width; high bits
         * beyond a byte do not become nonzero ELF section contents. */
        fragments[0].byte_count = global.storage_size = 1U;
        fragments[0].bits = 0x100U;
        if (!minic_multi_module_elf_global_plan_build(
                &global, ".data", true, lp64_directive, false, 4U, &plan) ||
            strcmp(plan.explicit_section_type, "nobits") != 0)
            return 14;
        fragments[0].kind = MINIC_CORE_MODULE_FRAGMENT_ZERO;
        fragments[0].byte_count = global.storage_size = 4U;
        if (!minic_multi_module_elf_global_plan_build(
                &global, ".data", true, lp64_directive, false, 4U, &plan) ||
            !minic_multi_module_elf_global_emit_visibility(out, &plan) ||
            !minic_multi_module_elf_global_emit_section(out, &plan) ||
            !minic_multi_module_elf_global_emit_binding(out, &plan) ||
            fclose(out) != 0) {
            free(text);
            return 15;
        }
        if (strcmp(text,
                   ".hidden test_obj\n.section .bss.test,\"a\",@nobits\n"
                   ".globl test_obj\n") != 0) {
            free(text);
            return 16;
        }
        free(text);
    }
    puts("MODULE_GLOBAL_FRAGMENTS=PASS zero bits source_neutral_signed_dialect widths=1,2,4,8 reloc label strict_layout ELF_section physical_nobits=5");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-program-emit-elf-owner-tls.c"}
/* Standalone, C-frontend-free witness for the physical ELF output contract:
 * undefined weak prototypes never demote an emitted strong owner; a direct
 * LP64 machine writer must not serialize TLS storage as ordinary .data. */
#include "target/common/program_emit.h"
#include "target/common/direct_program_emit.h"
#include "core/module_ir.h"

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static bool emit_object(FILE *out, const MinicCoreModule *module,
                        const MinicTargetInfo *target,
                        const MinicCoreModuleGlobal *object, size_t ordinal,
                        void *context) {
    (void)module; (void)target; (void)ordinal; (void)context;
    return object != NULL && object->name != NULL &&
        fprintf(out, ".data\n.globl %s\n.type %s,@object\n%s:\n"
                     "  .quad 0\n.size %s,8\n",
                object->name, object->name, object->name, object->name) >= 0;
}

static bool emit_function(FILE *out, const MinicCoreModule *module,
                          const MinicTargetInfo *target,
                          const MinicCoreModuleFunctionSymbol *symbol,
                          const MinicCoreFunction *function,
                          const MinicCoreFunctionFacts *facts,
                          const MinicCoreObjectStoragePlan *storage,
                          size_t ordinal, bool sections, void *context) {
    (void)module; (void)target; (void)function; (void)facts; (void)storage;
    (void)ordinal; (void)sections; (void)context;
    return symbol != NULL && symbol->is_defined &&
        fprintf(out, ".text\n.globl %s\n.type %s,@function\n%s:\n"
                     "  ret\n.size %s,.-%s\n",
                symbol->name, symbol->name, symbol->name,
                symbol->name, symbol->name) >= 0;
}

static bool emit_file_asm(FILE *out, const MinicCoreModule *module,
                          const MinicTargetInfo *target,
                          const MinicCoreFunction *functions,
                          size_t count, bool sections, void *context) {
    (void)target; (void)functions; (void)count; (void)sections; (void)context;
    return minic_program_emit_source_file_asm_module(out, module);
}

static bool direct_unused_function(FILE *out, const MinicTargetInfo *target,
                                   const MinicCoreModule *module,
                                   const MinicCoreModuleFunctionSymbol *symbol,
                                   const MinicCoreFunction *function,
                                   const MinicCoreFunctionFacts *facts,
                                   const MinicCoreObjectStoragePlan *storage,
                                   size_t index, bool sections) {
    (void)out; (void)target; (void)module; (void)symbol; (void)function;
    (void)facts; (void)storage; (void)index; (void)sections;
    return false;
}

static bool file_is(const char *path, const char *expected) {
    char buffer[128] = {0};
    FILE *file = fopen(path, "rb");
    size_t length;
    if (file == NULL) return false;
    length = fread(buffer, 1U, sizeof(buffer) - 1U, file);
    return fclose(file) == 0 && length == strlen(expected) &&
           strcmp(buffer, expected) == 0;
}

static bool write_original(const char *path) {
    FILE *file = fopen(path, "wb");
    if (file == NULL) return false;
    return fputs("ORIGINAL\n", file) != EOF && fclose(file) == 0;
}

static bool check_direct_tls(const char *path, const MinicCoreTypeContext *types,
                             MinicCoreTypeId word_id) {
    MinicCoreModuleFragment zero = {
        .kind = MINIC_CORE_MODULE_FRAGMENT_ZERO, .byte_count = 8U
    };
    MinicCoreModuleGlobal data = {
        .name = "core_tls_owner", .emittable = true,
        .is_thread_local = true,
        .core_type_id = word_id, .storage_size = 8U,
        .storage_alignment = 8U, .fragments = &zero, .fragment_count = 1U,
        .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX,
        .default_section = MINIC_CORE_MODULE_SECTION_DATA
    };
    MinicCoreModule module = {
        .type_context = types, .globals = &data,
        .global_count = 1U, .finalized = true
    };
    MinicTargetInfo target = {0};
    MinicMultiDirectModuleConfig config = {
        .architecture_name = "aarch64", .display_name = "AArch64",
        .gnu_stack_note = ".section .note.GNU-stack,\"\",@progbits\n",
        .elf_function_type = "%function", .elf_object_type = "%object",
        .emit_function = direct_unused_function
    };
    MinicDiagnostic diagnostic = {0};
    size_t index;
    const MinicTargetArchitecture architectures[2] = {
        MINIC_TARGET_ARCH_AARCH64, MINIC_TARGET_ARCH_LOONGARCH64
    };
    if (!minic_core_module_verify(&module)) return false;
    for (index = 0U; index < 2U; ++index) {
        target.architecture = architectures[index];
        config.architecture = architectures[index];
        config.architecture_name = index == 0U ? "aarch64" : "loongarch64";
        config.display_name = index == 0U ? "AArch64" : "LoongArch64";
        if (!write_original(path) ||
            minic_multi_direct_write_module(path, &target, NULL, 0U, false,
                                           &module, &config, &diagnostic) ||
            !file_is(path, "ORIGINAL\n"))
            return false;
    }
    /* The exact same source-free Core definition must emit when non-TLS;
     * otherwise a generic output failure could masquerade as the TLS gate. */
    data.is_thread_local = false;
    for (index = 0U; index < 2U; ++index) {
        FILE *out;
        char buffer[1024] = {0};
        size_t length;
        target.architecture = architectures[index];
        config.architecture = architectures[index];
        if (!minic_multi_direct_write_module(path, &target, NULL, 0U, false,
                                             &module, &config, &diagnostic))
            return false;
        out = fopen(path, "rb");
        if (out == NULL) return false;
        length = fread(buffer, 1U, sizeof(buffer) - 1U, out);
        if (fclose(out) != 0 || length == 0U ||
            strstr(buffer, "core_tls_owner:\n") == NULL ||
            strstr(buffer, ".size core_tls_owner,8\n") == NULL)
            return false;
    }
    return true;
}

int main(int argc, char **argv) {
    static const char file_asm_text[] =
        ".data\n.quad weak_before\n.quad weak_after\n.quad weak_fn\n"
        ".quad weak_after_fn\n.quad cross_function_owner\n"
        ".quad cross_object_owner\n.quad missing_object\n.quad missing_fn\n";
    MinicCoreTypeContext types = {0};
    MinicCoreType word = {
        .kind = MINIC_CORE_TYPE_INTEGER, .has_layout = true,
        .size = 8U, .alignment = 8U
    };
    MinicCoreTypeId word_id;
    MinicCoreModuleFragment zeros[2] = {
        { .kind = MINIC_CORE_MODULE_FRAGMENT_ZERO, .byte_count = 8U },
        { .kind = MINIC_CORE_MODULE_FRAGMENT_ZERO, .byte_count = 8U }
    };
    MinicCoreModuleGlobal globals[8] = {
        { .name = "weak_before", .definition_kind = MINIC_CORE_MODULE_DEFINITION_DECLARATION,
          .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        { .name = "weak_before", .emittable = true, .storage_size = 8U,
          .storage_alignment = 8U, .fragments = &zeros[0], .fragment_count = 1U,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        { .name = "weak_after", .emittable = true, .storage_size = 8U,
          .storage_alignment = 8U, .fragments = &zeros[1], .fragment_count = 1U,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        { .name = "weak_after", .definition_kind = MINIC_CORE_MODULE_DEFINITION_DECLARATION,
          .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        { .name = "missing_object", .definition_kind = MINIC_CORE_MODULE_DEFINITION_DECLARATION,
          .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        { .name = "unused_object", .definition_kind = MINIC_CORE_MODULE_DEFINITION_DECLARATION,
          .is_weak = true,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        /* An object-typed weak declaration has a FUNCTION definition owner. */
        { .name = "cross_function_owner",
          .definition_kind = MINIC_CORE_MODULE_DEFINITION_DECLARATION,
          .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX },
        /* In the opposite order a strong OBJECT precedes a weak function. */
        { .name = "cross_object_owner", .emittable = true,
          .storage_size = 8U, .storage_alignment = 8U,
          .fragments = &zeros[0], .fragment_count = 1U,
          .alias_target_index = SIZE_MAX, .owner_function_index = SIZE_MAX }
    };
    MinicCoreModuleFunctionSymbol symbols[8] = {
        { .name = "weak_fn", .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "weak_fn", .is_defined = true, .is_referenced = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "weak_after_fn", .is_defined = true, .is_referenced = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "weak_after_fn", .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "missing_fn", .is_weak = true, .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "unused_fn", .is_weak = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "cross_function_owner", .is_defined = true,
          .is_referenced = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX },
        { .name = "cross_object_owner", .is_weak = true,
          .is_file_asm_root = true,
          .alias_target_index = SIZE_MAX, .storage_owner_function_index = SIZE_MAX }
    };
    MinicCoreBlock entry = {
        .has_terminator = true,
        .terminator = { .kind = MINIC_CORE_TERMINATOR_RETURN,
                        .return_value = MINIC_CORE_VALUE_INVALID }
    };
    MinicCoreFunction functions[8] = {0};
    MinicCoreModuleFileAsm file_asm = {
        .text = (char *)file_asm_text, .length = sizeof(file_asm_text) - 1U
    };
    MinicCoreModule module = {
        .type_context = &types, .globals = globals,
        .global_count = sizeof(globals) / sizeof(globals[0]),
        .function_symbols = symbols,
        .function_count = sizeof(symbols) / sizeof(symbols[0]),
        .file_asms = &file_asm, .file_asm_count = 1U,
        .finalized = true
    };
    MinicProgramEmitConfig config = {
        .emit_function = emit_function, .between = emit_file_asm,
        .selection = MINIC_PROGRAM_FUNCTION_LIVE_DEFINITIONS
    };
    MinicTargetInfo target = {0};
    size_t index;
    if (argc != 3) return 2;
    minic_core_type_context_initialize(&types);
    if (!minic_core_type_register(&types, &word, &word_id)) return 3;
    for (index = 0U; index < 8U; ++index)
        globals[index].core_type_id = word_id;
    functions[1].name = "weak_fn";
    functions[1].type_context = &types;
    functions[1].blocks = &entry;
    functions[1].block_count = 1U;
    functions[2].name = "weak_after_fn";
    functions[2].type_context = &types;
    functions[2].blocks = &entry;
    functions[2].block_count = 1U;
    functions[6].name = "cross_function_owner";
    functions[6].type_context = &types;
    functions[6].blocks = &entry;
    functions[6].block_count = 1U;
    if (!minic_core_module_verify(&module) ||
        !minic_program_emit_write_module(argv[1], &module, &target,
            functions, 8U, false, &config, NULL, emit_object))
        return 4;
    if (!check_direct_tls(argv[2], &types, word_id)) return 5;
    (void)remove(argv[2]);
    minic_core_type_context_destroy(&types);
    puts("MINIC_ELF_SYMBOL_OWNER_TLS=PASS same_kind_owner=4 cross_kind_owner=2 undefined_weak=2 direct_TLS_reject=2 direct_nonTLS_emit=2");
    return 0;
}

/* No CALLs or stack objects are in this standalone Core fixture. */
bool minic_core_object_storage_plan_build(
    const MinicCoreFunction *function, MinicCoreObjectStoragePlan *plan) {
    return function != NULL && plan != NULL && function->object_count == 0U;
}
void minic_core_object_storage_plan_destroy(MinicCoreObjectStoragePlan *plan) {
    if (plan != NULL) *plan = (MinicCoreObjectStoragePlan){0};
}
bool minic_core_call_index_build(const MinicCoreFunction *function,
                                 size_t expected, MinicCoreCallIndex *index) {
    return function != NULL && expected == 0U && index != NULL;
}
void minic_core_call_index_destroy(MinicCoreCallIndex *index) {
    if (index != NULL) *index = (MinicCoreCallIndex){0};
}
bool minic_core_function_verify(const MinicCoreFunction *function) {
    return function != NULL && function->type_context != NULL &&
           function->block_count == 1U && function->blocks != NULL;
}
bool minic_core_function_dump(FILE *output, const MinicCoreFunction *function) {
    (void)output; (void)function;
    return false;
}
