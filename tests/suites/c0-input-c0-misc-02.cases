int main(int argc, char **argv) {
    MinicCoreType scalar = {
        .kind = MINIC_CORE_TYPE_INTEGER, .has_layout = true,
        .size = 8U, .alignment = 8U
    };
    MinicCoreTypeId scalar_id;
    MinicCoreModuleFragment zero = {
