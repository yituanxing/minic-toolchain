@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_linux_iocsr_wrapper_alias.c"}
/* The four GNU larchintrin.h extern-inline wrappers used by Linux 6.6.143.
 * Their bodies belong to genuine GNU machine builtins, never ELF libcalls.
 * Keep the spellings/signatures aligned with the frozen original GNU .i. */
extern __inline unsigned long
__attribute__((__gnu_inline__, __always_inline__, __artificial__))
__iocsrrd_d(unsigned int addr) {
    return (unsigned long)__builtin_loongarch_iocsrrd_d(addr);
}

extern __inline unsigned int
__attribute__((__gnu_inline__, __always_inline__, __artificial__))
__iocsrrd_w(unsigned int addr) {
    return (unsigned int)__builtin_loongarch_iocsrrd_w(addr);
}

extern __inline void
__attribute__((__gnu_inline__, __always_inline__, __artificial__))
__iocsrwr_d(unsigned long value, unsigned int addr) {
    __builtin_loongarch_iocsrwr_d(value, addr);
}

extern __inline void
__attribute__((__gnu_inline__, __always_inline__, __artificial__))
__iocsrwr_w(unsigned int value, unsigned int addr) {
    __builtin_loongarch_iocsrwr_w(value, addr);
}

unsigned long minic_iocsr_read64(unsigned int addr) {
    return __iocsrrd_d(addr);
}

unsigned int minic_iocsr_read32(unsigned int addr) {
    return __iocsrrd_w(addr);
}

void minic_iocsr_write64(unsigned long value, unsigned int addr) {
    __iocsrwr_d(value, addr);
}

void minic_iocsr_write32(unsigned int value, unsigned int addr) {
    __iocsrwr_w(value, addr);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_linux_irq_stack.c"}
/* Linux 6.6.143 arch/loongarch/kernel/traps.c:do_vint IRQ-stack switch.
 * The compiler must save its own RA and S0 across this inline BL. */
struct pt_regs { unsigned long regs[32]; };
extern void handle_loongarch_irq(struct pt_regs *regs);

void loong_irq_switch(unsigned long stack, struct pt_regs *regs) {
    __asm__ __volatile__(
        "move\t$s0, $sp\t\t\n"
        "move\t$sp, %[stk]\t\t\n"
        "move\t$a0, %[regs]\t\t\n"
        "bl\thandle_loongarch_irq\n"
        "move\t$sp, $s0\t\t\n"
        :
        : [stk] "r" (stack), [regs] "r" (regs)
        : "$a0", "$a1", "$a2", "$a3", "$a4", "$a5", "$a6", "$a7", "$s0",
          "$t0", "$t1", "$t2", "$t3", "$t4", "$t5", "$t6", "$t7", "$t8",
          "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_linux_mixed_mul_overflow.c"}
/* Actual operand/result types at Linux 6.6.143 drm_mode_vrefresh and
 * fbcon_set_font. GNU overflow arithmetic compares the exact mathematical
 * product to the destination type's range, regardless of C promotions. */
int drm_like(int clock, unsigned int numerator, unsigned int *product) {
    return __builtin_mul_overflow(clock, numerator, product);
}

int fbcon_like(int size, unsigned int charcount, int *product) {
    return __builtin_mul_overflow(size, charcount, product);
}

int drm_like_negated(unsigned int numerator, int clock,
                     unsigned int *product) {
    return __builtin_mul_overflow(numerator, clock, product);
}

#ifdef MINI_MIXED_OVERFLOW_HOST_TEST
#include <limits.h>
#include <stdio.h>

static int check_one(int lhs, unsigned int rhs) {
    unsigned int u = 0;
    int s = 0;
    const long long exact = (long long)lhs * (long long)rhs;
    const int expected_unsigned = exact < 0 || exact > (long long)UINT_MAX;
    const int expected_signed = exact < INT_MIN || exact > INT_MAX;
    const int got_unsigned = drm_like(lhs, rhs, &u);
    const int got_signed = fbcon_like(lhs, rhs, &s);
    return got_unsigned == expected_unsigned &&
           got_signed == expected_signed &&
           u == (unsigned int)exact && s == (int)exact &&
           drm_like_negated(rhs, lhs, &u) == expected_unsigned;
}

int main(void) {
    static const int signed_samples[] = {
        INT_MIN, INT_MIN + 1, -10000, -1, 0, 1, 2, 10000, INT_MAX
    };
    static const unsigned int unsigned_samples[] = {
        0U, 1U, 2U, 32767U, 65536U, (unsigned int)INT_MAX,
        0x80000000U, UINT_MAX
    };
    unsigned int i, j;
    for (i = 0; i < sizeof(signed_samples)/sizeof(signed_samples[0]); ++i)
        for (j = 0; j < sizeof(unsigned_samples)/sizeof(unsigned_samples[0]); ++j)
            if (!check_one(signed_samples[i], unsigned_samples[j])) {
                fprintf(stderr, "mixed overflow mismatch: %d, %u\n",
                        signed_samples[i], unsigned_samples[j]);
                return 1;
            }
    return 0;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_linux_simd_asm.i"}
void lsx_raid_step(unsigned char *p, unsigned char *q) {
    asm volatile("vld $vr0, %0" : : "m"(*p));
    asm volatile("vori.b $vr4, $vr0, 0");
    asm volatile("vslti.b $vr12, $vr4, 0");
    asm volatile("vslli.b $vr16, $vr4, 1");
    asm volatile("vandi.b $vr12, $vr12, 0x1d");
    asm volatile("vxor.v $vr16, $vr16, $vr12");
    asm volatile("vst $vr16, %0" : "=m"(*q));
}
void lasx_recover_step(unsigned char *p, unsigned char *q) {
    asm volatile("xvld $xr20, %0" : : "m"(*p));
    asm volatile("xvreplve0.q $xr22, $xr20");
    asm volatile("xvsrli.b $xr4, $xr22, 4");
    asm volatile("xvandi.b $xr4, $xr4, 0x0f");
    asm volatile("xvshuf.b $xr2, $xr22, $xr22, $xr4");
    asm volatile("xvxor.v $xr4, $xr4, $xr2");
    asm volatile("xvst $xr4, %0" : "=m"(*q));
}
void raid_eight_memory_rw(
    unsigned char *p0, unsigned char *p1,
    unsigned char *p2, unsigned char *p3,
    unsigned char *p4, unsigned char *p5,
    unsigned char *p6, unsigned char *p7) {
    asm volatile(
        "vld $vr0, %0\n\t"
        "vld $vr1, %1\n\t"
        "vld $vr2, %2\n\t"
        "vld $vr3, %3\n\t"
        "vld $vr4, %4\n\t"
        "vld $vr5, %5\n\t"
        "vld $vr6, %6\n\t"
        "vld $vr7, %7\n\t"
        "vxor.v $vr0, $vr0, $vr4\n\t"
        "vxor.v $vr1, $vr1, $vr5\n\t"
        "vst $vr0, %0\n\t"
        "vst $vr1, %1\n\t"
        "vst $vr2, %2\n\t"
        "vst $vr3, %3\n\t"
        "vst $vr4, %4\n\t"
        "vst $vr5, %5\n\t"
        "vst $vr6, %6\n\t"
        "vst $vr7, %7\n\t"
        : "+m"(*p0), "+m"(*p1), "+m"(*p2), "+m"(*p3),
          "+m"(*p4), "+m"(*p5), "+m"(*p6), "+m"(*p7));
}
void xor_named_pointer(unsigned long *v1, const unsigned long *v2) {
    asm volatile(
        "vld $vr0, %[v1], 0\n\t"
        "vld $vr1, %[v1], 16\n\t"
        "vld $vr4, %[v2], 0\n\t"
        "vld $vr5, %[v2], 16\n\t"
        "vxor.v $vr0, $vr0, $vr4\n\t"
        "vxor.v $vr1, $vr1, $vr5\n\t"
        "vst $vr0, %[v1], 0\n\t"
        "vst $vr1, %[v1], 16\n\t"
        : : [v1] "r"(v1), [v2] "r"(v2) : "memory");
}
