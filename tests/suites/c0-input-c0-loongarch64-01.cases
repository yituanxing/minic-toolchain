@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_syscall_alias_policy.c"}
/* GCC oracle and MiniC LoongArch GNU-alias ABI test vectors. Compile each
 * `-DCASE=N` through the host preprocessor before passing the resulting .i
 * to MiniC; a malformed GNU alias does not prove target-policy rejection. */
#ifndef CASE
#define CASE 0
#endif

#if CASE == 0
/* Genuine Linux __SYSCALL_DEFINEx ABI transport: two 64-bit GPR words. */
extern long sys_entry(unsigned int id, const char *ptr)
    __attribute__((alias("__se_sys_entry")));
long __se_sys_entry(long id, long ptr) { return id + (ptr != 0); }
int main(void) { return sys_entry(41U, (const char *)1) == 42 ? 0 : 1; }
#elif CASE == 1
/* Generic C-compatible aliases remain legal regardless of symbol spelling. */
extern long ordinary_alias(long n) __attribute__((alias("ordinary_owner")));
long ordinary_owner(long n) { return n + 1; }
int main(void) { return ordinary_alias(41) == 42 ? 0 : 1; }
#elif CASE == 2
/* An unrelated alias must not inherit sys_*'s ABI exception. */
extern long ordinary_alias(unsigned int id) __attribute__((alias("ordinary_owner")));
long ordinary_owner(long id) { return id; }
#elif CASE == 3
/* The two symbol suffixes must match exactly. */
extern long sys_alpha(unsigned int id) __attribute__((alias("__se_sys_beta")));
long __se_sys_beta(long id) { return id; }
#elif CASE == 4
/* COMPAT syscalls are a separate Linux ABI family, not admitted implicitly. */
extern long compat_sys_entry(unsigned int id)
    __attribute__((alias("__se_compat_sys_entry")));
long __se_compat_sys_entry(long id) { return id; }
#elif CASE == 5
/* FP arguments travel through a different LoongArch ABI register class. */
extern long sys_float(float value) __attribute__((alias("__se_sys_float")));
long __se_sys_float(long value) { return value; }
#elif CASE == 6
/* Aggregate arguments can use a different ABI transfer shape. */
struct Word { int value; };
extern long sys_record(struct Word value) __attribute__((alias("__se_sys_record")));
long __se_sys_record(long value) { return value; }
#elif CASE == 7
/* A variadic alias cannot use the fixed-arity syscall sanitizer contract. */
extern long sys_vararg(int value, ...) __attribute__((alias("__se_sys_vararg")));
long __se_sys_vararg(long value, ...) { return value; }
#elif CASE == 8
/* A 128-bit source parameter needs more than one GPR word. */
extern long sys_wide(__int128 value) __attribute__((alias("__se_sys_wide")));
long __se_sys_wide(long value) { return value; }
#elif CASE == 9
/* The sanitizer must receive a full 64-bit long/long long word. */
extern long sys_small(int value) __attribute__((alias("__se_sys_small")));
long __se_sys_small(unsigned int value) { return value; }
#elif CASE == 10
/* Source and sanitizer return types must be C-compatible signed long. */
extern int sys_result(int value) __attribute__((alias("__se_sys_result")));
long __se_sys_result(long value) { return value; }
#elif CASE == 11
/* Linux __SYSCALL_DEFINEx admits at most six positional arguments. */
extern long sys_seven(int a, int b, int c, int d, int e, int f, int g)
    __attribute__((alias("__se_sys_seven")));
long __se_sys_seven(long a, long b, long c, long d, long e, long f, long g) {
    return a + b + c + d + e + f + g;
}
#elif CASE == 12
/* A 64-bit long long source travels to __SC_LONG's signed long long word. */
extern long sys_longlong(unsigned long long value)
    __attribute__((alias("__se_sys_longlong")));
long __se_sys_longlong(long long value) { return value == 41 ? 42 : 0; }
int main(void) { return sys_longlong(41ULL) == 42 ? 0 : 1; }
#else
#error unknown test case
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_typed_invtlb_add_unless.c"}
/* Original Loong Linux native INVTLB / LL-SC add-unless ASM forms.
 * These source templates exercise typed form variants without executing
 * privileged TLB operations on the host. */
void invtlb_asid_va(unsigned int asid, unsigned long va) {
    __asm__ __volatile__("invtlb %0, %1, %2" : :
        "i"(0), "r"(asid), "r"(va) : "memory");
}

void invtlb_va(unsigned long va) {
    __asm__ __volatile__("invtlb %0, $zero, %1" : :
        "i"(0), "r"(va) : "memory");
}

void invtlb_asid(unsigned int asid) {
    __asm__ __volatile__("invtlb %0, %1, $zero" : :
        "i"(0), "r"(asid) : "memory");
}

void invtlb_all(void) {
    __asm__ __volatile__("invtlb %0, $zero, $zero" : : "i"(0) : "memory");
}

unsigned int add_unless_word(volatile unsigned int *ptr,
                             unsigned int add, unsigned int unless) {
    unsigned int prior, sc;
    __asm__ __volatile__(
        "0: ll.w %[p], %[c]\n"
        "beq %[p], %[u], 1f\n"
        "add.w %[rc], %[p], %[a]\n"
        "sc.w %[rc], %[c]\n"
        "beqz %[rc], 0b\n"
        "b 2f\n"
        "1: dbar 0x700\n"
        "2:"
        : [p] "=&r"(prior), [rc] "=&r"(sc), [c] "=ZB"(*ptr)
        : [a] "r"(add), [u] "r"(unless) : "memory");
    return prior;
}

unsigned long add_unless_double(volatile unsigned long *ptr,
                                 unsigned long add, unsigned long unless) {
    unsigned long prior, sc;
    __asm__ __volatile__(
        "0: ll.d %[p], %[c]\n"
        "beq %[p], %[u], 1f\n"
        "add.d %[rc], %[p], %[a]\n"
        "sc.d %[rc], %[c]\n"
        "beqz %[rc], 0b\n"
        "b 2f\n"
        "1: dbar 0x700\n"
        "2:"
        : [p] "=&r"(prior), [rc] "=&r"(sc), [c] "=ZB"(*ptr)
        : [a] "r"(add), [u] "r"(unless) : "memory");
    return prior;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_va_start_nested_builtin_arena.c"}
/* Keep the Function arena exactly at its initial 16-slot capacity when
 * va_start parses the nested LoongArch builtin. The builtin synthesizes the
 * seventeenth Function and can realloc the arena while the enclosing parser
 * is still checking its final named parameter. Run with an ASan MiniC build
 * to catch dangling MinicFunction* reads, not merely source acceptance. */
typedef __builtin_va_list minic_va_list;

extern int arena_f00(void);
extern int arena_f01(void);
extern int arena_f02(void);
extern int arena_f03(void);
extern int arena_f04(void);
extern int arena_f05(void);
extern int arena_f06(void);
extern int arena_f07(void);
extern int arena_f08(void);
extern int arena_f09(void);
extern int arena_f10(void);
extern int arena_f11(void);
extern int arena_f12(void);
extern int arena_f13(void);
extern int arena_f14(void);

unsigned long loong_va_start_nested_builtin(unsigned long tag, ...) {
    minic_va_list ap;
    __builtin_va_start(*(&ap + (0U * __builtin_loongarch_cpucfg(0U))), tag);
    unsigned long result = __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return result;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_vararg_int128_pair.c"}
/* GNU LoongArch LP64D: only *unnamed* 16-aligned wide scalars skip an odd
 * GAR. Named __int128 retains the ordinary a7/stack split rule. */
typedef unsigned __int128 U128;
typedef unsigned long (*VaOneFn)(unsigned long, ...);
typedef unsigned long (*VaSevenFn)(unsigned long, unsigned long,
    unsigned long, unsigned long, unsigned long, unsigned long,
    unsigned long, ...);

extern unsigned long va_one(unsigned long tag, ...);
extern unsigned long va_seven(unsigned long a, unsigned long b,
    unsigned long c, unsigned long d, unsigned long e,
    unsigned long f, unsigned long g, ...);
extern unsigned long fixed_one(unsigned long tag, U128 value);
extern unsigned long fixed_seven(unsigned long a, unsigned long b,
    unsigned long c, unsigned long d, unsigned long e,
    unsigned long f, unsigned long g, U128 value);

unsigned long loong_va_pair_direct(U128 value) {
    return va_one(11UL, value, 19UL);
}

unsigned long loong_va_pair_indirect(U128 value) {
    VaOneFn callee = va_one;
    return callee(11UL, value, 19UL);
}

unsigned long loong_va_spill_direct(U128 value) {
    return va_seven(1UL, 2UL, 3UL, 4UL, 5UL, 6UL, 7UL,
                    value, 19UL);
}

unsigned long loong_va_spill_indirect(U128 value) {
    VaSevenFn callee = va_seven;
    return callee(1UL, 2UL, 3UL, 4UL, 5UL, 6UL, 7UL,
                  value, 19UL);
}

unsigned long loong_named_pair_control(U128 value) {
    return fixed_one(11UL, value);
}

unsigned long loong_named_split_control(U128 value) {
    return fixed_seven(1UL, 2UL, 3UL, 4UL, 5UL, 6UL, 7UL, value);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_vararg_int128_pair_gnu.c"}
#include <stdarg.h>
typedef unsigned __int128 U128;

extern unsigned long loong_va_pair_direct(U128);
extern unsigned long loong_va_pair_indirect(U128);
extern unsigned long loong_va_spill_direct(U128);
extern unsigned long loong_va_spill_indirect(U128);
extern unsigned long loong_named_pair_control(U128);
extern unsigned long loong_named_split_control(U128);

static U128 reference(void) {
    return ((U128)0x123456789abcdef0ULL << 64) |
           (U128)0xfedcba9876543210ULL;
}

unsigned long va_one(unsigned long tag, ...) {
    va_list ap;
    U128 wide;
    unsigned long tail;
    va_start(ap, tag);
    wide = va_arg(ap, U128);
    tail = va_arg(ap, unsigned long);
    va_end(ap);
    return tag == 11UL && wide == reference() && tail == 19UL;
}

unsigned long va_seven(unsigned long a, unsigned long b,
    unsigned long c, unsigned long d, unsigned long e,
    unsigned long f, unsigned long g, ...) {
    va_list ap;
    U128 wide;
    unsigned long tail;
    va_start(ap, g);
    wide = va_arg(ap, U128);
    tail = va_arg(ap, unsigned long);
    va_end(ap);
    return a == 1UL && b == 2UL && c == 3UL && d == 4UL &&
           e == 5UL && f == 6UL && g == 7UL &&
           wide == reference() && tail == 19UL;
}

unsigned long fixed_one(unsigned long tag, U128 wide) {
    return tag == 11UL && wide == reference();
}

unsigned long fixed_seven(unsigned long a, unsigned long b,
    unsigned long c, unsigned long d, unsigned long e,
    unsigned long f, unsigned long g, U128 wide) {
    return a == 1UL && b == 2UL && c == 3UL && d == 4UL &&
           e == 5UL && f == 6UL && g == 7UL && wide == reference();
}

int main(void) {
    U128 wide = reference();
    if (!loong_va_pair_direct(wide)) return 1;
    if (!loong_va_pair_indirect(wide)) return 2;
    if (!loong_va_spill_direct(wide)) return 3;
    if (!loong_va_spill_indirect(wide)) return 4;
    if (!loong_named_pair_control(wide)) return 5;
    if (!loong_named_split_control(wide)) return 6;
    return 42;
}
@@@ end
