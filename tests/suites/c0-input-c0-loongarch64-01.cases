@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_frame_fold.c"}
/* The native path may use a known frame-object offset directly. An escaped
 * pointer and a packed external pointer must retain their distinct paths. */
struct S { long a, b; int flag; };
struct __attribute__((packed)) Packed { char tag; int value; };
volatile long output;
extern void escape(int *);

long work(long a, long b) {
    struct S x;
    x.a = a;
    x.b = b;
    x.flag = 3;
    x.a += x.b;
    output = x.a;
    return x.a * x.flag + x.b;
}

int alias_escape(int x) {
    int local = x;
    escape(&local);
    return local;
}

int packed_read(struct Packed *p) {
    return p->value;
}

/* Keep the frame genuinely large: the volatile byte object is observable,
 * while incoming scalar/SSA transport remains naturally aligned above it. */
unsigned long large_frame_touch(unsigned long x) {
    volatile unsigned char bytes[4096];
    bytes[4032] = (unsigned char)x;
    return (unsigned long)bytes[4032] + x;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_immediate_core_fold.c"}
/* A single-use Core INTEGER_CONSTANT is a machine-immediate operand only
 * when the LoongArch selector can encode it. Tests also exercise a fallback
 * constant, a dynamic RHS, and a volatile LOAD->ALU sequence. */
static volatile long minic_immediate_volatile = 20;

__attribute__((noinline)) long minic_immediate_add(long value)
{
    return value + 7L;
}

__attribute__((noinline)) long minic_immediate_sub(long value)
{
    return value - 2048L;
}

__attribute__((noinline)) long minic_immediate_mask(long value)
{
    return (value & 4095L) ^ 7L;
}

__attribute__((noinline)) long minic_immediate_out_of_range(long value)
{
    return value + 2048L;
}

__attribute__((noinline)) long minic_immediate_dynamic(long left, long right)
{
    return left + right;
}

__attribute__((noinline)) long minic_immediate_load_chain(void)
{
    return minic_immediate_volatile + 7L;
}

__attribute__((noinline)) long minic_immediate_barrier(void)
{
    long value = minic_immediate_volatile;
    __asm__ __volatile__("" ::: "memory");
    return value + 7L;
}

int main(void)
{
    if (minic_immediate_add(13) != 20) return 1;
    if (minic_immediate_sub(2057) != 9) return 2;
    if (minic_immediate_mask(4101) != 2) return 3;
    if (minic_immediate_out_of_range(13) != 2061) return 4;
    if (minic_immediate_dynamic(13, 7) != 20) return 5;
    if (minic_immediate_load_chain() != 27) return 6;
    if (minic_immediate_barrier() != 27) return 7;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_indirect_sret.c"}
/* MiniC half of the LoongArch LP64D cross-compiler aggregate-result ABI.
 * An indirect call with a 17+/24+/40-byte result passes hidden $a0,
 * named arguments in $a1+, and returns the caller's result buffer in $a0. */
struct L17 { unsigned char b[17]; };
struct L24 { unsigned long w[3]; };
struct L40 { unsigned long w[5]; };

extern struct L17 (*make17)(unsigned char);
extern struct L24 (*make24)(unsigned long);
extern struct L40 (*make40)(unsigned long, unsigned long, unsigned long,
                           unsigned long, unsigned long, unsigned long,
                           unsigned long, unsigned long, unsigned long,
                           unsigned long);

struct L17 minic_indirect_17(unsigned char v) {
    return make17(v);
}

struct L24 minic_indirect_24(unsigned long v) {
    struct L24 intermediate = make24(v);
    intermediate.w[2] += 5UL;
    return intermediate;
}

struct L40 minic_indirect_40(unsigned long v) {
    return make40(1UL, 2UL, 3UL, 4UL, 5UL, 6UL,
                  7UL, 8UL, 9UL, v);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_indirect_sret_gnu.c"}
/* GNU LoongArch64 side; GNU caller checks MiniC indirect-call results,
 * while GNU callees interpret the hidden-result and stack argument ABI. */
#include <stdio.h>

struct L17 { unsigned char b[17]; };
struct L24 { unsigned long w[3]; };
struct L40 { unsigned long w[5]; };

extern struct L17 minic_indirect_17(unsigned char);
extern struct L24 minic_indirect_24(unsigned long);
extern struct L40 minic_indirect_40(unsigned long);

static struct L17 gnu17(unsigned char v) {
    struct L17 result;
    unsigned i;
    for (i = 0; i < 17; ++i) result.b[i] = (unsigned char)(v + i);
    return result;
}
static struct L24 gnu24(unsigned long v) {
    struct L24 result = {{ v, v + 11UL, v + 22UL }};
    return result;
}
static struct L40 gnu40(unsigned long a, unsigned long b, unsigned long c,
                        unsigned long d, unsigned long e, unsigned long f,
                        unsigned long g, unsigned long h, unsigned long i,
                        unsigned long j) {
    struct L40 result = {{ a + b, c + d, e + f, g + h, i + j }};
    return result;
}

struct L17 (*make17)(unsigned char) = gnu17;
struct L24 (*make24)(unsigned long) = gnu24;
struct L40 (*make40)(unsigned long, unsigned long, unsigned long,
                     unsigned long, unsigned long, unsigned long,
                     unsigned long, unsigned long, unsigned long,
                     unsigned long) = gnu40;

int main(void) {
    struct L17 a = minic_indirect_17(7);
    struct L24 b = minic_indirect_24(31UL);
    struct L40 c = minic_indirect_40(21UL);
    unsigned i;
    for (i = 0U; i < 17U; ++i)
        if (a.b[i] != (unsigned char)(i + 7U)) return 1;
    if (b.w[0] != 31UL || b.w[1] != 42UL || b.w[2] != 58UL)
        return 2;
    if (c.w[0] != 3UL || c.w[1] != 7UL || c.w[2] != 11UL ||
        c.w[3] != 15UL || c.w[4] != 30UL)
        return 3;
    puts("LOONGARCH64_INDIRECT_SRET_OK");
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_inline_invtlb_mnemonic.c"}
/* Linux-style always-inline wrapper has the same C name as the target opcode.
 * The `i` operand is not valid in its generic function body; constant
 * callsites specialize before the Core reachability closure. */
static __inline__ __attribute__((__gnu_inline__, __always_inline__))
void invtlb(unsigned int op, unsigned int info, unsigned long address) {
    __asm__ __volatile__("invtlb %0, %1, %2\n\t" : :
        "i"(op), "r"(info), "r"(address) : "memory");
}

void emit_invtlb_constant(unsigned int info, unsigned long address) {
    invtlb(0U, info, address);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/loongarch64_linux_clock_cpuid_memory.c"}
/* Exact Linux 6.6 arch/loongarch/vdso/vgetcpu.i CPU-ID clock form.
 * Unlike the nonvolatile VDSO base form, this source has one memory clobber. */
static __inline__ __attribute__((__gnu_inline__, __always_inline__))
int linux_read_cpu_id(void) {
    int cpu_id;
    __asm__ __volatile__("rdtime.d $zero, %0\n"
                         : "=r"(cpu_id) : : "memory");
    return cpu_id;
}

int linux_cpu_id(void) { return linux_read_cpu_id(); }
