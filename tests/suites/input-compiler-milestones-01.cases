@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc066_aarch64_fp_pointer_aggregate.c"}
/* MC-066: a type's FLOAT/DOUBLE base_kind does not make its pointer an FP
 * leaf. Preserve 16/17/32/64-byte ABI shapes and verify nested indirections
 * separately from actual homogeneous FP/NEON value members. */
#ifndef MC066_BYTES
#define MC066_BYTES 32
#endif

typedef double *MC066_DoublePtr;
typedef double (*MC066_ArrayPtr)[4];
struct MC066_FPObject { double number; };
typedef struct MC066_FPObject *MC066_RecordPtr;

#if MC066_BYTES == 17 || defined(MC066_PACKED_POINTER) || \
    defined(MC066_PACKED_FLOAT_VALUES)
#define MC066_RECORD_ATTRIBUTE __attribute__((packed))
#else
#define MC066_RECORD_ATTRIBUTE
#endif

struct MC066_RECORD_ATTRIBUTE PointerRecord {
#ifdef MC066_FLOAT_VALUES
    double first;
    double second;
    double third;
    double fourth;
#elif defined(MC066_PACKED_FLOAT_VALUES)
    double first;
    double second;
    double third;
    double fourth;
#elif defined(MC066_POINTER_ARRAY)
    double *numbers[2];
    #if MC066_BYTES > 16
    unsigned char padding[MC066_BYTES - sizeof(double *) * 2];
    #endif
#elif defined(MC066_TYPEDEF_PTR)
    MC066_DoublePtr number;
    unsigned char padding[MC066_BYTES - sizeof(MC066_DoublePtr)];
#elif defined(MC066_POINTER_TO_ARRAY)
    MC066_ArrayPtr number;
    unsigned char padding[MC066_BYTES - sizeof(MC066_ArrayPtr)];
#elif defined(MC066_POINTER_TO_RECORD)
    MC066_RecordPtr number;
    unsigned char padding[MC066_BYTES - sizeof(MC066_RecordPtr)];
#elif defined(MC066_PACKED_POINTER)
    unsigned char prefix;
    double *number;
    unsigned char padding[MC066_BYTES - 1 - sizeof(double *)];
#elif defined(MC066_INTEGER_PTR)
    int *number;
    unsigned char padding[MC066_BYTES - sizeof(int *)];
#else
    double *number;
    unsigned char padding[MC066_BYTES - sizeof(double *)];
#endif
};
_Static_assert(sizeof(struct PointerRecord) == MC066_BYTES,
               "MC-066 probe must retain exact AArch64 record extent");

struct PointerRecord pass_pointer_record(struct PointerRecord x);

/* Compile the same source twice to cross the caller/callee ABI boundary.
 * Runtime mode is only used with the default double* member. */
#ifdef MC066_RUNTIME_CALLER
int main(void) {
    double datum = 7.0;
    struct PointerRecord input = {0};
    struct PointerRecord output;
    unsigned int i;
    input.number = &datum;
    for (i = 0U; i < sizeof(input.padding); ++i)
        input.padding[i] = (unsigned char)(i * 7U + 1U);
    output = pass_pointer_record(input);
    if (output.number != &datum) return 1;
    for (i = 0U; i < sizeof(input.padding); ++i)
        if (output.padding[i] != input.padding[i]) return 2;
    return 42;
}
#else
struct PointerRecord pass_pointer_record(struct PointerRecord x) { return x; }
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc067_attributed_record_forward_declaration.c"}
/* MC-067: GNU attributes may appear between struct and its forward tag.
 * -DMC067_PLAIN_CONTROL removes only the attribute; both forms are legal
 * GNU11, and the full definition must still refer to the same forward tag. */
#ifdef MC067_PLAIN_CONTROL
struct Forward;
#else
struct __attribute__((aligned(16))) Forward;
#endif
struct Forward { int x; };
int main(void) { return (int)sizeof(struct Forward); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc072_inline_computed_label_owner.c"}
/* MC-072: Valid GNU C. A static label table belongs to one function body;
 * an integer-specialized inline clone must not leave its relocations without
 * a matching source-label symbol definition. Do not use always_inline here:
 * GCC rejects forcing a copy of a function with static &&label storage. */
static inline int dispatch_inline_local(int n) {
    static void *const jumps[] = {&&alpha, &&beta};
    if (n < 0 || n > 1) return 0;
    goto *jumps[n];
alpha:
    return 10;
beta:
    return 20;
}

/* Negative control: an unused inline owner must not publish either its
 * static table or aliases for its private labels into the module. */
static inline int unused_dispatch_inline_local(int n) {
    static void *const dead_jumps[]
        __attribute__((section(".data.mc072_dead_owner"))) = {&&dead_a, &&dead_b};
    goto *dead_jumps[n & 1];
dead_a:
    return 91;
dead_b:
    return 92;
}

int caller_one(void) { return dispatch_inline_local(0); }
int caller_two(void) { return dispatch_inline_local(1); }

#ifdef MC072_RUNTIME
int main(void) {
    return caller_one() == 10 && caller_two() == 20 ? 0 : 1;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc082_sysv_record_abi.h"}
#ifndef MC082_SYSV_RECORD_ABI_H
#define MC082_SYSV_RECORD_ABI_H

/* All scalar leaves are byte-aligned INTEGER-class fields. The structs'
 * true sizes span every SysV one-/two-eightbyte partial-tail boundary. */
#define MC082_SIZES(X) \
    X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) \
    X(9) X(10) X(11) X(12) X(13) X(14) X(15) X(16)

#define MC082_RECORD(N) \
    struct MC082_R##N { unsigned char bytes[N]; }; \
    struct MC082_R##N mc082_make_##N(unsigned char seed); \
    unsigned int mc082_check_##N(struct MC082_R##N value);
MC082_SIZES(MC082_RECORD)
#undef MC082_RECORD

/* packed with a naturally aligned u32 leaf still has INTEGER class. */
struct __attribute__((packed)) MC082_Packed5 {
    unsigned int word;
    unsigned char tail;
};
struct MC082_Packed5 mc082_make_packed5(unsigned int value);
unsigned int mc082_check_packed5(struct MC082_Packed5 value);

/* Explicit eightbyte alignment can raise sizeof(3-byte data) to eight. */
struct __attribute__((aligned(8))) MC082_Aligned8 {
    unsigned char bytes[3];
};
struct MC082_Aligned8 mc082_make_aligned8(unsigned char seed);
unsigned int mc082_check_aligned8(struct MC082_Aligned8 value);

/* Internal and tail padding are part of sizeof but never authorize an
 * eightbyte read past that size; both remain INTEGER-class aggregates. */
struct MC082_Padded8 { unsigned char tag; unsigned int word; };
struct MC082_Padded16 { unsigned char tag; unsigned long long word; };
struct MC082_Padded8 mc082_make_padded8(unsigned int value);
unsigned int mc082_check_padded8(struct MC082_Padded8 value);
struct MC082_Padded16 mc082_make_padded16(unsigned long long value);
unsigned int mc082_check_padded16(struct MC082_Padded16 value);

/* A one-GP value after six integer arguments and indivisible two-GP values
 * after five arguments must take SysV stack fallback, including odd tails. */
unsigned int mc082_stack3(unsigned long, unsigned long, unsigned long,
                          unsigned long, unsigned long, unsigned long,
                          struct MC082_R3);
unsigned int mc082_stack9(unsigned long, unsigned long, unsigned long,
                          unsigned long, unsigned long, struct MC082_R9);
unsigned int mc082_stack15(unsigned long, unsigned long, unsigned long,
                           unsigned long, unsigned long, struct MC082_R15);

#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc082_sysv_record_abi_driver.c"}
#include "mc082_sysv_record_abi.h"

int main(void) {
#define MC082_VERIFY(N) do { \
        struct MC082_R##N value = mc082_make_##N(7U); \
        struct MC082_R##N outgoing = {0}; \
        unsigned int index, expected = 0U; \
        for (index = 0U; index < N; ++index) { \
            unsigned char byte = (unsigned char)(7U + index * 3U); \
            if (value.bytes[index] != byte) return N; \
            outgoing.bytes[index] = byte; \
            expected += byte; \
        } \
        if (mc082_check_##N(value) != expected) return 20 + N; \
        if (mc082_check_##N(outgoing) != expected) return 40 + N; \
    } while (0);
    MC082_SIZES(MC082_VERIFY)
#undef MC082_VERIFY
    if (mc082_check_packed5(mc082_make_packed5(0x12345678U)) != 42U)
        return 60;
    if (mc082_check_aligned8(mc082_make_aligned8(7U)) != 24U)
        return 61;
    if (mc082_check_padded8(mc082_make_padded8(0x12345678U)) != 42U)
        return 65;
    if (mc082_check_padded16(mc082_make_padded16(0x1234567887654321ULL)) != 42U)
        return 66;
    {
        struct MC082_R3 three = mc082_make_3(7U);
        struct MC082_R9 nine = mc082_make_9(7U);
        struct MC082_R15 fifteen = mc082_make_15(7U);
        unsigned int (*volatile indirect3)(struct MC082_R3) = mc082_check_3;
        if (mc082_stack3(1UL, 2UL, 3UL, 4UL, 5UL, 6UL, three) !=
            21U + mc082_check_3(three)) return 62;
        if (mc082_stack9(1UL, 2UL, 3UL, 4UL, 5UL, nine) !=
            15U + mc082_check_9(nine)) return 63;
        if (mc082_stack15(1UL, 2UL, 3UL, 4UL, 5UL, fifteen) !=
            15U + mc082_check_15(fifteen)) return 64;
        if (indirect3(three) != mc082_check_3(three)) return 67;
    }
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc082_sysv_record_abi_functions.c"}
#include "mc082_sysv_record_abi.h"

#define MC082_FUNCTIONS(N) \
    struct MC082_R##N mc082_make_##N(unsigned char seed) { \
        struct MC082_R##N result = {0}; \
        unsigned int index; \
        for (index = 0U; index < N; ++index) \
            result.bytes[index] = (unsigned char)(seed + index * 3U); \
        return result; \
    } \
    unsigned int mc082_check_##N(struct MC082_R##N value) { \
        unsigned int index, checksum = 0U; \
        for (index = 0U; index < N; ++index) \
            checksum += value.bytes[index]; \
        return checksum; \
    }
MC082_SIZES(MC082_FUNCTIONS)
#undef MC082_FUNCTIONS

struct MC082_Packed5 mc082_make_packed5(unsigned int value) {
    struct MC082_Packed5 result = {0};
    result.word = value;
    result.tail = 0xa5U;
    return result;
}

unsigned int mc082_check_packed5(struct MC082_Packed5 value) {
    return value.word == 0x12345678U && value.tail == 0xa5U ? 42U : 1U;
}

struct MC082_Aligned8 mc082_make_aligned8(unsigned char seed) {
    struct MC082_Aligned8 result = {0};
    result.bytes[0] = seed;
    result.bytes[1] = (unsigned char)(seed + 1U);
    result.bytes[2] = (unsigned char)(seed + 2U);
    return result;
}

unsigned int mc082_check_aligned8(struct MC082_Aligned8 value) {
    return (unsigned int)value.bytes[0] + value.bytes[1] + value.bytes[2];
}

struct MC082_Padded8 mc082_make_padded8(unsigned int value) {
    struct MC082_Padded8 result = {0};
    result.tag = 0xa7U;
    result.word = value;
    return result;
}

unsigned int mc082_check_padded8(struct MC082_Padded8 value) {
    return value.tag == 0xa7U && value.word == 0x12345678U ? 42U : 1U;
}

struct MC082_Padded16 mc082_make_padded16(unsigned long long value) {
    struct MC082_Padded16 result = {0};
    result.tag = 0xb8U;
    result.word = value;
    return result;
}

unsigned int mc082_check_padded16(struct MC082_Padded16 value) {
    return value.tag == 0xb8U && value.word == 0x1234567887654321ULL ? 42U : 1U;
}

unsigned int mc082_stack3(unsigned long a, unsigned long b, unsigned long c,
                          unsigned long d, unsigned long e, unsigned long f,
                          struct MC082_R3 value) {
    return (unsigned int)(a + b + c + d + e + f) +
           value.bytes[0] + value.bytes[1] + value.bytes[2];
}

unsigned int mc082_stack9(unsigned long a, unsigned long b, unsigned long c,
                          unsigned long d, unsigned long e, struct MC082_R9 value) {
    return (unsigned int)(a + b + c + d + e) + mc082_check_9(value);
}

unsigned int mc082_stack15(unsigned long a, unsigned long b, unsigned long c,
                           unsigned long d, unsigned long e, struct MC082_R15 value) {
    return (unsigned int)(a + b + c + d + e) + mc082_check_15(value);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc082_sysv_unaligned_memory_negative.c"}
/* GNU SysV classifies this packed unaligned u32 leaf as MEMORY, not INTEGER.
 * MC-082 extends only naturally aligned INTEGER-class transport; until the
 * <=16-byte MEMORY/sret classifier exists, MiniC must still fail closed. */
struct __attribute__((packed)) Misaligned5 {
    unsigned char prefix;
    unsigned int word;
};

struct Misaligned5 memory_return(unsigned int word) {
    struct Misaligned5 value = {0};
    value.prefix = 7U;
    value.word = word;
    return value;
}

unsigned int memory_argument(struct Misaligned5 value) {
    return value.prefix + value.word;
}

int main(void) {
    return memory_argument(memory_return(35U));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc085_diagnostic_attribute_cases.c"}
/* MC-085: GNU compile-time call attributes, one selected TU per case.
 * Preprocess with -DMC085_CASE=N before passing the TU to MiniC. */
#ifndef MC085_CASE
#define MC085_CASE 1
#endif

#if MC085_CASE == 1
extern void stop(void) __attribute__((error("MC085 live error")));
int main(void) { stop(); return 0; }
#elif MC085_CASE == 2
extern void stop(void) __attribute__((error("MC085 dead error")));
int main(void) { if (0) stop(); return 0; }
#elif MC085_CASE == 3
extern void stop(void) __attribute__((error("MC085 constant error")));
int main(void) { if ((1 + 0) == 0) stop(); return 0; }
#elif MC085_CASE == 4
extern void caution(void) __attribute__((warning("MC085 live warning")));
int main(void) { caution(); return 0; }
#elif MC085_CASE == 5
extern void stop(void) __attribute__((error("MC085 indirect error")));
int main(void) { void (*fp)(void) = stop; fp(); return 0; }
#elif MC085_CASE == 6
extern void stop(void) __attribute__((error("MC085 indirect error")));
int call_through(void (*fp)(void)) { fp(); return 0; }
int main(void) { return call_through(stop); }
#elif MC085_CASE == 7
extern void stop(void) __asm__("mc085_alias")
    __attribute__((error("MC085 alias error")));
int main(void) { stop(); return 0; }
#elif MC085_CASE == 8
extern void stop(void) __attribute__((error("MC085 inline guard error")));
static inline __attribute__((always_inline)) void guard(int value) {
    if (value) stop();
}
int main(void) { guard(0); return 0; }
#elif MC085_CASE == 9
extern void stop(void) __attribute__((error("MC085 inactive static error")));
static void dormant(void) { stop(); }
int main(void) { return 0; }
#elif MC085_CASE == 10
extern void stop(void) __attribute__((error("MC085 reachable static error")));
static void dormant(void) { stop(); }
int main(void) { dormant(); return 0; }
#elif MC085_CASE == 11
extern void caution(void) __attribute__((warning("MC085 warning and error"),
                                         error("MC085 warning and error")));
int main(void) { caution(); return 0; }
#elif MC085_CASE == 12
extern void stop(void) __attribute__((error("MC085 conditional error")));
int maybe(int value) { if (value) stop(); return value; }
int main(void) { return maybe(0); }
#elif MC085_CASE == 13
/* Distinct C identifiers deliberately share one linker symbol. Matching
 * Core CALL names to *all* attributed declarations would be a false error. */
extern void dangerous(void) __asm__("mc085_same")
    __attribute__((error("MC085 false alias diagnostic")));
extern void safe(void) __asm__("mc085_same");
int main(void) { safe(); return 0; }
#elif MC085_CASE == 14
extern void dangerous(void) __asm__("mc085_same")
    __attribute__((error("MC085 true alias diagnostic")));
extern void safe(void) __asm__("mc085_same");
int main(void) { dangerous(); return 0; }
#elif MC085_CASE == 15
extern void stop(void) __attribute__((error("MC085 false cold-label error")));
int main(void) { if (0) { cold_label: stop(); } return 0; }
#elif MC085_CASE == 16
extern void stop(void) __attribute__((error("MC085 jumped-over label error")));
int main(void) { goto after; cold_label: stop(); after: return 0; }
#else
#error Unknown MC085 case
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc089_x87_ordered_comparisons.c"}
/* MC-089: compile this TU with MiniC; the harness is a separate GNU TU. */
int mc089_less(long double a, long double b) { return a < b; }
int mc089_less_equal(long double a, long double b) { return a <= b; }
int mc089_greater(long double a, long double b) { return a > b; }
int mc089_greater_equal(long double a, long double b) { return a >= b; }
int mc089_equal(long double a, long double b) { return a == b; }
int mc089_not_equal(long double a, long double b) { return a != b; }

int mc089_direct_greater(void) {
    long double a = 2.0L;
    long double b = 1.0L;
    return a > b;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc089_x87_ordered_comparisons_support.c"}
#include <stdio.h>
#include <stdlib.h>

extern int mc089_less(long double, long double);
extern int mc089_less_equal(long double, long double);
extern int mc089_greater(long double, long double);
extern int mc089_greater_equal(long double, long double);
extern int mc089_equal(long double, long double);
extern int mc089_not_equal(long double, long double);
extern int mc089_direct_greater(void);

typedef int (*Mc089Compare)(long double, long double);

int main(void) {
    static const Mc089Compare compare[] = {
        mc089_less, mc089_less_equal, mc089_greater,
        mc089_greater_equal, mc089_equal, mc089_not_equal
    };
    long double nan_value = strtold("nan", NULL);
    long double positive_inf = strtold("inf", NULL);
    long double negative_inf = -positive_inf;
    long double pair[12][2] = {
        {2.0L, 1.0L}, {1.0L, 2.0L}, {1.0L, 1.0L},
        {-2.0L, -1.0L}, {-1.0L, -2.0L}, {-0.0L, 0.0L},
        {0.0L, -0.0L}, {positive_inf, 2.0L},
        {negative_inf, -3.0L}, {nan_value, 1.0L},
        {1.0L, nan_value}, {nan_value, nan_value}
    };
    size_t i, op;
    int mismatches = mc089_direct_greater() != 1;

    for (i = 0U; i < 12U; ++i) {
        long double a = pair[i][0];
        long double b = pair[i][1];
        int expected[] = {a < b, a <= b, a > b, a >= b, a == b, a != b};
        for (op = 0U; op < 6U; ++op) {
            int got = compare[op](a, b);
            if (got != expected[op]) {
                (void)fprintf(stderr,
                              "MC089_DIFF case=%zu op=%zu got=%d expected=%d\n",
                              i, op, got, expected[op]);
                ++mismatches;
            }
        }
    }
    (void)printf("MC089_MISMATCHES=%d\n", mismatches);
    return mismatches == 0 ? 0 : 1;
}
@@@ end
