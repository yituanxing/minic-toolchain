@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc038_anonymous_designator_runtime.c"}
/* GNU C runtime designator continuation through anonymous record fields.
 * Compile this TU with MiniC; the caller/oracle TU with GNU cc. */
struct Mc038Simple {
    struct { int a; int b; };
    int c;
};

struct Mc038Deep {
    struct { struct { int a; int b; }; int hidden; };
    int c;
};

struct Mc038Union {
    union { int a; int b; };
    int c;
};

struct Mc038Offset {
    int z;
    int y;
    struct { int a; int b; };
    int c;
};

struct Mc038Named {
    struct { int a; int b; } inner;
    int c;
};

struct Mc038Multiple {
    struct { int a; int b; };
    int c;
    int d;
};

struct Mc038Preserve {
    struct { int a; int b; int c; };
    int d;
};

int mc038_simple(void) {
    struct Mc038Simple x = { .b = 2, 3 };
    return x.a * 100 + x.b * 10 + x.c;
}
int mc038_deep(void) {
    struct Mc038Deep x = { .b = 2, 3 };
    return x.a * 1000 + x.b * 10 + x.hidden * 100 + x.c;
}
int mc038_union(void) {
    struct Mc038Union x = { .b = 2, 3 };
    return x.b * 10 + x.c;
}
int mc038_offset(void) {
    struct Mc038Offset x = { .b = 2, 3 };
    return x.z * 1000 + x.y * 100 + x.a * 100 + x.b * 10 + x.c;
}
int mc038_named(void) {
    struct Mc038Named x = { .inner.b = 2, 3 };
    return x.inner.a * 100 + x.inner.b * 10 + x.c;
}
int mc038_named_mid(void) {
    struct Mc038Named x = { .inner.a = 2, 3 };
    return x.inner.a * 10 + x.inner.b + x.c * 100;
}
int mc038_deep_multi(void) {
    struct Mc038Deep x = { .b = 2, 3, 4 };
    return x.b * 10 + x.hidden * 100 + x.c;
}
int mc038_named_multi(void) {
    struct Mc038Named x = { .inner.a = 2, 3, 4 };
    return x.inner.a * 100 + x.inner.b * 10 + x.c;
}
int mc038_dotted_after_positional(void) {
    struct Mc038Named x = { .inner.a = 1, 2, .c = 3 };
    return x.inner.a * 100 + x.inner.b * 10 + x.c;
}
int mc038_preserve_designated(void) {
    struct Mc038Preserve x = { .c = 7, .a = 2, 3 };
    return x.a * 1000 + x.b * 100 + x.c * 10 + x.d;
}
int mc038_preserve_outer(void) {
    struct Mc038Named x = { .c = 7, .inner.a = 2, 3 };
    return x.inner.a * 100 + x.inner.b * 10 + x.c;
}
int mc038_multiple(void) {
    struct Mc038Multiple x = { .b = 2, 3, 4 };
    return x.b * 100 + x.c * 10 + x.d;
}
int mc038_explicit(void) {
    struct Mc038Simple x = { .b = 2, .c = 3 };
    return x.b * 10 + x.c;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/audit/mc038_anonymous_designator_runtime_support.c"}
/* Oracle: all expected values are unambiguous and observable at runtime. */
#ifndef MC038_FREESTANDING
#include <stdio.h>
#endif

extern int mc038_simple(void);
extern int mc038_deep(void);
extern int mc038_union(void);
extern int mc038_offset(void);
extern int mc038_named(void);
extern int mc038_named_mid(void);
extern int mc038_deep_multi(void);
extern int mc038_named_multi(void);
extern int mc038_dotted_after_positional(void);
extern int mc038_preserve_designated(void);
extern int mc038_preserve_outer(void);
extern int mc038_multiple(void);
extern int mc038_explicit(void);

int main(void) {
    unsigned int failures = 0U;
    if (mc038_simple() != 23) failures |= 1U;
    /* The anonymous outer struct still has `hidden` after promoted `.b`. */
    if (mc038_deep() != 320) failures |= 2U;
    if (mc038_union() != 23) failures |= 4U;
    if (mc038_offset() != 23) failures |= 8U;
    if (mc038_named() != 23) failures |= 16U;
    if (mc038_multiple() != 234) failures |= 32U;
    if (mc038_explicit() != 23) failures |= 64U;
    if (mc038_named_mid() != 23) failures |= 128U;
    if (mc038_deep_multi() != 324) failures |= 256U;
    if (mc038_named_multi() != 234) failures |= 512U;
    if (mc038_dotted_after_positional() != 123) failures |= 1024U;
    if (mc038_preserve_designated() != 2370) failures |= 2048U;
    if (mc038_preserve_outer() != 237) failures |= 4096U;
#ifndef MC038_FREESTANDING
    (void)printf("mc038_failure_mask=0x%x\n", failures);
#endif
    return failures != 0U;
}
@@@ end
