#elif defined(TEST_PARAM)
struct Empty pass_empty(struct Empty e) { return e; }
#elif defined(TEST_CALL_RETURN)
struct Empty ret_empty(void);
int call_ret(void) { ret_empty(); return 17; }
#elif defined(TEST_CALL_PARAM)
