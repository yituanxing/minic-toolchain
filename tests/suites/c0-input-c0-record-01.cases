@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/record_rvalue_array_member.c"}
/* An array selected from an aggregate rvalue is not an lvalue, but may
 * decay into a pointer to an array inside the full-expression temporary. */
struct Inner {
    long words[3];
};

struct Outer {
    struct Inner inner;
    long tail;
};

static int evaluations;

static struct Outer produce(long x) {
    struct Outer result;
    evaluations++;
    result.inner.words[0] = x;
    result.inner.words[1] = x + 1;
    result.inner.words[2] = x + 2;
    result.tail = x + 3;
    return result;
}

static long consume(const long *words) {
    return words[0] + words[2];
}

int main(void) {
    long first = produce(10).inner.words[1];
    long second = consume(produce(20).inner.words);
    long third = (0 ? produce(30) : produce(40)).inner.words[2];
    unsigned long extent = sizeof(produce(50).inner.words);
    if (first != 11 || second != 42 || third != 42 ||
        extent != 3 * sizeof(long) || evaluations != 3)
        return 1;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/record_rvalue_member.c"}
typedef struct {
    unsigned long pgprot;
} pgprot_t;

pgprot_t pgprot_noncached(pgprot_t oldprot)
{
    return oldprot;
}

unsigned long project(pgprot_t oldprot)
{
    return (pgprot_noncached(oldprot)).pgprot;
}

int main(void)
{
    pgprot_t value = { 17 };
    return project(value) == 17 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/record_rvalue_nested_member.c"}
/* A GNU/ISO C aggregate rvalue has one temporary object: nested member
 * projections walk that one materialization without re-running the source
 * call. Linux arm64 mmu.c has ((pud_t){...}).p4d.pgd.pgd chains. */
struct Leaf { unsigned long value; };
struct Mid { struct Leaf leaf; unsigned long extra; };
struct Outer { struct Mid mid; unsigned long tail; };

static int evaluations;

static struct Outer produce(unsigned long value) {
    struct Outer result;
    evaluations += 1;
    result.mid.leaf.value = value + 11UL;
    result.mid.extra = value + 21UL;
    result.tail = value + 31UL;
    return result;
}

static struct Mid pass_mid(unsigned long value) {
    return produce(value).mid;
}

static struct Leaf pass_leaf(unsigned long value) {
    return produce(value).mid.leaf;
}

int main(void) {
    unsigned long one = produce(3UL).mid.leaf.value;
    struct Mid two = produce(4UL).mid;
    struct Leaf three = produce(5UL).mid.leaf;
    unsigned long four = (1 ? produce(6UL) : produce(7UL)).mid.leaf.value;
    struct Mid five = pass_mid(8UL);
    struct Leaf six = pass_leaf(9UL);

    if (evaluations != 6 || one != 14UL || two.leaf.value != 15UL ||
        two.extra != 25UL || three.value != 16UL || four != 17UL ||
        five.leaf.value != 19UL || five.extra != 29UL || six.value != 20UL)
        return 1;
    return 0;
}
@@@ end
