@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/mc058_stale_boolean_parameter.c"}
/* MC-058: an incoming specialization range belongs to a parameter VALUE,
 * not to its mutable storage across writes, branches, and address escapes.
 * GCC and MiniC must both return zero from main on x86 native execution.
 * All five target compilers must accept this same GNU-preprocessed fixture. */
__attribute__((always_inline)) static inline int leaf_range(int x) {
    return x == 2 ? 1 : 0;
}

__attribute__((always_inline)) static inline int middle_assign(int x) {
    x = 2;
    return leaf_range(x);
}

__attribute__((always_inline)) static inline int middle_increment(int x) {
    ++x;
    return leaf_range(x);
}

__attribute__((always_inline)) static inline int middle_conditional(int x, int change) {
    if (change)
        x = 2;
    return leaf_range(x);
}

__attribute__((always_inline)) static inline int middle_escape(int x) {
    int *alias = &x;
    *alias = 2;
    return leaf_range(x);
}

__attribute__((always_inline)) static inline int middle_loop(int x) {
    int n = 0;
    while (n < 1) {
        x = 2;
        ++n;
    }
    return leaf_range(x);
}

int check_assign(int z) { return middle_assign((_Bool)z); }
int check_increment(int z) { return middle_increment((_Bool)z); }
int check_conditional(int z, int change) {
    return middle_conditional((_Bool)z, change);
}
int check_escape(int z) { return middle_escape((_Bool)z); }
int check_loop(int z) { return middle_loop((_Bool)z); }

int main(void) {
    return check_assign(0) != 1 || check_assign(1) != 1 ||
           check_increment(0) != 0 || check_increment(1) != 1 ||
           check_conditional(0, 0) != 0 || check_conditional(1, 0) != 0 ||
           check_conditional(0, 1) != 1 || check_conditional(1, 1) != 1 ||
           check_escape(0) != 1 || check_escape(1) != 1 ||
           check_loop(0) != 1 || check_loop(1) != 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/mc058_symbolic_pointer_addends.c"}
/* MC-058: GNU asm `i` symbol addends are byte offsets, while source C
 * pointer +/- integer uses the pointee size. The %c modifier prints the
 * raw address on x86 GCC and in MiniC's common immediate normalizer. */
struct Mc058Pair { int lo; long long hi; };
static int mc058_words[8];
static char mc058_bytes[8];
static long long mc058_wides[8];
static struct Mc058Pair mc058_pairs[8];

static inline __attribute__((always_inline)) int mc058_int(int *p) {
    __asm__ volatile(".quad %c0" : : "i"(p));
    return 1;
}
static inline __attribute__((always_inline)) int mc058_char(char *p) {
    __asm__ volatile(".quad %c0" : : "i"(p));
    return 1;
}
static inline __attribute__((always_inline)) int mc058_wide(long long *p) {
    __asm__ volatile(".quad %c0" : : "i"(p));
    return 1;
}
static inline __attribute__((always_inline)) int mc058_pair(struct Mc058Pair *p) {
    __asm__ volatile(".quad %c0" : : "i"(p));
    return 1;
}
static inline __attribute__((always_inline)) int mc058_void(void *p) {
    __asm__ volatile(".quad %c0" : : "i"(p));
    return 1;
}

int mc058_int_plus(void) { return mc058_int(mc058_words + 1); }
int mc058_int_commuted(void) { return mc058_int(1 + mc058_words); }
int mc058_int_minus(void) { return mc058_int(mc058_words - 1); }
int mc058_char_plus(void) { return mc058_char(mc058_bytes + 1); }
int mc058_wide_plus(void) { return mc058_wide(mc058_wides + 1); }
int mc058_pair_plus(void) { return mc058_pair(mc058_pairs + 1); }
int mc058_void_plus(void) { return mc058_void((void *)mc058_words + 1); }
int mc058_cast_char_plus(void) { return mc058_char((char *)mc058_words + 1); }
@@@ end
