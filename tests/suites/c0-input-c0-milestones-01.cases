@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/mc058_asm_integer_param_mutation_negative.c"}
/* MC-058: the ingress constant 1 is killed by x=y. GNU rejects its later
 * `i` constraint because y is an arbitrary runtime value; MiniC must not
 * silently emit the stale `.byte 1` from clone entrance facts. */
static inline __attribute__((always_inline)) int mc058_rebound(int x, int y) {
    x = y;
    __asm__ volatile(".byte %c0" : : "i"(x));
    return 1;
}
int mc058_rebound_probe(int y) { return mc058_rebound(1, y); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/mc058_asm_integer_param_rebind_constant.c"}
/* A write kills the entry specialization fact, but local Core tracking may
 * still prove a newly assigned constant. Preserve that valid immediate. */
static inline __attribute__((always_inline)) int mc058_rebind_constant(int x) {
    x = 2;
    __asm__ volatile(".byte %c0" : : "i"(x));
    return x;
}
int mc058_rebind_constant_probe(void) { return mc058_rebind_constant(1); }
