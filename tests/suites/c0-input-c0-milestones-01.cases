@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p41_bounded_or_conditional_negative.c"}
/* P41: dynamic path changes an entry-specialized parameter via bounded OR;
 * its value is no longer admissible for GNU `i` immediate operands. */
__attribute__((always_inline)) static inline int p41_or_conditional(int x, int y) {
    if (y) x |= 2;
    __asm__ volatile(".byte %c0" : : "i"(x));
    return x;
}
int p41_or_conditional_probe(int y) { return p41_or_conditional(0, y); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p41_bounded_or_controlflow_runtime.c"}
/* P41: a one-sided bounded-bit proof survives OR, but a speculative inline
 * parameter *entry* fact must not survive conditional, nested, or loop writes.
 * The source parameter is constant at the callsite, the control flag is not. */
__attribute__((always_inline)) static inline int p41_or_cond(int x, int y) {
    if (y) x |= 2;
    return x;
}

__attribute__((always_inline)) static inline int p41_or_nested(int x, int y) {
    if (y) {
        x |= 2;
        if (y > 2) x |= 4;
    }
    return x;
}

__attribute__((always_inline)) static inline int p41_or_loop(int x, int y) {
    int i = 0;
    while (i < y) {
        x |= 2;
        ++i;
    }
    return x;
}

int main(int argc, char **argv) {
    int y = argc - 1;
    int expected_nested;
    (void)argv;
    expected_nested = y <= 0 ? 1 : y <= 2 ? 3 : 7;
    return p41_or_cond(0, y) != (y ? 2 : 0) ||
           p41_or_cond(1, y) != (y ? 3 : 1) ||
           p41_or_nested(1, y) != expected_nested ||
           p41_or_loop(0, y) != (y > 0 ? 2 : 0);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p41_bounded_or_live_immediate.c"}
/* P41: a specialization fact describes the function entry, not a parameter
 * after a compound assignment. Even when a bounded-bit analysis retains
 * useful information, the old immediate fact must be invalidated. */
__attribute__((always_inline)) static inline int p41_or_live(int x) {
    x |= 2;
    __asm__ volatile(".byte %c0" : : "i"(x));
    return x;
}

int p41_or_live_probe(void) { return p41_or_live(0); }

extern int p41_unknown(int);
__attribute__((always_inline)) static inline int p41_or_live_barrier(int x, int y) {
    x |= 2;
    if (y) p41_unknown(x);
    __asm__ volatile(".byte %c0" : : "i"(x));
    return x;
}
int p41_or_barrier_probe(int z) { return p41_or_live_barrier(0, z); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p41_volatile_record_member.c"}
/* P41 regression: member cv-qualification is a source-type property. */
struct P41Counter {
    volatile unsigned int embedded;
    unsigned int plain;
};

struct P41Outer {
    struct P41Counter child;
    unsigned int *pointer;
    unsigned int array[2];
    unsigned int bits:5;
};

volatile struct P41Counter p41_global;

unsigned int p41_read_global_twice(void) {
    return p41_global.plain + p41_global.plain;
}

unsigned int p41_read_pointer_twice(volatile struct P41Counter *pointer) {
    return pointer->plain + pointer->plain;
}

unsigned int p41_read_nested_pointer_twice(volatile struct P41Counter *pointer) {
    return pointer->embedded + pointer->plain;
}

void p41_store_pointer(volatile struct P41Counter *pointer, unsigned int value) {
    pointer->plain = value;
}

void p41_discard_volatile_member(volatile struct P41Counter *pointer) {
    pointer->plain;
}

int p41_volatile_member_generic(volatile struct P41Counter *pointer) {
    return _Generic(&pointer->plain, volatile unsigned int *: 1, default: 0);
}

int p41_nested_record_generic(volatile struct P41Outer *outer) {
    return _Generic(&outer->child.plain, volatile unsigned int *: 1, default: 0);
}

int p41_pointer_field_generic(volatile struct P41Outer *outer) {
    return _Generic(&outer->pointer, unsigned int *volatile *: 1, default: 0);
}

int p41_array_element_generic(volatile struct P41Outer *outer) {
    return _Generic(&outer->array[0], volatile unsigned int *: 1, default: 0);
}

int p41_const_volatile_member_generic(const volatile struct P41Counter *pointer) {
    return _Generic(&pointer->plain, const volatile unsigned int *: 1, default: 0);
}

unsigned int p41_read_bitfield(volatile struct P41Outer *outer) {
    return outer->bits;
}

#ifdef P41_NATIVE_MAIN
int main(void) {
    volatile struct P41Counter counter;
    volatile struct P41Outer outer;
    counter.plain = 3;
    counter.embedded = 9;
    outer.bits = 17;
    outer.child.plain = 7;
    outer.array[0] = 11;
    if (p41_read_pointer_twice(&counter) != 6U ||
        p41_read_nested_pointer_twice(&counter) != 12U ||
        p41_volatile_member_generic(&counter) != 1 ||
        p41_nested_record_generic(&outer) != 1 ||
        p41_pointer_field_generic(&outer) != 1 ||
        p41_array_element_generic(&outer) != 1 ||
        p41_const_volatile_member_generic(&counter) != 1 ||
        p41_read_bitfield(&outer) != 17U) {
        return 1;
    }
    p41_store_pointer(&counter, 5U);
    return counter.plain == 5U ? 0 : 2;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p43_direct_record_callsite.c"}
/* A single source FunctionBody supplies three independent specialization
 * dimensions to Record-returning direct CALLs.  The leaf CALL is a shared
 * source ExpressionId, even when its enclosing middle is cloned for callers
 * in different sections.  The caller owns the executable CALL identity. */
struct P43Record {
    long value;
};

static int p43_first = 11;
static int p43_second = 22;
static int p43_third = 33;

static __attribute__((always_inline)) inline struct P43Record
p43_record_leaf(int *pointer, int delta, _Bool select_first) {
    struct P43Record result;
    result.value = (long)*pointer +
        (__builtin_constant_p(delta) ? (long)delta : 900L) +
        (select_first ? 100L : 200L);
    return result;
}

static __attribute__((always_inline)) inline struct P43Record
p43_record_middle(int *pointer, int delta, _Bool select_first) {
    return p43_record_leaf(pointer, delta, select_first);
}

__attribute__((section(".head.text")))
long p43_record_head(void) {
    struct P43Record result = p43_record_middle(&p43_first, 3, 1);
    return result.value;
}

__attribute__((section(".init.text")))
long p43_record_init(void) {
    struct P43Record result = p43_record_middle(&p43_second, 5, 0);
    return result.value;
}

__attribute__((section(".head.text")))
long p43_record_head_other(void) {
    struct P43Record result = p43_record_middle(&p43_third, 7, 1);
    return result.value;
}

__attribute__((section(".head.text")))
long p43_record_head_reuse(void) {
    struct P43Record result = p43_record_middle(&p43_first, 3, 1);
    return result.value;
}

/* Runtime values must not inherit an unrelated caller's entry facts. */
static long p43_record_dynamic(int *pointer, int delta, int flag) {
    struct P43Record result = p43_record_middle(pointer, delta, (_Bool)flag);
    return result.value;
}

int main(void) {
    volatile int dynamic_delta = 5;
    volatile int dynamic_flag = 1;
    if (p43_record_head() != 114L) return 11;
    if (p43_record_init() != 227L) return 12;
    if (p43_record_head_other() != 140L) return 13;
    if (p43_record_head_reuse() != 114L) return 14;
    if (p43_record_dynamic(&p43_third, dynamic_delta, dynamic_flag) != 1033L)
        return 15;
    return 0;
}
