@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p43_inline_call_plan_identity.c"}
/* P43: source CALL IDs must remain canonical even when several AST passes
 * successively choose a clone for the same expression. The transient plan
 * is discarded before Core lowering, which independently resolves the
 * executable callee from the active caller's proven facts. */
#include "compiler/inline_specialize_common.h"

#include <stdio.h>

#define CHECK(test, id) do { if (!(test)) return (id); } while (0)

/* The common unit also provides the source-owner worklist.  This small
 * contract test deliberately does not construct an owner index. */
bool minic_perf_program_build_expression_source_owners(
    const MinicC0Program *program, size_t function_limit,
    MinicFunctionId *owners, size_t owner_count) {
    (void)program;
    (void)function_limit;
    (void)owners;
    (void)owner_count;
    return false;
}

static int test_call_plan(void) {
    MinicFunction functions[7] = {0};
    MinicExpression expressions[6] = {0};
    MinicC0Program program = {0};
    MinicInlineCallPlan plan = {0};

    program.functions = functions;
    program.function_count = 3U;
    program.expressions = expressions;
    program.expression_count = 3U;

    expressions[0].kind = MINIC_EXPRESSION_CALL;
    expressions[0].value.call.function_id = 0U;
    expressions[1].kind = MINIC_EXPRESSION_INTEGER;
    expressions[2].kind = MINIC_EXPRESSION_CALL;
    expressions[2].value.call.function_id = 1U;

    CHECK(minic_inline_call_plan_initialize(&plan, &program), 1);
    CHECK(!minic_inline_call_plan_initialize(&plan, &program), 2);
    CHECK(minic_inline_call_plan_get(&plan, 0U) == 0U, 3);
    CHECK(minic_inline_call_plan_get(&plan, 2U) == 1U, 4);
    CHECK(minic_inline_call_plan_get(&plan, 1U) == MINIC_FUNCTION_INVALID, 5);

    /* Clones appended by successive integer/symbolic/boolean passes. */
    program.function_count = 6U;
    CHECK(minic_inline_call_plan_set(&plan, 2U, 3U), 6);
    CHECK(minic_inline_call_plan_set(&plan, 0U, 4U), 7);
    CHECK(minic_inline_call_plan_set(&plan, 2U, 5U), 8);
    CHECK(minic_inline_call_plan_get(&plan, 0U) == 4U, 9);
    CHECK(minic_inline_call_plan_get(&plan, 2U) == 5U, 10);
    CHECK(expressions[0].value.call.function_id == 0U, 11);
    CHECK(expressions[2].value.call.function_id == 1U, 12);

    /* A later-cloned FunctionBody appends a previously nonexistent CALL.
     * The plan must expand without losing earlier selections or modifying
     * the just-appended canonical expression. */
    expressions[3].kind = MINIC_EXPRESSION_CALL;
    expressions[3].value.call.function_id = 2U;
    expressions[4].kind = MINIC_EXPRESSION_INTEGER;
    expressions[5].kind = MINIC_EXPRESSION_CALL;
    expressions[5].value.call.function_id = 0U;
    program.expression_count = 6U;
    CHECK(minic_inline_call_plan_get(&plan, 3U) == 2U, 13);
    CHECK(minic_inline_call_plan_get(&plan, 5U) == 0U, 14);
    CHECK(minic_inline_call_plan_set(&plan, 5U, 3U), 15);
    CHECK(minic_inline_call_plan_get(&plan, 0U) == 4U, 16);
    CHECK(minic_inline_call_plan_get(&plan, 2U) == 5U, 17);
    CHECK(minic_inline_call_plan_get(&plan, 3U) == 2U, 18);
    CHECK(minic_inline_call_plan_get(&plan, 5U) == 3U, 19);
    CHECK(expressions[5].value.call.function_id == 0U, 20);

    CHECK(!minic_inline_call_plan_set(&plan, 1U, 3U), 21);
    CHECK(!minic_inline_call_plan_set(&plan, 6U, 3U), 22);
    CHECK(!minic_inline_call_plan_set(&plan, 3U, 7U), 23);
    CHECK(minic_inline_call_plan_get(&plan, 6U) == MINIC_FUNCTION_INVALID, 24);
    CHECK(expressions[0].value.call.function_id == 0U &&
          expressions[2].value.call.function_id == 1U &&
          expressions[3].value.call.function_id == 2U &&
          expressions[5].value.call.function_id == 0U, 25);

    minic_inline_call_plan_destroy(&plan);
    CHECK(plan.program == NULL && plan.selected == NULL &&
          plan.selected_count == 0U, 26);
    CHECK(minic_inline_call_plan_get(&plan, 0U) == MINIC_FUNCTION_INVALID, 27);
    CHECK(minic_inline_call_plan_initialize(&plan, &program), 28);
    CHECK(minic_inline_call_plan_get(&plan, 0U) == 0U &&
          minic_inline_call_plan_get(&plan, 2U) == 1U &&
          minic_inline_call_plan_get(&plan, 5U) == 0U, 29);
    minic_inline_call_plan_destroy(&plan);
    return 0;
}

int main(void) {
    int result = test_call_plan();
    if (result != 0) {
        fprintf(stderr, "P43_INLINE_CALL_PLAN_IDENTITY=FAIL test=%d\n", result);
        return result;
    }
    puts("P43_INLINE_CALL_PLAN_IDENTITY=PASS canonical_source=PASS clone_appends=PASS");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p44_inline_asm_mutating_symbolic.c"}
/* P44: GNU `i` must preserve a known pointer-symbol fact even when a distinct
 * read/write ASM output escapes the pointer parameter's lvalue. The source
 * FunctionBody is shared by inline variants; producing the symbolic text
 * before invalidating mutable source locals is essential. */
static int p44_mutating_symbolic_slots[8] = { 11, 22, 33, 44 };

#ifdef P44_DIRECT_OUTPUT_LOCAL
#define P44_OUTPUT_LVALUE(p) (p)
#else
#define P44_OUTPUT_LVALUE(p) (*(&(p)))
#endif

static __attribute__((always_inline)) inline int
p44_inline_mutating_symbolic(int *p) {
    __asm__ volatile(".pushsection .rodata\n\t"
                     ".quad %c1\n\t"
                     ".popsection"
                     : "+r"(P44_OUTPUT_LVALUE(p)) : "i"(p));
    return 0;
}

int main(void) {
    return p44_inline_mutating_symbolic(p44_mutating_symbolic_slots);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p44_live_asm_reachability.c"}
/* P44: only an *emitted* GNU inline ASM operand can keep its static
 * relocation target alive. A dead C function or dead Core CFG branch is
 * not a linker-visible root merely because the parser saw an "i" operand.
 * The live producer must retain its static function and object on every
 * admitted target, including in a GNU-linked x86 ELF executable. */
extern int p44_dead_unresolved(void);

static int p44_dead_fn(void) __attribute__((unused));
static int p44_dead_fn(void) {
    return p44_dead_unresolved();
}

static int p44_dead_object __attribute__((unused)) = 17;

static void p44_dead_asm_owner(void) __attribute__((unused));
static void p44_dead_asm_owner(void) {
    __asm__ volatile(".pushsection .rodata\n\t"
                     ".quad %c0\n\t"
                     ".quad %c1\n\t"
                     ".popsection" : :
                     "i"(p44_dead_fn), "i"(&p44_dead_object));
}

static int p44_dead_branch_fn(void) __attribute__((unused));
static int p44_dead_branch_fn(void) {
    return p44_dead_unresolved();
}

static int p44_live_fn(void) __attribute__((unused));
static int p44_live_fn(void) {
    return 29;
}

static int p44_live_object __attribute__((unused)) = 31;
static unsigned char p44_live_bytes[16] __attribute__((unused));

int main(void) {
    if (0) {
        __asm__ volatile(".pushsection .rodata\n\t"
                         ".quad %c0\n\t"
                         ".popsection" : : "i"(p44_dead_branch_fn));
    }
    __asm__ volatile(".pushsection .rodata\n\t"
                     ".quad %c0\n\t"
                     ".quad %c1\n\t"
                     ".popsection" : :
                     "i"(p44_live_fn), "i"(&p44_live_object));
    /* The source-symbol edge must survive both simple byte offsets and
     * nested expression wrappers; an ASM operand is not necessarily a
     * direct FUNCTION/GLOBAL_OBJECT AST node. */
    __asm__ volatile(".pushsection .rodata\n\t"
                     ".quad %c0\n\t"
                     ".quad %c1\n\t"
                     ".popsection" : :
                     "i"((char *)&p44_live_bytes + 4),
                     "i"(((char *)&p44_live_bytes[0]) + (2 + 6)));
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p46_oracle_aggregate_copy.c"}
/* P46: compare complete aggregate byte images against GNU C, using sizes
 * that cross the x86 machine copy threshold, byte tails, and page bounds.
 * All cases have distinct source/destination storage and a self-copy. */
extern int puts(const char *);

#define P46_CASE(N)                                                          \
    struct P46Blob_##N { unsigned char bytes[N]; };                          \
    struct P46Frame_##N {                                                     \
        unsigned long before;                                                 \
        struct P46Blob_##N blob;                                              \
        unsigned long after;                                                  \
    };                                                                        \
    static int p46_case_##N(void) {                                           \
        struct P46Frame_##N source;                                           \
        struct P46Frame_##N destination;                                      \
        unsigned long index;                                                  \
        source.before = 0x12345678UL;                                        \
        source.after = 0x87654321UL;                                         \
        destination.before = 0x10203040UL;                                   \
        destination.after = 0x50607080UL;                                    \
        for (index = 0; index < N; ++index) {                                \
            source.blob.bytes[index] =                                        \
                (unsigned char)((index * 17UL + N) & 255UL);                  \
            destination.blob.bytes[index] = 0;                               \
        }                                                                     \
        destination.blob = source.blob;                                       \
        source.blob.bytes[0] ^= 0x5aU;                                       \
        destination.blob = destination.blob;                                  \
        for (index = 0; index < N; ++index) {                                \
            if (destination.blob.bytes[index] !=                              \
                (unsigned char)((index * 17UL + N) & 255UL))                  \
                return 1;                                                     \
        }                                                                     \
        if (source.before != 0x12345678UL ||                                \
            source.after != 0x87654321UL ||                                 \
            destination.before != 0x10203040UL ||                           \
            destination.after != 0x50607080UL)                              \
            return 2;                                                         \
        return 0;                                                             \
    }

P46_CASE(1)
P46_CASE(3)
P46_CASE(7)
P46_CASE(8)
P46_CASE(9)
P46_CASE(2048)
P46_CASE(4096)
P46_CASE(4097)
P46_CASE(16384)

int main(void) {
    if (p46_case_1() || p46_case_3() || p46_case_7() ||
        p46_case_8() || p46_case_9() || p46_case_2048() ||
        p46_case_4096() || p46_case_4097() || p46_case_16384())
        return 42;
    puts("P46_AGGREGATE_COPY=PASS");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p46_x86_head_aggregate.c"}
/* MC-076: original C source for GCC and MiniC head physical-address roles.
 * Move the compiled .head.text together with its .head.data and execute the
 * displaced copy: RIP-relative record accesses follow the displacement,
 * while link-VMA pointer->integer round-trips must be rebased at memory use.
 */
struct P46Pair {
    unsigned long lo;
    unsigned long hi;
};

struct P46Pair x86_p46_head_src
    __attribute__((section(".head.data"))) = {0x37195UL, 0xeca264UL};
struct P46Pair x86_p46_head_dst
    __attribute__((section(".head.data"))) = {0x11UL, 0x22UL};

__attribute__((section(".head.text"), noinline, used))
void x86_p46_head_copy_direct(void) {
    x86_p46_head_dst = x86_p46_head_src;
}

__attribute__((section(".head.text"), noinline, used))
void x86_p46_head_copy_cast(void) {
    *(struct P46Pair *)(unsigned long)&x86_p46_head_dst =
        *(struct P46Pair *)(unsigned long)&x86_p46_head_src;
}

__attribute__((section(".head.text"), noinline, used))
void x86_p46_head_copy_load(void) {
    struct P46Pair value = x86_p46_head_src;
    x86_p46_head_dst = value;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p46_x86_head_aggregate_driver.c"}
#define _GNU_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>

struct P46Pair { unsigned long lo, hi; };
extern struct P46Pair x86_p46_head_src;
extern struct P46Pair x86_p46_head_dst;
extern void x86_p46_head_copy_direct(void);
extern void x86_p46_head_copy_cast(void);
extern void x86_p46_head_copy_load(void);

static int check_displaced(void (*fn)(void)) {
    const uintptr_t code = (uintptr_t)(void *)fn;
    const uintptr_t src = (uintptr_t)&x86_p46_head_src;
    const uintptr_t dst = (uintptr_t)&x86_p46_head_dst;
    const uintptr_t begin = code < src ? (code < dst ? code : dst)
                                       : (src < dst ? src : dst);
    const uintptr_t end_code = code + 1024U;
    const uintptr_t end_src = src + sizeof(struct P46Pair);
    const uintptr_t end_dst = dst + sizeof(struct P46Pair);
    const uintptr_t end1 = end_code > end_src ? end_code : end_src;
    const uintptr_t end = end1 > end_dst ? end1 : end_dst;
    const size_t span = (size_t)(end - begin);
    unsigned char *image;
    uintptr_t offset_code;
    void (*displaced)(void);
    struct P46Pair cloned_destination;
    const struct P46Pair known_source = {0x6137acUL, 0xf31b42UL};
    const struct P46Pair original_destination = {0x765432UL, 0xabcdefUL};
    int result;

    if (span > (2U << 20)) return 0;
    image = mmap(NULL, span, PROT_READ | PROT_WRITE | PROT_EXEC,
                 MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (image == MAP_FAILED) return 0;
    memcpy(image + (code - begin), (const void *)code, 1024U);
    memcpy(image + (src - begin), &known_source, sizeof(known_source));
    memcpy(image + (dst - begin), &original_destination,
           sizeof(original_destination));

    x86_p46_head_dst = original_destination;
    offset_code = (uintptr_t)(image + (code - begin));
    memcpy(&displaced, &offset_code, sizeof(displaced));
    displaced();
    memcpy(&cloned_destination, image + (dst - begin),
           sizeof(cloned_destination));
    result = cloned_destination.lo == known_source.lo &&
             cloned_destination.hi == known_source.hi &&
             x86_p46_head_dst.lo == original_destination.lo &&
             x86_p46_head_dst.hi == original_destination.hi;
    if (munmap(image, span) != 0) return 0;
    return result;
}

int main(void) {
    int direct = check_displaced(x86_p46_head_copy_direct);
    int cast = check_displaced(x86_p46_head_copy_cast);
    int load = check_displaced(x86_p46_head_copy_load);
    printf("HEAD_AGGREGATE displace_direct=%d displace_cast=%d displace_load=%d\n",
           direct, cast, load);
    return direct && cast && load ? 0 : 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p48_x86_head_local_provenance.c"}
/* MC-076: all heads use the SAME early-boot C source as the GNU controls.
 * The code and .head.data objects are moved together at runtime.  Pointer
 * storage in a local Core object must not erase the distinction between the
 * displaced physical dereference and the original link-time numeric VMA.
 * No C-source or target flag is used to mark the desired address role. */

volatile unsigned long p48_head_cells[3]
    __attribute__((section(".head.data"))) = {0x11UL, 0x22UL, 0x33UL};
volatile unsigned long p48_head_other
    __attribute__((section(".head.data"))) = 0x44UL;

/* GCC -O2 independently produces PC-relative store + link-VMA return. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_baseline(unsigned long value, unsigned long selector) {
    (void)selector;
    p48_head_cells[0] = value;
    return (unsigned long)&p48_head_cells[0];
}

/* Deliberately non-volatile local pointer: GCC -O2 can coalesce this into a
 * PC-relative physical store and absolute link-VMA return.  MiniC still
 * has to preserve the same two observable behaviors. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_plain_local(unsigned long value,
                                   unsigned long selector) {
    volatile unsigned long *pointer = &p48_head_cells[1];
    (void)selector;
    *pointer = value;
    return (unsigned long)pointer;
}

/* Volatile pointer OBJECT storage forces a genuine pointer STORE/LOAD. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_local(unsigned long value, unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_head_cells[0];
    (void)selector;
    *pointer = value;
    return (unsigned long)pointer;
}

/* Transport through two independent local pointer slots.  The pointer
 * offset is runtime-variable, followed by pointer->integer->pointer; the
 * returned integer must still be a link VMA including that same offset. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_roundtrip(unsigned long value, unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_head_cells[0];
    unsigned long numeric = (unsigned long)(pointer + selector);
    volatile unsigned long *volatile roundtrip =
        (volatile unsigned long *)numeric;
    *roundtrip = value;
    return (unsigned long)roundtrip;
}

/* Two control-flow edges agree on the SAME symbol but select different
 * elements.  A proof may retain the shared origin, not a fixed offset. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_same_origin_branch(unsigned long value,
                                          unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_head_cells[0];
    if (selector != 0UL)
        pointer = &p48_head_cells[1];
    *pointer = value;
    return (unsigned long)pointer;
}

/* A pointer lives in an addressable record field.  This is a distinct Core
 * field-address LOAD/STORE path, not the scalar local-slot fast path. */
struct P48PointerRecord {
    unsigned long tag;
    volatile unsigned long *pointer;
};

__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_record_field(unsigned long value,
                                    unsigned long selector) {
    struct P48PointerRecord record;
    (void)selector;
    record.tag = 0x17UL;
    record.pointer = &p48_head_cells[2];
    *record.pointer = value;
    return (unsigned long)record.pointer;
}

/* A fixed result-address inside __builtin_add_overflow is a real machine
 * memory writer, even though it is not a Core STORE instruction.  Use a
 * runtime selector (zero in this particular oracle) to keep the overflow
 * operation live, then verify the displaced *result address* was written. */
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_head_overflow_address(unsigned long value,
                                        unsigned long selector) {
    unsigned int carry = __builtin_add_overflow(
        value, selector, (unsigned long *)&p48_head_cells[2]);
    return carry ? 0UL : (unsigned long)&p48_head_cells[2];
}

/* Ordinary .text runs at its linked address and must not inherit the early
 * physical/link-VMA conversion.  The PIE variant uses this same source. */
__attribute__((noinline, used))
unsigned long p48_normal_local(unsigned long value, unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_head_cells[0];
    (void)selector;
    *pointer = value;
    return (unsigned long)pointer;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p48_x86_head_local_provenance_driver.c"}
#define _GNU_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>

extern volatile unsigned long p48_head_cells[3];
extern volatile unsigned long p48_head_other;

typedef unsigned long (*P48HeadFunction)(unsigned long, unsigned long);
extern unsigned long p48_head_baseline(unsigned long, unsigned long);
extern unsigned long p48_head_plain_local(unsigned long, unsigned long);
extern unsigned long p48_head_local(unsigned long, unsigned long);
extern unsigned long p48_head_roundtrip(unsigned long, unsigned long);
extern unsigned long p48_head_same_origin_branch(unsigned long, unsigned long);
extern unsigned long p48_head_record_field(unsigned long, unsigned long);
extern unsigned long p48_head_overflow_address(unsigned long, unsigned long);
extern unsigned long p48_normal_local(unsigned long, unsigned long);

/* Match the P46 displaced-native oracle: one physical image of code and the
 * entire head-data symbol region, relocated by the SAME delta.  A dereference
 * through an absolute linked VMA writes the original object instead of the
 * cloned physical object, and therefore fails even if ordinary native
 * execution at the linked address would have passed. */
static int p48_check_displaced(const char *name, P48HeadFunction fn,
                              unsigned long value, unsigned long selector,
                              int written_index, int numeric_index) {
    enum { P48_COPIED_FUNCTION_BYTES = 1024 };
    const unsigned long initial_cells[3] = {
        0x128c31UL, 0x637a45UL, 0x9abc51UL
    };
    const unsigned long initial_other = 0xeeca72UL;
    const uintptr_t code = (uintptr_t)(void *)fn;
    const uintptr_t cells = (uintptr_t)(const void *)p48_head_cells;
    const uintptr_t other = (uintptr_t)(const void *)&p48_head_other;
    const uintptr_t begin = code < cells ? (code < other ? code : other)
                                         : (cells < other ? cells : other);
    const uintptr_t code_end = code + P48_COPIED_FUNCTION_BYTES;
    const uintptr_t cells_end = cells + sizeof(initial_cells);
    const uintptr_t other_end = other + sizeof(initial_other);
    const uintptr_t end_a = code_end > cells_end ? code_end : cells_end;
    const uintptr_t end = end_a > other_end ? end_a : other_end;
    const size_t span = (size_t)(end - begin);
    unsigned char *image;
    unsigned long cloned_cells[3] = {0UL, 0UL, 0UL};
    unsigned long cloned_other = 0UL;
    uintptr_t relocated_address;
    P48HeadFunction relocated;
    unsigned long actual;
    uintptr_t expected_numeric;
    int ok = 1;
    size_t i;

    if (span == 0U || span > (4U << 20)) {
        fprintf(stderr, "P48_DISPLACED=FAIL %s unsupported_span=%zu\n",
                name, span);
        return 0;
    }
    image = mmap(NULL, span, PROT_READ | PROT_WRITE | PROT_EXEC,
                 MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (image == MAP_FAILED) {
        fprintf(stderr, "P48_DISPLACED=FAIL %s mmap\n", name);
        return 0;
    }
    memcpy(image + (code - begin), (const void *)(uintptr_t)code,
           P48_COPIED_FUNCTION_BYTES);
    memcpy(image + (cells - begin), initial_cells, sizeof(initial_cells));
    memcpy(image + (other - begin), &initial_other, sizeof(initial_other));
    for (i = 0U; i < 3U; ++i) p48_head_cells[i] = initial_cells[i];
    p48_head_other = initial_other;

    relocated_address = (uintptr_t)(image + (code - begin));
    memcpy(&relocated, &relocated_address, sizeof(relocated));
    actual = relocated(value, selector);
    memcpy(cloned_cells, image + (cells - begin), sizeof(cloned_cells));
    memcpy(&cloned_other, image + (other - begin), sizeof(cloned_other));

    expected_numeric = numeric_index == 3
        ? other : cells + (size_t)numeric_index * sizeof(unsigned long);
    if (actual != (unsigned long)expected_numeric) ok = 0;
    for (i = 0U; i < 3U; ++i) {
        if (cloned_cells[i] !=
            (written_index == (int)i ? value : initial_cells[i]) ||
            p48_head_cells[i] != initial_cells[i])
            ok = 0;
    }
    if (cloned_other != (written_index == 3 ? value : initial_other) ||
        p48_head_other != initial_other) ok = 0;
    if (!ok)
        fprintf(stderr,
                "P48_DISPLACED=FAIL %s returned=0x%lx expected=0x%lx "
                "clone0=0x%lx clone1=0x%lx clone2=0x%lx other=0x%lx\n",
                name, actual, (unsigned long)expected_numeric,
                cloned_cells[0], cloned_cells[1], cloned_cells[2],
                cloned_other);
    if (munmap(image, span) != 0) ok = 0;
    return ok;
}

static int p48_check_normal(void) {
    unsigned long expected = (unsigned long)&p48_head_cells[0];
    const unsigned long value = 0x72ca32UL;
    p48_head_cells[0] = 0x5151UL;
    return p48_normal_local(value, 0UL) == expected &&
           p48_head_cells[0] == value;
}

int main(void) {
#ifdef P48_NATIVE_ONLY
    const int normal = p48_check_normal();
    printf("P48_HEAD_LOCAL pic_normal=%d\n", normal);
    return normal ? 0 : 42;
#else
    /* GCC -O2 is a genuine displaced positive reference for the baseline
     * and plain local.  GNU -O0's volatile local pointer store transports
     * an absolute VMA, so it is NOT a displaced golden for harder cases. */
    const int baseline = p48_check_displaced(
        "baseline", p48_head_baseline, 0x17ae31UL, 0UL, 0, 0);
    const int plain = p48_check_displaced(
        "plain_local", p48_head_plain_local, 0x18a25cUL, 0UL, 1, 1);
    const int normal = p48_check_normal();
#ifdef P48_GNU_GOLDEN
    printf("P48_HEAD_LOCAL gnu_baseline=%d gnu_plain_local=%d normal=%d\n",
           baseline, plain, normal);
    return baseline && plain && normal ? 0 : 42;
#else
    const int local = p48_check_displaced(
        "local", p48_head_local, 0x19be43UL, 0UL, 0, 0);
    const int roundtrip_zero = p48_check_displaced(
        "roundtrip_zero", p48_head_roundtrip, 0x6dabc1UL, 0UL, 0, 0);
    const int roundtrip_one = p48_check_displaced(
        "roundtrip_one", p48_head_roundtrip, 0x6dabc2UL, 1UL, 1, 1);
    const int branch_zero = p48_check_displaced(
        "branch_zero", p48_head_same_origin_branch, 0x71be50UL, 0UL, 0, 0);
    const int branch_one = p48_check_displaced(
        "branch_one", p48_head_same_origin_branch, 0x71be51UL, 1UL, 1, 1);
    const int record = p48_check_displaced(
        "record_field", p48_head_record_field, 0xc1a713UL, 0UL, 2, 2);
    const int overflow = p48_check_displaced(
        "overflow_address", p48_head_overflow_address,
        0x19ab34UL, 0UL, 2, 2);
    printf("P48_HEAD_LOCAL baseline=%d plain=%d local=%d roundtrip0=%d "
           "roundtrip1=%d branch0=%d branch1=%d record=%d overflow=%d "
           "normal=%d\n",
           baseline, plain, local, roundtrip_zero, roundtrip_one,
           branch_zero, branch_one, record, overflow, normal);
    return baseline && plain && local && roundtrip_zero && roundtrip_one &&
           branch_zero && branch_one && record && overflow && normal ? 0 : 42;
#endif
#endif
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p48_x86_head_local_uncertain.c"}
/* MC-076 P48 negative admission: two distinct unproved local-pointer
 * origins, each also used in a function with a direct physical data store.
 * A target must never silently assign one global's physical/VMA policy to
 * a pointer after conflicting writes or an address-escaping local slot.
 * `P48_CASE_CONFLICT` and `P48_CASE_ALIAS` are compiled independently so a
 * rejection in one cannot hide accidental acceptance of the other. */

volatile unsigned long p48_uncertain_cells[2]
    __attribute__((section(".head.data"))) = {0x11UL, 0x22UL};
volatile unsigned long p48_uncertain_other
    __attribute__((section(".head.data"))) = 0x33UL;

#ifdef P48_CASE_CONFLICT
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_uncertain_conflict(unsigned long value,
                                     unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_uncertain_cells[0];
    if (selector != 0UL)
        pointer = &p48_uncertain_other;
    p48_uncertain_cells[0] = value;
    return (unsigned long)pointer;
}
#endif

#ifdef P48_CASE_ALIAS
__attribute__((section(".head.text"), noinline, used))
unsigned long p48_uncertain_escaped_alias(unsigned long value,
                                          unsigned long selector) {
    volatile unsigned long *volatile pointer = &p48_uncertain_cells[0];
    volatile unsigned long *volatile *alias = &pointer;
    if (selector != 0UL)
        *alias = &p48_uncertain_other;
    p48_uncertain_cells[0] = value;
    return (unsigned long)pointer;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p49_x86_head_crosscall_driver.c"}
#define _GNU_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>

extern volatile unsigned long p49_head_global;
extern unsigned long p49_head_entry(unsigned long);
#ifdef P51_NESTED_RETURN
extern volatile unsigned long *p51_head_wrapper(volatile unsigned long *);
#endif
#ifdef P49_POINTER_RETURN
extern volatile unsigned long *p49_head_helper(volatile unsigned long *);
#else
extern unsigned long p49_head_helper(volatile unsigned long *);
#endif

typedef unsigned long (*P49Entry)(unsigned long);

int main(void) {
    enum { copied_code = 256 };
    const uintptr_t entry = (uintptr_t)(void *)p49_head_entry;
    const uintptr_t helper = (uintptr_t)(void *)p49_head_helper;
#ifdef P51_NESTED_RETURN
    const uintptr_t wrapper = (uintptr_t)(void *)p51_head_wrapper;
#endif
    const uintptr_t data = (uintptr_t)(const void *)&p49_head_global;
    uintptr_t begin = entry < helper ? entry : helper;
    uintptr_t end = entry > helper ? entry : helper;
    const unsigned long initial = 0x2211UL, value = 0x45fa72UL;
    unsigned char *image;
    unsigned long cloned_value = 0UL, actual;
    uintptr_t destination;
    P49Entry cloned_entry;
    int ok;
#ifdef P51_NESTED_RETURN
    if (wrapper < begin) begin = wrapper;
    if (wrapper > end) end = wrapper;
#endif
    if (data < begin) begin = data;
    end += copied_code;
    if (data + sizeof(initial) > end) end = data + sizeof(initial);
    if (end <= begin || end - begin > (4U << 20)) return 3;
    image = mmap(NULL, end - begin, PROT_READ | PROT_WRITE | PROT_EXEC,
                 MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (image == MAP_FAILED) return 4;
    memcpy(image + (entry - begin), (void *)entry, copied_code);
    memcpy(image + (helper - begin), (void *)helper, copied_code);
#ifdef P51_NESTED_RETURN
    memcpy(image + (wrapper - begin), (void *)wrapper, copied_code);
#endif
    memcpy(image + (data - begin), &initial, sizeof(initial));
    p49_head_global = initial;
    destination = (uintptr_t)(image + (entry - begin));
    memcpy(&cloned_entry, &destination, sizeof(cloned_entry));
    actual = cloned_entry(value);
    memcpy(&cloned_value, image + (data - begin), sizeof(cloned_value));
    ok = actual == data && cloned_value == value &&
         p49_head_global == initial;
    printf("P49_HEAD_CROSSCALL=%s returned=0x%lx expected_vma=0x%lx "
           "cloned=0x%lx original=0x%lx\n",
           ok ? "PASS" : "FAIL", actual, (unsigned long)data,
           cloned_value, p49_head_global);
    return munmap(image, end - begin) == 0 && ok ? 0 : 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p49_x86_head_crosscall_provenance.c"}
/* MC-076/P49: GCC and MiniC must see exactly this same source.  Direct
 * stores in .head.text use relocated physical memory; a helper's numeric
 * pointer result instead denotes the original ELF link VMA. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_helper(volatile unsigned long *pointer) {
    return (unsigned long)pointer;
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    p49_head_global = value;
    return p49_head_helper(&p49_head_global);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p49_x86_head_physical_helper.c"}
/* Distinct positive admission: a head helper physically dereferences the
 * pointer and never treats it as a numeric link-VMA. Do not reject all
 * pointer arguments merely because a global is also directly accessed. */
volatile unsigned long p49_physical_global
    __attribute__((section(".head.data"))) = 0x12UL;

__attribute__((section(".head.text"), noinline, used))
void p49_physical_helper(volatile unsigned long *pointer,
                         unsigned long value) {
    *pointer = value;
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_physical_entry(unsigned long value) {
    p49_physical_global = value;
    p49_physical_helper(&p49_physical_global, value + 1UL);
    return p49_physical_global;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p49_x86_head_return_alias.c"}
/* MC-076/P49: a head helper returns the original pointer unchanged and
 * only its caller observes the numeric link VMA.  The callee contains no
 * pointer-to-integer cast, so a callee-only provenance check misses it. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

__attribute__((section(".head.text"), noinline, used))
volatile unsigned long *p49_head_helper(volatile unsigned long *pointer) {
    return pointer;
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    p49_head_global = value;
    return (unsigned long)p49_head_helper(&p49_head_global);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p50_x86_head_return_local_alias.c"}
/* MC-076/P50: an early-head helper returns a physical pointer.  The
 * caller first stores it in a volatile local pointer slot and only then
 * converts the reloaded pointer to a link-VMA integer.  The GNU -O2 oracle
 * must keep a real stack store/load, so a direct CALL-result-bitcast-only
 * check is insufficient.  This is an intentional fail-closed case until
 * cross-function Core pointer provenance is modeled and emitted correctly. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

__attribute__((section(".head.text"), noinline, used))
volatile unsigned long *p49_head_helper(volatile unsigned long *pointer) {
    return pointer;
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    volatile unsigned long *volatile saved;
    p49_head_global = value;
    saved = p49_head_helper(&p49_head_global);
    return (unsigned long)saved;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p51_x86_head_nested_return_alias.c"}
/* MC-076/P51: a pointer from the early-head physical global crosses two
 * direct-call ABI boundaries.  The first callee forwards it to a second
 * helper and returns that CALL result, rather than its own parameter SSA.
 * A one-level parameter-to-RETURN census misses this alias route. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

__attribute__((section(".head.text"), noinline, used))
volatile unsigned long *p49_head_helper(volatile unsigned long *pointer) {
    return pointer;
}

__attribute__((section(".head.text"), noinline, used))
volatile unsigned long *p51_head_wrapper(volatile unsigned long *pointer) {
    return p49_head_helper(pointer);
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    p49_head_global = value;
    return (unsigned long)p51_head_wrapper(&p49_head_global);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p52_x86_head_indirect_return_alias.c"}
/* MC-076/P52: the .head.text pointer-returning function is reached through
 * a volatile function-pointer slot.  Physical STORE and numeric link VMA
 * need different relocations even when the target of the INDIRECT_CALL is
 * not resolved by the Core direct-call census. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

typedef volatile unsigned long *(*P52Fn)(volatile unsigned long *);

__attribute__((section(".head.text"), noinline, used))
volatile unsigned long *p49_head_helper(volatile unsigned long *pointer) {
    return pointer;
}

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    P52Fn volatile callback = p49_head_helper;
    p49_head_global = value;
    return (unsigned long)callback(&p49_head_global);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p53_x86_head_external_return_alias.c"}
/* MC-076/P53: this early-head callee has no definition in the current
 * source module.  The compiler must not assume an external helper never
 * forwards a physically addressed global into a numeric link-VMA use. */
volatile unsigned long p49_head_global
    __attribute__((section(".head.data"))) = 0x2211UL;

extern volatile unsigned long *p53_external_identity(
    volatile unsigned long *pointer);

__attribute__((section(".head.text"), noinline, used))
unsigned long p49_head_entry(unsigned long value) {
    p49_head_global = value;
    return (unsigned long)p53_external_identity(&p49_head_global);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/p54_x86_head_external_physical_only.c"}
/* MC-076/P54 positive control: an external helper only consumes a pointer
 * for an early physical access.  No pointer return is interpreted as a
 * numerical link-VMA value.  It must remain compile-admissible. */
volatile unsigned long p54_physical_global
    __attribute__((section(".head.data"))) = 0x2211UL;

extern void p54_external_physical_writer(volatile unsigned long *pointer);

__attribute__((section(".head.text"), noinline, used))
void p54_head_entry(unsigned long value) {
    p54_physical_global = value;
    p54_external_physical_writer(&p54_physical_global);
}
