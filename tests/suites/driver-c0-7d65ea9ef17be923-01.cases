@@@ {"id": "7d65ea9ef17be923", "kind": "shared", "newline": true}
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
minic=${MINIC_CC:-"$root/build/release/bin/minic-cc"}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-aarch64-linux-kvm-debug-pmu-icc.sh", "shared": "7d65ea9ef17be923"}
#!/bin/sh

"${HOST_CC:-cc}" -E -P -std=gnu11 -x c \
    "$root/tests/compiler/c0/aarch64_linux_kvm_debug_pmu_writes.c" \
    -o "$work/debug.i"
"${HOST_CC:-cc}" -E -P -std=gnu11 -x c \
    "$root/tests/compiler/c0/aarch64_linux_kvm_icc_encoded_writes.c" \
    -o "$work/icc.i"
"$minic" --target=aarch64-linux -S "$work/debug.i" -o "$work/debug.s"
"$minic" --target=aarch64-linux -S "$work/icc.i" -o "$work/icc.s"
test "$(grep -c '^  msr ' "$work/debug.s")" -eq 134
test "$(grep -c '^  \.inst 0xd5' "$work/icc.s")" -eq 8

for reg in dbgbcr0_el1 dbgbcr15_el1 dbgwvr0_el1 dbgwvr15_el1 \
    pmevcntr0_el0 pmevcntr30_el0 pmevtyper0_el0 pmevtyper30_el0 \
    spsr_irq spsr_fiq sp_el1 dacr32_el2 ifsr32_el2 dbgvcr32_el2; do
    grep -Fq "msr $reg," "$work/debug.s"
done
for reg in '8 4' '8 7' '9 0' '9 3'; do
    set -- $reg
    crm=$1; op2=$2
    encoding=$(printf '0x%08x' "$((0xd5000000 | (3 << 19) | (12 << 12) | (crm << 8) | (op2 << 5) | 9))")
    grep -Fq ".inst $encoding" "$work/icc.s"
done
for target in x86_64 loongarch64 riscv64 riscv32; do
    if "$minic" --target="$target-linux" -S "$work/debug.i" \
        -o "$work/$target.s" >/dev/null 2>&1; then
        echo "FAIL accepted AArch64 sysreg by $target" >&2
        exit 1
    fi
done
printf '%s\n' \
    'void unknown(unsigned long long v) { asm volatile("msr dbgbvr16_el1, %x0" :: "rZ"(v)); }' \
    > "$work/unknown.i"
if "$minic" --target=aarch64-linux -S "$work/unknown.i" \
    -o "$work/unknown.s" >/dev/null 2>&1; then
    echo 'FAIL accepted out-of-range debug sysreg' >&2
    exit 1
fi
printf '%s\n' \
    'void wrong(unsigned long long v) { asm volatile("msr dbgbcr15_el1, %x0" :: "m"(v)); }' \
    > "$work/wrong.i"
if "$minic" --target=aarch64-linux -S "$work/wrong.i" \
    -o "$work/wrong.s" >/dev/null 2>&1; then
    echo 'FAIL accepted invalid GNU constraint' >&2
    exit 1
fi
printf '%s\n' 'PASS AArch64 KVM debug 64 PMUv3 62 extra 8 ICC 8 forbidden 2 target gates 4'
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-aarch64-linux-kvm-el2-pmu-sysreg.sh", "shared": "7d65ea9ef17be923"}
#!/bin/sh

"${HOST_CC:-cc}" -std=gnu11 -E -P -x c \
    "$root/tests/compiler/c0/aarch64_linux_kvm_el2_pmu_sysreg.c" \
    -o "$work/kvm-sysreg.i"
"$minic" --target=aarch64-linux -S "$work/kvm-sysreg.i" -o "$work/accepted.s"
test -s "$work/accepted.s"
for reg in par_el1 elr_el2 spsr_el2 spsr_abt spsr_und vmpidr_el2 \
    cnthctl_el2 cntvoff_el2 pmuserenr_el0 pmcntenset_el0 \
    pmcntenclr_el0 pmovsclr_el0 pmevtyper0_el0 pmevcntr0_el0 \
    pmselr_el0 pmintenset_el1 pmintenclr_el1 pmccntr_el0 \
    pmccfiltr_el0 pmcr_el0 dbgbcr15_el1 dbgbvr0_el1 CPACR_EL1; do
    grep -Fq "msr $reg," "$work/accepted.s"
done
for target in x86_64 loongarch64 riscv64 riscv32; do
    if "$minic" --target="$target-linux" -S "$work/kvm-sysreg.i" \
        -o "$work/$target.s" >/dev/null 2>&1; then
        printf '%s\n' "FAIL compiler/c0/kvm-sysreg unexpected target acceptance: $target" >&2
        exit 1
    fi
done
printf '%s\n' \
    'void rejected_reg(unsigned long long v){asm volatile("msr invented_el2, %x0"::"rZ"(v));}' \
    > "$work/unknown.i"
if "$minic" --target=aarch64-linux -S "$work/unknown.i" \
    -o "$work/unknown.s" >/dev/null 2>&1; then
    printf '%s\n' 'FAIL compiler/c0/kvm-sysreg unknown sysreg accepted' >&2
    exit 1
fi
printf '%s\n' \
    'void wrong_constraint(unsigned long long v){asm volatile("msr cntvoff_el2, %x0"::"m"(v));}' \
    > "$work/wrong-constraint.i"
if "$minic" --target=aarch64-linux -S "$work/wrong-constraint.i" \
    -o "$work/wrong-constraint.s" >/dev/null 2>&1; then
    printf '%s\n' 'FAIL compiler/c0/kvm-sysreg invalid constraint accepted' >&2
    exit 1
fi
printf '%s\n' 'PASS compiler/c0/aarch64_kvm_el2_pmu_sysreg hardware_writes=23 target-gate=4 negative=2'
@@@ end
@@@ {"head_lines": 2, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loongarch64-linux-clock-cpuid-memory.sh", "shared": "7d65ea9ef17be923"}
#!/bin/sh
# Source-qualified CPU-ID exact memory clobber, Core MachineIR and fail-closed cases.
input="$root/tests/compiler/c0/loongarch64_linux_clock_cpuid_memory.c"
cc -std=gnu11 -Wall -Wextra -Werror -fsyntax-only "$input"
cc -E -P -x c "$input" -o "$work/cpuid.i"
"$minic" --target=loongarch64-linux -mabi=lp64s -S "$work/cpuid.i" -o "$work/cpuid.s"
grep -Eq '^[[:space:]]+rdtime[.]d[[:space:]]+\$zero,[[:space:]]*\$t0$' "$work/cpuid.s"
for bad in missing-memory extra-clobber invalid-template; do
    case "$bad" in
        missing-memory)
            sed 's/: : "memory"/: :/' "$work/cpuid.i" > "$work/bad.i" ;;
        extra-clobber)
            sed 's/: : "memory"/: : "memory", "cc"/' "$work/cpuid.i" > "$work/bad.i" ;;
        invalid-template)
            sed 's/rdtime.d \$zero/rdtime.w $zero/' "$work/cpuid.i" > "$work/bad.i" ;;
    esac
    if cmp -s "$work/cpuid.i" "$work/bad.i"; then
        echo "LOONG_CPU_ID_CLOCK_NEGATIVE=FAIL missed_mutation=$bad" >&2
        exit 1
    fi
    if "$minic" --target=loongarch64-linux -mabi=lp64s -S \
        "$work/bad.i" -o "$work/bad.s" >"$work/out" 2>"$work/err"; then
        echo "LOONG_CPU_ID_CLOCK_NEGATIVE=FAIL admitted=$bad" >&2
        exit 1
    fi
    test ! -e "$work/bad.s"
done
echo 'LOONG_CPU_ID_CLOCK=PASS GNU_C=1 original_form=1 memory_clobber=1 negatives=3 GNU_AS=NOT_RUN'
@@@ end
