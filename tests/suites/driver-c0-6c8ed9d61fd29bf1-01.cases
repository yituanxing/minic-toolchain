@@@ {"id": "6c8ed9d61fd29bf1", "kind": "shared", "newline": true}
set -Eeuo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
minic=${MINIC:-"$root/build/debug/bin/minic"}
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-core-asm-empty-rk.sh", "shared": "6c8ed9d61fd29bf1"}
#!/usr/bin/env bash

${HOST_CC:-cc} -E -P -std=gnu11 -x c \
  "$root/tests/compiler/c0/core_asm_empty_rk_immediate.c" \
  -o "$work/input.i"
"$minic" -S "$work/input.i" -o "$work/output.s"
test -s "$work/output.s"
echo 'CORE_ASM_EMPTY_RK=PASS zero_template_constant_input=compiler_barrier'
@@@ end
@@@ {"head_lines": 2, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-core-asm-goto-percent-escape.sh", "shared": "6c8ed9d61fd29bf1"}
#!/usr/bin/env bash
# GNU escaped percents are not operands, including %%0 adjacent to a live %0.

${HOST_CC:-cc} -E -P -std=gnu11 -x c \
  "$root/tests/compiler/c0/core_asm_goto_escaped_percent.c" \
  -o "$work/fixture.i"
"$minic" -S "$work/fixture.i" -o "$work/fixture.s"

grep -Fq '.ascii "%0"' "$work/fixture.s"
grep -Fq '.word 33' "$work/fixture.s"
if grep -Fq '.ascii "%33"' "$work/fixture.s"; then
    echo 'CORE_ASM_GOTO_PERCENT_ESCAPE=FAIL literal-percent misidentified as operand' >&2
    exit 1
fi
echo 'CORE_ASM_GOTO_PERCENT_ESCAPE=PASS literal_%%0=preserved integer_%0=33'
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-core-asm-nonvolatile-rk.sh", "shared": "6c8ed9d61fd29bf1"}
#!/usr/bin/env bash

${HOST_CC:-cc} -E -P -std=gnu11 -x c \
  "$root/tests/compiler/c0/core_asm_nonvolatile_rk_output.c" \
  -o "$work/input.i"
"$minic" -S "$work/input.i" -o "$work/output.s"
grep -Eq 'addi.*zero.*0' "$work/output.s"
echo 'CORE_ASM_NONVOLATILE_RK=PASS output_is_execution_effect=1 immediate=0'
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-core-asm-zero-stride.sh", "shared": "6c8ed9d61fd29bf1"}
#!/usr/bin/env bash

${HOST_CC:-cc} -E -P -std=gnu11 -x c \
  "$root/tests/compiler/c0/core_asm_zero_stride_immediate.c" \
  -o "$work/input.i"
if "$minic" -S "$work/input.i" -o "$work/output.s" \
    >"$work/stdout" 2>"$work/stderr"; then
    echo 'CORE_ASM_ZERO_STRIDE=FAIL invalid symbolic offset was accepted' >&2
    exit 1
fi
if grep -Ei 'floating point exception|division by zero|core dumped' \
    "$work/stderr" >/dev/null; then
    echo 'CORE_ASM_ZERO_STRIDE=FAIL compiler crashed in zero-stride arithmetic' >&2
    exit 1
fi
test ! -s "$work/output.s"
echo 'CORE_ASM_ZERO_STRIDE=PASS rejects_invalid_zero_stride_without_crash=1'
@@@ end
