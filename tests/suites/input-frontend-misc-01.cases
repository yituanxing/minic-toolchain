    assert(existing_array->element_count == 0U);
    assert(!existing_array->is_zero_length);
    assert(object != NULL);
    assert(object->visibility == MINIC_SYMBOL_VISIBILITY_HIDDEN);

    minic_c0_program_destroy(&program);
}

