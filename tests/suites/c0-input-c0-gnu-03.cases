/* Two otherwise identical callbacks must preserve their pointee element
 * qualifications.  A mutable u64 (*)[2] parameter cannot silently stand in
 * for a const u64 (*)[2] formal function type. */
typedef unsigned long long u64;

typedef void (*callback_const)(const u64 h[][2]);

static void callback_mutable(u64 h[][2]) {
    h[0][0] += 1U;
}

static void accept_callback(callback_const cb) {
    (void)cb;
}

void reject_different_nested_array_qualifiers(void) {
    accept_callback(callback_mutable);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_gnu_function_pointer_array_signature.c"}
/* Passing a callback with a different nested array extent remains invalid.
 * Structural function type matching must preserve fixed array bounds. */
typedef unsigned long long u64;

typedef void (*callback_2)(const u64 h[][2]);

static void bad_callback(const u64 h[][3]) {
    (void)h;
}

static void accept_callback(callback_2 cb) {
    (void)cb;
}

void reject_different_nested_array_extent(void) {
    accept_callback(bad_callback);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_gnu_mixed_void_conditional_value.c"}
extern void minic_void_effect(void);

/* GNU result type is void: it cannot initialize an int or be returned
 * from a nonvoid function. */
int minic_invalid_mixed_void_result(int cond) {
    return cond ? minic_void_effect() : 1;
}
