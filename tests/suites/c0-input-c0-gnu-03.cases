@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_variadic_single_scalar_record.c"}
typedef __builtin_va_list MiniVaList;

typedef struct {
    unsigned int value;
} MiniUserId;

typedef struct {
    unsigned int value;
} MiniGroupId;

typedef struct {
    double value;
} MiniReal;

typedef struct {
    void *value;
} MiniPointer;

unsigned int mini_va_record_sum(unsigned int tag, ...) {
    MiniVaList ap;
    __builtin_va_start(ap, tag);
    MiniUserId uid = __builtin_va_arg(ap, MiniUserId);
    MiniGroupId gid = __builtin_va_arg(ap, MiniGroupId);
    __builtin_va_end(ap);
    return uid.value + gid.value + tag;
}

unsigned int mini_va_record_many(unsigned int tag, ...) {
    MiniVaList ap;
    unsigned int total = tag;
    unsigned int i;
    __builtin_va_start(ap, tag);
    for (i = 0; i < 9; ++i) {
        MiniUserId current = __builtin_va_arg(ap, MiniUserId);
        total += current.value;
    }
    __builtin_va_end(ap);
    return total;
}

double mini_va_record_real(unsigned int tag, ...) {
    MiniVaList ap;
    double total = (double)tag;
    unsigned int i;
    __builtin_va_start(ap, tag);
    for (i = 0; i < 9; ++i) {
        MiniReal current = __builtin_va_arg(ap, MiniReal);
        total += current.value;
    }
    __builtin_va_end(ap);
    return total;
}

unsigned long mini_va_record_pointer(unsigned int tag, ...) {
    MiniVaList ap;
    __builtin_va_start(ap, tag);
    MiniPointer current = __builtin_va_arg(ap, MiniPointer);
    __builtin_va_end(ap);
    return (unsigned long)current.value + tag;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_variadic_single_scalar_record_driver.c"}
typedef struct { unsigned int value; } MiniUserId;
typedef struct { unsigned int value; } MiniGroupId;
typedef struct { double value; } MiniReal;
typedef struct { void *value; } MiniPointer;

extern unsigned int mini_va_record_sum(unsigned int tag, ...);
extern unsigned int mini_va_record_many(unsigned int tag, ...);
extern double mini_va_record_real(unsigned int tag, ...);
extern unsigned long mini_va_record_pointer(unsigned int tag, ...);

int main(void) {
    MiniUserId uid = { 25U };
    MiniGroupId gid = { 7U };
    MiniReal v = { 1.0 };
    MiniPointer pointer = { (void *)&uid };
    if (mini_va_record_sum(10U, uid, gid) != 42U) return 1;
    if (mini_va_record_many(3U, uid, uid, uid, uid, uid,
                            uid, uid, uid, uid) != 228U) return 2;
    if (mini_va_record_real(2U, v, v, v, v, v,
                            v, v, v, v) != 11.0) return 3;
    if (mini_va_record_pointer(7U, pointer) !=
        (unsigned long)(void *)&uid + 7U) return 4;
    return 0;
}
@@@ end
