@@@ {"id": "c9b602d9660935a6", "kind": "shared", "newline": true}
set -Eeuo pipefail
minic="$1";test -x "$minic"
d=$(mktemp -d);trap 'rm -rf "$d"' EXIT
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-aarch64-large-structured-asm-spills.sh", "shared": "c9b602d9660935a6"}
#!/usr/bin/env bash
for updates in 45 640;do
  python3 - "$updates" "$d/large-$updates.i" <<'PY'
import sys
n=int(sys.argv[1]);out=sys.argv[2];mask=(1<<64)-1;v=17
# A reusable scalar SSA chain no longer implies a large physical frame.
# Force an actual non-reusable, observable local object on both boundaries.
# The second store also reaches deep into the object, so the 4095 case
# cannot pass merely because the total SP subtraction is large.
frame_anchor_bytes=768 if n==45 else 8192
lines=['typedef unsigned long u64;','static u64 published;',
 '__attribute__((noinline)) static u64 heavy(u64 x) {',
 ' volatile unsigned char frame_anchor[%d];' % frame_anchor_bytes]
for i in range(n):
    k=(i*83+17)%65521
    lines.append(' x = ((x << 3) ^ (x >> 2)) + %dUL;' % k)
    v=(((v << 3) ^ (v >> 2)) + k) & mask
lines.extend([' frame_anchor[0] = (unsigned char)x;',
 ' frame_anchor[%d] = frame_anchor[0];' % (frame_anchor_bytes-1),
 ' asm volatile("stlr %x1, %0" : "=Q"(published) : "rZ"(x) : "memory");',
 ' return published;','}',
 'int main(void) { return heavy(17UL) == %dUL ? 42 : 1; }' % v])
open(out,'w').write('\n'.join(lines)+'\n')
PY
  MINIC_M1_TRACE=1 MINIC_ASM_OPERAND_PLAN_TRACE=1 "$minic" --target=aarch64-linux -S "$d/large-$updates.i" -o "$d/large-$updates.s"
  grep -Fq 'stlr x9, [x10]' "$d/large-$updates.s"
  if command -v aarch64-linux-gnu-as >/dev/null 2>&1; then
    aarch64-linux-gnu-as "$d/large-$updates.s" -o "$d/large-$updates.o"
    test -s "$d/large-$updates.o"
  fi
  # Register allocation and Common Core spill-slot reuse can legitimately
  # eliminate the old x17 materialization. Keep the actual byte-offset
  # boundary test independent of that incidental register choice.
  python3 - "$d/large-$updates.s" "$updates" <<'PY'
import re
import sys

with open(sys.argv[1], encoding='utf-8') as stream:
    assembly = stream.read()
updates = int(sys.argv[2])
heavy = assembly.split('heavy:\n', 1)[1].split('.globl main', 1)[0]
match = re.search(r'(?m)^[ \t]*movz x(\d+), #(\d+), lsl #0[ \t]*\n[ \t]*sub sp, sp, x\1[ \t]*$', heavy)
if not match:
    raise SystemExit('missing real AArch64 heavy() stack allocation')
frame_bytes = int(match.group(2))
minimum = 512 if updates == 45 else 4095
if frame_bytes <= minimum:
    raise SystemExit(f'AArch64 frame {frame_bytes} did not cross {minimum}')
if frame_bytes >= 16384:
    raise SystemExit(f'AArch64 frame {frame_bytes} overflowed 16KiB kernel stack budget')
if updates == 640 and not re.search(r'\badd x(\d+), sp, x\1\b', heavy):
    raise SystemExit('missing large SP-relative address materialization')
print(f'AARCH64_LARGE_STRUCTURED_ASM_FRAME=PASS updates={updates} bytes={frame_bytes}')
PY
  if [[ "${MINIC_SOURCE_ONLY:-0}" != 1 ]];then
    aarch64-linux-gnu-gcc -static -O0 -x c "$d/large-$updates.i" -o "$d/gnu-$updates"
    aarch64-linux-gnu-gcc -static -x assembler "$d/large-$updates.s" -o "$d/mini-$updates"
    for compiler in gnu mini;do
      code=0;timeout 45s qemu-aarch64 "$d/$compiler-$updates" || code=$?
      if [[ "$code" != 42 ]];then
        echo "large-spill $updates $compiler exit=$code" >&2;exit 1
      fi
    done
  fi
  echo "AARCH64_LARGE_STRUCTURED_ASM_SPILL=PASS updates=$updates"
done
sed 's/stlr %x1, %0/str %x1, %0/' "$d/large-45.i" > "$d/unsafe.i"
if "$minic" --target=aarch64-linux -S "$d/unsafe.i" -o "$d/unsafe.s" >/dev/null 2>&1;then
  echo 'AArch64 target accepted wrong hardware ISA template' >&2;exit 1
fi
test ! -e "$d/unsafe.s"
if [[ "${MINIC_SOURCE_ONLY:-0}" == 1 ]]; then
  echo 'AARCH64_LARGE_STRUCTURED_ASM_SOURCE=PASS 512_boundary=1 4095_boundary=1 negatives=1 GNU_QEMU=SKIP'
else
  echo 'AARCH64_LARGE_STRUCTURED_ASM=PASS 512_boundary=1 4095_boundary=1 GNU_QEMU_42=2 negatives=1'
fi
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loong-linux-cmpxchg-qemu.sh", "shared": "c9b602d9660935a6"}
#!/usr/bin/env bash
# Original Linux 6.6.143 LoongArch cmpxchg.h hardware LL/SC GNU oracle.
# Includes exact 32/64 and 8/16-bit masked-replacement original templates.
cat > "$d/original.i" <<'SRC'
typedef unsigned int u32;
typedef unsigned long long u64;
static volatile u32 value32=5;
static volatile u64 value64=7;
static volatile u32 valueSmall=0x12345678;
u32 linux_cmpxchg32(u32 old,unsigned long newval) {
    u32 ret;
    volatile u32 *ptr=&value32;
    __asm__ __volatile__(
       "1:\t" "ll.w" "\t%0, %2\t\t# __cmpxchg_asm \n"
       "\tbne\t%0, %z3, 2f\t\t\t\n"
       "\tmove\t$t0, %z4\t\t\t\n"
       "\t" "sc.w" "\t$t0, %1\t\t\t\t\n"
       "\tbeqz\t$t0, 1b\t\t\t\t\n"
       "2:\t\t\t\t\t\t\n"
       "\tdbar 0x700\t\n"
       : "=&r" (ret), "=ZB" (*ptr)
       : "ZB" (*ptr), "Jr" (old), "Jr" (newval)
       : "t0", "memory");
    return ret;
}
u64 linux_cmpxchg64(u64 old,u64 newval) {
    u64 ret;
    volatile u64 *ptr=&value64;
    __asm__ __volatile__(
       "1:\t" "ll.d" "\t%0, %2\t\t# __cmpxchg_asm \n"
       "\tbne\t%0, %z3, 2f\t\t\t\n"
       "\tmove\t$t0, %z4\t\t\t\n"
       "\t" "sc.d" "\t$t0, %1\t\t\t\t\n"
       "\tbeqz\t$t0, 1b\t\t\t\t\n"
       "2:\t\t\t\t\t\t\n"
       "\tdbar 0x700\t\n"
       : "=&r" (ret), "=ZB" (*ptr)
       : "ZB" (*ptr), "Jr" (old), "Jr" (newval)
       : "t0", "memory");
    return ret;
}
u32 linux_cmpxchg_small(u32 old, u32 replacement) {
    u32 old32, temp, mask=0xffU;
    volatile u32 *ptr32=&valueSmall;
    asm volatile (
      "1:\tll.w\t\t%0, %3\t\t\n"
      "\tand\t\t%1, %0, %z4\t\n"
      "\tbne\t\t%1, %z5, 2f\t\n"
      "\tandn\t\t%1, %0, %z4\t\n"
      "\tor\t\t%1, %1, %z6\t\n"
      "\tsc.w\t\t%1, %2\t\t\n"
      "\tbeqz\t\t%1, 1b\t\t\n"
      "\tb\t\t3f\t\t\n"
      "2:\t\t\t\t\n"
      "\tdbar 0x700\t\n"
      "3:\t\t\t\t\n"
      : "=&r" (old32), "=&r" (temp), "=ZC" (*ptr32)
      : "ZC" (*ptr32), "Jr" (mask), "Jr" (old), "Jr" (replacement)
      : "memory");
    return old32 & mask;
}
unsigned long linux_cmpxchg_switch(volatile void *ptr,unsigned long old,
                                    unsigned long replacement,unsigned int size) {
    switch(size) {
    case 4:
        return ({ __typeof((u32)old) __ret; __asm__ __volatile__(
            "1:\t" "ll.w" "\t%0, %2\t\t# __cmpxchg_asm \n"
            "\tbne\t%0, %z3, 2f\t\t\t\n"
            "\tmove\t$t0, %z4\t\t\t\n"
            "\t" "sc.w" "\t$t0, %1\t\t\t\t\n"
            "\tbeqz\t$t0, 1b\t\t\t\t\n"
            "2:\t\t\t\t\t\t\n"
            "\tdbar 0x700\t\n"
            : "=&r" (__ret), "=ZB" (*(volatile u32 *)ptr)
            : "ZB" (*(volatile u32 *)ptr), "Jr" ((u32)old), "Jr" (replacement)
            : "t0", "memory"); __ret; });
    case 8:
        return ({ __typeof((u64)old) __ret; __asm__ __volatile__(
            "1:\t" "ll.d" "\t%0, %2\t\t# __cmpxchg_asm \n"
            "\tbne\t%0, %z3, 2f\t\t\t\n"
            "\tmove\t$t0, %z4\t\t\t\n"
            "\t" "sc.d" "\t$t0, %1\t\t\t\t\n"
            "\tbeqz\t$t0, 1b\t\t\t\t\n"
            "2:\t\t\t\t\t\t\n"
            "\tdbar 0x700\t\n"
            : "=&r" (__ret), "=ZB" (*(volatile u64 *)ptr)
            : "ZB" (*(volatile u64 *)ptr), "Jr" ((u64)old), "Jr" (replacement)
            : "t0", "memory"); __ret; });
    default: return 0;
    }
}
int main(void) {
    if (linux_cmpxchg32(4,8)!=5||value32!=5) return 1;
    if (linux_cmpxchg32(5,8)!=5||value32!=8) return 2;
    if (linux_cmpxchg64(6,9)!=7||value64!=7) return 3;
    if (linux_cmpxchg64(7,9)!=7||value64!=9) return 4;
    if (linux_cmpxchg_small(0x77,0x9a)!=0x78||valueSmall!=0x12345678) return 5;
    if (linux_cmpxchg_small(0x78,0x9a)!=0x78||valueSmall!=0x1234569a) return 6;
    if(linux_cmpxchg_switch(&value32,8,11,4)!=8||value32!=11)return 7;
    if(linux_cmpxchg_switch(&value64,9,13,8)!=9||value64!=13)return 8;
    return 42;
}
SRC
"$minic" --target=loongarch64-linux -S "$d/original.i" -o "$d/minic.s"
test -s "$d/minic.s"
for opcode in 'll.w' 'll.d' 'sc.w' 'sc.d' 'andn' 'dbar 0x700'; do
  grep -Fq "$opcode" "$d/minic.s"
done
if [[ "${MINIC_SOURCE_ONLY:-0}" != 1 ]];then
  gcc=loongarch64-linux-gnu-gcc-13
  command -v "$gcc" >/dev/null
  command -v qemu-loongarch64 >/dev/null
  "$gcc" -static -x assembler "$d/minic.s" -o "$d/minic.elf"
  "$gcc" -static -x c "$d/original.i" -o "$d/gnu.elf"
  for provider in minic gnu;do
    code=0;timeout 45s qemu-loongarch64 "$d/$provider.elf" || code=$?
    if [[ "$code" != 42 ]];then
      echo "ORIGINAL_LOONG_CMPXCHG failed $provider code=$code" >&2;exit 1
    fi
  done
fi
for bad in bad-op bad-barrier;do
 if [[ "$bad" == bad-op ]];then
   sed 's/ll.w/ld.w/g' "$d/original.i" > "$d/$bad.i"
 else
   sed 's/dbar 0x700/dbar 0x701/g' "$d/original.i" > "$d/$bad.i"
 fi
 if "$minic" --target=loongarch64-linux -S "$d/$bad.i" -o "$d/$bad.s" >/dev/null 2>&1;then
   echo "unqualified LoongArch LL/SC source accepted $bad" >&2;exit 1
 fi
 test ! -e "$d/$bad.s"
done
if [[ "${MINIC_SOURCE_ONLY:-0}" == 1 ]]; then
  echo 'ORIGINAL_LOONG_LLSC_CMPXCHG=PASS mode=source_only forms=3 GNU_QEMU=NOT_RUN failure_and_success_paths=NOT_RUN negatives=2'
else
  echo 'ORIGINAL_LOONG_LLSC_CMPXCHG=PASS mode=runtime forms=3 GNU_QEMU=2 failure_and_success_paths=1 negatives=2'
fi
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loong-linux-xchg-qemu.sh", "shared": "c9b602d9660935a6"}
#!/usr/bin/env bash
cat > "$d/xchg.i" <<'SRC'
typedef unsigned int u32;
typedef unsigned long long u64;
static volatile u32 state32=5;
static volatile u64 state64=7;
u32 linux_xchg32(u32 v) {
  volatile u32 *ptr=&state32;
  u32 old;
  __asm__ __volatile__(
      "amswap_db.w %1, %z2, %0\n"
      : "+ZB" (*ptr), "=&r" (old) : "Jr" (v) : "memory");
  return old;
}
u64 linux_xchg64(u64 v) {
  volatile u64 *ptr=&state64;
  u64 old;
  __asm__ __volatile__(
      "amswap_db.d %1, %z2, %0\n"
      : "+ZB" (*ptr), "=&r" (old) : "Jr" (v) : "memory");
  return old;
}
int main(void){
  if(linux_xchg32(8)!=5 || state32!=8)return 1;
  if(linux_xchg64(9)!=7 || state64!=9)return 2;
  if(linux_xchg32(17)!=8 || state32!=17)return 3;
  if(linux_xchg64(23)!=9 || state64!=23)return 4;
  return 42;
}
SRC
"$minic" --target=loongarch64-linux -S "$d/xchg.i" -o "$d/mini.s"
test -s "$d/mini.s"
grep -Fq 'amswap_db.w' "$d/mini.s"
grep -Fq 'amswap_db.d' "$d/mini.s"
if [[ "${MINIC_SOURCE_ONLY:-0}" != 1 ]];then
    gcc=loongarch64-linux-gnu-gcc-13
    "$gcc" -static -O0 -x c "$d/xchg.i" -o "$d/gnu.elf"
    "$gcc" -static -x assembler "$d/mini.s" -o "$d/mini.elf"
    for compiler in gnu mini;do
      code=0
      timeout 45s qemu-loongarch64 "$d/$compiler.elf" || code=$?
      if [[ "$code" != 42 ]];then
        echo "LoongArch Linux amswap $compiler code=$code" >&2;exit 1
      fi
    done
fi
sed 's/amswap_db.w/amxor_db.w/' "$d/xchg.i" > "$d/unsafe-op.i"
sed 's/"+ZB"/"+m"/' "$d/xchg.i" > "$d/unsafe-constraint.i"
for bad in unsafe-op unsafe-constraint;do
  if "$minic" --target=loongarch64-linux -S "$d/$bad.i" \
      -o "$d/$bad.s" >/dev/null 2>&1;then
    echo "unsafe LoongArch Linux xchg contract accepted $bad" >&2;exit 1
  fi
  test ! -e "$d/$bad.s"
done
if [[ "${MINIC_SOURCE_ONLY:-0}" == 1 ]]; then
  echo 'LOONG_LINUX_AMSWAP_DB_GNU=PASS mode=source_only widths=32/64 GNU_QEMU_42=NOT_RUN original_volatile_memory=1 negatives=2'
else
  echo 'LOONG_LINUX_AMSWAP_DB_GNU=PASS mode=runtime widths=32/64 GNU_QEMU_42=2 original_volatile_memory=1 negatives=2'
fi
@@@ end
