@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_overaligned_varargs.c"}
/* MC-014 / MC-015: a GNU variadic callee can realign its local frame to
 * 64 bytes, but the caller only guarantees 16-byte entry-SP alignment.
 * The saved a-registers and the caller's stack arguments form ONE linear
 * va_list regardless of the 0/16/32/48-byte entry-SP alignment phase. */
struct Aligned64 {
    unsigned long words[8];
} __attribute__((aligned(64)));

__attribute__((noinline))
unsigned long va_frame_one(unsigned long tag, ...) {
    struct Aligned64 storage;
    __builtin_va_list ap;
    unsigned long total = 0;
    unsigned int i;
    storage.words[0] = tag;
    total += (unsigned long)&storage & 63UL;
    __builtin_va_start(ap, tag);
    for (i = 0; i < 9U; ++i)
        total += __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return total + storage.words[0];
}

__attribute__((noinline))
unsigned long va_frame_seven(
    unsigned long a0, unsigned long a1, unsigned long a2,
    unsigned long a3, unsigned long a4, unsigned long a5,
    unsigned long a6, ...) {
    struct Aligned64 storage;
    __builtin_va_list ap;
    unsigned long total;
    storage.words[0] = a0 + a1 + a2 + a3 + a4 + a5 + a6;
    total = (unsigned long)&storage & 63UL;
    __builtin_va_start(ap, a6);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return total + storage.words[0];
}

__attribute__((noinline))
unsigned long va_frame_eight(
    unsigned long a0, unsigned long a1, unsigned long a2,
    unsigned long a3, unsigned long a4, unsigned long a5,
    unsigned long a6, unsigned long a7, ...) {
    struct Aligned64 storage;
    __builtin_va_list ap;
    unsigned long total;
    storage.words[0] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    total = (unsigned long)&storage & 63UL;
    __builtin_va_start(ap, a7);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return total + storage.words[0];
}

/* The first unnamed word is one caller-stack slot after the ninth named
 * parameter. RV32 must not accidentally use E or realigned S here. */
__attribute__((noinline))
unsigned long va_frame_nine(
    unsigned long a0, unsigned long a1, unsigned long a2,
    unsigned long a3, unsigned long a4, unsigned long a5,
    unsigned long a6, unsigned long a7, unsigned long a8, ...) {
    struct Aligned64 storage;
    __builtin_va_list ap;
    unsigned long total;
    storage.words[0] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
    total = (unsigned long)&storage & 63UL;
    __builtin_va_start(ap, a8);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return total + storage.words[0];
}

/* A moving alloca-SP must not change the entry-SP ABI anchor either. */
__attribute__((noinline))
unsigned long va_frame_dynamic(unsigned long tag, unsigned long count, ...) {
    struct Aligned64 storage;
    unsigned char *scratch = __builtin_alloca(count + 16UL);
    __builtin_va_list ap;
    unsigned long total;
    scratch[0] = (unsigned char)count;
    storage.words[0] = tag + scratch[0];
    total = (unsigned long)&storage & 63UL;
    __builtin_va_start(ap, count);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    total += __builtin_va_arg(ap, unsigned long);
    __builtin_va_end(ap);
    return total + storage.words[0];
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_packed_overflow_alignment.c"}
/* Every checked-overflow result_address is a real C lvalue, including a
 * GNU packed field which can be misaligned relative to its integer width. */
struct __attribute__((packed)) OverflowPacked {
    unsigned char lead;
    signed short narrow;
    int word;
    unsigned long long wide;
};

int packed_overflow_narrow(struct OverflowPacked *p) {
    return __builtin_add_overflow((short)32767, (short)1, &p->narrow);
}
int packed_overflow_add(struct OverflowPacked *p) {
    return __builtin_add_overflow(2147483647, 1, &p->word);
}
int packed_overflow_sub(struct OverflowPacked *p) {
    return __builtin_sub_overflow(-2147483647 - 1, 1, &p->word);
}
int packed_overflow_mul(struct OverflowPacked *p) {
    return __builtin_mul_overflow(100000, 100000, &p->word);
}
int packed_overflow_wide(struct OverflowPacked *p) {
    return __builtin_mul_overflow(0x100000000ULL, 0x100000000ULL, &p->wide);
}

int main(void) {
    struct OverflowPacked p;
    p.lead = 27;
    if (!packed_overflow_narrow(&p) || p.narrow != (short)-32768)
        return 1;
    if (!packed_overflow_add(&p) || p.word != (-2147483647 - 1))
        return 2;
    if (!packed_overflow_sub(&p) || p.word != 2147483647)
        return 3;
    if (!packed_overflow_mul(&p) || p.word != 1410065408)
        return 4;
    if (!packed_overflow_wide(&p) || p.wide != 0ULL || p.lead != 27)
        return 5;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_packed_structured_asm_alignment.c"}
/* GNU constraints are source owned; the compiler-generated register ingress
 * and egress must obey the same packed-lvalue alignment as ordinary C.
 * Native GNU x86 uses x86 template spelling; RISCV_ASM_PROBE_TARGET selects
 * the equivalent Base-I source text for RV32I and RV64I -S verification. */
#ifdef RISCV_ASM_PROBE_TARGET
#define ASM_INT_INC "addi %0, %0, 1"
#define ASM_INT_SET "li %0, 17"
#define ASM_LONG_INC "addi %0, %0, 1"
#else
#define ASM_INT_INC "addl $1, %0"
#define ASM_INT_SET "movl $17, %0"
#define ASM_LONG_INC "addq $1, %0"
#endif

struct __attribute__((packed)) PackedAsm {
    unsigned char prefix;
    int value;
    long wide;
};

void packed_asm_readwrite(struct PackedAsm *p) {
    __asm__ __volatile__(ASM_INT_INC : "+r"(p->value));
}

void packed_asm_output(struct PackedAsm *p) {
    __asm__ __volatile__(ASM_INT_SET : "=r"(p->value));
}

void packed_asm_wide(struct PackedAsm *p) {
    __asm__ __volatile__(ASM_LONG_INC : "+r"(p->wide));
}

/* Six simultaneous operands survive a large-displacement frame reload. The
 * static frame transport may only use t2, t5 and t6 as hidden temporaries;
 * those registers must never be allocated as any asm input at this site. */
void packed_asm_large_frame(long a, long b, long c,
                            long d, long e, long f) {
    volatile unsigned char space[8192];
    space[0] = 1;
    (void)space[0];
    __asm__ __volatile__(
        "# MINIC_PACKED_ASM_INPUTS %0 %1 %2 %3 %4 %5"
        : : "r"(a), "r"(b), "r"(c), "r"(d), "r"(e), "r"(f)
        : "memory");
}

#ifndef RISCV_ASM_PROBE_TARGET
int main(void) {
    struct PackedAsm p;
    p.prefix = 71;
    p.value = 4;
    p.wide = 123;
    packed_asm_readwrite(&p);
    if (p.value != 5)
        return 1;
    packed_asm_output(&p);
    if (p.value != 17)
        return 2;
    packed_asm_wide(&p);
    if (p.wide != 124 || p.prefix != 71)
        return 3;
    packed_asm_large_frame(1, 2, 3, 4, 5, 6);
    return 0;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_secondary_label_closure.c"}
/* A constant-specialized clone can retain an indirect-entry label whose
 * ordinary entry path was folded away.  This is a genuine Core entry root,
 * not permission for the backend to forge a branch from its ABI prologue. */
static inline int secondary_label(unsigned selector) {
    if (selector == 0U) return 13;
    if (selector == 1U) goto alternate;
    return 27;
alternate:
    return 41;
}

int secondary_first(void) { return secondary_label(0U); }
int secondary_second(void) { return secondary_label(1U); }
int secondary_third(unsigned selector) {
    return secondary_label(selector);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_source_asm_saved_operands.c"}
/* The original RISC-V Linux irq.c runs inline ASM that clobbers the whole
 * caller-saved a/t bank. GCC binds its remaining generic inputs to saved
 * s-registers; the MiniC RV64 frame must save/restore exactly those. */
#if defined(MINIC_BAD_NO_AVAILABLE_GPR)
void cannot_bind_operand(unsigned long first) {
    __asm__ volatile("xor zero, %0, %0" : : "r"(first) :
        "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7",
        "t0", "t1", "t2", "t3", "t4", "t5", "t6",
        "s0", "s1", "s2", "s3", "s4", "s5", "s6",
        "s7", "s8", "s9", "s10", "s11", "memory");
}
#else
unsigned long linux_irq_two_saved_inputs(unsigned long first,
                                          unsigned long second) {
    __asm__ volatile("xor zero, %[first], %[second]" :
        : [first] "r"(first), [second] "r"(second) :
        "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7",
        "t0", "t1", "t2", "t3", "t4", "t5", "t6", "memory");
    return first + second;
}
#endif
@@@ end
