@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_mixed_checked_overflow_edge.c"}
#include <limits.h>

/* GNU checked arithmetic uses mathematical operands rather than the normal
 * C usual arithmetic conversions. In particular ULONG_MAX+1 must overflow
 * an int even though its low machine word wraps to zero. */
static int wide_first(unsigned long wide, int narrow, int *out) {
    return __builtin_add_overflow(wide, narrow, out);
}
static int signed_first(int narrow, unsigned long wide, int *out) {
    return __builtin_add_overflow(narrow, wide, out);
}
static int multiply_signed_first(int signed_operand,
    unsigned int unsigned_operand, int *out) {
    return __builtin_mul_overflow(signed_operand, unsigned_operand, out);
}
static int multiply_unsigned_first(unsigned int unsigned_operand,
    int signed_operand, int *out) {
    return __builtin_mul_overflow(unsigned_operand, signed_operand, out);
}

int main(void) {
    int result = 0;
    if (!wide_first(ULONG_MAX, 1, &result) || result != 0)
        return 1;
    if (!signed_first(1, ULONG_MAX, &result) || result != 0)
        return 2;
    if (wide_first(0, -1, &result) || result != -1)
        return 3;
    if (signed_first(INT_MIN, 0, &result) || result != INT_MIN)
        return 4;
    if (wide_first((unsigned long)INT_MAX + 1UL, -1, &result) ||
        result != INT_MAX)
        return 5;
    if (!signed_first(0, (unsigned long)INT_MAX + 1UL, &result) ||
        result != INT_MIN)
        return 6;
    if (multiply_signed_first(-2, 3U, &result) || result != -6)
        return 7;
    if (multiply_unsigned_first(3U, -2, &result) || result != -6)
        return 8;
    if (!multiply_signed_first(INT_MIN, 2U, &result) || result != 0)
        return 9;
    if (multiply_unsigned_first(1U, INT_MIN, &result) || result != INT_MIN)
        return 10;
    if (!multiply_unsigned_first(UINT_MAX, -1, &result) || result != 1)
        return 11;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_named_asm_goto.c"}
/* Exact GNU C asm-goto source ownership: named `i` input and C label.
 * C ingress binds names once; RV32/RV64 typed MachineIR preserves the source
 * and proves the real Core CFG branch and physical fallthrough. */
int rv32_jump_owner(int test) {
    if (test)
        __asm__ __volatile__ goto (
            ".option push\n\t.option norelax\n"
            "1: nop\n\t"
            ".pushsection __jump_table,\"aw\"\n\t"
            ".long 1b - ., %l[enabled] - .\n\t"
            ".word %[key]\n\t"
            ".popsection\n\t.option pop"
            : : [key] "i"(11) : : enabled);
    return 0;
enabled:
    return 1;
}

/* Two distinct actual labels must retain two independently verifiable
 * Machine successors. The first three GNU operands are constant facts. */
int rv32_jump_two_labels(int choice) {
    if (choice)
        __asm__ __volatile__ goto (
            ".pushsection __jump_table,\"aw\"\n\t"
            ".word %[alpha], %[beta], %[gamma]\n\t"
            ".long %l[yes] - ., %l[no] - .\n\t"
            ".popsection"
            : : [alpha] "i"(3), [beta] "i"(5), [gamma] "i"(7)
            : : yes, no);
    return 0;
yes:
    return 1;
no:
    return 2;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_named_asm_goto_failures.c"}
/* GNU names are resolved at C ingress and sealed in Core; `%l[...]` may
 * reference only a C label, `%[...]` only an input operand. The three
 * deliberately forged forms must fail before any target text is emitted. */
#if NAMED_GOTO_FAILURE == 1
int rv32_named_goto_missing_input(void) {
    asm volatile goto(".word %[ghost]" : : [key] "i"(11) : : enabled);
    return 0;
enabled:
    return 1;
}
#elif NAMED_GOTO_FAILURE == 2
int rv32_named_goto_wrong_kind(void) {
    asm volatile goto(".long %l[key] - ." : : [key] "i"(11) : : enabled);
    return 0;
enabled:
    return 1;
}
#elif NAMED_GOTO_FAILURE == 3
int rv32_named_goto_colliding_names(void) {
    asm volatile goto(".word %[key]\n.long %l[key] - ."
        : : [key] "i"(11) : : key);
    return 0;
key:
    return 1;
}
#else
#error NAMED_GOTO_FAILURE must select a deliberately invalid form
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_overalign_frame.c"}
int rv32_overaligned_frame(int p0, int p1, int p2, int p3,
                           int p4, int p5, int p6, int p7,
                           int p8, int p9) {
    char huge[7] __attribute__((aligned(64)));
    huge[0] = (char)p9;
    return (int)huge[0] + (int)((unsigned long)huge & 63u) + p8;
}
