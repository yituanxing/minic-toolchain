@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/check-riscv-gpr-abi.c"}
/* Standalone psABI placement contract, independent of any Core IR frame. */
#include "target/riscv/gpr_abi_cursor.h"
#include <stdio.h>

static int check(MinicRiscvGprAbiCursor in, size_t words,
                 bool unnamed, bool pair, size_t rb, size_t rc,
                 size_t sb, size_t sc, size_t next_reg, size_t next_stack) {
    MinicRiscvGprAbiPlacement p = {0};
    if (!minic_riscv_gpr_abi_place(&in, words, unnamed, pair, &p) ||
        p.register_begin != rb || p.register_count != rc ||
        p.stack_begin != sb || p.stack_count != sc ||
        in.register_words != next_reg || in.stack_words != next_stack)
        return 1;
    return 0;
}
int main(void) {
    const MinicRiscvGprAbiCursor after_a0 = {1U, 0U, false};
    const MinicRiscvGprAbiCursor after_a6 = {7U, 0U, false};
    const MinicRiscvGprAbiCursor odd_stack = {8U, 1U, false};
    const MinicRiscvGprAbiCursor already_stack = {8U, 2U, true};
    MinicRiscvGprAbiPlacement result = {0};
    MinicRiscvGprAbiCursor overflow = {8U, SIZE_MAX, false};
    if (check(after_a6, 2U, false, false, 7U, 1U, 0U, 1U, 8U, 1U)) return 1;
    if (check(after_a0, 2U, true, true, 2U, 2U, 0U, 0U, 4U, 0U)) return 2;
    if (check(after_a6, 2U, true, true, 8U, 0U, 0U, 2U, 8U, 2U)) return 3;
    if (check(odd_stack, 2U, true, true, 8U, 0U, 2U, 2U, 8U, 4U)) return 4;
    if (check(already_stack, 1U, true, false, 8U, 0U, 2U, 1U, 8U, 3U)) return 5;
    if (check(after_a0, 2U, false, false, 1U, 2U, 0U, 0U, 3U, 0U)) return 6;
    if (minic_riscv_gpr_abi_place(&overflow, 1U, true, false, &result) ||
        overflow.stack_words != SIZE_MAX) return 7;
    if (minic_riscv_gpr_abi_place(&overflow, 2U, false, true, &result)) return 8;
    puts("RISCV_GPR_ABI_CURSOR=PASS named_split=1 wide_even=1 stack_align=1 overflow=reject");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/check-riscv-machine-selection.c"}
/* ISA/ABI-free RISC-V machine selection contract for both XLEN widths. */
#include "target/riscv/instruction_select.h"
#include <stdio.h>
#include <limits.h>
#include <string.h>

static int match(const char *got, const char *expected) {
    return got != NULL && strcmp(got, expected) == 0;
}
static bool pointer_scale(size_t stride,
                          MinicRiscvPointerScaleKind kind,
                          unsigned shift) {
    MinicRiscvPointerScalePlan plan;
    return minic_riscv_plan_pointer_scale(stride, &plan) &&
           plan.kind == kind && plan.shift == shift;
}
int main(void) {
    const struct {
        MinicCoreInstructionKind kind;
        bool is_unsigned;
        unsigned xlen;
        const char *symbol;
    } arithmetic[] = {
        { MINIC_CORE_INSTRUCTION_INTEGER_MULTIPLY, false, 32U, "__mulsi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_MULTIPLY, false, 64U, "__muldi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_DIVIDE, false, 32U, "__divsi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_DIVIDE, true, 32U, "__udivsi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_REMAINDER, false, 32U, "__modsi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_REMAINDER, true, 32U, "__umodsi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_DIVIDE, false, 64U, "__divdi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_DIVIDE, true, 64U, "__udivdi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_REMAINDER, false, 64U, "__moddi3" },
        { MINIC_CORE_INSTRUCTION_INTEGER_REMAINDER, true, 64U, "__umoddi3" }
    };
    size_t i;
    for (i = 0U; i < sizeof(arithmetic) / sizeof(arithmetic[0]); ++i)
        if (!match(minic_riscv_integer_arithmetic_symbol(
                    arithmetic[i].kind, arithmetic[i].is_unsigned,
                    arithmetic[i].xlen), arithmetic[i].symbol))
            return 1;
    if (minic_riscv_integer_arithmetic_symbol(
            MINIC_CORE_INSTRUCTION_INTEGER_DIVIDE, false, 128U) != NULL ||
        minic_riscv_integer_arithmetic_symbol(
            MINIC_CORE_INSTRUCTION_POINTER_LESS, true, 32U) != NULL)
        return 2;
    if (!match(minic_riscv_scalar_binary_opcode(
            MINIC_CORE_INSTRUCTION_INTEGER_SHIFT_RIGHT, false), "sra") ||
        !match(minic_riscv_scalar_binary_opcode(
            MINIC_CORE_INSTRUCTION_INTEGER_SHIFT_RIGHT, true), "srl") ||
        !match(minic_riscv_scalar_binary_opcode(
            MINIC_CORE_INSTRUCTION_INTEGER_LESS, false), "slt") ||
        !match(minic_riscv_scalar_binary_opcode(
            MINIC_CORE_INSTRUCTION_INTEGER_LESS, true), "sltu"))
        return 3;
    if (!match(minic_riscv_softfloat_arithmetic_symbol(
            MINIC_CORE_INSTRUCTION_DOUBLE_ADD), "__adddf3"))
        return 4;
    if (!pointer_scale(0U, MINIC_RISCV_POINTER_SCALE_ZERO, 0U) ||
        !pointer_scale(1U, MINIC_RISCV_POINTER_SCALE_UNIT, 0U) ||
        !pointer_scale(2U, MINIC_RISCV_POINTER_SCALE_SHIFT, 1U) ||
        !pointer_scale(8U, MINIC_RISCV_POINTER_SCALE_SHIFT, 3U) ||
        !pointer_scale(3U, MINIC_RISCV_POINTER_SCALE_MULTIPLY, 0U) ||
        !pointer_scale((size_t)-1, MINIC_RISCV_POINTER_SCALE_MULTIPLY, 0U) ||
        !pointer_scale((size_t)1U << (sizeof(size_t) * CHAR_BIT - 1U),
                       MINIC_RISCV_POINTER_SCALE_SHIFT,
                       (unsigned)(sizeof(size_t) * CHAR_BIT - 1U)) ||
        minic_riscv_plan_pointer_scale(0U, NULL))
        return 5;
    puts("RISCV_MACHINE_SELECTION=PASS ilp32_libgcc=5 lp64_libgcc=5 shift_compare=4 softfloat=1");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_abi_register_boundary.S"}
/* GNU AS physical-register witnesses: no compiler normalization masks a
 * caller's raw a0 or ninth outgoing stack slot. */
.text
.globl _start
.type _start,@function
_start:
    .option push
    .option norelax
    la gp, __global_pointer$
    .option pop
    call main
    li a7,93
    ecall

#if ABI_RV64
.globl abi_raw_arg_u32
.type abi_raw_arg_u32,@function
abi_raw_arg_u32:
    /* Return full incoming physical a0 bit pattern unchanged. */
    ret

.globl abi_raw_stack_u32
.type abi_raw_stack_u32,@function
abi_raw_stack_u32:
    /* Eight preceding unsigned-long arguments occupy a0..a7. */
    ld a0,0(sp)
    ret

.globl abi_raw_call_ret_u32
.type abi_raw_call_ret_u32,@function
abi_raw_call_ret_u32:
    addi sp,sp,-16
    sd ra,8(sp)
    call minic_ret_u32
    ld ra,8(sp)
    addi sp,sp,16
    /* Return MiniC's untouched raw unsigned-i32 a0 as unsigned long. */
    ret
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_abi_register_boundary.c"}
/* RV32/RV64 native C->Core->Machine psABI scalar register differential.
 * Cross-compile this exact file with both GNU C and MiniC. */
#if ABI_RV64
extern unsigned long abi_raw_arg_u32(unsigned int);
extern unsigned long abi_raw_stack_u32(
    unsigned long, unsigned long, unsigned long, unsigned long,
    unsigned long, unsigned long, unsigned long, unsigned long,
    unsigned int);

unsigned long minic_caller_arg_u32(void) {
    unsigned int value = 0x80000000U;
    return abi_raw_arg_u32(value);
}
unsigned long minic_caller_stack_u32(void) {
    unsigned int value = 0x80000000U;
    return abi_raw_stack_u32(1UL, 2UL, 3UL, 4UL,
        5UL, 6UL, 7UL, 8UL, value);
}
unsigned int minic_ret_u32(void) {
    return 0x80000000U;
}
unsigned long minic_callee_convert_u32(unsigned int value) {
    /* GNU caller supplies sign-extended a0; Core must canonicalize
     * unsigned 32-bit values to zero-extended 64-bit C semantics. */
    return (unsigned long)value;
}
#endif

int minic_asm_signed_char(void) {
    signed char value = -2;
    __asm__ volatile ("srai %0,%0,1" : "+r"(value));
    return value == -1;
}
int minic_asm_signed_short(void) {
    signed short value = -2;
    __asm__ volatile ("srai %0,%0,1" : "+r"(value));
    return value == -1;
}
int minic_asm_unsigned_char(void) {
    unsigned char value = 0xfeU;
    /* QImode "+r" leaves upper GPR bits unspecified in GNU; test
     * only the defined low 8 bits of the inout value. */
    __asm__ volatile ("addi %0,%0,1" : "+r"(value));
    return value == 0xffU;
}
int minic_asm_unsigned_short(void) {
    unsigned short value = 0xfffeU;
    /* HImode "+r" likewise makes no promise about upper GPR bits. */
    __asm__ volatile ("addi %0,%0,1" : "+r"(value));
    return value == 0xffffU;
}
#if ABI_RV64
int minic_asm_unsigned32_readwrite(void) {
    unsigned int value = 0x80000000U;
    __asm__ volatile ("srai %0,%0,32" : "+r"(value));
    return value == 0xffffffffU;
}
int minic_asm_unsigned32_input(void) {
    unsigned int value = 0x80000000U;
    unsigned long output;
    __asm__ volatile ("srai %0,%1,32" : "=r"(output) : "r"(value));
    return output == ~0UL;
}
int minic_asm_unsigned32_mixed(void) {
    unsigned int value = 0x80000000U;
    unsigned long output;
    __asm__ volatile ("srai %0,%3,32" : "=&r"(output)
                      : "r"(value), "r"(value), "r"(value));
    return output == ~0UL;
}
int minic_asm_unsigned32_mixed_readwrite(void) {
    unsigned int value = 0x80000000U;
    __asm__ volatile ("srai %0,%0,32" : "+r"(value)
                      : "r"(value), "r"(value));
    return value == 0xffffffffU;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_abi_register_boundary_driver.c"}
/* Independent GNU C driver: every assertion is a guest exit code. */
extern int minic_asm_signed_char(void);
extern int minic_asm_signed_short(void);
extern int minic_asm_unsigned_char(void);
extern int minic_asm_unsigned_short(void);
#if ABI_RV64
extern unsigned long minic_caller_arg_u32(void);
extern unsigned long minic_caller_stack_u32(void);
extern unsigned long abi_raw_call_ret_u32(void);
extern unsigned long minic_callee_convert_u32(unsigned int);
extern int minic_asm_unsigned32_readwrite(void);
extern int minic_asm_unsigned32_input(void);
extern int minic_asm_unsigned32_mixed(void);
extern int minic_asm_unsigned32_mixed_readwrite(void);
#endif
int main(void) {
    if (minic_asm_signed_char() != 1) return 11;
    if (minic_asm_signed_short() != 1) return 12;
    if (minic_asm_unsigned_char() != 1) return 13;
    if (minic_asm_unsigned_short() != 1) return 14;
#if ABI_RV64
    if (minic_caller_arg_u32() != 0xffffffff80000000UL) return 21;
    if (minic_caller_stack_u32() != 0xffffffff80000000UL) return 22;
    if (abi_raw_call_ret_u32() != 0xffffffff80000000UL) return 23;
    if (minic_callee_convert_u32(0x80000000U) != 0x80000000UL) return 24;
    if (minic_asm_unsigned32_readwrite() != 1) return 31;
    if (minic_asm_unsigned32_input() != 1) return 32;
    if (minic_asm_unsigned32_mixed() != 1) return 33;
    if (minic_asm_unsigned32_mixed_readwrite() != 1) return 34;
#endif
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_adjacent_private_stack_forward.c"}
/* Exercise private Core SSA spills and intervening side-effect barriers. */
long mini_stack_forward_chain(long a, long b, long c) {
    long first = a + b;
    long second = first + c;
    return second + first;
}

long mini_stack_forward_call(long a, long b, long (*f)(long)) {
    long first = a + b;
    return f(first) + first;
}

long mini_stack_forward_asm(long a, long b) {
    long first = a + b;
    __asm__ __volatile__("nop" ::: "memory");
    return first + b;
}

long mini_stack_forward_branch(long a, long b, int choose) {
    long first = a + b;
    if (choose) return first + b;
    return first + a;
}

/* A large private frame exercises the 12-bit displacement expansion path. */
long mini_stack_forward_large(long a, long b) {
    volatile long pad[640];
    pad[0] = a;
    pad[639] = b;
    return pad[0] + pad[639] + a + b;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_adjacent_private_stack_forward_driver.c"}
/* Freestanding test driver: GCC emits only the harness, MiniC emits cases. */
extern long mini_stack_forward_chain(long, long, long);
extern long mini_stack_forward_call(long, long, long (*)(long));
extern long mini_stack_forward_asm(long, long);
extern long mini_stack_forward_branch(long, long, int);
extern long mini_stack_forward_large(long, long);

static long times_three(long value) { return value * 3; }

int mini_stack_forward_test_main(void) {
    if (mini_stack_forward_chain(-17, 9, 4) != -12) return 11;
    if (mini_stack_forward_chain(100, -7, 20) != 206) return 12;
    if (mini_stack_forward_call(-17, 9, times_three) != -32) return 13;
    if (mini_stack_forward_call(100, -7, times_three) != 372) return 14;
    if (mini_stack_forward_asm(-17, 9) != 1) return 15;
    if (mini_stack_forward_branch(-17, 9, 1) != 1) return 16;
    if (mini_stack_forward_branch(-17, 9, 0) != -25) return 17;
    if (mini_stack_forward_large(-17, 9) != -16) return 18;
    if (mini_stack_forward_large(100, -7) != 186) return 19;
    return 0;
}
@@@ end
