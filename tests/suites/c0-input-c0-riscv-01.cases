@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_aligned_payload_memory.c"}
/* Statically proven Core local address alignment may select integer word
 * payload transfers even under RV32I/RV64I's soft-float ABI. A pointer
 * parameter and a GNU packed field do not carry that proof. */
struct __attribute__((packed)) PackedDouble {
    unsigned char tag;
    double payload;
};

__attribute__((noinline)) double aligned_local_payload(double incoming) {
    double local = incoming;
    return local;
}

__attribute__((noinline)) double unknown_pointer_payload(const double *p) {
    return *p;
}

__attribute__((noinline)) double packed_field_payload(
    const struct PackedDouble *p) {
    return p->payload;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_extended_zero_output_implicit_volatile.c"}
/* Original Linux RISC-V TLB flush shape: GNU extended asm with zero outputs
 * is implicitly volatile even if it has inputs and a memory clobber. */
void local_flush_tlb_implicit(unsigned long asid) {
    if (asid != ~0UL)
        asm("sfence.vma x0, %0" : : "r"(asid) : "memory");
}

void local_flush_tlb_explicit(unsigned long asid) {
    if (asid != ~0UL)
        asm volatile("sfence.vma x0, %0" : : "r"(asid) : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_fixed_register_phase_alias.c"}
/* Real Linux vDSO ecall register family: output a0 may overlap an input
 * a0 only because =r is written after the asm reads its inputs. */
#if defined(MINIC_BAD_EARLYCLOBBER)
long fixed_alias_bad_earlyclobber(long first, long second) {
    register long in asm("a0") = first;
    register long other asm("a1") = second;
    register long result asm("a0");
    asm volatile("add %0, %1, %2"
                 : "=&r"(result) : "r"(in), "r"(other) : "memory");
    return result;
}
#elif defined(MINIC_BAD_TWO_INPUTS)
long fixed_alias_bad_two_inputs(long first, long second) {
    register long in0 asm("a0") = first;
    register long in1 asm("a0") = second;
    register long result asm("a1");
    asm volatile("add %0, %1, %2"
                 : "=r"(result) : "r"(in0), "r"(in1) : "memory");
    return result;
}
#else
long fixed_alias_vdso_like(long first, long second) {
    register long in0 asm("a0") = first;
    register long in1 asm("a1") = second;
    register long result asm("a0");
    register long nr asm("a7") = 169;
    asm volatile("add %0, %1, %2 # nr=%3"
                 : "=r"(result) : "r"(in0), "r"(in1), "r"(nr)
                 : "memory");
    return result;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/riscv_legacy_wide_asm.c"}
static inline unsigned long rv32_irq_save_legacy(void) {
    unsigned long flags = 2;
    __asm__ __volatile__("csrrc %0, 0x100, %1"
                         : "=r"(flags) : "rK"(flags) : "memory");
    return flags;
}
unsigned long rv32_irq_save_entry(void) { return rv32_irq_save_legacy(); }
int rv32_put_user_pair(unsigned int *ptr, unsigned long long value) {
    unsigned long err = 0;
    __asm__ __volatile__("sw %z3, %1\n\tsw %z4, %2"
                         : "+r"(err), "=m"(ptr[0]), "=m"(ptr[1])
                         : "rJ"(value), "rJ"(value >> 32) : "memory");
    return (int)err;
}
