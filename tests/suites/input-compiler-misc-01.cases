@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/aggregate_abi.c"}
/* Cross-ABI aggregate passing, nested records, hidden structure returns,
 * object copies, and pointer aliases.  No host-system headers required. */
struct MirInner { long value; unsigned short tag; };
struct MirRecord {
    struct MirInner inner[3];
    long tail[4];
    unsigned char status;
};

volatile long mir_aggregate_sink;

__attribute__((noinline))
struct MirRecord mir_make_record(long a, long b, long c) {
    struct MirRecord result = {0};
    result.inner[0].value = a + 3;
    result.inner[1].value = b * 7;
    result.inner[2].value = c - a;
    result.inner[1].tag = (unsigned short)(a ^ b);
    result.tail[0] = a;
    result.tail[1] = b;
    result.tail[2] = c;
    result.tail[3] = result.inner[1].value + result.inner[0].value;
    result.status = (unsigned char)(result.tail[3] & 255L);
    return result;
}

__attribute__((noinline))
long mir_use_record(struct MirRecord by_value, struct MirInner small,
                    long extra) {
    long sum = by_value.tail[0] + by_value.tail[3] + extra;
    sum += by_value.inner[1].value + small.value + small.tag;
    mir_aggregate_sink = sum;
    return sum;
}

int main(void) {
    struct MirRecord local = mir_make_record(5, 11, 17);
    struct MirInner tiny = local.inner[1];
    return (int)(mir_use_record(local, tiny, 29) & 255L);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/arith_call_frame.c"}
/* Intentionally header-free: host preprocessing is architecture neutral.
 * Exercises integer arithmetic, nested calls, outgoing stack arguments,
 * incoming stack arguments, locals, address-taken locals and frame layout. */
volatile long mir_sink;

__attribute__((noinline))
long mir_callee(long a, long b, long c, long d, long e,
                long f, long g, long h, long i, long j) {
    long mix = (a * 3L + b - c) ^ (d + e + f + g);
    return mix + h * 5L - i + j;
}

__attribute__((noinline))
long mir_frame(long seed) {
    long slots[12];
    long *volatile taken = slots;
    int i;
    for (i = 0; i < 12; ++i)
        slots[i] = seed + (long)i * 7L;
    mir_sink = slots[5];
    return mir_callee(slots[0], slots[1], slots[2], slots[3],
                      slots[4], slots[5], slots[6], slots[7],
                      slots[8], taken[9]);
}

int main(void) {
    return (int)(mir_frame(3L) & 255L);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/cfg_global.c"}
/* CFG/label identity, relocation-bearing globals and data are all visible
 * at GNU -S without a target cross-assembler. */
long mir_table[4] = {3, 5, 7, 11};
long *mir_global_ptr = mir_table;
volatile int mir_route;

__attribute__((noinline))
long mir_cfg(int selector, long x) {
    long result;
    if (selector < 0) goto negative;
    switch (selector) {
    case 0: result = mir_table[0]; break;
    case 1: result = mir_table[1] + x; break;
    case 3: result = mir_table[3] - x; break;
    default: result = mir_global_ptr[2] ^ x; break;
    }
    goto finish;
negative:
    result = -x;
finish:
    mir_route = selector;
    return result;
}

int main(void) {
    return (int)(mir_cfg(1, 4) + mir_cfg(-1, 9));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/entry_backedge.c"}
/* Forces a real CFG edge back into the function's first Core block; a
 * serializer must not mistake the symbol entry for an ordinary local label. */
volatile int mir_backedge_sink;

__attribute__((noinline))
int mir_backedge(int count) {
entry:
    if (count <= 0) return mir_backedge_sink;
    mir_backedge_sink += count;
    --count;
    goto entry;
}

int main(void) { return mir_backedge(4); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/fp_scalar_abi.c"}
/* Native floating operations, scalar ABI arguments/returns, comparisons,
 * casts, and stack-passed mixed-bank parameters (soft FP for RV32I/RV64I). */
volatile double mir_fp_sink;

__attribute__((noinline))
double mir_fp_callee(double a, double b, double c, double d,
                     double e, double f, double g, double h,
                     double i, double j) {
    double left = (a + b) * (c - d);
    float narrow = (float)(e + g);
    double right = (double)narrow / (f + 1.0);
    return left + right + h - i + j;
}

__attribute__((noinline))
long mir_fp_bridge(long seed, float scale, double bias) {
    double a = (double)seed + (double)scale;
    double b = mir_fp_callee(a, bias, 1.5, 2.0, 3.5,
                             4.0, 5.5, 6.0, 7.5, 8.0);
    mir_fp_sink = b;
    return (long)(b >= 0.0 ? b : -b);
}

int main(void) { return (int)(mir_fp_bridge(13, 2.5f, 0.25) & 255L); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/indirect_control.c"}
/* Computed goto, indirect calls, branch-sensitive SSA values and switch.
 * Address-taken entry labels must not jump back through a prologue. */
typedef long (*MirCall)(long, long);

__attribute__((noinline))
long mir_indirect_target(long a, long b) { return (a << 1) - b; }

__attribute__((noinline))
long mir_dispatch(int code, long value, MirCall call) {
    static void *const table[] = {&&s0, &&s1, &&s2, &&s3};
    long result = value;
    if ((unsigned)code >= 4U) goto done;
    goto *table[code];
s0:
    result += 19;
    goto done;
s1:
    result = call(result, 5);
    goto done;
s2:
    result ^= 0x55AAL;
    goto done;
s3:
    switch ((int)(result & 3L)) {
    case 0: result += 1; break;
    case 1: result *= 3; break;
    case 2: result >>= 2; break;
    default: result -= 9; break;
    }
done:
    return result;
}

int main(void) {
    return (int)(mir_dispatch(1, 41, mir_indirect_target) & 255L);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/inline_negative.c"}
/* A source-ASM positional reference with no matching source operand is
 * ill-formed. Admission must fail before any partial GNU .s is accepted. */
int main(void) {
    asm volatile("nop /* %0 */" ::: "memory");
    return 0;
}
