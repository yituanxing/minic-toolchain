@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/variadic_calls.c"}
/* ABI cursor, mixed-size arguments, and direct/indirect variadic calls. */
typedef __builtin_va_list MirVaList;

volatile long mir_variadic_sink;

__attribute__((noinline))
long mir_variadic_sum(unsigned count, ...) {
    MirVaList ap;
    unsigned i;
    long sum = 0;
    __builtin_va_start(ap, count);
    for (i = 0U; i < count; ++i)
        sum += __builtin_va_arg(ap, long);
    __builtin_va_end(ap);
    mir_variadic_sink = sum;
    return sum;
}

typedef long (*MirVariadicPointer)(unsigned, ...);

__attribute__((noinline))
long mir_variadic_bridge(MirVariadicPointer p, long base) {
    return p(9U, base, base + 1, base + 2, base + 3,
             base + 4, base + 5, base + 6, base + 7, base + 8);
}

int main(void) {
    return (int)(mir_variadic_bridge(mir_variadic_sum, 10L) & 255L);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/mir-migration/wide_integer.c"}
/* Native 128-bit integer Core arithmetic, shifts, comparisons, casts and
 * by-value ABI. RV32I must preserve the same unsigned 128-bit semantics. */
typedef unsigned __int128 MirU128;
typedef __int128 MirI128;

volatile unsigned long mir_wide_sink;

__attribute__((noinline))
MirU128 mir_wide_mul(MirU128 a, MirU128 b, unsigned shift) {
    MirU128 mixed = a * b + (a ^ b);
    mixed ^= (a << (shift & 63U));
    return (mixed >> 17U) + (mixed << 9U);
}

__attribute__((noinline))
long mir_wide_compare(MirI128 a, MirI128 b) {
    MirI128 q = a * 13 - b;
    MirI128 r = (a >> 19U) ^ (b << 7U);
    MirU128 x = mir_wide_mul((MirU128)q, (MirU128)r, 13U);
    return (long)(x > (MirU128)a ? x : (MirU128)(a + r));
}

int main(void) {
    MirI128 left = ((MirI128)0x12345678 << 67U) + 0x99887766;
    MirI128 right = ((MirI128)0x44556677 << 31U) + 23;
    long value = mir_wide_compare(left, right);
    mir_wide_sink = (unsigned long)value;
    return (int)(value & 255L);
}
@@@ end
