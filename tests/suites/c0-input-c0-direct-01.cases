@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/direct_lp64_reachable_host.c"}
/* Five-ISA CFG + GNU/native x86 differential without indirect branches.
 * Separate LP64 fixture covers computed-goto address relocations. */
static int enter_case(int take) {
    int value = 0;
    if (take) goto FORWARD;
    switch (sizeof(void *)) {
    case 1: FORWARD: value = 43; break;
    case 8: value = 42; break;
    default: value = 99; break;
    }
    return value;
}

int main(void) {
    return enter_case(0) == 42 && enter_case(1) == 43 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/direct_lp64_reachable_source_labels.c"}
/* A machine block can be reached without an ordinary CFG predecessor:
 * - a static &&label relocation, - a dynamic block address, and
 * - a forward goto into an otherwise dead lexical switch case.
 * All labels must remain roots when direct LP64 emitters skip dead blocks. */
static int static_dispatch(int n) {
    static void *const labels[] = {&&first, &&second, &&third};
    if (n < 0 || n > 2) return 0;
    goto *labels[n];
first:
    return 10;
second:
    return 20;
third:
    return 42;
}

static int dynamic_dispatch(int n) {
    void *address = &&miss;
    if (n != 0) address = &&hit;
    goto *address;
hit:
    return 42;
miss:
    return 7;
}

static int external_switch_reentry(int enter) {
    int result = 0;
    if (enter) goto FORWARD;
    switch (sizeof(void *)) {
    case 1: FORWARD: result = 43; break;
    case 8: result = 42; break;
    default: result = 99; break;
    }
    return result;
}

int main(void) {
    return static_dispatch(0) == 10 && static_dispatch(1) == 20 &&
           static_dispatch(2) == 42 && static_dispatch(3) == 0 &&
           dynamic_dispatch(0) == 7 && dynamic_dispatch(1) == 42 &&
           external_switch_reentry(0) == 42 &&
           external_switch_reentry(1) == 43 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/direct_lp64_source_object_slot_reuse.c"}
/* The LP64 source-object stack pool must use the existing RV Core interval
 * proof.  Temporary address-backed scalars with disjoint lifetimes may share
 * storage; pointers that escape and locals read across CFG joins may not. */

#define LOCAL_STEP(k) \
    volatile int local_##k = (seed ^ (k)) + 3; \
    sum += local_##k;

volatile int *lp64_slot_first;
volatile int *lp64_slot_second;

static void retain_both(volatile int *first, volatile int *second) {
    lp64_slot_first = first;
    lp64_slot_second = second;
}

int lp64_disjoint_local_slots(int seed) {
    int sum = 0;
    LOCAL_STEP(1); LOCAL_STEP(2); LOCAL_STEP(3); LOCAL_STEP(4);
    LOCAL_STEP(5); LOCAL_STEP(6); LOCAL_STEP(7); LOCAL_STEP(8);
    LOCAL_STEP(9); LOCAL_STEP(10); LOCAL_STEP(11); LOCAL_STEP(12);
    LOCAL_STEP(13); LOCAL_STEP(14); LOCAL_STEP(15); LOCAL_STEP(16);
    LOCAL_STEP(17); LOCAL_STEP(18); LOCAL_STEP(19); LOCAL_STEP(20);
    LOCAL_STEP(21); LOCAL_STEP(22); LOCAL_STEP(23); LOCAL_STEP(24);
    LOCAL_STEP(25); LOCAL_STEP(26); LOCAL_STEP(27); LOCAL_STEP(28);
    LOCAL_STEP(29); LOCAL_STEP(30); LOCAL_STEP(31); LOCAL_STEP(32);
    LOCAL_STEP(33); LOCAL_STEP(34); LOCAL_STEP(35); LOCAL_STEP(36);
    LOCAL_STEP(37); LOCAL_STEP(38); LOCAL_STEP(39); LOCAL_STEP(40);
    LOCAL_STEP(41); LOCAL_STEP(42); LOCAL_STEP(43); LOCAL_STEP(44);
    LOCAL_STEP(45); LOCAL_STEP(46); LOCAL_STEP(47); LOCAL_STEP(48);
    LOCAL_STEP(49); LOCAL_STEP(50); LOCAL_STEP(51); LOCAL_STEP(52);
    LOCAL_STEP(53); LOCAL_STEP(54); LOCAL_STEP(55); LOCAL_STEP(56);
    LOCAL_STEP(57); LOCAL_STEP(58); LOCAL_STEP(59); LOCAL_STEP(60);
    LOCAL_STEP(61); LOCAL_STEP(62); LOCAL_STEP(63); LOCAL_STEP(64);
    return sum;
}

int lp64_escape_preserves_independent_slots(int seed) {
    int first = seed + 11;
    int second = seed + 19;
    retain_both(&first, &second);
    if (lp64_slot_first == lp64_slot_second) return -5000;
    first += seed;
    second += seed * 2;
    return *lp64_slot_first * 3 + *lp64_slot_second * 5;
}

int lp64_crossblock_live_value(int seed) {
    int preserved = seed + 7;
    int result = 0;
    if ((seed & 1) != 0) goto JOIN;
    result += seed + 2;
JOIN:
    result += preserved;
    {
        int later = seed * 3;
        result += later;
    }
    return result;
}

int main(void) {
    const int seed = 13;
    const int expected_disjoint = lp64_disjoint_local_slots(seed);
    const int expected_escape = lp64_escape_preserves_independent_slots(seed);
    const int expected_join = lp64_crossblock_live_value(seed);
    return expected_disjoint == 2272 && expected_escape == 401 &&
           expected_join == 59 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/direct_lp64_spill_reuse_pressure.c"}
/* Shared Core last-use SSA spill allocator must drive both direct LP64
 * targets, including a zero-value function, CFG joins and address-backed
 * scalar locals. This deliberately creates >256 Core SSA results so the
 * historical value_id*8 frame exceeds LoongArch's signed-12-bit offset. */
#define SPILL_STEP(mask, gain) \
    do { if ((input & (mask)) != 0U) sum += (gain); } while (0)

void lp64_empty_values(void) { }

int lp64_spill_pressure(unsigned int input) {
    int sum = 0;
    SPILL_STEP(1U, 1); SPILL_STEP(2U, 2);
    SPILL_STEP(4U, 3); SPILL_STEP(8U, 4);
    SPILL_STEP(16U, 5); SPILL_STEP(32U, 6);
    SPILL_STEP(64U, 7); SPILL_STEP(128U, 8);
    SPILL_STEP(256U, 9); SPILL_STEP(512U, 10);
    SPILL_STEP(1024U, 11); SPILL_STEP(2048U, 12);
    SPILL_STEP(4096U, 13); SPILL_STEP(8192U, 14);
    SPILL_STEP(16384U, 15); SPILL_STEP(32768U, 16);
    SPILL_STEP(1U, 1); SPILL_STEP(2U, 2);
    SPILL_STEP(4U, 3); SPILL_STEP(8U, 4);
    SPILL_STEP(16U, 5); SPILL_STEP(32U, 6);
    SPILL_STEP(64U, 7); SPILL_STEP(128U, 8);
    SPILL_STEP(256U, 9); SPILL_STEP(512U, 10);
    SPILL_STEP(1024U, 11); SPILL_STEP(2048U, 12);
    SPILL_STEP(4096U, 13); SPILL_STEP(8192U, 14);
    SPILL_STEP(16384U, 15); SPILL_STEP(32768U, 16);
    SPILL_STEP(1U, 1); SPILL_STEP(2U, 2);
    SPILL_STEP(4U, 3); SPILL_STEP(8U, 4);
    SPILL_STEP(16U, 5); SPILL_STEP(32U, 6);
    SPILL_STEP(64U, 7); SPILL_STEP(128U, 8);
    SPILL_STEP(256U, 9); SPILL_STEP(512U, 10);
    SPILL_STEP(1024U, 11); SPILL_STEP(2048U, 12);
    SPILL_STEP(4096U, 13); SPILL_STEP(8192U, 14);
    SPILL_STEP(16384U, 15); SPILL_STEP(32768U, 16);
    if (input == 0U) goto EXIT;
    if ((input & 0x80000000U) != 0U) return -1;
EXIT:
    return sum;
}

int main(void) {
    volatile unsigned int runtime_input = 3U;
    lp64_empty_values();
    return lp64_spill_pressure(runtime_input) == 9 &&
           lp64_spill_pressure(0U) == 0 &&
           lp64_spill_pressure(65535U) == 408 ? 42 : 1;
}
@@@ end
