/* GNU mixed-void ternary is used by Linux x86's pgd_clear() macro. The
 * value-producing arm must still execute side effects exactly once. */
static int progress;

static void void_effect(int amount) {
    progress += amount;
}

static int value_effect(int amount) {
    progress += amount;
    return amount * 2;
}

void minic_mixed_void_conditional(int cond) {
    cond ? void_effect(3) : value_effect(5);
    cond ? value_effect(7) : void_effect(11);
}

void minic_constant_mixed_void(void) {
    1 ? void_effect(13) : value_effect(17);
    0 ? value_effect(19) : void_effect(23);
}

int main(void) {
    minic_mixed_void_conditional(1);
    minic_mixed_void_conditional(0);
    minic_constant_mixed_void();
    return progress == (3 + 7 + 5 + 11 + 13 + 23) ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_nested_record_member_qualifier_abi.c"}
/* A GNU record statement-expression is an rvalue; its pointer member's
 * outer const must vanish from Core SSA, while pointee const must survive. */
typedef struct QualLeaf {
    const int *const pointer;
    volatile unsigned int mark;
} QualLeaf;
typedef struct QualOuter { QualLeaf leaf; } QualOuter;

static const int selected_values[2] = { 19, 31 };
static unsigned int call_count;

__attribute__((noinline)) static QualOuter make_outer(int which) {
    QualOuter value = {
        { which ? &selected_values[1] : &selected_values[0],
          (unsigned int)(70 + which) }
    };
    call_count++;
    return value;
}

__attribute__((noinline)) const int *select_nested_pointer(int which) {
    return ({ QualOuter value = make_outer(which); value; }).leaf.pointer;
}

__attribute__((noinline)) unsigned int read_nested_volatile_twice(void) {
    QualOuter source = make_outer(0);
    /* Two distinct volatile scalar projections of a record rvalue. The
     * record copies must not suppress the member loads as ordinary SSA. */
    unsigned int first = ({ QualOuter value = source; value; }).leaf.mark;
    unsigned int second = ({ QualOuter value = source; value; }).leaf.mark;
    return first + second;
}

int main(void) {
    const int *left = select_nested_pointer(0);
    const int *right = select_nested_pointer(1);
    const unsigned int twice = read_nested_volatile_twice();
    return *left == 19 && *right == 31 && twice == 140 &&
           call_count == 3 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_nested_switch_return_reachability.c"}
/* A nested switch can return along every arm despite a trailing, dead break. */
static int nested_mode(unsigned product, unsigned mode) {
    switch (product) {
    case 11:
        switch (mode) {
        case 1: return 111;
        case 2: return 112;
        default: return -11;
        }
        break;
    case 22:
        switch (mode) {
        case 3: return 223;
        default: return -22;
        }
        break;
    default:
        return -1;
    }
}

/* A genuinely reachable break must still escape the switch. */
static int live_break(unsigned product, unsigned mode) {
    switch (product) {
    case 11:
        switch (mode) {
        case 1: return 111;
        default: break;
        }
        break;
    case 22:
        return 222;
    default:
        return -1;
    }
    return -77;
}

int main(void) {
    if (nested_mode(11, 1) != 111 || nested_mode(11, 2) != 112 ||
        nested_mode(11, 99) != -11 || nested_mode(22, 3) != 223 ||
        nested_mode(22, 0) != -22 || nested_mode(99, 0) != -1)
        return 1;
    if (live_break(11, 1) != 111 || live_break(11, 0) != -77 ||
        live_break(22, 0) != 222 || live_break(99, 0) != -1)
        return 2;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_nested_union_compound_record_array.c"}
/* Linux i915 power maps contain file-scope compound-literal record arrays
 * with two pointer relocations per row and an anonymous union of records. */
enum minic_well_id { MINIC_WELL_ALWAYS_ON = 1, MINIC_WELL_BXT = 7 };

struct minic_domain_list {
    const unsigned int *list;
    unsigned char count;
};

struct minic_well_instance {
    const char *name;
    const struct minic_domain_list *domains;
    enum minic_well_id id;
    union {
        struct { unsigned char index; } vlv;
        struct { int phy; } bxt;
        struct { unsigned char index; } hsw;
    };
};

static const unsigned int minic_domains[] = { 2, 4, 6 };
static const struct minic_domain_list minic_domain_set = { minic_domains, 3 };

#define MINIC_WELL_ROWS(...) ((const struct minic_well_instance[]) { __VA_ARGS__ })

static const struct minic_well_instance *minic_compound_wells =
    MINIC_WELL_ROWS(
        { .name = "always-on", .domains = &minic_domain_set,
          .id = MINIC_WELL_ALWAYS_ON },
        { .name = "bxt", .domains = &minic_domain_set,
          .id = MINIC_WELL_BXT, .bxt.phy = 0x1234 }
    );

int minic_nested_union_compound_result(void) {
    return (minic_compound_wells[0].id == MINIC_WELL_ALWAYS_ON &&
            minic_compound_wells[0].vlv.index == 0 &&
            minic_compound_wells[1].id == MINIC_WELL_BXT &&
            minic_compound_wells[1].bxt.phy == 0x1234 &&
            minic_compound_wells[1].domains->list[2] == 6 &&
            minic_compound_wells[0].name[0] == 'a' &&
            minic_compound_wells[1].name[1] == 'x') ? 0 : 91;
}

int main(void) { return minic_nested_union_compound_result(); }
@@@ end
