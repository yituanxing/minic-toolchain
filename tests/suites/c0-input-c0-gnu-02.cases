@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_nf_conntrack_total_size.c"}
/* Fixed Linux v6.6.143 net/netfilter/nf_conntrack_extend.c shape.
 * Reduced historical-owner candidate, NOT authenticated original frozen .i. */
typedef unsigned int u32;
enum { NF_CT_EXT_NUM = 5 };
struct nf_ct_ext { u32 offset[8]; u32 len; };
struct nf_conn_help { unsigned char data[24]; };
struct nf_conn_nat { unsigned char data[16]; };
struct nf_conn_seqadj { unsigned char data[12]; };
struct nf_conn_acct { unsigned char data[24]; };
struct nf_conntrack_ecache { unsigned char data[20]; };
struct nf_conn_tstamp { unsigned char data[16]; };

extern void __compiletime_assert_697(void);
extern void runtime_size_assert_probe(void);
static volatile u32 observable_loop_counter;

static inline __attribute__((__gnu_inline__)) __attribute__((__unused__))
    __attribute__((no_instrument_function)) __attribute__((__always_inline__))
    u32 total_extension_size(void)
{
    /* Upstream has this separate BUG_ON before the `sizeof` return. Its
     * do/while AST wrapper is significant to compile-time helper folding. */
    do {
        extern void __compiletime_assert_696(void);
        if (!(NF_CT_EXT_NUM <= 10))
            __compiletime_assert_696();
    } while (0);
    return sizeof(struct nf_ct_ext) + sizeof(struct nf_conn_help) +
           sizeof(struct nf_conn_nat) + sizeof(struct nf_conn_seqadj) +
           sizeof(struct nf_conn_acct) + sizeof(struct nf_conntrack_ecache) +
           sizeof(struct nf_conn_tstamp);
}

static u32 nf_ct_ext_add_size(void)
{
    if (total_extension_size() > 255U)
        __compiletime_assert_697();
    return total_extension_size();
}

/* The leading-loop optimization MUST reject an actual write.  The caller
 * observes this effect, so neither GNU nor MiniC may remove it while proving
 * the otherwise constant return. */
static __attribute__((always_inline)) inline u32 impure_size(void)
{
    do {
        ++observable_loop_counter;
    } while (0);
    return total_extension_size();
}

int main(void)
{
    return nf_ct_ext_add_size() == 148U &&
           impure_size() == 148U &&
           observable_loop_counter == 1U ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
u32 nf_ct_dynamic_guard(u32 externally_supplied)
{
    if (total_extension_size() + externally_supplied > 255U)
        runtime_size_assert_probe();
    return externally_supplied;
}

u32 nf_ct_inverted_guard(u32 incoming)
{
    if (incoming > total_extension_size())
        runtime_size_assert_probe();
    return incoming;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_nvme_prp_constant_guard.c"}
/* Linux 6.6.143 drivers/nvme/host/pci.i:53436-53441,55828.
 * The original GNU -E source has exactly two initialized unsigned locals;
 * BUILD_BUG_ON must reject a real runtime guard, not this constant five. */
#define NVME_PAGE_SIZE (1U << 12)
#define NVME_MAX_KB_SZ 8192U
#define NVME_MAX_NR_ALLOCATIONS 5U
#define DIV_ROUND_UP(n, d) (((n) + (d) - 1U) / (d))

static inline __attribute__((always_inline)) unsigned nvme_pci_npages_prp(void)
{
    unsigned max_bytes = (NVME_MAX_KB_SZ * 1024U) + NVME_PAGE_SIZE;
    unsigned nprps = DIV_ROUND_UP(max_bytes, NVME_PAGE_SIZE);
    return DIV_ROUND_UP(8U * nprps, NVME_PAGE_SIZE - 8U);
}

extern void __compiletime_assert_449(void)
    __attribute__((error("BUILD_BUG_ON failed: nvme_pci_npages_prp() > 5")));

int main(void)
{
    if (nvme_pci_npages_prp() > NVME_MAX_NR_ALLOCATIONS)
        __compiletime_assert_449();
    return 42;
}

#ifdef MINIC_NVME_PRP_NEGATIVES
extern volatile unsigned live_nprps;
extern void witnessed_effect(void);
extern void __compiletime_assert_runtime(void);

static inline __attribute__((always_inline)) unsigned effectful_prp(void)
{
    unsigned max_bytes = (NVME_MAX_KB_SZ * 1024U) + NVME_PAGE_SIZE;
    witnessed_effect();
    unsigned nprps = DIV_ROUND_UP(max_bytes, NVME_PAGE_SIZE);
    return DIV_ROUND_UP(8U * nprps, NVME_PAGE_SIZE - 8U);
}

unsigned negative_effect(void)
{
    return effectful_prp();
}

static inline __attribute__((always_inline)) unsigned volatile_prp(void)
{
    unsigned nprps = live_nprps;
    return DIV_ROUND_UP(8U * nprps, NVME_PAGE_SIZE - 8U);
}

void negative_volatile(void)
{
    if (volatile_prp() > NVME_MAX_NR_ALLOCATIONS)
        __compiletime_assert_runtime();
}

static inline __attribute__((always_inline)) unsigned parameter_prp(unsigned nprps)
{
    return DIV_ROUND_UP(8U * nprps, NVME_PAGE_SIZE - 8U);
}

void negative_argument(unsigned nprps)
{
    if (parameter_prp(nprps) > NVME_MAX_NR_ALLOCATIONS)
        __compiletime_assert_runtime();
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_static_field_guard.c"}
/* GNU Linux bitfield.h-style diagnostics inside an ordinary TU-local static
 * function.  Its mask is a formal parameter, but every live caller supplies
 * a compile-time constant.  MiniC must specialize the call without a GCC C
 * fallback and must not synthesize definitions for diagnostic externs. */
extern void invalid_field_mask(void)
    __attribute__((error("field mask must be constant and contiguous")));

static unsigned long read_field(unsigned long reg, unsigned long mask)
{
    unsigned long shifted;
    if (!__builtin_constant_p(mask))
        invalid_field_mask();
    if (mask == 0UL)
        invalid_field_mask();
    shifted = mask >> __builtin_ctzl(mask);
    if ((shifted & (shifted + 1UL)) != 0UL)
        invalid_field_mask();
    return (reg & mask) >> __builtin_ctzl(mask);
}

static unsigned long use_two_fields(unsigned long reg)
{
    return read_field(reg, 0x00000070UL) +
           read_field(reg, 0x0000f000UL);
}

int main(void)
{
#if defined(TEST_DYNAMIC_FIELD_GUARD)
    volatile unsigned long dynamic_mask = 0x70UL;
    return (int)read_field(0x15d40UL, dynamic_mask);
#elif defined(TEST_INVALID_FIELD_GUARD)
    return (int)read_field(0x15d40UL, 0x000000a0UL);
#else
    return use_two_fields(0x15d40UL) != 9UL;
#endif
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_task_mmu_swp_pfn_guard.c"}
/* Linux 6.6.143 fs/proc/task_mmu.c -> include/linux/swapops.h:
 * is_pfn_swap_entry(): BUILD_BUG_ON(SWP_TYPE_SHIFT < SWP_PFN_BITS).
 * The exact frozen GNU .i spells the bound as
 *     58 < ((feature ? 52 : 46) - 12).
 * This standalone model is NOT the frozen original and must not certify
 * whole-kernel GNU LD/QEMU on its own. */
typedef unsigned long u64;
static volatile unsigned int observed_feature_reads;

extern void __compiletime_assert_347(void);

static unsigned int boot_cpu_feature(void)
{
    ++observed_feature_reads;
    return observed_feature_reads & 1U;
}

static u64 is_pfn_swap_entry_guard_model(void)
{
    u64 pfn_bits = (boot_cpu_feature() ? 52UL : 46UL) - 12UL;
    if (58UL < pfn_bits)
        __compiletime_assert_347();
    return pfn_bits;
}

int main(void)
{
    u64 first = is_pfn_swap_entry_guard_model();
    u64 second = is_pfn_swap_entry_guard_model();
    return first == 40UL && second == 34UL &&
           observed_feature_reads == 2U ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
extern void runtime_pfn_bits_probe(void);
extern u64 dangerous_pfn_bits_source(void);

/* A runtime-dependent branch may genuinely produce a value > 58. */
u64 dynamic_high_pfn_bits(int active)
{
    u64 bits = (active ? dangerous_pfn_bits_source() : 46UL) - 12UL;
    if (58UL < bits)
        runtime_pfn_bits_probe();
    return bits;
}

/* A literal high branch is still unsafe, despite the other being 46. */
u64 fixed_high_pfn_bits(int active)
{
    u64 bits = (active ? 80UL : 46UL) - 12UL;
    if (58UL < bits)
        runtime_pfn_bits_probe();
    return bits;
}

/* A changed local must not inherit the original two-constant bound. */
u64 escaped_pfn_bits(int active)
{
    u64 bits = (active ? 52UL : 46UL) - 12UL;
    bits |= dangerous_pfn_bits_source();
    if (58UL < bits)
        runtime_pfn_bits_probe();
    return bits;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_zoned_constant_switch.c"}
/* CONFIG_BLK_DEV_ZONED=n: a dead `return q->limits.zoned` must not keep a
 * runtime zoned callback alive through an inline switch/helper/getter chain.
 * The companion dynamic case exercises the opposite live-reference edge. */
struct minic_zoned_queue {
    int model;
};

struct minic_zoned_disk {
    struct minic_zoned_queue *queue;
};

extern int minic_disabled_zoned_must_not_resolve(void);
extern int minic_dynamic_zoned_must_resolve(void);

static volatile int minic_dynamic_zoned_enabled = 1;
volatile int minic_zoned_getter_visits;

static inline int minic_disabled_zoned_model(struct minic_zoned_queue *queue)
{
    if (0)
        return queue->model;
    return 0;
}

static inline int minic_dynamic_zoned_model(struct minic_zoned_queue *queue)
{
    if (minic_dynamic_zoned_enabled)
        return queue->model;
    return 0;
}

static inline int minic_disabled_queue_is_zoned(struct minic_zoned_queue *queue)
{
    switch (minic_disabled_zoned_model(queue)) {
    case 1:
    case 2:
        return 1;
    default:
        return 0;
    }
}

static inline int minic_dynamic_queue_is_zoned(struct minic_zoned_queue *queue)
{
    switch (minic_dynamic_zoned_model(queue)) {
    case 1:
    case 2:
        return 1;
    default:
        return 0;
    }
}

static inline struct minic_zoned_queue *
minic_disk_queue(struct minic_zoned_disk *disk)
{
    return disk->queue;
}

int minic_disabled_zoned_entry(struct minic_zoned_disk *disk)
{
    if (minic_disabled_queue_is_zoned(minic_disk_queue(disk)))
        return minic_disabled_zoned_must_not_resolve();
    return 41;
}

int minic_dynamic_zoned_entry(struct minic_zoned_disk *disk)
{
    if (minic_dynamic_queue_is_zoned(minic_disk_queue(disk)))
        return minic_dynamic_zoned_must_resolve();
    return 43;
}

static inline struct minic_zoned_queue *
minic_disk_queue_with_effect(struct minic_zoned_disk *disk)
{
    ++minic_zoned_getter_visits;
    return disk->queue;
}

int minic_zoned_getter_effect_entry(struct minic_zoned_disk *disk)
{
    struct minic_zoned_queue *queue = minic_disk_queue_with_effect(disk);
    return queue->model + minic_zoned_getter_visits;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_zoned_constant_switch_driver.c"}
struct minic_zoned_queue {
    int model;
};

struct minic_zoned_disk {
    struct minic_zoned_queue *queue;
};

extern volatile int minic_zoned_getter_visits;
extern int minic_disabled_zoned_entry(struct minic_zoned_disk *disk);
extern int minic_dynamic_zoned_entry(struct minic_zoned_disk *disk);
extern int minic_zoned_getter_effect_entry(struct minic_zoned_disk *disk);

int minic_dynamic_zoned_must_resolve(void)
{
    return 97;
}

int main(void)
{
    struct minic_zoned_queue queue = {1};
    struct minic_zoned_disk disk = {&queue};
    if (minic_disabled_zoned_entry(&disk) != 41)
        return 1;
    if (minic_dynamic_zoned_entry(&disk) != 97)
        return 2;
    if (minic_zoned_getter_effect_entry(&disk) != 2 ||
        minic_zoned_getter_visits != 1)
        return 3;
    return 0;
}
