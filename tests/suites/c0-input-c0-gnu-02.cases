    [0].mcr_reg = (MinicReg){.reg = 0xced8U},
    [1].mcr_reg = (MinicReg){.reg = 0xcedcU},
    [2].mcr_reg = (MinicReg){.reg = 0xcee0U},
    [3].mcr_reg = (MinicReg){.reg = 0xcee4U},
    [5].mcr_reg = (MinicReg){.reg = 0xcf04U},
