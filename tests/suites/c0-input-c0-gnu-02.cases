/* A GNU static union designator may create many anonymous record types while
 * evaluating sizeof(). The growable parser->program->records array may move;
 * an outer union descriptor must not retain an arena pointer across it. */
#define A(N) sizeof(struct { unsigned char member_##N; })
union trap_config {
    unsigned long long raw;
    struct {
        unsigned long long fgt : 8;
        unsigned long long bit : 8;
        unsigned long long unused : 48;
    };
};

static const union trap_config traps[] = {
    { .fgt = 3 + ((
        A(1) + A(2) + A(3) + A(4) + A(5) + A(6) + A(7) + A(8) +
        A(9) + A(10) + A(11) + A(12) + A(13) + A(14) + A(15) + A(16) +
        A(17) + A(18) + A(19) + A(20) + A(21) + A(22) + A(23) + A(24) +
        A(25) + A(26) + A(27) + A(28) + A(29) + A(30) + A(31) + A(32) +
        A(33) + A(34) + A(35) + A(36) + A(37) + A(38) + A(39) + A(40) +
        A(41) + A(42) + A(43) + A(44) + A(45) + A(46) + A(47) + A(48) +
        A(49) + A(50) + A(51) + A(52) + A(53) + A(54) + A(55) + A(56) +
        A(57) + A(58) + A(59) + A(60) + A(61) + A(62) + A(63) + A(64)) & 7),
      .bit = 5 + ((
        A(65) + A(66) + A(67) + A(68) + A(69) + A(70) + A(71) + A(72) +
        A(73) + A(74) + A(75) + A(76) + A(77) + A(78) + A(79) + A(80) +
        A(81) + A(82) + A(83) + A(84) + A(85) + A(86) + A(87) + A(88) +
        A(89) + A(90) + A(91) + A(92) + A(93) + A(94) + A(95) + A(96) +
        A(97) + A(98) + A(99) + A(100) + A(101) + A(102) + A(103) + A(104) +
        A(105) + A(106) + A(107) + A(108) + A(109) + A(110) + A(111) + A(112) +
        A(113) + A(114) + A(115) + A(116) + A(117) + A(118) + A(119) + A(120) +
        A(121) + A(122) + A(123) + A(124) + A(125) + A(126) + A(127) + A(128)) & 7) },
};

int main(void) { return traps[0].fgt == 3 && traps[0].bit == 5 ? 0 : 1; }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_static_union_anonymous_record_designator.c"}
/* arch/arm64/kvm/emulate-nested.c uses promoted anonymous bitfields in
 * designated static union initializers nested inside arrays of records. */
union trap_config {
    unsigned long long val;
    struct {
        unsigned long long cgt:10;
        unsigned long long fgt:4;
        unsigned long long bit:6;
        unsigned long long pol:1;
        unsigned long long fgf:5;
        unsigned long long unused:37;
        unsigned long long mbz:1;
    };
};

struct encoding_to_trap_config {
    const unsigned int encoding;
    const unsigned int end;
    const union trap_config tc;
    const unsigned int line;
};

static const struct encoding_to_trap_config entries[] = {
    {.encoding = 11, .end = 11, .tc = {.cgt = 3}, .line = 21},
    {.encoding = 12, .end = 12,
     .tc = {.fgt = 2, .bit = 4, .pol = 1, .fgf = 3}, .line = 22},
    {.encoding = 13, .end = 13, .tc = {.val = 41}, .line = 23}
};

int main(void) {
    return entries[0].tc.cgt != 3 || entries[0].tc.val != 3 ||
           entries[1].tc.fgt != 2 || entries[1].tc.bit != 4 ||
           entries[1].tc.pol != 1 || entries[1].tc.fgf != 3 ||
           entries[2].tc.val != 41 || entries[2].line != 23;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_tee_nested_const_record_member.c"}
typedef struct KUid { unsigned int val; } KUid;
typedef struct Cred { KUid euid; } Cred;
static Cred credential = { { 77U } };
static volatile Cred volatile_credential = { { 145U } };
static unsigned int credential_calls;
static unsigned int volatile_credential_calls;

static const Cred *current_cred(void) { credential_calls++; return &credential; }
static const volatile Cred *current_cred_volatile(void) {
    volatile_credential_calls++;
    return &volatile_credential;
}
extern int snprintf(char *buffer, unsigned long size, const char *format, ...);

int current_uid(char *buffer) {
    return snprintf(buffer, 128UL, "uid=%x",
        (({ ({ do { } while (0); ;
               ((typeof(*(current_cred())) *)(current_cred()));
            })->euid; })).val);
}

int current_uid_volatile(char *buffer) {
    return snprintf(buffer, 128UL, "uid=%x",
        (({ ({ do { } while (0); ;
               ((typeof(*(current_cred_volatile())) *)(current_cred_volatile()));
            })->euid; })).val);
}

int main(void) {
    char first[128], second[128];
    return current_uid(first) == 6 && first[0] == 'u' &&
        first[4] == '4' && first[5] == 'd' && first[6] == 0 &&
        current_uid_volatile(second) == 6 && second[0] == 'u' &&
        second[4] == '9' && second[5] == '1' && second[6] == 0 &&
        credential_calls == 1 && volatile_credential_calls == 1 ? 0 : 1;
}
@@@ end
