@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_transparent_union_callback.c"}
/* Original BusyBox libbb/xconnect.c meets glibc getsockname:
 * a function whose second parameter is a GNU transparent-union pointer
 * is passed where the consumer declares the union's FIRST pointer member.
 * This must preserve the C function-pointer ABI without accepting unrelated
 * incompatible signatures. */
#include <stdio.h>
struct MiniSockaddr { int family; };
typedef union {
    struct MiniSockaddr *sa;
    void *opaque;
} MiniSockaddrArg __attribute__((__transparent_union__));

static int read_address(int fd, MiniSockaddrArg addr, unsigned *length)
{
    if (addr.sa == 0 || length == 0 || *length != 4U)
        return -1;
    ++*length;
    return fd + addr.sa->family + (int)*length;
}

static int run_callback(int fd,
                        int (*getter)(int, struct MiniSockaddr *, unsigned *))
{
    struct MiniSockaddr addr = {17};
    unsigned length = 4U;
    int result = getter(fd, &addr, &length);
    return result + (int)length;
}

int main(void)
{
    int result = run_callback(7, read_address);
    if (result != 34) {
        printf("bad=%d\n", result);
        return 1;
    }
    puts("transparent-union-callback: 34");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_typedef_nonredundant_aligned.c"}
typedef int over_aligned_int __attribute__((aligned(16)));

struct aligned_holder {
    char prefix;
    over_aligned_int value;
};

struct call_single_shape {
    unsigned long words[2];
};

typedef struct call_single_shape call_single_shape_t
    __attribute__((__aligned__(sizeof(struct call_single_shape))));

_Static_assert(__alignof__(over_aligned_int) == 16, "typedef minimum alignment");
_Static_assert(__builtin_offsetof(struct aligned_holder, value) == 16,
               "record field consumes typedef alignment");
_Static_assert(sizeof(struct aligned_holder) == 32, "record size consumes typedef alignment");
_Static_assert(sizeof(struct call_single_shape) == 16, "fixture shape size");
_Static_assert(__alignof__(call_single_shape_t) == 16, "sizeof expression alignment");

over_aligned_int read_over_aligned(over_aligned_int value) {
    return value;
}

unsigned long aligned_holder_size(void) {
    return sizeof(struct aligned_holder);
}

unsigned long call_single_alignment(void) {
    return __alignof__(call_single_shape_t);
}
@@@ end
