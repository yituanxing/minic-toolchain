@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_is_constexpr_bitfield.c"}
/* Linux 6.6 i915_reg_defs.h uses BUILD_BUG_ON_ZERO(-!!(condition)) and
 * __is_constexpr to validate register bitfields at compile time. The C
 * conditional operator must distinguish an integer ICE zero cast to void*
 * from an otherwise identical runtime expression: only the ICE is a null
 * pointer constant, so the conditional's pointer type changes. */
#define KERNEL_IS_CONSTEXPR(x) \
    (sizeof(int) == sizeof(*(8 ? ((void *)((long)(x) * 0L)) : (int *)8)))
#define KERNEL_BUILD_BUG_ON_ZERO(e) ((int)sizeof(struct { int : (-!!(e)); }))
#define KERNEL_BF_SHF(x) (__builtin_ffsll(x) - 1)
#define KERNEL_POWER_OF_TWO(x) ((x) && (((x) & ((x) - 1)) == 0))
#define KERNEL_PREP(mask, value) \
    ((unsigned)((((__typeof__(mask))(value) << KERNEL_BF_SHF(mask)) & (mask)) + \
    KERNEL_BUILD_BUG_ON_ZERO(!KERNEL_IS_CONSTEXPR(mask)) + \
    KERNEL_BUILD_BUG_ON_ZERO((mask) == 0 || (mask) > 4294967295U) + \
    KERNEL_BUILD_BUG_ON_ZERO(!KERNEL_POWER_OF_TWO((mask) + \
                               (1ULL << KERNEL_BF_SHF(mask)))) + \
    KERNEL_BUILD_BUG_ON_ZERO(__builtin_choose_expr( \
        KERNEL_IS_CONSTEXPR(value), \
        (~((mask) >> KERNEL_BF_SHF(mask)) & (value)), 0))))

#if defined(REJECT_ZERO_MASK)
unsigned reject_bad_mask(void) { return KERNEL_PREP(0U, 2U); }
#elif defined(REJECT_OUT_OF_RANGE_VALUE)
unsigned reject_bad_value(void) { return KERNEL_PREP(0xF0U, 32U); }
#else
_Static_assert(KERNEL_IS_CONSTEXPR(0xF0U), "integer ICE zero is a null pointer constant");
_Static_assert(sizeof(*(8 ? (void *)((long)0xF0U * 0L) : (int *)8)) == sizeof(int),
               "ICE zero must retain the int pointer arm");

unsigned kernel_i915_bitfield_probe(unsigned runtime) {
    /* Runtime x * 0 is still NOT an integer constant expression. The
     * conditional must instead select composite void*, GNU sizeof(void)=1. */
    _Static_assert(!KERNEL_IS_CONSTEXPR(runtime), "runtime zero is not an ICE");
    _Static_assert(sizeof(*(8 ? (void *)((long)runtime * 0L) : (int *)8)) == 1,
                   "non-ICE conditional must retain void pointer arm");
    return KERNEL_PREP(0xF0U, 2U) + KERNEL_PREP(0xF0U, runtime);
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_bpf_union_zero.c"}
/* Linux 6.6.143 kernel/bpf/helpers.c union spinlock zero test shape.
 * A reduced source model, NOT an authenticated frozen GNU Linux .i owner.
 * The same GNU-preprocessed file must pass both GNU -O2 and MiniC codegen. */
typedef unsigned int u32;
typedef struct { u32 value; } TinySpinlock;
typedef union { u32 word; TinySpinlock lock; } TinySpinWord;

extern void __compiletime_assert_758(void);

int bpf_union_zero_assert_model(u32 *spinword)
{
    /* Exact fixed-kernel ordering: __bpf_spin_lock declares its alias to
     * the incoming lock before the local designated-initialized union. */
    u32 *l = (void *)spinword;
    TinySpinWord u = { .lock = { .value = 0U } };
    if (u.word != 0U)
        __compiletime_assert_758();
    return (int)u.word + (l != (void *)0);
}

int main(void)
{
    u32 lock_word = 0;
    return bpf_union_zero_assert_model(&lock_word) == 1 ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
/* Each case must retain all possible live writes and side effects.  An
 * initial zero union may not be used to prove a subsequently changed or
 * escaped object remains zero. Volatile union reads must stay observable. */
extern void runtime_nonzero_probe(void);
extern void mutate_spinword(TinySpinWord *);

u32 bpf_union_dynamic_write(u32 input)
{
    TinySpinWord u = { .lock = { .value = 0U } };
    u.word = input;
    if (u.word != 0U)
        runtime_nonzero_probe();
    return u.word;
}

u32 bpf_union_escaped_write(void)
{
    TinySpinWord u = { .lock = { .value = 0U } };
    mutate_spinword(&u);
    if (u.word != 0U)
        runtime_nonzero_probe();
    return u.word;
}

u32 bpf_union_volatile_read(u32 input)
{
    volatile TinySpinWord u = { .lock = { .value = 0U } };
    if (input != 0U)
        u.word = input;
    if (u.word != 0U)
        runtime_nonzero_probe();
    return u.word;
}

u32 bpf_union_nonzero_initializer(void)
{
    TinySpinWord u = { .lock = { .value = 1U } };
    if (u.word != 0U)
        runtime_nonzero_probe();
    return u.word;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_i915_irq_known_zero.c"}
/* Fixed Linux 6.6.143 intel_gt_irq.c: gen11_gt_irq_postinstall's essential
 * BUILD_BUG_ON(irqs & 0xffff0000) shape. This is a model of the source,
 * NOT an authenticated frozen .i proof for the remaining x86 GNU LD owner.
 * The difference from an expression-only mask proof is a conditional update
 * to a local object, followed by a control-flow merge and then a read. */
typedef unsigned int u32;

extern void __compiletime_assert_461(void)
    __attribute__((__error__("i915 interrupt bits must remain low16")));

static volatile unsigned int observed_conditions;

static int intel_uc_wants_guc_submission(u32 configured)
{
    ++observed_conditions;
    return configured != 0U;
}

static u32 gen11_gt_irq_postinstall(u32 configured)
{
    u32 irqs = 0x00000100U;
    if (!intel_uc_wants_guc_submission(configured))
        irqs |= 0x00000004U | 0x00000010U | 0x00000020U;

    if (irqs & 0xffff0000U)
        __compiletime_assert_461();
    return irqs;
}

int main(int argc, char **argv)
{
    u32 a, b;
    (void)argv;
    a = gen11_gt_irq_postinstall((u32)(argc - 1));
    b = gen11_gt_irq_postinstall((u32)argc);
    return a == 0x00000134U && b == 0x00000100U &&
        observed_conditions == 2U ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
/* These MUST retain the external call. A possible-one-bits dataflow fact
 * cannot survive unknown compound OR, escaped locals or volatile accesses. */
extern void runtime_dynamic_highbits_probe(void);
extern void runtime_escaped_highbits_probe(void);
extern void runtime_volatile_highbits_probe(void);
extern void runtime_constant_highbits_probe(void);
extern void mutate_irqs(u32 *);

u32 dynamic_highbits(u32 incoming, int enabled)
{
    u32 irqs = 0x00000100U;
    if (enabled)
        irqs |= incoming;
    if (irqs & 0xffff0000U)
        runtime_dynamic_highbits_probe();
    return irqs;
}

u32 constant_highbits(int enabled)
{
    u32 irqs = 0x00000100U;
    if (enabled)
        irqs |= 0x80000000U;
    if (irqs & 0xffff0000U)
        runtime_constant_highbits_probe();
    return irqs;
}

u32 escaped_local_highbits(u32 incoming)
{
    u32 irqs = incoming & 0xffffU;
    mutate_irqs(&irqs);
    if (irqs & 0xffff0000U)
        runtime_escaped_highbits_probe();
    return irqs;
}

u32 volatile_local_highbits(u32 incoming)
{
    volatile u32 irqs = incoming & 0xffffU;
    if (incoming & 1U)
        irqs |= 0x20U;
    if (irqs & 0xffff0000U)
        runtime_volatile_highbits_probe();
    return irqs;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_ioremap_inline_arg_guard.c"}
/* Fixed Linux v6.6.143 arch/x86/mm/ioremap.c and asm-generic/fixmap.h:
 * early_ioremap_init calls fix_to_virt(0), whose pure always-inline body
 * starts with the parameter-dependent BUILD_BUG_ON(idx >= limit). This
 * models the real frozen .i failure; it does not replace its SHA evidence. */
typedef unsigned int u32;
typedef unsigned long ulong;

extern void __compiletime_assert_183(void);
extern void __compiletime_assert_369(void);

static inline __attribute__((always_inline)) ulong fix_to_virt(u32 idx)
{
    do {
        if (idx >= 1024U)
            __compiletime_assert_183();
    } while (0);
    return 0xffffffffff5ff000UL - ((ulong)idx << 12);
}

int main(void)
{
    do {
        if ((fix_to_virt(0U) + 4096UL) & ((1UL << 21) - 1UL))
            __compiletime_assert_369();
    } while (0);
    return fix_to_virt(0U) == 0xffffffffff5ff000UL ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
extern void runtime_guard_side_effect(u32);
volatile u32 observed_guard;

/* A nonconstant parameter may enter the diagnostic path. Do not treat the
 * pure guard-loop admission at call-site zero as a function-wide theorem. */
ulong negative_dynamic_idx(u32 idx)
{
    return fix_to_virt(idx);
}

/* A truly dynamic loop guard has observable side effects even when the
 * helper's returned integer is constant at the call site. */
static inline __attribute__((always_inline)) ulong volatile_guard(u32 idx)
{
    do {
        if (observed_guard)
            runtime_guard_side_effect(idx);
    } while (0);
    return 0xffffffffff5ff000UL - ((ulong)idx << 12);
}

ulong negative_volatile_guard(void)
{
    return volatile_guard(0U);
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_kaslr_addr_range_guard.c"}
/* Fixed Linux 6.6.143 arch/x86/mm/kaslr.c: kernel_randomize_memory().
 * Source-level model of the original GNU frozen .i:30937-30941.  The
 * pgtable_l5_enabled() condition is runtime-dependent and MUST run, but
 * both candidate address-space bases lie below CPU_ENTRY_AREA_BASE.
 * Not an authenticated execution of the complete frozen Kbuild owner. */
#define __PAGE_OFFSET_BASE_L5 0xff11000000000000UL
#define __PAGE_OFFSET_BASE_L4 0xffff888000000000UL
#define CPU_ENTRY_AREA_BASE ((-4UL) << 39)

static const unsigned long vaddr_end = CPU_ENTRY_AREA_BASE;
extern void __compiletime_assert_287(void);

static int probe_count;
static int pgtable_l5_enabled(int config)
{
    probe_count++;
    return config != 0;
}

static unsigned long kernel_randomize_memory_shape(int config)
{
    unsigned long vaddr_start;
    unsigned long vaddr;
    vaddr_start = pgtable_l5_enabled(config) ?
        __PAGE_OFFSET_BASE_L5 : __PAGE_OFFSET_BASE_L4;
    vaddr = vaddr_start;
    if (vaddr_start >= vaddr_end)
        __compiletime_assert_287();
    return vaddr;
}

int main(void)
{
    unsigned long l5 = kernel_randomize_memory_shape(1);
    unsigned long l4 = kernel_randomize_memory_shape(0);
    return probe_count == 2 && l5 == __PAGE_OFFSET_BASE_L5 &&
           l4 == __PAGE_OFFSET_BASE_L4 ? 42 : 1;
}

#ifdef MINIC_NEGATIVE_CASES
extern void observed_above_end(void);
static volatile unsigned long dynamic_address;

unsigned long kaslr_dynamic_invalid(int config)
{
    unsigned long start = config ? __PAGE_OFFSET_BASE_L5 : dynamic_address;
    if (start >= vaddr_end)
        observed_above_end();
    return start;
}

unsigned long kaslr_static_invalid(int config)
{
    unsigned long start = config ? __PAGE_OFFSET_BASE_L5 : ~0UL;
    if (start >= vaddr_end)
        observed_above_end();
    return start;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_linux_kbuild_disjoint_bitmask_assert.c"}
/* Exact essential GNU -E fs/exec.c BUILD_BUG_ON condition, stripped of
 * unrelated Linux headers.  Runtime-dependent VM_EXEC is strictly disjoint
 * from VM_STACK_INCOMPLETE_SETUP and cannot reach the diagnostic call. */
typedef unsigned int u32;
struct task_snapshot { u32 personality; };
static volatile int observed_side_effects;

extern void __compiletime_assert_707(void)
    __attribute__((__noreturn__, __error__("VM_STACK_FLAGS & VM_STACK_INCOMPLETE_SETUP")));

static int linux_stack_flags(struct task_snapshot *task) {
    if (!(!((0x00000100 | (0x00000001 | 0x00000002 |
                    ((task->personality & 0x00200000) ? 0x00000004 : 0) |
                    0x00000010 | 0x00000020 | 0x00000040) |
               0x00100000) & (0x00010000 | 0x00008000 | 0)))) {
        __compiletime_assert_707();
    }
    return task->personality & 1U ? 42 : 41;
}

static u32 snapshot_personality(struct task_snapshot *task) {
    ++observed_side_effects;
    return task->personality;
}

static void linux_stack_flags_effectful(struct task_snapshot *task) {
    if (!(!((0x00000100 | (0x00000001 | 0x00000002 |
                    ((snapshot_personality(task) & 0x00200000) ? 0x00000004 : 0) |
                    0x00000010 | 0x00000020 | 0x00000040) |
               0x00100000) & (0x00010000 | 0x00008000 | 0)))) {
        __compiletime_assert_707();
    }
}

int main(int argc, char **argv) {
    struct task_snapshot task;
    (void)argv;
    task.personality = (u32)argc;
    linux_stack_flags_effectful(&task);
    return observed_side_effects == 1 ? linux_stack_flags(&task) : 1;
}
