@@@ {"id": "9ef4c79ea956c9cf", "kind": "shared", "newline": true}
set -Eeuo pipefail
minic="${1:?expected minic-cc}"
test -x "$minic"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
@@@ end
@@@ {"head_lines": 5, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-aarch64-linux-alt-cap-bounds.sh", "shared": "9ef4c79ea956c9cf"}
#!/usr/bin/env bash
# Verify the two *different* Linux arm64 ELF feature alternatives through
# their entire legal capability encoding range, including the callback bit.
# This complements the GNU/QEMU one-value execution probe. The machine must
# never truncate/alias out-of-range cpucaps into an apparently valid .hword.
source="$root/tests/compiler/c0/aarch64-linux-cap-alternative.c"

compile_variant() {
    local label="$1" cap="$2"
    sed "s/38UL/${cap}UL/g" "$source" >"$work/$label.c"
    cc -E -P -x c "$work/$label.c" -o "$work/$label.i"
    "$minic" --target=aarch64-linux -S "$work/$label.i" \
        -o "$work/$label.s"
}

for cap in 0 1 31 127 255 1023 4095 16383 32767; do
    compile_variant "cap$cap" "$cap"
    asm="$work/cap$cap.s"
    # Non-callback cap: one 16-bit CPU feature value; callback cap: bit15
    # signals patch-via-callback instead of replacing an instruction.
    grep -Fq " .hword $cap" "$asm"
    grep -Fq " .hword (1 << 15) | ($cap)" "$asm"
    test "$(grep -Fc '.pushsection .altinstructions' "$asm")" -eq 2
    test "$(grep -Fc '.word alt_cb_patch_nops- .' "$asm")" -eq 1
    test "$(grep -Fc '.word 663f - .' "$asm")" -eq 1
    test "$(grep -Fc '.byte 662b-661b' "$asm")" -eq 2
    test "$(grep -Fc '.byte 664f-663f' "$asm")" -eq 2
    test "$(grep -Fc '.previous' "$asm")" -eq 1
    test "$(grep -Fc '.subsection 1' "$asm")" -eq 1
    # Both asm-goto branches must name real emitted Core block labels;
    # neither may be erased or redirected to an invented local label.
    # Inline-GNU %l[l_yes]/%l[l_no] binds to Core's exported C label,
    # while MachineIR-internal CFG jumps deliberately use .Lminic_mir_*.
    # Check exactly two real asm-goto branches, one inside each helper, and
    # verify every branch target is an emitted local label in the same helper.
    test "$(grep -Ec $'^\tb\t\\.Luser_[0-9]+$' "$asm")" -eq 2
    for helper in linux_has_cap_unlikely linux_has_cap_likely; do
        target="$(sed -n -E "/^${helper}:/,/^\.size ${helper},/s/^[[:space:]]*b[[:space:]]+(\.Luser_[0-9]+)$/\1/p" "$asm")"
        test -n "$target"
        test "$(printf '%s\n' "$target" | wc -l)" -eq 1
        grep -Fxq "${target}:" "$asm"
    done
done

# 32768 already overlaps the callback marker. 65535/65536 test hword
# overflow, and 4294967295 catches host-int coercion or silent wrapping.
# The source is otherwise legitimate: a reject must come from the target
# number-width contract, and must not leave behind a misleading .s file.
for cap in 32768 32769 65535 65536 4294967295; do
    sed "s/38UL/${cap}UL/g" "$source" >"$work/reject$cap.c"
    cc -E -P -x c "$work/reject$cap.c" -o "$work/reject$cap.i"
    if "$minic" --target=aarch64-linux -S "$work/reject$cap.i" \
        -o "$work/reject$cap.s" >"$work/reject$cap.log" 2>&1; then
        echo "Linux arm64 cap $cap silently truncated into .hword" >&2
        exit 1
    fi
    test ! -e "$work/reject$cap.s"
done

# GNU's accepted immediate expression can be assembly-checked when the
# actual cross assembler is present. This is NOT a QEMU/kernel proof.
if [[ "${MINIC_SOURCE_ONLY:-0}" != 1 ]]; then
    command -v aarch64-linux-gnu-gcc >/dev/null
    for cap in 0 127 4095 32767; do
        aarch64-linux-gnu-gcc -c -x assembler "$work/cap$cap.s" \
            -o "$work/cap$cap.o"
        readelf -W -S "$work/cap$cap.o" | grep -Fq '.altinstructions'
        # Two 12-byte Linux alt_instr records: one direct alternate and one
        # callback alternate, with relocation expressions left for the link.
        size_hex="$(objdump -h "$work/cap$cap.o" |
            awk '$2 == ".altinstructions" { print $3 }')"
        test "$size_hex" == '00000018'
        readelf -r "$work/cap$cap.o" | grep -Fq 'alt_cb_patch_nops'
    done
    echo 'AARCH64_ALT_CAP_BOUNDS=PASS caps=9 rejected=5 GAS_ELF=4 alt_size=24B'
else
    echo 'AARCH64_ALT_CAP_BOUNDS=PASS caps=9 rejected=5 source=only'
fi
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-aarch64-linux-cap-alternative-qemu.sh", "shared": "9ef4c79ea956c9cf"}
#!/usr/bin/env bash
# Linux 6.6 alternative_has_cap_unlikely(), *actual* one-input asm goto.
# The original assembler table, patched branch and Core C label are tested
# together. This intentionally does not claim to execute Linux's patcher.
source="$root/tests/compiler/c0/aarch64-linux-cap-alternative.c"
cc -E -P -x c "$source" -o "$work/original.i"
"$minic" --target=aarch64-linux -S "$work/original.i" -o "$work/mini.s"
test -s "$work/mini.s"

# Preserve the Linux boot-time patch table, actual feature ID and real CFG
# edge. A fallthrough NOP is not an equivalent replacement for asm goto.
grep -Fq '.pushsection .altinstructions,"a"' "$work/mini.s"
grep -Fq ' .word 661b - .' "$work/mini.s"
grep -Fq ' .word 663f - .' "$work/mini.s"
grep -Fq ' .hword 38' "$work/mini.s"
grep -Fq ' .word alt_cb_patch_nops- .' "$work/mini.s"
grep -Fq ' .hword (1 << 15) | (38)' "$work/mini.s"
grep -Fq ' .byte 662b-661b' "$work/mini.s"
grep -Fq ' .byte 664f-663f' "$work/mini.s"
grep -Fq '.subsection 1' "$work/mini.s"
grep -Fq '.org' "$work/mini.s"
# Inline-GNU %l[l_yes]/%l[l_no] binds to Core's exported C label,
# while MachineIR-internal CFG jumps deliberately use .Lminic_mir_*.
# Check exactly two real asm-goto branches, one inside each helper, and
# verify every branch target is an emitted local label in the same helper.
test "$(grep -Ec $'^\tb\t\\.Luser_[0-9]+$' "$work/mini.s")" -eq 2
for helper in linux_has_cap_unlikely linux_has_cap_likely; do
    target="$(sed -n -E "/^${helper}:/,/^\.size ${helper},/s/^[[:space:]]*b[[:space:]]+(\.Luser_[0-9]+)$/\1/p" "$work/mini.s")"
    test -n "$target"
    test "$(printf '%s\n' "$target" | wc -l)" -eq 1
    grep -Fxq "${target}:" "$work/mini.s"
done

test "$(grep -Fc '.pushsection .altinstructions' "$work/mini.s")" -eq 2


# Neither an unknown alternative instruction nor changed GNU constraints
# may silently fall back into a generic Core opaque instruction.
while IFS='|' read -r label before after; do
    test -n "$label" || continue
    sed "s/$before/$after/g" "$work/original.i" >"$work/$label.i"
    if cmp -s "$work/original.i" "$work/$label.i"; then
        echo "invalid alternative negative fixture: $label" >&2; exit 1
    fi
    if "$minic" --target=aarch64-linux -S "$work/$label.i" \
        -o "$work/$label.s" >"$work/$label.log" 2>&1; then
        echo "unsafe AArch64 Linux alternative accepted: $label" >&2; exit 1
    fi
    test ! -e "$work/$label.s"
done <<'CASES'
wrong-cap-number|\.hword|\.word
wrong-section|altinstructions|otherinstructions
wrong-subsection|\.subsection 1|.subsection 2
wrong-old-insn|nop|yield
wrong-new-insn|b\\t%l|bl\\t%l
wrong-cap-name|cpucap|cpubad
wrong-goto-label|l_yes|l_bad
wrong-input-constraint|"i"|"r"
wrong-label-length|662b-661b|663b-661b
wrong-replacement-length|664f-663f|663f-664f
CASES

# Callback alternatives use a different PREL32 second relocation and an
# unconditional original branch. Their metadata and label must also be
# independently fail-closed (not just the unlikely/regular alternative).
while IFS='|' read -r label before after; do
    test -n "$label" || continue
    sed "s/$before/$after/g" "$source" >"$work/$label.c"
    if cmp -s "$source" "$work/$label.c"; then
        echo "invalid callback negative fixture: $label" >&2; exit 1
    fi
    cc -E -P -x c "$work/$label.c" -o "$work/$label.i"
    if "$minic" --target=aarch64-linux -S "$work/$label.i" \
        -o "$work/$label.s" >"$work/$label.log" 2>&1; then
        echo "unsafe AArch64 callback alternative accepted: $label" >&2
        exit 1
    fi
    test ! -e "$work/$label.s"
done <<'CASES'
wrong-callback|alt_cb_patch_nops|alt_cb_patch_bad
wrong-callback-reloc|- .|+ .
wrong-callback-prefix|1 << 15|1 << 14
wrong-callback-cap|hword|word
wrong-callback-section|altinstructions|wronginstructions
wrong-callback-label|l_no|l_bad
wrong-callback-old-branch|b\\t%l|cbz\\t%l
wrong-callback-len|.byte 664f-663f|.byte 664f-662b
CASES

# Linux calls the helper with cpucap as a formal inline parameter. Today
# that remains a deferred immediate: -S discovery is permitted, but *not*
# described as a complete linkable kernel implementation.
cc -E -P -DCHECK_DEFERRED -x c "$source" -o "$work/deferred.i"
"$minic" --target=aarch64-linux -S "$work/deferred.i" -o "$work/deferred.s"
grep -Fq 'MINIC_DEFERRED_ASM_IMMEDIATE requires inline specialization' "$work/deferred.s"
grep -Fq '.extern __minic_deferred_asm_immediate_' "$work/deferred.s"
test "$(grep -Fc 'MINIC_DEFERRED_ASM_IMMEDIATE' "$work/deferred.s")" -eq 2

# Linux 6.6.143's exact zero-operand PAN alternative has since acquired its
# own target-side machine contract. Assert the original feature-38 hardware
# alternative is preserved, then reject altered cpucap/opcode/metadata.
# Keeping the old blanket-rejection expectation would incorrectly fail when
# an independently verified privileged instruction becomes supported.
cc -E -P -DCHECK_PAN_ALT -x c "$source" -o "$work/pan.i"
"$minic" --target=aarch64-linux -S "$work/pan.i" \
    -o "$work/pan.s"
test "$(grep -Fc '.hword 38' "$work/pan.s")" -ge 2
test "$(grep -Fc '.pushsection .altinstructions' "$work/pan.s")" -ge 2
cc -E -P -DCHECK_PAN_ALT -DPAN_CAP=37 -x c "$source" \
    -o "$work/pan-wrong-cap.i"
sed 's/0xd500401f/0xd500401e/g' "$work/pan.i" \
    > "$work/pan-wrong-opcode.i"
sed '/void linux_pan_disable/,/int linux_has_cap_unlikely/s/664f-663f/664f-662b/g' \
    "$work/pan.i" \
    > "$work/pan-wrong-length.i"
for kind in cap opcode length; do
    if cmp -s "$work/pan.i" "$work/pan-wrong-$kind.i"; then
        echo "invalid PAN mutation fixture: $kind" >&2; exit 1
    fi
    if "$minic" --target=aarch64-linux -S "$work/pan-wrong-$kind.i" \
        -o "$work/pan-wrong-$kind.s" >/dev/null 2>&1; then
        echo "unsafe PAN alternative accidentally accepted: $kind" >&2
        exit 1
    fi
    test ! -e "$work/pan-wrong-$kind.s"
done

if [[ "${MINIC_SOURCE_ONLY:-0}" == 1 ]]; then
    echo 'AARCH64_CAP_ASM_GOTO=PASS source forms=2 metadata=12B edges=2 PAN38=PASS deferred=tracked negatives=22'
    exit 0
fi

command -v aarch64-linux-gnu-gcc >/dev/null
command -v qemu-aarch64 >/dev/null
aarch64-linux-gnu-gcc -static -O0 "$source" -o "$work/gnu.elf"
aarch64-linux-gnu-gcc -static -x assembler "$work/mini.s" -o "$work/mini.elf"
for compiler in gnu mini; do
    readelf -S "$work/$compiler.elf" | grep -Fq '.altinstructions'
    code=0
    timeout 45s qemu-aarch64 "$work/$compiler.elf" || code=$?
    if [[ "$code" != 42 ]]; then
        echo "AArch64 unpatched alternative $compiler exit=$code expected=42" >&2
        exit 1
    fi
done
echo 'AARCH64_CAP_ASM_GOTO=PASS GNU_QEMU_42=2 forms=2 metadata=12B PAN38=PASS negatives=22 deferred=tracked'
@@@ end
@@@ {"head_lines": 1, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loong-linux-named-store-mb-qemu.sh", "shared": "9ef4c79ea956c9cf"}
#!/usr/bin/env bash
source="$root/tests/compiler/c0/loong-linux-named-store-mb.c"
cc -E -P -x c "$source" -o "$work/original.i"

"$minic" --target=loongarch64-linux -S "$work/original.i" -o "$work/mini.s"
test -s "$work/mini.s"
grep -Eq '^[[:space:]]*amswap_db\.w[[:space:]]+\$t2,[[:space:]]*\$t0,[[:space:]]*\$t1[[:space:]]*$' "$work/mini.s"
grep -Eq '^[[:space:]]*amswap_db\.d[[:space:]]+\$t2,[[:space:]]*\$t0,[[:space:]]*\$t1[[:space:]]*$' "$work/mini.s"
grep -Eq '^[[:space:]]*st\.d[[:space:]]+\$t2,[[:space:]]*\$t1,[[:space:]]*0[[:space:]]*$' "$work/mini.s"
if [[ "$(grep -Fc 'amswap_db.' "$work/mini.s")" != 3 ]];then
    echo 'LoongArch Linux store-mb must emit exactly three hardware AMDB stores' >&2
    exit 1
fi

# All mutations preserve a plausible GNU inline-ASM surface but violate
# the actual kernel ISA, register, memory or ordering contract.
while IFS='|' read -r label before after; do
    test -n "$label" || continue
    sed "s/$before/$after/g" "$work/original.i" > "$work/$label.i"
    if cmp -s "$work/original.i" "$work/$label.i";then
        echo "invalid named AMDB rejection fixture: $label" >&2;exit 1
    fi
    if "$minic" --target=loongarch64-linux -S "$work/$label.i" \
        -o "$work/$label.s" >"$work/$label.log" 2>&1;then
        echo "unsafe GNU Linux named AMDB accepted: $label" >&2;exit 1
    fi
    test ! -e "$work/$label.s"
done <<'CASES'
wrong-w-op|amswap_db.w|amxor_db.w
wrong-d-op|amswap_db.d|amswap_db.w
wrong-value-constraint|"r" (value)|"Jr" (value)
wrong-memory-constraint|"+ZB"|"+m"
wrong-output-constraint|"=&r"|"=r"
wrong-clobber|: );|: "memory");
wrong-address|%\[mem\]|%[val]
wrong-input|%\[val\]|%[tmp]
wrong-volatile|__asm__ __volatile__|__asm__
wrong-output-width|unsigned long tmp|u32 tmp
CASES

if [[ "${MINIC_SOURCE_ONLY:-0}" == 1 ]];then
    echo 'LOONG_NAMED_STORE_MB=PASS widths=32/64 mode=source negatives=10'
    exit 0
fi

gcc=loongarch64-linux-gnu-gcc-13
command -v "$gcc" >/dev/null
command -v qemu-loongarch64 >/dev/null
"$gcc" -static -O0 -x c "$source" -o "$work/gnu.elf"
"$gcc" -static -x assembler "$work/mini.s" -o "$work/mini.elf"
for compiler in gnu mini; do
    rc=0
    timeout 45s qemu-loongarch64 "$work/$compiler.elf" || rc=$?
    if [[ "$rc" != 42 ]];then
        echo "LoongArch named store-mb $compiler exit=$rc expected=42" >&2
        exit 1
    fi
done
echo 'LOONG_NAMED_STORE_MB=PASS widths=32/64 GNU_QEMU_42=2 negatives=10'
@@@ end
