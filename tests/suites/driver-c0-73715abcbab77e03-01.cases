@@@ {"id": "73715abcbab77e03", "kind": "shared", "newline": true}
set -Eeuo pipefail
minic=$1
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
@@@ end
@@@ {"head_lines": 5, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-linux-declaration-gates.sh", "shared": "73715abcbab77e03"}
#!/usr/bin/env bash
# Both failures were first diagnosed against frozen ORIGINAL GNU Linux 6.6.143
# preprocessed C: x86 arch/x86/entry/common.i and drivers/char/random.i.
# Check both source-grammar correctness and REAL linked execution. Never
# conceal a bad ISA operand behind C-parser acceptance.
cat >"$work/static.i" <<'EOF'
int value=41;
int static_pointer_attributes(void) {
    static int * __attribute__((__used__))
        __attribute__((__section__(".data.minic_attr"))) p = &value;
    return *p + 1;
}
int call_indirect_from_statement(int input) {
    return ({ static void * __attribute__((__used__))
            __attribute__((__section__(".discard.addressable")))
            __minic_addressable = (void *)&static_pointer_attributes;;
             (&static_pointer_attributes); })() + input;
}
int main(void) {
    return call_indirect_from_statement(0);
}
EOF
cc -O0 -no-pie -x c "$work/static.i" -o "$work/static.gnu"
set +e
"$work/static.gnu"
gcc_rc=$?
set -e
test "$gcc_rc" -eq 42 || { echo 'FAIL GNU original static statement attribute oracle'; exit 1; }
# End-to-end executable x86 control includes a GNU function-pointer result
# from a statement expression. Other targets have separate runtime ABI gates;
# this probe isolates the shared declaration grammar from those backends.
for target in x86_64-linux; do
    "$minic" --target="$target" -S "$work/static.i" \
        -o "$work/static.$target.s"
    grep -Fq '.data.minic_attr' "$work/static.$target.s"
done
cc -O0 -no-pie -x assembler "$work/static.x86_64-linux.s" -o "$work/static.minic"
set +e
"$work/static.minic"
minic_rc=$?
set -e
test "$minic_rc" -eq "$gcc_rc" || {
    echo "FAIL MiniC static local GNU oracle gnu=$gcc_rc minic=$minic_rc"; exit 1;
}
cat >"$work/gnu-register.i" <<'EOF'
unsigned long linux_register_bind_percent(void) {
    register unsigned long ret __asm__("%""rax")=41UL;
    return ret+1UL;
}
int main(void) {return linux_register_bind_percent() == 42UL ? 42 : 1;}
EOF
"$minic" --target=x86_64-linux -S "$work/gnu-register.i" \
    -o "$work/gnu-register.s"
cc -O0 -no-pie -x assembler "$work/gnu-register.s" -o "$work/gnu-register.minic"
set +e
"$work/gnu-register.minic"
register_rc=$?
set -e
test "$register_rc" -eq 42 || {
    echo "FAIL x86 GNU %rax local register spelling rc=$register_rc"; exit 1;
}
for name in '%rbx' '%rsp' '%' '%r17' '%cc'; do
    sed "s/%\"\"rax/$name/" "$work/gnu-register.i" >"$work/reject.i"
    if "$minic" --target=x86_64-linux -S "$work/reject.i" \
        -o "$work/reject.s" >"$work/reject.out" 2>"$work/reject.err"; then
        echo "FAIL unsafe x86 local binding admitted $name"; exit 1
    fi
done
cat >"$work/invalid-section.i" <<'EOF'
int value=0;
int f(void) {
    static int * __attribute__((__section__(".data.foo")))
        __attribute__((__section__(".data.bar"))) p=&value;
    return *p;
}
EOF
if "$minic" --target=x86_64-linux -S "$work/invalid-section.i" \
    -o "$work/invalid-section.s" >"$work/invalid-section.out" 2>&1; then
    echo 'FAIL conflicting GNU static local section admitted'; exit 1
fi
echo 'MINIC_LINUX_GNU_DECLARATION_GATES=PASS native_target=x86_64 native_static=42 x86_percent_rax=42 malformed_hardreg=5 conflicting_section_rejected=1'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-linux-global-prefix-attributes.sh", "shared": "73715abcbab77e03"}
#!/usr/bin/env bash
# Original GNU Linux 6.6.143 x86 idt.i and kernel/sched/build_policy.i:
# 'static const __attribute__((section/unused)) <type>' used to fail parse.
cat >"$work/global.i" <<'EOF'
struct rec { unsigned long value; };
static const __attribute__((__section__(".init.rodata")))
    struct rec initial[] = { {41UL} };
static volatile __attribute__((__used__)) unsigned long counter=1UL;
static const __attribute__((__used__))
    __attribute__((__section__(".init.rodata"))) unsigned long base=40UL;
int main(void) {
    return (initial[0].value + counter == 42UL &&
            base==40UL) ? 42 : 1;
}
EOF
cc -O0 -no-pie -x c "$work/global.i" -o "$work/global.gnu"
"$minic" --target=x86_64-linux -S "$work/global.i" -o "$work/global.minic.s"
grep -Fq '.init.rodata' "$work/global.minic.s"
cc -O0 -no-pie -x assembler "$work/global.minic.s" -o "$work/global.minic"
for variant in gnu minic; do
    set +e
    "$work/global.$variant"
    rc=$?
    set -e
    test "$rc" -eq 42 || {
        echo "FAIL Linux global prefix $variant rc=$rc"; exit 1;
    }
done
cat >"$work/bad-global.i" <<'EOF'
static const __attribute__((__section__(".one")))
    __attribute__((__section__(".two"))) int value=1;
int main(void) { return value; }
EOF
if "$minic" --target=x86_64-linux -S "$work/bad-global.i" \
    -o "$work/bad-global.s" >"$work/bad-global.log" 2>&1; then
    echo 'FAIL conflicting GNU section declaration head admitted'; exit 1
fi
echo 'MINIC_LINUX_GNU_GLOBAL_PREFIX=PASS GNU_native=42 MiniC_native=42 section=1 qualifier_preserved=1 conflicting_section_rejected=1'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-bit-scan-native.sh", "shared": "73715abcbab77e03"}
#!/usr/bin/env bash
# Original Linux 6.6.143 __ffs, __fls and ffz bit scan GNU asm contract.
# Compare MiniC output with GCC on nonzero inputs, never claim zero semantics.
cat >"$work/scans.i" <<'EOF'
unsigned long mini_ffs(unsigned long word) {
    asm("rep; bsf %1,%0" : "=r"(word) : "rm"(word));
    return word;
}
unsigned long mini_ffz(unsigned long word) {
    unsigned long result;
    asm("rep; bsf %1,%0" : "=r"(result) : "r"(~word));
    return result;
}
unsigned long mini_fls(unsigned long word) {
    asm("bsr %1,%0" : "=r"(word) : "rm"(word));
    return word;
}
EOF
cat >"$work/gcc.c" <<'EOF'
unsigned long gcc_ffs(unsigned long word) {
    asm("rep; bsf %1,%0" : "=r"(word) : "rm"(word));
    return word;
}
unsigned long gcc_ffz(unsigned long word) {
    unsigned long result;
    asm("rep; bsf %1,%0" : "=r"(result) : "r"(~word));
    return result;
}
unsigned long gcc_fls(unsigned long word) {
    asm("bsr %1,%0" : "=r"(word) : "rm"(word));
    return word;
}
EOF
cat >"$work/driver.c" <<'EOF'
extern unsigned long mini_ffs(unsigned long), mini_ffz(unsigned long);
extern unsigned long mini_fls(unsigned long);
extern unsigned long gcc_ffs(unsigned long), gcc_ffz(unsigned long);
extern unsigned long gcc_fls(unsigned long);
int main(void) {
    static const unsigned long cases[] = {
        1UL, 2UL, 4UL, 8UL, 255UL, 1024UL,
        (1UL << 31), (1UL << 47), (1UL << 63), ~0UL
    };
    unsigned long i, value;
    for (i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
        value = cases[i];
        if (mini_ffs(value) != gcc_ffs(value) ||
            mini_fls(value) != gcc_fls(value))
            return 1;
        if (value != ~0UL && mini_ffz(value) != gcc_ffz(value))
            return 2;
    }
    return 42;
}
EOF
"$minic" --target=x86_64-linux -S "$work/scans.i" -o "$work/minic.s"
grep -F '  rep; bsfq %r10, %rax' "$work/minic.s" >/dev/null
grep -F '  bsrq %r10, %rax' "$work/minic.s" >/dev/null
cc -no-pie -O0 "$work/driver.c" "$work/gcc.c" \
    -x assembler "$work/minic.s" -o "$work/check.elf"
set +e
"$work/check.elf"
rc=$?
set -e
test "$rc" -eq 42 || { echo "FAIL x86 GNU bit scan differential rc=$rc" >&2; exit 1; }
cat >"$work/unsafe.i" <<'EOF'
unsigned long bad(unsigned long word) {
    asm("rep; bsf %1,%0; cli" : "=r"(word) : "rm"(word));
    return word;
}
EOF
if "$minic" --target=x86_64-linux -S "$work/unsafe.i" \
    -o "$work/unsafe.s" >"$work/unsafe.log" 2>&1; then
    echo 'FAIL unknown x86 machine template admitted' >&2
    exit 1
fi
cat >"$work/wrong-width.i" <<'EOF'
unsigned int bad(unsigned int word) {
    asm("rep; bsf %1,%0" : "=r"(word) : "rm"(word));
    return word;
}
EOF
if "$minic" --target=x86_64-linux -S "$work/wrong-width.i" \
    -o "$work/wrong-width.s" >"$work/wrong-width.log" 2>&1; then
    echo 'FAIL x86 32-bit bsf mistaken for native 64-bit contract' >&2
    exit 1
fi
echo 'X86_GNU_BIT_SCAN_NATIVE=PASS bsf_nonzero=10 bsr_nonzero=10 ffz_nonzero=9 unknown_machine_rejected=1 wrong_width_rejected=1'
@@@ end
@@@ {"head_lines": 2, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-nospec-native.sh", "shared": "73715abcbab77e03"}
#!/usr/bin/env bash
# Original Linux x86 array_index_mask_nospec hardware CF/SBB GNU differential.
cat >"$work/mask.i" <<'EOF'
unsigned long mini64(unsigned long index,unsigned long size) {
    unsigned long mask;
    asm volatile("cmp %1,%2; sbb %0,%0;" : "=r"(mask) : "g"(size), "r"(index) : "cc");
    return mask;
}
unsigned long mini32(unsigned int index,unsigned int size) {
    unsigned long mask;
    asm volatile("cmp %1,%2; sbb %0,%0" : "=r"(mask) : "g"(size), "r"(index) : "cc");
    return mask;
}
EOF
sed 's/mini64/gcc64/;s/mini32/gcc32/' "$work/mask.i" >"$work/gcc.c"
cat >"$work/main.c" <<'EOF'
extern unsigned long mini64(unsigned long,unsigned long),gcc64(unsigned long,unsigned long);
extern unsigned long mini32(unsigned int,unsigned int),gcc32(unsigned int,unsigned int);
int main(void) {
    static const unsigned long cases[] = {0UL,1UL,2UL,42UL,255UL,65536UL,
        0xffffffffUL,0x100000000UL,~0UL};
    unsigned long i,j;
    for(i=0;i<sizeof(cases)/sizeof(cases[0]);++i)
        for(j=0;j<sizeof(cases)/sizeof(cases[0]);++j){
            unsigned long a=cases[i],b=cases[j];
            if(mini64(a,b)!=gcc64(a,b) ||
               mini32((unsigned int)a,(unsigned int)b)!=
               gcc32((unsigned int)a,(unsigned int)b))return 1;
        }
    return 42;
}
EOF
"$minic" --target=x86_64-linux -S "$work/mask.i" -o "$work/mask.s"
grep -Fq '  cmpq %r10, %r11' "$work/mask.s"
grep -Fq '  cmpl %r10d, %r11d' "$work/mask.s"
grep -Fq '  sbbq %r8, %r8' "$work/mask.s"
cc -O0 -no-pie "$work/main.c" "$work/gcc.c" -x assembler "$work/mask.s" -o "$work/verify"
set +e
"$work/verify"
rc=$?
set -e
test "$rc" -eq 42 || { echo "FAIL nospec GCC hardware differential rc=$rc" >&2; exit 1; }
cat >"$work/unsafe.i" <<'EOF'
unsigned long bad(unsigned long idx,unsigned long sz){
    unsigned long r;
    asm volatile("cmp %1,%2; sbb %0,%0; cli" : "=r"(r) : "g"(sz), "r"(idx) : "cc");
    return r;
}
EOF
if "$minic" --target=x86_64-linux -S "$work/unsafe.i" -o "$work/unsafe.s" >"$work/unsafe.log" 2>&1; then
  echo 'FAIL injected privileged instruction admitted' >&2; exit 1
fi
cat >"$work/width.i" <<'EOF'
unsigned long bad(unsigned short idx,unsigned short sz){
    unsigned long r;
    asm volatile("cmp %1,%2; sbb %0,%0" : "=r"(r) : "g"(sz), "r"(idx) : "cc");
    return r;
}
EOF
if "$minic" --target=x86_64-linux -S "$work/width.i" -o "$work/width.s" >"$work/width.log" 2>&1; then
  echo 'FAIL unsupported 16-bit x86 mask admitted' >&2; exit 1
fi
echo 'X86_LINUX_NOSPEC_GNU_NATIVE=PASS u64_pairs=81 u32_pairs=81 injected_rejected=1 width_rejected=1'
@@@ end
@@@ {"head_lines": 2, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-return-frame-pc-native.sh", "shared": "73715abcbab77e03"}
#!/usr/bin/env bash
# SysV x86 caller-PC and frame0: exact machine-state oracles, no guesses.
cat >"$work/minic.i" <<'EOF'
void nested_effect(void);
unsigned long mini_return_leaf(void) { return (unsigned long)__builtin_return_address(0); }
unsigned long mini_return_nonleaf(void) {
    nested_effect(); return (unsigned long)__builtin_return_address(0);
}
unsigned long mini_frame_leaf(void) { return (unsigned long)__builtin_frame_address(0); }
unsigned long mini_frame_nonleaf(void) {
    nested_effect(); return (unsigned long)__builtin_frame_address(0);
}
EOF
cat >"$work/gnu.c" <<'EOF'
void nested_effect(void);
unsigned long gnu_return_leaf(void) { return (unsigned long)__builtin_return_address(0); }
unsigned long gnu_return_nonleaf(void) {
    nested_effect(); return (unsigned long)__builtin_return_address(0);
}
unsigned long gnu_frame_leaf(void) { return (unsigned long)__builtin_frame_address(0); }
unsigned long gnu_frame_nonleaf(void) {
    nested_effect(); return (unsigned long)__builtin_frame_address(0);
}
EOF
cat >"$work/oracle.s" <<'EOF'
.text
.globl oracle_return_pc
.type oracle_return_pc,@function
oracle_return_pc:
  pushq %rbp
  movq %rsp, %rbp
  call *%rdi
1:
  leaq 1b(%rip), %r10
  xorq %r10, %rax
  leave
  ret
.size oracle_return_pc, .-oracle_return_pc
.globl oracle_frame
.type oracle_frame,@function
oracle_frame:
  pushq %rbp
  movq %rsp, %rbp
  call *%rdi
  leaq -16(%rbp), %r10
  xorq %r10, %rax
  leave
  ret
.size oracle_frame, .-oracle_frame
EOF
cat >"$work/driver.c" <<'EOF'
typedef unsigned long (*function)(void);
extern unsigned long mini_return_leaf(void), mini_return_nonleaf(void);
extern unsigned long mini_frame_leaf(void), mini_frame_nonleaf(void);
extern unsigned long gnu_return_leaf(void), gnu_return_nonleaf(void);
extern unsigned long gnu_frame_leaf(void), gnu_frame_nonleaf(void);
extern unsigned long oracle_return_pc(function), oracle_frame(function);
volatile unsigned long nested_counter;
void nested_effect(void) { ++nested_counter; }
int main(void) {
    if (oracle_return_pc(mini_return_leaf) ||
        oracle_return_pc(mini_return_nonleaf) ||
        oracle_frame(mini_frame_leaf) ||
        oracle_frame(mini_frame_nonleaf) ||
        oracle_return_pc(gnu_return_leaf) ||
        oracle_return_pc(gnu_return_nonleaf) ||
        oracle_frame(gnu_frame_leaf) ||
        oracle_frame(gnu_frame_nonleaf))
        return 1;
    return nested_counter == 4UL ? 42 : 2;
}
EOF
"$minic" --target=x86_64-linux -S "$work/minic.i" -o "$work/minic.s"
grep -F '  movq 8(%rbp), %rax' "$work/minic.s" >/dev/null
grep -F '  movq %rbp, %rax' "$work/minic.s" >/dev/null
cc -no-pie -O0 -fno-omit-frame-pointer "$work/driver.c" "$work/gnu.c" \
    -x assembler "$work/oracle.s" "$work/minic.s" -o "$work/check.elf"
set +e
"$work/check.elf"
rc=$?
set -e
test "$rc" -eq 42 || {
    echo "FAIL: x86 exact return-PC/frame GNU oracle exit=$rc" >&2; exit 1;
}
for builtin in return_address frame_address; do
    cat >"$work/unsupported.i" <<EOF
void *illegal(void) { return __builtin_$builtin(1); }
EOF
    if "$minic" --target=x86_64-linux -S "$work/unsupported.i" \
        -o "$work/unsupported.s" >"$work/unsupported.log" 2>&1; then
        echo "FAIL: x86 caller unwind depth>0 admitted for $builtin" >&2
        exit 1
    fi
    grep -F 'level is not supported by target' "$work/unsupported.log" >/dev/null
done
echo 'X86_SYSV_CALL_FRAME_GNU_NATIVE=PASS return_leaf=2 return_nonleaf=2 frame_leaf=2 frame_nonleaf=2 exact_PC=1 exact_RBP=1 depth1_rejected=2'
@@@ end
