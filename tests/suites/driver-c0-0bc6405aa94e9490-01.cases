@@@ {"id": "0bc6405aa94e9490", "kind": "shared", "newline": true}
set -Eeuo pipefail
mini=${1:?MiniC compiler path}
test -x "$mini"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-chained-static-array-relocations.sh", "shared": "0bc6405aa94e9490"}
#!/usr/bin/env bash
# GNU chained [row][column] initializers must merge repeated row actions.
# All four cells of a populated row remain independent pointer relocations;
# later writes replace only the selected cell, including its relocation.

cat > "$work/chained.i" <<'SOURCE'
extern int first, second, replacement, fourth;
extern int fifth, sixth, seventh, eighth;
void *const chained_grid[4][4] = {
    [1][0] = &first,
    [1][1] = &second,
    [1][0] = &replacement,
    [1][2] = &fourth,
    [2] = { &fifth, &sixth },
    [2][2] = &seventh,
    [2][3] = &eighth,
};
void *const flat_grid[2] = { &first, &second };
SOURCE

for target in x86_64 aarch64 loongarch64 riscv64 riscv32; do
    "$mini" --target="$target"-linux -S "$work/chained.i" -o "$work/$target.s"
    for symbol in replacement fourth fifth sixth seventh eighth; do
        test "$(grep -Ec "[[:space:]]$symbol$" "$work/$target.s")" -eq 1
    done
    test "$(grep -Ec '[[:space:]]second$' "$work/$target.s")" -eq 2
    test "$(grep -Ec '[[:space:]]first$' "$work/$target.s")" -eq 1
    grep -Fq 'flat_grid:' "$work/$target.s"
    grep -Fq 'chained_grid:' "$work/$target.s"
    if [[ "$target" == x86_64 ]]; then
        test "$(grep -Ec '[[:space:]]\.quad first$' "$work/$target.s")" -eq 1
        cc -c "$work/$target.s" -o "$work/$target.o"
        gcc -x c -c "$work/chained.i" -o "$work/gnu.o"
        test "$(readelf -rW "$work/$target.o" | grep -c 'R_X86_64_64')" -eq 9
        test "$(readelf -rW "$work/gnu.o" | grep -c 'R_X86_64_64')" -eq 9
    elif [[ "${MINIC_CHAINED_ARRAY_SOURCE_ONLY:-0}" != 1 ]]; then
        as_tool=${target}-linux-gnu-as
        command -v "$as_tool" >/dev/null
        "$as_tool" -o "$work/$target.o" "$work/$target.s"
    fi
done

cat > "$work/deep.i" <<'SOURCE'
extern int deep_a, deep_b;
void *const deep[2][2][2] = {
    [1][0][0] = &deep_a,
    [1][0][1] = &deep_b,
};
SOURCE
for target in x86_64 aarch64 loongarch64 riscv64 riscv32; do
    "$mini" --target="$target"-linux -S "$work/deep.i" -o "$work/deep-$target.s"
    test "$(grep -Ec '[[:space:]]deep_a$' "$work/deep-$target.s")" -eq 1
    test "$(grep -Ec '[[:space:]]deep_b$' "$work/deep-$target.s")" -eq 1
done

cat > "$work/invalid.i" <<'SOURCE'
extern int first;
void *const invalid[4][4] = { [4][0] = &first };
SOURCE
for target in x86_64 aarch64 loongarch64 riscv64 riscv32; do
    if "$mini" --target="$target"-linux -S "$work/invalid.i" \
        -o "$work/invalid-$target.s" >"$work/invalid-$target.log" 2>&1; then
        printf 'out-of-range chained designator accepted on %s\n' "$target" >&2
        exit 1
    fi
    test ! -e "$work/invalid-$target.s"
done
echo "MINIC_CHAINED_ARRAY_RELOC=PASS targets=5 grid_relocs=7 deep_relocs=2 overwritten=1 negative_rejected=5"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-core-expr-branch-local-facts.sh", "shared": "0bc6405aa94e9490"}
#!/usr/bin/env bash
# Dynamic ?: / && / || expression merges must not leak path-specific local
# constants into a later `if (x)` guard or drop mandatory side effects.
source_file=tests/compiler/c0/core_expr_branch_local_fact_merge.c
host_cc=${HOST_CC:-gcc}

"$host_cc" -E -P -std=gnu11 -x c "$source_file" -o "$work/input.i"
"$host_cc" -O0 -std=gnu11 -no-pie -x c "$work/input.i" -o "$work/gnu"

for target in x86_64 riscv32 riscv64 aarch64 loongarch64; do
    "$mini" --target="$target-linux" -S "$work/input.i" \
        -o "$work/$target.s"
    test -s "$work/$target.s"
done
"$host_cc" -no-pie -x assembler "$work/x86_64.s" -o "$work/minic"

for name in gnu minic; do
    status=0
    "$work/$name" >"$work/$name.stdout" 2>"$work/$name.stderr" || status=$?
    if [[ "$status" != 42 ]]; then
        printf 'CORE_EXPR_BRANCH_FACTS=FAIL runner=%s status=%s\n' "$name" "$status" >&2
        exit 1
    fi
done
cmp "$work/gnu.stdout" "$work/minic.stdout"
cmp "$work/gnu.stderr" "$work/minic.stderr"
echo 'CORE_EXPR_BRANCH_FACTS=PASS cases=25 source_isa=5 x86_GNU_native=1'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-recursive-zero-int128-global.sh", "shared": "0bc6405aa94e9490"}
#!/usr/bin/env bash
# Recursive aggregate initializer: an unsigned/signed __int128 zero consumes
# one logical scalar slot but occupies sixteen physical bytes. Preserve the
# next nested pointer relocation and reject nonzero payload truncation.

cat > "$work/zero.i" <<'SOURCE'
extern int external_target;
struct inner { unsigned __int128 zero; void *pointer; signed __int128 signed_zero; };
struct outer { int prefix; struct inner data; int suffix; };
struct outer global_state = {
    .prefix = 13,
    .data = { .pointer = &external_target },
    .suffix = 41
};
SOURCE

for target in aarch64 loongarch64; do
    "$mini" --target="$target"-linux -S "$work/zero.i" -o "$work/$target.s"
    test "$(grep -Fc '.zero 16' "$work/$target.s")" -eq 2
    grep -Fq '.8byte external_target' "$work/$target.s"
    grep -Fq 'global_state:' "$work/$target.s"
    if [[ "${MINIC_RECURSIVE_INT128_SOURCE_ONLY:-0}" != 1 ]]; then
        as_tool=${target}-linux-gnu-as
        command -v "$as_tool" >/dev/null
        "$as_tool" -o "$work/$target.o" "$work/$target.s"
    fi
done

cat > "$work/nonzero.i" <<'SOURCE'
struct payload { unsigned __int128 full; };
struct payload global_nonzero = { .full = 1 };
SOURCE
for target in aarch64 loongarch64; do
    if "$mini" --target="$target"-linux -S "$work/nonzero.i" \
        -o "$work/bad.s" >"$work/bad.out" 2>&1; then
        printf 'nonzero 128-bit scalar was silently truncated on %s\n' "$target" >&2
        exit 1
    fi
    test ! -e "$work/bad.s"
done
echo "MINIC_RECURSIVE_INT128_GLOBAL=PASS targets=2 zero_payloads=4 pointer_relocs=2 nonzero_rejected=2 source_only=${MINIC_RECURSIVE_INT128_SOURCE_ONLY:-0}"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-csum-partial-carry.sh", "shared": "0bc6405aa94e9490"}
#!/usr/bin/env bash
# Original Linux checksum_64.h carry chains: preserve CF across all qwords,
# including five GNU memory inputs and the 8/16/32-byte `m` alias regions.

cat > "$work/probe.i" <<'SOURCE'
unsigned long carry_reg(unsigned long sum, unsigned long other) {
    asm("addq %1,%0\n\tadcq $0,%0" : "+r"(sum) : "r"(other));
    return sum;
}
unsigned long carry_five(unsigned long sum, const unsigned long m[5]) {
    asm("addq %1,%0\n\tadcq %2,%0\n\tadcq %3,%0\n\t"
        "adcq %4,%0\n\tadcq %5,%0\n\tadcq $0,%0"
        : "+r"(sum) : "m"(m[0]), "m"(m[1]), "m"(m[2]),
                       "m"(m[3]), "m"(m[4]));
    return sum;
}
unsigned long carry_32(unsigned long sum, const void *buff) {
    asm("addq 0*8(%[src]),%[res]\n\tadcq 1*8(%[src]),%[res]\n\t"
        "adcq 2*8(%[src]),%[res]\n\tadcq 3*8(%[src]),%[res]\n\t"
        "adcq $0,%[res]" : [res] "+r"(sum)
        : [src] "r"(buff), "m"(*(const char(*)[32])buff));
    return sum;
}
unsigned long carry_16(unsigned long sum, const void *buff) {
    asm("addq 0*8(%[src]),%[res]\n\tadcq 1*8(%[src]),%[res]\n\t"
        "adcq $0,%[res]" : [res] "+r"(sum)
        : [src] "r"(buff), "m"(*(const char(*)[16])buff));
    return sum;
}
unsigned long carry_8(unsigned long sum, const void *buff) {
    asm("addq 0*8(%[src]),%[res]\n\tadcq $0,%[res]"
        : [res] "+r"(sum)
        : [src] "r"(buff), "m"(*(const char(*)[8])buff));
    return sum;
}
unsigned long carry_tail(unsigned long sum, unsigned long trail) {
    asm("addq %[trail],%[res]\n\tadcq $0,%[res]"
        : [res] "+r"(sum) : [trail] "r"(trail));
    return sum;
}
SOURCE

"$mini" --target=x86_64-linux -S "$work/probe.i" -o "$work/probe.s"
cc -c "$work/probe.s" -o "$work/probe.o"
gcc -x c -c "$work/probe.i" -o "$work/gnu-probe.o"

cat > "$work/harness.c" <<'SOURCE'
#include <stdint.h>
#include <stdio.h>
extern unsigned long carry_reg(unsigned long, unsigned long);
extern unsigned long carry_five(unsigned long, const unsigned long *);
extern unsigned long carry_32(unsigned long, const void *);
extern unsigned long carry_16(unsigned long, const void *);
extern unsigned long carry_8(unsigned long, const void *);
extern unsigned long carry_tail(unsigned long, unsigned long);
static uint64_t seed = UINT64_C(0x9e3779b97f4a7c15);
static uint64_t next_random(void) {
    seed ^= seed << 13;
    seed ^= seed >> 7;
    seed ^= seed << 17;
    return seed;
}
static unsigned long add_with_carry(unsigned long a, unsigned long b) {
    const unsigned __int128 wide = (unsigned __int128)a + b;
    return (unsigned long)wide + (unsigned long)(wide >> 64);
}
int main(void) {
    unsigned long m[5];
    size_t i, j;
    for (i = 0; i < 2048; ++i) {
        const unsigned long sum = i & 1U ? ~0UL : next_random();
        unsigned long expected = sum;
        for (j = 0; j < 5; ++j) {
            m[j] = (i & 2U) ? ~0UL : next_random();
            expected = add_with_carry(expected, m[j]);
        }
        if (carry_reg(sum, m[0]) != add_with_carry(sum, m[0]) ||
            carry_tail(sum, m[0]) != add_with_carry(sum, m[0]) ||
            carry_five(sum, m) != expected ||
            carry_32(sum, m) != add_with_carry(add_with_carry(
                add_with_carry(add_with_carry(sum, m[0]), m[1]), m[2]), m[3]) ||
            carry_16(sum, m) != add_with_carry(add_with_carry(sum, m[0]), m[1]) ||
            carry_8(sum, m) != add_with_carry(sum, m[0])) {
            fprintf(stderr, "checksum CF mismatch at iteration %zu\n", i);
            return 1;
        }
    }
    puts("MINIC_X86_CSUM_CARRY_NATIVE=PASS cases=2048 forms=6");
    return 0;
}
SOURCE
gcc -std=c11 -O2 -Wall -Wextra -Werror -c "$work/harness.c" -o "$work/harness.o"
gcc -no-pie "$work/harness.o" "$work/probe.o" -o "$work/minic"
"$work/minic"
gcc -no-pie "$work/harness.o" "$work/gnu-probe.o" -o "$work/gnu"
"$work/gnu"

cat > "$work/invalid.i" <<'SOURCE'
unsigned long broken(unsigned long sum, unsigned long other) {
    asm("addq %1,%0\n\tadcq $1,%0" : "+r"(sum) : "r"(other));
    return sum;
}
SOURCE
if "$mini" --target=x86_64-linux -S "$work/invalid.i" \
    -o "$work/invalid.s" >"$work/invalid.log" 2>&1; then
    printf 'unsupported checksum carry-chain mutation was accepted\n' >&2
    exit 1
fi
test ! -e "$work/invalid.s"
echo "MINIC_X86_CSUM_CARRY=PASS exact_original_forms=6 malformed_rejected=1"
@@@ end
