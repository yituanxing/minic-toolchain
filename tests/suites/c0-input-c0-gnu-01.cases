@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_if_condition_local_owner.c"}
/* Linux 6.6.143 net/core/bpf_sk_storage.c:diag_get regression model.
 * The compile-time assertion is false. GNU min_t uses a statement
 * expression with two locally initialized temporaries, whose ownership is
 * inside the IF predicate and not its lexical predecessor. */
typedef unsigned int u32;

struct bpf_local_storage_elem {
    void *next;
    void *prev;
    void *sdata;
    unsigned int flags;
    unsigned int size;
};

#define U16_MAX 65535U
#define NLA_HDRLEN 4U
#define KMALLOC_MAX_SIZE (1U << 20)
#define MAX_BPF_STACK 512U
#define min_t(type, x, y) ({ type ux = (x); type uy = (y); ux < uy ? ux : uy; })
#define BPF_LOCAL_STORAGE_MAX_VALUE_SIZE \
    min_t(u32, (KMALLOC_MAX_SIZE - MAX_BPF_STACK - \
                sizeof(struct bpf_local_storage_elem)), \
               (U16_MAX - sizeof(struct bpf_local_storage_elem)))
#define BUILD_BUG_ON(c) do { extern void __compiletime_assert_645(void); \
    if (c) __compiletime_assert_645(); } while (0)

/* The nested owner test ensures the inner statement-expression block, not
 * merely the condition's first block, owns and initializes its locals. */
#define nested_min_t(type, x, y) ({ \
    type outer = (x); \
    type inner = ({ type ux = outer; type uy = (y); ux < uy ? ux : uy; }); \
    inner; })

int diag_get(int n) {
    BUILD_BUG_ON(U16_MAX - NLA_HDRLEN < BPF_LOCAL_STORAGE_MAX_VALUE_SIZE);
    return n + 1;
}

int diag_get_direct(int n) {
    BUILD_BUG_ON(U16_MAX - NLA_HDRLEN <
        (U16_MAX - sizeof(struct bpf_local_storage_elem)));
    return n + 2;
}

int diag_get_nested(int n) {
    BUILD_BUG_ON(U16_MAX - NLA_HDRLEN <
        nested_min_t(u32, (KMALLOC_MAX_SIZE - MAX_BPF_STACK -
                           sizeof(struct bpf_local_storage_elem)),
                           (U16_MAX - sizeof(struct bpf_local_storage_elem))));
    return n + 3;
}

/* Take the opposite min_t arm: the ownership proof must be independent of
 * which constant local actually becomes the result. */
int diag_get_small(int n) {
    BUILD_BUG_ON(U16_MAX - NLA_HDRLEN <
        min_t(u32, (4096U - MAX_BPF_STACK -
                    sizeof(struct bpf_local_storage_elem)),
                   (U16_MAX - sizeof(struct bpf_local_storage_elem))));
    return n + 4;
}

/* A source IF may be lowered after its arms. A later block-local cannot
 * inherit a known/escaped fact from that speculative traversal: it has not
 * entered its declaration scope yet. The initializer, not the earlier
 * condition's snapshot, establishes its value. Keep an unproven runtime
 * condition plus a dead GNU diagnostic to cover both sides of this boundary. */
int future_local_runtime_gate;

int future_local_after_impure_guard(int n) {
    int result = n;
    if (future_local_runtime_gate)
        result += 2;
    {
        int future_value = n + 9;
        if (__builtin_expect(!!(0), 0))
            BUILD_BUG_ON(1);
        result += future_value;
    }
    return result;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_if_condition_local_owner_driver.c"}
#include <stdio.h>

extern int diag_get(int n);
extern int diag_get_direct(int n);
extern int diag_get_nested(int n);
extern int diag_get_small(int n);
extern int future_local_runtime_gate;
extern int future_local_after_impure_guard(int n);

static int bad_calls;
void __compiletime_assert_645(void) { ++bad_calls; }

int main(void) {
    int a = diag_get(1);
    int b = diag_get_direct(1);
    int c = diag_get_nested(1);
    int d = diag_get_small(1);
    future_local_runtime_gate = 0;
    int future0 = future_local_after_impure_guard(-3);
    future_local_runtime_gate = 1;
    int future1 = future_local_after_impure_guard(4);
    printf("diag=%d direct=%d nested=%d small=%d future0=%d future1=%d bad_calls=%d\n",
           a, b, c, d, future0, future1, bad_calls);
    return a == 2 && b == 3 && c == 4 && d == 5 &&
           future0 == 3 && future1 == 19 && bad_calls == 0 ? 0 : 1;
}
@@@ end
