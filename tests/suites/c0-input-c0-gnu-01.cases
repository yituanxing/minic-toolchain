@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_constant_bitfield_helper_cfg.c"}
/* GNU-preprocessed model of Linux bitfield.h's helper chain.  No Linux symbol
 * is special to the compiler: the guard and diagnostic are ordinary GNU C. */
extern void invalid_mask(void) __attribute__((error("invalid mask")));
extern void value_does_not_fit(void) __attribute__((error("value does not fit")));

static inline __attribute__((always_inline))
unsigned long multiplier(unsigned long field) {
    if ((field | (field - 1UL)) & ((field | (field - 1UL)) + 1UL))
        invalid_mask();
    return field & -field;
}

static inline __attribute__((always_inline))
unsigned long mask(unsigned long field) {
    return field / multiplier(field);
}

static inline __attribute__((always_inline))
unsigned long encode(unsigned long value, unsigned long field) {
    if (__builtin_constant_p(value) && (value & ~mask(field)))
        value_does_not_fit();
    return (value & mask(field)) * multiplier(field);
}

static unsigned long dynamic_value(unsigned long value) {
    return encode(value, 0x1cUL);
}

static volatile unsigned long side_effect_count;

static inline __attribute__((always_inline))
unsigned long observed_branch(unsigned long value) {
    if (value == 1UL)
        ++side_effect_count;
    return value + 1UL;
}

int main(int argc, char **argv) {
    (void)argv;
    return (encode(3UL, 0x1cUL) != 12UL) ||
           (dynamic_value((unsigned long)argc + 1UL) != 8UL) ||
           (observed_branch(1UL) != 2UL) ||
           (side_effect_count != 1UL);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_constant_p_ice_regression.c"}
/* Regression for local-facts constant_p queries used inside GCC ICEs.
 * A runtime-dependent expression is not itself constant, but
 * __builtin_constant_p(runtime_expression) is an ICE whose value is zero.
 */
struct interval {
    int cur;
    int seg;
};

_Static_assert(__builtin_constant_p(6 * 7), "known integer constant");
_Static_assert(
    __builtin_choose_expr(__builtin_constant_p(6 * 7), 6 * 7 == 42, 0),
    "known constant_p must choose the true arm");

static int check_segment(struct interval *p) {
    _Static_assert(
        __builtin_choose_expr(
            __builtin_constant_p(p->cur < p->seg),
            p->cur < p->seg,
            1),
        "dynamic local must select the fallback arm");
    _Static_assert(
        __builtin_choose_expr(
            __builtin_constant_p(p->cur < p->seg),
            0,
            __builtin_choose_expr(__builtin_constant_p(3 + 4), 7 == 7, 0)),
        "nested compile-time selection");
    return p->cur < p->seg;
}

int main(void) {
    struct interval one;
    one.cur = 3;
    one.seg = 7;
    if (check_segment(&one) != 1)
        return 1;
    one.cur = 9;
    if (check_segment(&one) != 0)
        return 2;
    return 0;
}
@@@ end
