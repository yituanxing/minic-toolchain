               "forward and completed record signatures must retain identity");
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_indirect_fp_record_abi_negative.c"}
typedef struct {
    double value;
} FloatingRecord;

double unsupported_sysv_fp_record_return(double value,
                                         FloatingRecord (*reader)(double)) {
    FloatingRecord result = reader(value);
    return result.value;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_indirect_record_call_abi.c"}
typedef struct {
    unsigned value;
} SmallRegister;

typedef struct {
    unsigned long low, high;
} PairRegister;

typedef struct {
    unsigned long a, b, c, d, e;
} WideRegister;

typedef SmallRegister (*SmallReader)(unsigned);
typedef PairRegister (*PairReader)(unsigned);
typedef WideRegister (*WideReader)(unsigned);

static SmallRegister small_read(unsigned value) {
    SmallRegister result = { .value = 3U + value };
    return result;
}

static PairRegister pair_read(unsigned value) {
    PairRegister result = { .low = value + 7U, .high = value + 11U };
    return result;
}

static WideRegister wide_read(unsigned value) {
    WideRegister result = {
        .a = value, .b = value + 1U, .c = value + 2U,
        .d = value + 3U, .e = value + 4U
    };
    return result;
}

static unsigned consume_small(SmallRegister reg, unsigned amount) {
    return reg.value + amount;
}

unsigned indirect_small_record(unsigned value, SmallReader reader) {
    return consume_small(reader(value), 7U);
}

unsigned long indirect_pair_record(unsigned value, PairReader reader) {
    PairRegister reg = reader(value);
    return reg.low * 2UL + reg.high;
}

unsigned long indirect_wide_record(unsigned value, WideReader reader) {
    WideRegister reg = reader(value);
    return reg.a + reg.b + reg.c + reg.d + reg.e;
}

int main(void) {
    return indirect_small_record(17U, small_read) == 27U &&
           indirect_pair_record(10U, pair_read) == 55UL &&
           indirect_wide_record(10U, wide_read) == 60UL
               ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_inline_asm_eight_operands.c"}
unsigned long sbi_eight_operand_shape(unsigned long v0,
                                      unsigned long v1,
                                      unsigned long v2,
                                      unsigned long v3,
                                      unsigned long v4,
                                      unsigned long v5,
                                      unsigned long v6,
                                      unsigned long v7) {
    register unsigned long a0 asm("a0") = v0;
    register unsigned long a1 asm("a1") = v1;
    register unsigned long a2 asm("a2") = v2;
    register unsigned long a3 asm("a3") = v3;
    register unsigned long a4 asm("a4") = v4;
    register unsigned long a5 asm("a5") = v5;
    register unsigned long a6 asm("a6") = v6;
    register unsigned long a7 asm("a7") = v7;

    asm volatile("add %0, %0, %2\n\t# sbi %1 %3 %4 %5 %6 %7"
                 : "+r"(a0), "+r"(a1)
                 : "r"(a2), "r"(a3), "r"(a4), "r"(a5), "r"(a6), "r"(a7)
                 : "memory");
    return a0 + a1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_inline_asm_fence.c"}
static void write_fence(void) {
    __asm__ __volatile__("fence " "rw" "," "w" : : : "memory");
}

static void read_fence(void) {
    __asm__ __volatile__("fence " "r" "," "rw" : : : "memory");
}

int main(void) {
    write_fence();
    read_fence();
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/gnu_inline_asm_goto.c"}
static int dynamic_jump_label(int *key, int branch) {
    asm goto(
        "nop\n\t"
        ".long %l[label] - .\n\t"
        ".dword %0 - .\n\t"
        :
        : "i"(&((char *)key)[branch])
        :
        : label);

    return 0;
label:
    return 1;
}

static int literal_alternative(void) {
    asm goto(
        "j %l[yes]\n\t"
        ".word %[ext]\n\t"
        :
        : [ext] "i"(33)
        :
        : yes);

    return 0;
yes:
    return 1;
}

int main(void) {
    int key = 0;
    return dynamic_jump_label(&key, 0) + literal_alternative();
}
@@@ end
