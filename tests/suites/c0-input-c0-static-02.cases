@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/static_zero_length_record_field_relocation.c"}
static int target = 7;

struct payload {
    long a;
    long b;
    long c;
    long d;
    long e;
    long f;
    long g;
};

struct holder {
    int before;
    struct payload zero[0];
    int *pointer;
    int after;
    int *tail[];
};

static struct holder state = {
    .before = 3,
    .pointer = &target,
    .after = 5,
};

int main(void) {
    return (state.before == 3 && state.pointer == &target && *state.pointer == 7 &&
            state.after == 5)
               ? 0
               : 1;
}
