@@@ {"id": "c083857c5d97b622", "kind": "shared", "newline": true}
set -eu
: "${MINIC_CC:?set MINIC_CC}"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-riscv-shared-word-operations.sh", "shared": "c083857c5d97b622"}
#!/bin/sh
# Apt-free end-to-end Core -> RISC-V family word-operation lowering.
# Existing GNU/QEMU owner acceptance remains the final certification.

cat > "$work/rv32.i" <<'SRC'
typedef unsigned long long U;
typedef long long I;
U pair_add(U a, U b) { return a + b; }
U pair_sub(U a, U b) { return a - b; }
U pair_xor(U a, U b) { return a ^ b; }
U pair_and(U a, U b) { return a & b; }
U pair_or(U a, U b) { return a | b; }
U pair_not(U a) { return ~a; }
I pair_neg(I a) { return -a; }
U pair_shl(U a, unsigned k) { return a << k; }
U pair_shr(U a, unsigned k) { return a >> k; }
I pair_sar(I a, unsigned k) { return a >> k; }
U pair_shl_wide_count(U a, U k) { return a << k; }
int bit_clz(U a) { return __builtin_clzll(a); }
int bit_ctz(U a) { return __builtin_ctzll(a); }
SRC
"$MINIC_CC" --target=riscv32-linux -march=rv32i -mabi=ilp32 \
  -S "$work/rv32.i" -o "$work/rv32.s"
test -s "$work/rv32.s"
# MachineIR is the only RV32/RV64 emitter. Inspect each selected function's
# exact Base-I physical register forms (numeric xN and equivalent psABI
# spellings), without tying correctness to removed direct-emitter loop labels.
# The current bit scans and 2*XLEN shifts are deliberately branch-free.
require_form() {
  target=$1
  fn=$2
  form=$3
  # POSIX awk reserves `function`; choose an ordinary selector name.
  awk -v selected_fn="$fn" '
    $0 == selected_fn ":" { found = 1 }
    found { print }
    found && $1 == ".size" && $2 == selected_fn "," { exit }
  ' "$work/$target.s" | grep -Eq "$form" || {
    printf 'RISCV_SHARED_WORD_OPS=FAIL %s function=%s missing_MachineIR_form=%s\n' \
      "$target" "$fn" "$form" >&2
    exit 1
  }
}
require_function_set() {
  target=$1
  for fn in pair_add pair_sub pair_xor pair_and pair_or pair_not pair_neg \
            pair_shl pair_shr pair_sar bit_clz bit_ctz; do
    count=$(grep -Ec "^$fn:$" "$work/$target.s" || :)
    if [ "$count" -ne 1 ]; then
      printf 'RISCV_SHARED_WORD_OPS=FAIL %s function=%s count=%s\n' \
        "$target" "$fn" "$count" >&2
      exit 1
    fi
  done
}
require_pair_forms() {
  target=$1
  require_function_set "$target"
  # Wide ADD carry, SUB borrow and both 2*XLEN bitwise lanes.
  require_form "$target" pair_add '^  sltu (x30|t5), (x29|t4), (x5|t0)$'
  require_form "$target" pair_add '^  add (x6|t1), (x6|t1), (x30|t5)$'
  require_form "$target" pair_sub '^  sltu (x30|t5), (x5|t0), (x7|t2)$'
  require_form "$target" pair_xor '^  xor (x5|t0), (x5|t0), (x7|t2)$'
  require_form "$target" pair_and '^  and (x6|t1), (x6|t1), (x28|t3)$'
  require_form "$target" pair_or '^  or (x6|t1), (x6|t1), (x28|t3)$'
  require_form "$target" pair_not '^  not (x5|t0), (x5|t0)$'
  require_form "$target" pair_not '^  not (x6|t1), (x6|t1)$'
  require_form "$target" pair_neg '^  snez (x7|t2), (x5|t0)$'
  # Select the [0,XLEN), [XLEN,2*XLEN), >=2*XLEN cases with
  # register comparisons/masks, not deleted _wide_ge* branch islands.
  require_form "$target" pair_shl '^  sltu (x12|a2), (x7|t2), (x14|a4)$'
  require_form "$target" pair_shr '^  sltu (x13|a3), (x7|t2), (x14|a4)$'
  require_form "$target" pair_sar '^  sra (x16|a6), (x6|t1), (x10|a0)$'
  # CLZ/CTZ use an unrolled bit-search with Core SSA, not stale named loops.
  require_form "$target" bit_clz '^  srl (x5|t0), (x5|t0), (x28|t3)$'
  require_form "$target" bit_ctz '^  srl (x5|t0), (x5|t0), (x28|t3)$'
}
require_pair_forms rv32
test "$(grep -Ec '^pair_shl_wide_count:$' "$work/rv32.s" || :)" -eq 1
# A two-word shift count must mask out all counts with nonzero upper word.
require_form rv32 pair_shl_wide_count '^  seqz (x14|a4), (x30|t5)$'

cat > "$work/rv64.i" <<'SRC'
typedef unsigned __int128 U;
typedef __int128 I;
U pair_add(U a, U b) { return a + b; }
U pair_sub(U a, U b) { return a - b; }
U pair_xor(U a, U b) { return a ^ b; }
U pair_and(U a, U b) { return a & b; }
U pair_or(U a, U b) { return a | b; }
U pair_not(U a) { return ~a; }
I pair_neg(I a) { return -a; }
U pair_shl(U a, unsigned k) { return a << k; }
U pair_shr(U a, unsigned k) { return a >> k; }
I pair_sar(I a, unsigned k) { return a >> k; }
int bit_clz(unsigned long a) { return __builtin_clzl(a); }
int bit_ctz(unsigned long a) { return __builtin_ctzl(a); }
SRC
"$MINIC_CC" --target=riscv64-linux -march=rv64i -mabi=lp64 \
  -S "$work/rv64.i" -o "$work/rv64.s"
test -s "$work/rv64.s"
require_pair_forms rv64
if grep -Eq '^[[:space:]]+(mul|mulw|div|rem|clz|ctz)[[:space:]]' \
   "$work/rv32.s" "$work/rv64.s"; then
  echo "RISCV_SHARED_WORD_OPS=FAIL unexpected non-I instruction" >&2
  exit 1
fi
echo 'RISCV_SHARED_WORD_OPS=PASS rv32=64bit-pair rv64=128bit-pair clz_ctz=xlen-based shifts=zero_1_limb_2limb_highcount'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-rv64-extended-float-native.sh", "shared": "c083857c5d97b622"}
#!/bin/sh
# apt-free fast Frontend + Core + RV64 Backend preflight.
# Full original RV64 glibc/GNU/QEMU comparison runs separately in T1.
cat >"$work/header.i" <<'SRC'
typedef _Float32 rv_float32;
typedef _Float64 rv_float64;
typedef _Float32x rv_float32x;
typedef _Float64x rv_float64x;
typedef _Float128 rv_float128;
extern _Float32 strtof32(const char *, char **);
extern _Float64 strtof64(const char *, char **);
extern _Float128 strtof128(const char *, char **);
int rv64_extended_header_sizes(void) {
    return sizeof(rv_float32) == 4U &&
           sizeof(rv_float64) == 8U &&
           sizeof(rv_float32x) == 8U &&
           sizeof(rv_float64x) == 16U &&
           sizeof(rv_float128) == 16U ? 42 : 1;
}
SRC
if ! "$MINIC_CC" --target=riscv64-linux -S "$work/header.i" \
  -o "$work/output.s" 2>"$work/minic.err"; then
  echo "RV64_FLOAT_DECL_NATIVE=FAIL stage=minic" >&2
  sed -n '1,25p' "$work/minic.err" >&2
  exit 1
fi
test -s "$work/output.s"
grep -q 'rv64_extended_header_sizes' "$work/output.s"
echo 'RV64_FLOAT_DECL_NATIVE=PASS five_distinct_extended_types=1 binary128_size_layout=1 glibc_declarations=3 cross_ABI_not_claimed=1'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100755", "newline": true, "path": "tests/compiler/c0/probe-rv64-pic-glibc-got.sh", "shared": "c083857c5d97b622"}
#!/bin/sh
# Independent PIC vs static-linux RISC-V addressing oracle.
# Static kernel mode MUST retain PCREL relocations and avoid GOT; GNU/glibc
# dynamic PIE must use GOT for extern data and function addresses.
# Linux headers declare hidden vDSO/EFI symbols that are never used by the
# emitted TU. A declaration alone must not create an undefined ELF symbol:
# GNU ld rejects even an unreferenced `.hidden missing_symbol`.
cat > "$work/source.c" <<'SRC'
extern int optind;
extern int puts(const char *);
extern int printf(const char *, ...);
extern int rv64_unused_hidden_object __attribute__((visibility("hidden")));
extern int rv64_unused_internal_object __attribute__((visibility("internal")));
__attribute__((visibility("protected"))) extern int rv64_unused_protected_function(void);
__attribute__((visibility("hidden"))) extern int rv64_unused_hidden_function(void);
static inline int rv64_unused_inline_hidden_reference(void) {
    return rv64_unused_hidden_object + rv64_unused_hidden_function();
}
int *rv_pic_optind(void) { return &optind; }
int (*rv_pic_puts(void))(const char *) { return &puts; }
int main(void) {
    if (rv_pic_optind() != &optind || rv_pic_puts() != &puts)
        return 1;
    printf("RV64_GLIBC_PIE_GOT_OK:%d\\n", optind > 0);
    return 42;
}
SRC
cat > "$work/nonpreemptible.c" <<'SRC'
static int local_data;
static int local_function(void) { return local_data; }
extern int hidden_data __attribute__((visibility("hidden")));
__attribute__((visibility("hidden"))) extern int hidden_function(void);
extern int ordinary_extern;
extern int ordinary_function(void);
int *local_data_address(void) { return &local_data; }
int (*local_function_address(void))(void) { return &local_function; }
int *hidden_data_address(void) { return &hidden_data; }
int (*hidden_function_address(void))(void) { return &hidden_function; }
int *ordinary_data_address(void) { return &ordinary_extern; }
int (*ordinary_function_address(void))(void) { return &ordinary_function; }
const char *boot_chosen_string(void) { return "/chosen"; }
SRC
# -E -P is deliberately used even in apt-free mode; the TU has no headers.
cp "$work/source.c" "$work/source.i"
"$MINIC_CC" --target=riscv64-linux -fPIE -S "$work/source.i" -o "$work/pic.s"
"$MINIC_CC" --target=riscv64-linux -fno-pie -S "$work/source.i" -o "$work/kernel.s"
if grep -Eq '^[[:space:]]*\.(hidden|internal|protected)[[:space:]]+rv64_unused_' \
   "$work/pic.s" "$work/kernel.s"; then
  echo 'RV64_PIC_GLIBC_GOT=FAIL unreferenced visibility declaration emitted' >&2
  exit 1
fi
for pic_flag in -fPIE -fPIC; do
  "$MINIC_CC" --target=riscv64-linux "$pic_flag" -S \
    "$work/nonpreemptible.c" -o "$work/nonpreemptible-$pic_flag.s"
  for symbol in hidden_data hidden_function; do
    grep -Eq "^[[:space:]]*\\.hidden[[:space:]]+$symbol$" "$work/nonpreemptible-$pic_flag.s" || {
      echo "RV64_PIC_GLIBC_GOT=FAIL $pic_flag lost live hidden binding for $symbol" >&2
      exit 1
    }
  done
  for symbol in local_data local_function hidden_data hidden_function; do
    grep -Eq "^[[:space:]]+lla (x5|t0), $symbol$" "$work/nonpreemptible-$pic_flag.s" || {
      echo "RV64_PIC_GLIBC_GOT=FAIL $pic_flag should use PCREL for $symbol" >&2
      exit 1
    }
  done
  grep -Eq '^[[:space:]]+lla (x5|t0), \.Lminic_string_[0-9]+' \
    "$work/nonpreemptible-$pic_flag.s" || {
    echo "RV64_PIC_GLIBC_GOT=FAIL $pic_flag private_string_got_regression=1" >&2
    exit 1
  }
  for symbol in ordinary_extern ordinary_function; do
    grep -Eq "^[[:space:]]+la (x5|t0), $symbol$" "$work/nonpreemptible-$pic_flag.s" || {
      echo "RV64_PIC_GLIBC_GOT=FAIL $pic_flag should use GOT for $symbol" >&2
      exit 1
    }
  done
done
"$MINIC_CC" --target=riscv64-linux -fno-pie -S \
  "$work/nonpreemptible.c" -o "$work/nonpreemptible-static.s"
if grep -q '  .option pic' "$work/nonpreemptible-static.s"; then
  echo 'RV64_PIC_GLIBC_GOT=FAIL kernel_pic_got_regression=1' >&2
  exit 1
fi
grep -Fq '  .option pic' "$work/pic.s" || {
  echo 'RV64_PIC_GLIBC_GOT=FAIL missing PIC directive' >&2
  exit 1
}
grep -Eq '^  la (x5|t0), optind$' "$work/pic.s" || {
  echo 'RV64_PIC_GLIBC_GOT=FAIL missing external optind GOT addressing' >&2
  exit 1
}
grep -Eq '^  la (x5|t0), puts$' "$work/pic.s" || {
  echo 'RV64_PIC_GLIBC_GOT=FAIL missing external puts GOT addressing' >&2
  exit 1
}
grep -Eq '^  lla (x5|t0), optind$' "$work/kernel.s" || {
  echo 'RV64_PIC_GLIBC_GOT=FAIL missing static optind PCREL addressing' >&2
  exit 1
}
grep -Eq '^  lla (x5|t0), puts$' "$work/kernel.s" || {
  echo 'RV64_PIC_GLIBC_GOT=FAIL missing static puts PCREL addressing' >&2
  exit 1
}
if grep -q '  .option pic' "$work/kernel.s"; then
  echo 'RV64_PIC_GLIBC_GOT=FAIL static_kernel_got_regression=1' >&2
  exit 1
fi
if [ "${MINIC_PIC_ASM_ONLY:-0}" = 1 ]; then
  echo 'RV64_PIC_GLIBC_GOT=PASS stage=apt_free_core_target preemptible_GOT=1 private_hidden_PCREL=1 unused_visibility_decls_emitted=0 live_hidden_binding=1 kernel_lla=1'
  exit 0
fi
gcc=${RISCV_CC:-riscv64-linux-gnu-gcc}
qemu=${QEMU_RISCV64:-qemu-riscv64}
sysroot=${RISCV_SYSROOT:-/usr/riscv64-linux-gnu}
"$gcc" -fPIE -pie "$work/source.c" -o "$work/gnu"
"$gcc" -c -x assembler "$work/pic.s" -o "$work/mini.o"
"${gcc%-gcc}-readelf" -Wr "$work/mini.o" >"$work/mini.reloc"
grep -q 'R_RISCV_GOT_HI20.*optind' "$work/mini.reloc"
grep -q 'R_RISCV_GOT_HI20.*puts' "$work/mini.reloc"
"$gcc" -c -x assembler "$work/nonpreemptible--fPIE.s" \
  -o "$work/nonpreemptible.o"
"${gcc%-gcc}-readelf" -Wr "$work/nonpreemptible.o" \
  >"$work/nonpreemptible.reloc"
grep -q 'R_RISCV_PCREL_HI20' "$work/nonpreemptible.reloc"
for symbol in ordinary_extern ordinary_function; do
  grep -Eq "R_RISCV_GOT_HI20.*$symbol" "$work/nonpreemptible.reloc" || {
    echo "RV64_PIC_GLIBC_GOT=FAIL missing preemptible relocation for $symbol" >&2
    exit 1
  }
done
if grep -Eq 'R_RISCV_GOT_HI20.*(hidden_data|hidden_function|local_data|local_function|\.Lminic_string_)' \
    "$work/nonpreemptible.reloc"; then
  echo 'RV64_PIC_GLIBC_GOT=FAIL nonpreemptible GOT relocation' >&2
  exit 1
fi
"$gcc" -c -x assembler "$work/kernel.s" -o "$work/kernel.o"
"${gcc%-gcc}-readelf" -Wr "$work/kernel.o" >"$work/kernel.reloc"
grep -q 'R_RISCV_PCREL_HI20.*optind' "$work/kernel.reloc"
"$gcc" -pie "$work/mini.o" -o "$work/mini"
set +e
"$qemu" -L "$sysroot" "$work/gnu" >"$work/gnu.out" 2>"$work/gnu.err"
gnu_rc=$?
"$qemu" -L "$sysroot" "$work/mini" >"$work/mini.out" 2>"$work/mini.err"
mini_rc=$?
set -e
if [ "$gnu_rc" -ne 42 ] || [ "$mini_rc" -ne 42 ] ||
   ! cmp -s "$work/gnu.out" "$work/mini.out" ||
   ! cmp -s "$work/gnu.err" "$work/mini.err"; then
  echo "RV64_PIC_GLIBC_GOT=FAIL GNU_rc=$gnu_rc MiniC_rc=$mini_rc" >&2
  cat "$work/gnu.out" "$work/mini.out" "$work/mini.err" >&2
  exit 1
fi
echo 'RV64_PIC_GLIBC_GOT=PASS GNU_QEMU_byte_exact=1 R_RISCV_GOT_HI20_extern=1 unused_visibility_decls_emitted=0 live_hidden_binding=1 static_kernel_PCREL=1'
@@@ end
