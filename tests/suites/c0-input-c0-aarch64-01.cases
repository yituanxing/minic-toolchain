@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64-linux-cap-alternative.c"}
/* Original Linux 6.6 arch/arm64/include/asm/alternative-macros.h.
 * The default feature path is NOP; the alternative table records a branch
 * to a named C label for Linux boot-time capability patching. */
#define STRINGIFY_1(x) #x
#define STRINGIFY(x) STRINGIFY_1(x)
#define __emit_inst(x) ".inst " STRINGIFY((x)) "\n\t"
#define Op1_shift 16
#define Op2_shift 5
#define CRm_shift 8
#define pstate_field(op1, op2) ((op1) << Op1_shift | (op2) << Op2_shift)
#define PSTATE_PAN pstate_field(0, 4)
#define SET_PSTATE(x, r) __emit_inst(0xd500401f | PSTATE_ ## r | ((!!x) << CRm_shift))
#define SET_PSTATE_PAN(x) SET_PSTATE((x), PAN)

#define ALTINSTR_ENTRY(cap)                           \
    " .word 661b - .\n"                              \
    " .word 663f - .\n"                              \
    " .hword " STRINGIFY(cap) "\n"                    \
    " .byte 662b-661b\n"                            \
    " .byte 664f-663f\n"
#define ALTINSTR_ENTRY_CB(cap, cb)                    \
    " .word 661b - .\n"                              \
    " .word " STRINGIFY(cb) "- .\n"                   \
    " .hword " STRINGIFY(cap) "\n"                    \
    " .byte 662b-661b\n"                            \
    " .byte 664f-663f\n"
#define ALTERNATIVE_CFG(oldinstr, newinstr, cap)      \
    ".if 1 == 1\n"                                  \
    "661:\n\t"                                      \
    oldinstr "\n"                                   \
    "662:\n"                                        \
    ".pushsection .altinstructions,\"a\"\n"         \
    ALTINSTR_ENTRY(cap)                              \
    ".popsection\n"                                 \
    ".subsection 1\n"                               \
    "663:\n\t"                                      \
    newinstr "\n"                                   \
    "664:\n\t"                                      \
    ".org\t. - (664b-663b) + (662b-661b)\n\t"      \
    ".org\t. - (662b-661b) + (664b-663b)\n\t"      \
    ".previous\n"                                   \
    ".endif\n"
#define ALTERNATIVE_CB(oldinstr, cap, cb)             \
    ".if 1 == 1\n"                                  \
    "661:\n\t"                                      \
    oldinstr "\n"                                   \
    "662:\n"                                        \
    ".pushsection .altinstructions,\"a\"\n"         \
    ALTINSTR_ENTRY_CB((1 << 15) | (cap), cb)          \
    ".popsection\n"                                 \
    "663:\n\t"                                      \
    "664:\n\t"                                      \
    ".endif\n"

/* ARM64_HAS_PAN is a generated cpucap. The ABI of this exact expansion
 * is checked against the frozen corpus signature; do not assume a v6.6
 * numeric cap still equals Linux 6.6.143's generated number. */
#ifndef PAN_CAP
#define PAN_CAP 38
#endif
#ifdef CHECK_PAN_ALT
void linux_pan_disable(void) {
    __asm__(ALTERNATIVE_CFG("nop", SET_PSTATE_PAN(0), PAN_CAP));
}
void linux_pan_enable(void) {
    __asm__(ALTERNATIVE_CFG("nop", SET_PSTATE_PAN(1), PAN_CAP));
}
#endif

/* Linux alternative_has_cap_unlikely(): this is the *other* NOP family,
 * using asm goto, a named immediate feature and a named C branch label.
 * It occurs in generic Linux objects, not just arch/arm64/uaccess. */
int linux_has_cap_unlikely(void) {
    __asm__ goto (
        ALTERNATIVE_CFG("nop", "b\t%l[l_yes]", %[cpucap])
        :
        : [cpucap] "i" (38UL)
        :
        : l_yes);
    return 0;
l_yes:
    return 1;
}

/* Linux alternative_has_cap_likely(): the original is an unconditional
 * branch; the alternative callback turns that branch into NOPs. The callback
 * address in .altinstructions is a PREL32 relocation, not a dead comment. */
void alt_cb_patch_nops(void) {}
int linux_has_cap_likely(void) {
    __asm__ goto (
        ALTERNATIVE_CB("b\t%l[l_no]", %[cpucap], alt_cb_patch_nops)
        : : [cpucap] "i" (38UL) : : l_no);
    return 1;
l_no:
    return 0;
}

int main(void) {
    /* Before Linux boot-time patching the original NOP falls through. */
    return linux_has_cap_unlikely() == 0 &&
           linux_has_cap_likely() == 0 ? 42 : 1;
}

/* Deferred cpucap is a real Linux pattern but is only -S discovery until
 * MiniC can specialize the inline caller's compile-time immediate. */
#ifdef CHECK_DEFERRED
int linux_has_cap_deferred(const unsigned long cpucap) {
    __asm__ goto (
        ALTERNATIVE_CFG("nop", "b\t%l[l_yes]", %[cpucap])
        : : [cpucap] "i" (cpucap) : : l_yes);
    return 0;
l_yes:
    return 1;
}
int linux_has_cap_likely_deferred(const unsigned long cpucap) {
    __asm__ goto (
        ALTERNATIVE_CB("b\t%l[l_no]", %[cpucap], alt_cb_patch_nops)
        : : [cpucap] "i" (cpucap) : : l_no);
    return 1;
l_no:
    return 0;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64-linux-narrow-cmpxchg.c"}
/* Original Linux 6.6 arm64 atomic_ll_sc.h __CMPXCHG_CASE: width and
 * memory-order combinations, including the required narrow old cast. */
typedef unsigned char u8;
typedef unsigned short u16;
typedef unsigned int u32;
typedef unsigned long long u64;

#define NO_CLOBBER
#define MEMORY_CLOBBER : "memory"
#define DEFINE_CMPXCHG(T, W, MODE, LD, ST, FENCE, CLOB)                  \
T cmp_##W##_##MODE(volatile void *ptr, unsigned long old, T replacement) { \
    unsigned long tmp;                                                   \
    T oldval;                                                            \
    old = (T)old;                                                        \
    __asm__ __volatile__(                                               \
        " prfm pstl1strm, %[v]\n"                                      \
        "1: " #LD " %w[oldval], %[v]\n"                                \
        " eor %w[tmp], %w[oldval], %w[old]\n"                          \
        " cbnz %w[tmp], 2f\n"                                           \
        " " #ST " %w[tmp], %w[new], %[v]\n"                            \
        " cbnz %w[tmp], 1b\n"                                           \
        FENCE "2:"                                                     \
        : [tmp] "=&r" (tmp), [oldval] "=&r" (oldval),                    \
          [v] "+Q" (*(T *)ptr)                                         \
        : [old] "Kr" (old), [new] "r" (replacement) CLOB);              \
    return oldval;                                                       \
}

DEFINE_CMPXCHG(u8, 8, relaxed, ldxrb, stxrb, "", NO_CLOBBER)
DEFINE_CMPXCHG(u8, 8, acquire, ldaxrb, stxrb, "", MEMORY_CLOBBER)
DEFINE_CMPXCHG(u8, 8, release, ldxrb, stlxrb, "", MEMORY_CLOBBER)
DEFINE_CMPXCHG(u8, 8, full, ldxrb, stlxrb, " dmb ish\n", MEMORY_CLOBBER)
DEFINE_CMPXCHG(u16, 16, relaxed, ldxrh, stxrh, "", NO_CLOBBER)
DEFINE_CMPXCHG(u16, 16, acquire, ldaxrh, stxrh, "", MEMORY_CLOBBER)
DEFINE_CMPXCHG(u16, 16, release, ldxrh, stlxrh, "", MEMORY_CLOBBER)
DEFINE_CMPXCHG(u16, 16, full, ldxrh, stlxrh, " dmb ish\n", MEMORY_CLOBBER)

/* Exercise the 32/64-bit members of the *same* 16-form ISA contract,
 * including GNU register width and Lr-versus-Kr old-value constraints.
 * Width=64 uses X registers, while subword/word values use W registers;
 * the STXR/STLXR status remains W for every width. */
#define DEFINE_WIDE_CMPXCHG(T, W, REG, CON, MODE, LD, ST, FENCE, CLOB)    \
T cmp_##W##_##MODE(volatile void *ptr, unsigned long old, T replacement) { \
    unsigned long tmp;                                                     \
    T oldval;                                                              \
    old = (T)old;                                                          \
    __asm__ __volatile__(                                                 \
        " prfm pstl1strm, %[v]\n"                                        \
        "1: " #LD " " REG "[oldval], %[v]\n"                             \
        " eor " REG "[tmp], " REG "[oldval], " REG "[old]\n"              \
        " cbnz " REG "[tmp], 2f\n"                                       \
        " " #ST " %w[tmp], " REG "[new], %[v]\n"                          \
        " cbnz %w[tmp], 1b\n"                                            \
        FENCE "2:"                                                        \
        : [tmp] "=&r" (tmp), [oldval] "=&r" (oldval),                      \
          [v] "+Q" (*(T *)ptr)                                           \
        : [old] CON (old), [new] "r" (replacement) CLOB);                \
    return oldval;                                                         \
}

DEFINE_WIDE_CMPXCHG(u32, 32, "%w", "Kr", relaxed, ldxr, stxr, "", NO_CLOBBER)
DEFINE_WIDE_CMPXCHG(u32, 32, "%w", "Kr", acquire, ldaxr, stxr, "", MEMORY_CLOBBER)
DEFINE_WIDE_CMPXCHG(u32, 32, "%w", "Kr", release, ldxr, stlxr, "", MEMORY_CLOBBER)
DEFINE_WIDE_CMPXCHG(u32, 32, "%w", "Kr", full, ldxr, stlxr, " dmb ish\n", MEMORY_CLOBBER)
DEFINE_WIDE_CMPXCHG(u64, 64, "%", "Lr", relaxed, ldxr, stxr, "", NO_CLOBBER)
DEFINE_WIDE_CMPXCHG(u64, 64, "%", "Lr", acquire, ldaxr, stxr, "", MEMORY_CLOBBER)
DEFINE_WIDE_CMPXCHG(u64, 64, "%", "Lr", release, ldxr, stlxr, "", MEMORY_CLOBBER)
DEFINE_WIDE_CMPXCHG(u64, 64, "%", "Lr", full, ldxr, stlxr, " dmb ish\n", MEMORY_CLOBBER)

int test_narrow_byte(void) {
    u8 v = 3;
    /* Every success must publish exactly its replacement and expose the
     * previous value, while the mismatch branch leaves memory unchanged. */
    u8 a = cmp_8_relaxed(&v, 0x103UL, 4);
    u8 b = cmp_8_acquire(&v, 0x204UL, 5);
    u8 c = cmp_8_release(&v, 0x206UL, 9);
    u8 d = cmp_8_full(&v, 0x105UL, 6);
    return v == 6 && a == 3 && b == 4 && c == 5 && d == 5;
}

int test_narrow_half(void) {
    u16 v = 0x1234;
    u16 a = cmp_16_relaxed(&v, 0x11234UL, 0x2345);
    u16 b = cmp_16_acquire(&v, 0x22345UL, 0x3456);
    u16 c = cmp_16_release(&v, 0x13457UL, 0x4444);
    u16 d = cmp_16_full(&v, 0x13456UL, 0x4567);
    return v == 0x4567 && a == 0x1234 && b == 0x2345 &&
           c == 0x3456 && d == 0x3456;
}

int test_wide_word(void) {
    u32 v = 0x80001234U;
    u32 a = cmp_32_relaxed(&v, 0x180001234UL, 0x01010101U);
    u32 b = cmp_32_acquire(&v, 0x101010101UL, 0x02020202U);
    u32 c = cmp_32_release(&v, 0x102020203UL, 0x04040404U);
    u32 d = cmp_32_full(&v, 0x102020202UL, 0x03030303U);
    return v == 0x03030303U && a == 0x80001234U &&
           b == 0x01010101U && c == 0x02020202U && d == 0x02020202U;
}

int test_wide_double(void) {
    u64 v = 0x1234567887654321ULL;
    u64 a = cmp_64_relaxed(&v, 0x1234567887654321UL, 0x1020304050607080ULL);
    u64 b = cmp_64_acquire(&v, 0x1020304050607080UL, 0x2233445566778899ULL);
    u64 c = cmp_64_release(&v, 0x2233445566778898UL, 0x9988776655443322ULL);
    u64 d = cmp_64_full(&v, 0x2233445566778899UL, 0xaabbccddeeff0011ULL);
    return v == 0xaabbccddeeff0011ULL && a == 0x1234567887654321ULL &&
           b == 0x1020304050607080ULL && c == 0x2233445566778899ULL &&
           d == 0x2233445566778899ULL;
}

int main(void) {
    return test_narrow_byte() && test_narrow_half() &&
           test_wide_word() && test_wide_double() ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64-nzcv-nospec.i"}
unsigned long array_index_mask_nospec(unsigned long idx, unsigned long sz) {
    unsigned long mask;
    asm volatile("cmp %1, %2\n\tsbc %0, xzr, xzr\n"
                 : "=r"(mask) : "r"(idx), "Ir"(sz) : "cc");
    return mask;
}
register unsigned long current_stack_pointer asm("sp");
static unsigned long read_live_sp(void) {
    volatile unsigned long local = 21UL;
    unsigned long snapshot = current_stack_pointer;
    unsigned long local_address = (unsigned long)&local;
    if (snapshot == 0UL || (snapshot & 15UL) != 0UL ||
        local_address < snapshot || local_address - snapshot > 4096UL)
        return 1UL;
    return local;
}
__attribute__((noinline))
static unsigned long inner_return_clobber(unsigned long value) {
    return value + 1UL;
}
__attribute__((noinline))
static void *read_saved_return_address(void) {
    if (inner_return_clobber(41UL) != 42UL) return (void *)0;
    return __builtin_return_address(0);
}
int main(void) {
    if (array_index_mask_nospec(3UL, 4UL) != ~0UL) return 1;
    if (array_index_mask_nospec(4UL, 4UL) != 0UL) return 2;
    if (array_index_mask_nospec(5UL, 4UL) != 0UL) return 3;
    if (array_index_mask_nospec(0UL, 0UL) != 0UL) return 4;
    if (array_index_mask_nospec(0UL, 1UL) != ~0UL) return 5;
    if (read_live_sp() != 21UL) return 6;
    void *first = read_saved_return_address();
    void *second = read_saved_return_address();
    if (!first || !second || first == second) return 7;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64-typed-frame-production.i"}
typedef unsigned long u64;
static volatile u64 memory;
static volatile double numbers;

__attribute__((noinline)) static double floating(double a, float f) {
    double b = a * (double)f;
    double c = b / 2.0 + a;
    numbers = c;
    return c;
}

__attribute__((noinline)) static u64 effect(u64 *address) {
    u64 x = *address;
    *address = x + 1UL;
    return *address;
}

int main(void) {
    u64 local = 41UL;
    memory = effect(&local);
    return memory == 42UL && floating(4.0, 2.0f) == 8.0 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_64bit_pointer_stride.c"}
/* Type-size-only test: a 64-bit LP64 pointer-element stride needs MOVK at
 * bit 32. No object of this size is allocated at runtime. */
struct VastPointerElement {
    unsigned char payload[4295033120ULL];
};

struct VastPointerElement *vast_pointer_add(
    struct VastPointerElement *base, unsigned long index) {
    return base + index;
}

unsigned long vast_pointer_element_size(void) {
    return sizeof(struct VastPointerElement);
}
