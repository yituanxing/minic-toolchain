@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_builtin_va_list_declaration.c"}
/* AArch64 AAPCS64's compiler builtin is a declaration specifier in block
 * scopes as well as in formal parameters and typedefs. Its internal proxy
 * remains owned by TargetInfo; name classification must not invent an ISA. */
#if defined(INVALID_CONST_DEST)
int bad_va_copy(__builtin_va_list source) {
    const __builtin_va_list independent = source;
    __builtin_va_copy(independent, source);
    return 0;
}
#elif defined(INVALID_INTEGER_DEST)
int bad_va_copy(__builtin_va_list source) {
    int independent = 0;
    __builtin_va_copy(independent, source);
    return 0;
}
#elif defined(INVALID_INTEGER_SOURCE)
int bad_va_copy(__builtin_va_list source) {
    __builtin_va_list independent;
    __builtin_va_copy(independent, 0);
    return 0;
}
#else
typedef __builtin_va_list MiniAArch64VaList;
int builtin_va_declaration_probe(__builtin_va_list source) {
    __builtin_va_list independent;
    MiniAArch64VaList typed_independent;
    __builtin_va_copy(independent, source);
    __builtin_va_copy(typed_independent, independent);
    /* `for` initializers consult the same declaration-vs-expression probe
     * as block statements. Ensure both accept the builtin type spelling. */
    for (__builtin_va_list loop_cursor = typed_independent; 0;) {
        __builtin_va_end(loop_cursor);
    }
    __builtin_va_end(typed_independent);
    __builtin_va_end(independent);
    return 0;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_clone_safe_asm_policy.c"}
/* Direct negative and positive checks for AArch64 static clone ASM policy.
 * Build with src/target/aarch64/asm_contract.c under -ffunction-sections. */
#include "target/aarch64/asm_contract.h"
#include "target/aarch64/asm_contract_source.h"
#include "frontend/ast.h"
#include <stdio.h>
#include <string.h>

static int expect(const char *name, bool got, bool wanted)
{
    if (got == wanted) return 0;
    fprintf(stderr, "%s: clone policy got=%u expected=%u\n",
            name, (unsigned)got, (unsigned)wanted);
    return 1;
}

int main(void)
{
    MinicInlineAsmOperand output = {0}, input = {0};
    MinicInlineAsm source = {0};
    int failures = 0;

    output.constraint_text = "=r";
    output.constraint_length = 2U;
    input.constraint_text = "0";
    input.constraint_length = 1U;
    source.template_text = "";
    source.template_length = 0U;
    source.outputs = &output;
    source.output_count = 1U;
    source.inputs = &input;
    source.input_count = 1U;

    failures += expect("tied-register-empty", minic_aarch64_clone_safe_opaque_asm(&source), true);
    source.template_text = "nop";
    source.template_length = 3U;
    failures += expect("nonempty-template", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.template_text = "";
    source.template_length = 0U;
    source.has_memory_clobber = true;
    failures += expect("memory-clobber", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.has_memory_clobber = false;
    source.clobber_count = 1U;
    failures += expect("other-clobber", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.clobber_count = 0U;
    source.register_clobber_count = 1U;
    failures += expect("register-clobber", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.register_clobber_count = 0U;
    source.is_goto = true;
    failures += expect("asm-goto", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.is_goto = false;
    source.label_count = 1U;
    failures += expect("named-label", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.label_count = 0U;
    output.constraint_text = "+r";
    failures += expect("readwrite-output", minic_aarch64_clone_safe_opaque_asm(&source), false);
    output.constraint_text = "=r";
    input.constraint_text = "r";
    failures += expect("untied-input", minic_aarch64_clone_safe_opaque_asm(&source), false);
    input.constraint_text = "0";
    source.output_count = 2U;
    failures += expect("multiple-outputs", minic_aarch64_clone_safe_opaque_asm(&source), false);

    source.output_count = 0U;
    source.input_count = 0U;
    source.is_volatile = true;
    failures += expect("volatile-empty", minic_aarch64_clone_safe_opaque_asm(&source), true);
    source.has_memory_clobber = true;
    failures += expect("volatile-memory-clobber", minic_aarch64_clone_safe_opaque_asm(&source), false);
    source.has_memory_clobber = false;
    source.is_volatile = false;
    failures += expect("nonvolatile-zero-operands", minic_aarch64_clone_safe_opaque_asm(&source), false);
    return failures == 0 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_fixmap_cross_static_const.c"}
/* Linux 6.6.143: patch_map(fixmap) -> set_fixmap_offset -> fix_to_virt.
 * A plain TU-local static wrapper must not prevent __always_inline's
 * compile-time assertion from seeing its constant enum caller. */
enum fixed_addresses { FIX_HOLE, FIX_TEXT_POKE0, __end_of_fixed_addresses };
extern void original_set_fixmap(unsigned int, unsigned long, unsigned long);
static __attribute__((always_inline)) inline unsigned long fix_to_virt(unsigned int idx) {
    do { extern void __compiletime_assert_fixmap(void)
        __attribute__((error("fixmap index must be constant in range")));
        if (!(!(idx >= __end_of_fixed_addresses))) __compiletime_assert_fixmap();
    } while (0);
    return 0xffff000000000000UL - ((unsigned long)idx << 12);
}
#define set_fixmap_offset(idx, phys) ({ unsigned long address; \
    original_set_fixmap((idx), (phys), 0); \
    address = fix_to_virt((idx)) + ((phys) & 4095UL); address; })
static void *patch_map(void *addr, int fixmap) {
    return (void *)set_fixmap_offset(fixmap, (unsigned long)addr);
}
void *patch_entry(void *addr) { return patch_map(addr, FIX_TEXT_POKE0); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_fixmap_cross_static_const_bug_asm.c"}
/* Linux 6.6.143 patch_map shape: guarded fix_to_virt behind an ordinary
 * static wrapper with arm64's real BUG_ON metadata/BRK inline asm. Keep this
 * separate from the no-ASM green regression until Core can clone it safely. */
enum fixed_addresses { FIX_HOLE, FIX_TEXT_POKE0, FIX_TEXT_POKE1,
                       __end_of_fixed_addresses };
extern void original_set_fixmap(unsigned int, unsigned long, unsigned long);

/* CONFIG_GENERIC_BUG + CONFIG_DEBUG_BUGVERBOSE: GAS-local numeric labels
 * cross section push/pop and create ELF __bug_table relative fixups. */
#define ORIGINAL_STRINGIFY_1(value) #value
#define ORIGINAL_STRINGIFY(value) ORIGINAL_STRINGIFY_1(value)
#define ORIGINAL_ASM_BUG_FLAGS(flags) \
    ".pushsection __bug_table,\"aw\";\n" \
    ".align 2;\n" \
    "14470: .long 14471f - .;\n" \
    ".pushsection .rodata.str,\"aMS\",@progbits,1;\n" \
    "14472: .string \"" __FILE__ "\";\n" \
    ".popsection;\n" \
    ".long 14472b - .;\n" \
    ".short " ORIGINAL_STRINGIFY(__LINE__) ";\n" \
    ".short " #flags ";\n" \
    ".align 2;\n" \
    ".popsection;\n" \
    "14471: brk 0x800\n"
#define ORIGINAL_BUG() do { asm volatile(ORIGINAL_ASM_BUG_FLAGS(0)); \
    __builtin_unreachable(); } while (0)
#define ORIGINAL_BUG_ON(condition) do { if (__builtin_expect(!!(condition), 0)) \
    ORIGINAL_BUG(); } while (0)

static __attribute__((always_inline)) inline unsigned long fix_to_virt(unsigned int idx) {
    do { extern void __compiletime_assert_fixmap(void)
        __attribute__((error("fixmap index must be constant in range")));
        if (!(!(idx >= __end_of_fixed_addresses))) __compiletime_assert_fixmap();
    } while (0);
    return 0xffff000000000000UL - ((unsigned long)idx << 12);
}
#define set_fixmap_offset(idx, phys) ({ unsigned long address; \
    original_set_fixmap((idx), (phys), 0); \
    address = fix_to_virt((idx)) + ((phys) & 4095UL); address; })
static void *patch_map(void *addr, int fixmap) {
    ORIGINAL_BUG_ON(!addr);
    return (void *)set_fixmap_offset(fixmap, (unsigned long)addr);
}
void *patch_entry(void *addr) { return patch_map(addr, FIX_TEXT_POKE0); }
/* Two distinct constant callsites require separate clones. Their repeated
 * numeric labels must remain local to each emitted __bug_table entry. */
void *patch_entry_two(void *addr) { return patch_map(addr, FIX_TEXT_POKE1); }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_fixmap_opaque_asm_clone.c"}
/* Linux 6.6.143 arch/arm64/kernel/patching.c: a TU-local non-inline
 * wrapper holds a tied-register empty GNU asm, an empty volatile asm, and
 * a closed-numeric-label BUG table. The caller's constant fixmap index
 * must pass through the wrapper to discharge the inline BUILD_BUG_ON.
 * Cloning any arbitrary ASM with external labels is intentionally unsafe. */
enum fixed_addresses { FIX_HOLE, FIX_TEXT_POKE0, __end_of_fixed_addresses };
extern void minic_bad_fixmap(void)
    __attribute__((error("fixmap index must be constant and in range")));

static __attribute__((always_inline)) inline unsigned long
fix_to_virt(unsigned int idx)
{
    if (idx >= __end_of_fixed_addresses)
        minic_bad_fixmap();
    return 0xffff000000000000UL - ((unsigned long)idx << 12);
}

static unsigned long patch_map(unsigned long addr, int fixmap)
{
    unsigned long hidden;
    __asm__("" : "=r"(hidden) : "0"(addr));
    if (!addr) {
        __asm__ volatile(
            ".pushsection __bug_table,\"aw\"; .align 2; "
            "14470: .long 14471f - .; "
            ".pushsection .rodata.str,\"aMS\",@progbits,1; "
            "14472: .string \"aarch64-patching-fixture\"; "
            ".popsection; .long 14472b - .; .short 44; "
            ".short 0; .align 2; .popsection; 14471: brk 0x800");
        __asm__ volatile("");
        __builtin_unreachable();
    }
    return hidden + fix_to_virt(fixmap);
}

unsigned long minic_aarch64_fixmap_clone_entry(unsigned long addr)
{
    return patch_map(addr, FIX_TEXT_POKE0);
}
