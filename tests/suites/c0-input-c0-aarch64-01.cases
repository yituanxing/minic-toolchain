@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_llsc_last8.c"}
/* Native arm64 Linux LL/SC source forms admitted by the target contract.
 * These are full atomic sequences, not standalone instruction examples. */
typedef unsigned long long u64;
typedef unsigned int u32;
typedef unsigned __int128 u128;

u64 minic_llsc_dec_positive(u64 *addr) {
    u64 value, status;
    asm volatile(
        "// atomic64_dec_if_positive\n"
        " prfm pstl1strm, %2\n"
        "1: ldxr %0, %2\n"
        " subs %0, %0, #1\n"
        " b.lt 2f\n"
        " stlxr %w1, %0, %2\n"
        " cbnz %w1, 1b\n"
        " dmb ish\n"
        "2:\n"
        : "=&r"(value), "=&r"(status), "+Q"(*addr)
        :
        : "memory", "cc");
    return value;
}

u64 minic_llsc_cmpxchg128(u128 *addr,
    u64 expected_lo, u64 expected_hi, u64 desired_lo, u64 desired_hi) {
    u64 old_lo, old_hi;
    u32 status;
    asm volatile(
        "//__cmpxchg128\n"
        " prfm pstl1strm, %[v]\n"
        "1: ldxp %[rl], %[rh], %[v]\n"
        " cmp %[rl], %[ol]\n"
        " ccmp %[rh], %[oh], 0, eq\n"
        " b.ne 2f\n"
        " stxp %w[tmp], %[nl], %[nh], %[v]\n"
        " cbnz %w[tmp], 1b\n"
        "2:\n"
        : [v] "+Q"(*addr), [rl] "=&r"(old_lo),
          [rh] "=&r"(old_hi), [tmp] "=&r"(status)
        : [ol] "r"(expected_lo), [oh] "r"(expected_hi),
          [nl] "r"(desired_lo), [nh] "r"(desired_hi)
        : "cc");
    return old_lo;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_lse_atomic_full.c"}
/* Original Linux 6.6 atomic_lse.h GNU operand and AArch64 ISA contracts.
 * These are privileged kernel-oriented atomics: compile/assemble only. */
typedef unsigned __int128 minic_u128;
typedef union {
    minic_u128 full;
    struct { unsigned long low, high; } halves;
} minic_pair;

#define MINIC_LSE_CASP(NAME, ORDER, CLOBBERS...)                           \
minic_u128 NAME(volatile minic_u128 *ptr, minic_u128 expected,            \
                minic_u128 replacement) {                                 \
    minic_pair o = { .full = expected }, n = { .full = replacement };      \
    register unsigned long x0 asm("x0") = o.halves.low;                   \
    register unsigned long x1 asm("x1") = o.halves.high;                  \
    register unsigned long x2 asm("x2") = n.halves.low;                   \
    register unsigned long x3 asm("x3") = n.halves.high;                  \
    register unsigned long x4 asm("x4") = (unsigned long)ptr;             \
    asm volatile(".arch_extension lse\n"                               \
        "casp" ORDER "\t%[old1], %[old2], %[new1], %[new2], %[v]\n"     \
        : [old1] "+&r" (x0), [old2] "+&r" (x1),                          \
          [v] "+Q" (*(minic_u128 *)ptr)                                  \
        : [new1] "r" (x2), [new2] "r" (x3), [ptr] "r" (x4),               \
          [oldval1] "r" (o.halves.low), [oldval2] "r" (o.halves.high)     \
        : CLOBBERS);                                                      \
    minic_pair ret; ret.halves.low = x0; ret.halves.high = x1;            \
    return ret.full;                                                      \
}

#ifndef MINIC_ONLY_DEC
MINIC_LSE_CASP(minic_lse_casp128, "")
MINIC_LSE_CASP(minic_lse_casp128_mb, "al", "memory")
#endif

typedef struct { long counter; } minic_atomic64;

#ifndef MINIC_ONLY_CASP
long minic_lse_dec_if_positive(minic_atomic64 *v) {
    unsigned long tmp;
    asm volatile(
        ".arch_extension lse\n"
        "1:\tldr\t%x[tmp], %[v]\n"
        "\tsubs\t%[ret], %x[tmp], #1\n"
        "\tb.lt\t2f\n"
        "\tcasal\t%x[tmp], %[ret], %[v]\n"
        "\tsub\t%x[tmp], %x[tmp], #1\n"
        "\tsub\t%x[tmp], %x[tmp], %[ret]\n"
        "\tcbnz\t%x[tmp], 1b\n"
        "2:"
        : [ret] "+&r" (v), [v] "+Q" (v->counter), [tmp] "=&r" (tmp)
        :
        : "cc", "memory");
    return (long)v;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_mrs_read_family.c"}
/* Original Linux 6.6 AArch64 one-output read_sysreg() GNU ABI contract.
 * Indexed PMU/debug registers must remain physical MRS, never software
 * loads or a compiler barrier.  These functions are EL1/EL2 only. */
#define READ_SYSREG(REG)                                                \
    unsigned long long minic_read_##REG(void) {                          \
        unsigned long long result;                                      \
        asm volatile("mrs %0, " #REG : "=r" (result) : );              \
        return result;                                                  \
    }

READ_SYSREG(pmcr_el0)
READ_SYSREG(pmceid0_el0)
READ_SYSREG(pmceid1_el0)
READ_SYSREG(pmccntr_el0)
READ_SYSREG(pmovsclr_el0)
READ_SYSREG(cntpct_el0)
READ_SYSREG(cnthctl_el2)
READ_SYSREG(SCTLR_EL1)
READ_SYSREG(CPACR_EL1)
READ_SYSREG(cpacr_el1)
READ_SYSREG(actlr_el1)
READ_SYSREG(aidr_el1)
READ_SYSREG(amair_el1)
READ_SYSREG(dbgauthstatus_el1)
READ_SYSREG(elr_el1)
READ_SYSREG(mair_el1)
READ_SYSREG(midr_el1)
READ_SYSREG(revidr_el1)
READ_SYSREG(s3_0_c15_c0_5)
READ_SYSREG(spsr_abt)
READ_SYSREG(ttbr0_el1)

/* Boundaries of the architecturally enumerated debug and PMU banks. */
READ_SYSREG(dbgbcr0_el1)
READ_SYSREG(dbgbcr15_el1)
READ_SYSREG(dbgbvr0_el1)
READ_SYSREG(dbgbvr15_el1)
READ_SYSREG(dbgwcr0_el1)
READ_SYSREG(dbgwvr15_el1)
READ_SYSREG(pmevcntr0_el0)
READ_SYSREG(pmevcntr30_el0)
READ_SYSREG(pmevtyper0_el0)
READ_SYSREG(pmevtyper30_el0)
