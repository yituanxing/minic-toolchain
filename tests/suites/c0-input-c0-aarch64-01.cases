        "\t.endr\n" \
        "\t.equ\t.L__gpr_num_xzr, 31\n" \
        "\t.equ\t.L__gpr_num_wzr, 31\n" \
        "\t.macro\tmsr_s, sreg, rt\n" \
        ".inst (0xd5000000|(\\sreg)|(.L__gpr_num_\\rt))\n" \
        "\t.endm\n" \
        "\tmsr_s (((3) << 19) | ((0) << 16) | ((" #crn ") << 12) | ((" #crm ") << 8) | ((" #op2 ") << 5)), %x0\n" \
        "\t.purgem\tmsr_s\n" : : "rZ"(value)); \
}
