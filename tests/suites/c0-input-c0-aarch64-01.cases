@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_hyp_spinlock_lse.c"}
/* Linux 6.6.143 arch/arm64/kvm/hyp/include/nvhe/spinlock.h, with only
 * its kernel macro wrappers made self-contained for host preprocessing.
 * All GNU instructions, operands, labels, ALTERNATIVE and PREL32 remain
 * source-faithful. GNU AS must see exactly 5 LL/SC vs 5 LSE instructions
 * in the lock and 3 vs 3 in the unlock. */
typedef unsigned int u32;
typedef unsigned long u64;
typedef unsigned short u16;
typedef union hyp_spinlock {
    u32 __val;
    struct { u16 owner, next; };
} hyp_spinlock_t;

#define __LSE_PREAMBLE ".arch_extension lse\n"
#define __nops(n) ".rept\t" #n "\nnop\n.endr\n"
#define __ALTERNATIVE_CFG(oldinstr, newinstr) \
    ".if 1 == 1\n" \
    "661:\n\t" oldinstr "\n" \
    "662:\n" \
    ".pushsection .altinstructions,\"a\"\n" \
    ".word 661b - .\n" \
    ".word 663f - .\n" \
    ".hword 33\n" \
    ".byte 662b - 661b\n" \
    ".byte 664f - 663f\n" \
    ".popsection\n.subsection 1\n" \
    "663:\n\t" newinstr "\n" \
    "664:\n\t" \
    ".org . - (664b-663b) + (662b-661b)\n\t" \
    ".org . - (662b-661b) + (664b-663b)\n\t" \
    ".previous\n.endif\n"
#define ARM64_LSE_ATOMIC_INSN(llsc, lse) \
    __ALTERNATIVE_CFG(llsc, __LSE_PREAMBLE lse)

static inline void hyp_spin_lock(hyp_spinlock_t *lock) {
    u32 tmp;
    hyp_spinlock_t lockval, newval;
    asm volatile(
        ARM64_LSE_ATOMIC_INSN(
            "\tprfm\tpstl1strm, %3\n"
            "1:\tldaxr\t%w0, %3\n"
            "\tadd\t%w1, %w0, #(1 << 16)\n"
            "\tstxr\t%w2, %w1, %3\n"
            "\tcbnz\t%w2, 1b\n",
            "\tmov\t%w2, #(1 << 16)\n"
            "\tldadda\t%w2, %w0, %3\n"
            __nops(3))
        "\teor\t%w1, %w0, %w0, ror #16\n"
        "\tcbz\t%w1, 3f\n"
        "\tsevl\n"
        "2:\twfe\n"
        "\tldaxrh\t%w2, %4\n"
        "\teor\t%w1, %w2, %w0, lsr #16\n"
        "\tcbnz\t%w1, 2b\n"
        "3:"
        : "=&r"(lockval), "=&r"(newval), "=&r"(tmp), "+Q"(*lock)
        : "Q"(lock->owner)
        : "memory");
}

static inline void hyp_spin_unlock(hyp_spinlock_t *lock) {
    u64 tmp;
    asm volatile(
        ARM64_LSE_ATOMIC_INSN(
            "\tldrh\t%w1, %0\n"
            "\tadd\t%w1, %w1, #1\n"
            "\tstlrh\t%w1, %0",
            "\tmov\t%w1, #1\n"
            "\tstaddlh\t%w1, %0\n"
            __nops(1))
        : "=Q"(lock->owner), "=&r"(tmp)
        : : "memory");
}

void hyp_spin_roundtrip(hyp_spinlock_t *lock) {
    hyp_spin_lock(lock);
    hyp_spin_unlock(lock);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_kexec_crash_regs.c"}
/* Linux 6.6 arch/arm64/include/asm/kexec.h crash_setup_regs(), verbatim
 * inline-assembly contract with two early-clobber register outputs and a
 * pointer input. The stored register/PSTATE/PC image is a hardware effect. */
typedef unsigned long long u64;
struct arm64_crash_regs {
    u64 regs[31];
    u64 sp, pc, pstate;
};

/* Compile-only large-frame oracle. An escaping real 8-KiB local object
 * forces a large owned frame even if Core safely reuses all SSA spill slots;
 * volatile XOR reads still exercise the original register-input path.
 * Never execute this variant: it deliberately perturbs the pointer. */
#ifdef MINIC_CRASH_LARGE_SSA
extern volatile u64 minic_crash_stress_value;
#define MINI_STRESS_1(p) ((struct arm64_crash_regs *)((u64)(p) ^ minic_crash_stress_value))
#define MINI_STRESS_2(p) MINI_STRESS_1(MINI_STRESS_1(p))
#define MINI_STRESS_4(p) MINI_STRESS_2(MINI_STRESS_2(p))
#define MINI_STRESS_8(p) MINI_STRESS_4(MINI_STRESS_4(p))
#define MINI_STRESS_16(p) MINI_STRESS_8(MINI_STRESS_8(p))
#define MINI_STRESS_32(p) MINI_STRESS_16(MINI_STRESS_16(p))
#define MINI_STRESS_64(p) MINI_STRESS_32(MINI_STRESS_32(p))
#define MINI_STRESS_128(p) MINI_STRESS_64(MINI_STRESS_64(p))
#define MINI_STRESS_256(p) MINI_STRESS_128(MINI_STRESS_128(p))
#define MINI_STRESS_512(p) MINI_STRESS_256(MINI_STRESS_256(p))
extern void minic_crash_keep_stack_live(void *);
#endif

void arm64_crash_setup_regs(struct arm64_crash_regs *newregs) {
    u64 tmp1, tmp2;
#ifdef MINIC_CRASH_LARGE_SSA
    unsigned char minic_crash_large_owned_stack[8192];
    minic_crash_keep_stack_live(minic_crash_large_owned_stack);
    newregs = MINI_STRESS_512(newregs);
#endif
    __asm__ __volatile__ (
        "stp\t x0,   x1, [%2, #16 *  0]\n"
        "stp\t x2,   x3, [%2, #16 *  1]\n"
        "stp\t x4,   x5, [%2, #16 *  2]\n"
        "stp\t x6,   x7, [%2, #16 *  3]\n"
        "stp\t x8,   x9, [%2, #16 *  4]\n"
        "stp\tx10,  x11, [%2, #16 *  5]\n"
        "stp\tx12,  x13, [%2, #16 *  6]\n"
        "stp\tx14,  x15, [%2, #16 *  7]\n"
        "stp\tx16,  x17, [%2, #16 *  8]\n"
        "stp\tx18,  x19, [%2, #16 *  9]\n"
        "stp\tx20,  x21, [%2, #16 * 10]\n"
        "stp\tx22,  x23, [%2, #16 * 11]\n"
        "stp\tx24,  x25, [%2, #16 * 12]\n"
        "stp\tx26,  x27, [%2, #16 * 13]\n"
        "stp\tx28,  x29, [%2, #16 * 14]\n"
        "mov\t %0,  sp\n"
        "stp\tx30,  %0,  [%2, #16 * 15]\n"
        "/* faked current PSTATE */\n"
        "mrs\t %0, CurrentEL\n"
        "mrs\t %1, SPSEL\n"
        "orr\t %0, %0, %1\n"
        "mrs\t %1, DAIF\n"
        "orr\t %0, %0, %1\n"
        "mrs\t %1, NZCV\n"
        "orr\t %0, %0, %1\n"
        "adr\t %1, 1f\n"
        "1:\n"
        "stp\t %1, %0,   [%2, #16 * 16]\n"
        : "=&r" (tmp1), "=&r" (tmp2)
        : "r" (newregs)
        : "memory"
    );
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/aarch64_linux_kvm_at_fixup.c"}
/* Original Linux 6.6.143 arch/arm64/kvm/hyp/vhe/switch.c AT S1E1R.
 * The hyp exception-table entry and EL2 exception-state restoration are
 * inseparable from the AT operation; this fixture keeps all five GNU roles. */
typedef unsigned long u64;

__attribute__((noinline)) int translate_far(u64 far) {
    int err = 0;
    u64 spsr, elr;
    asm volatile(
        "mrs %1, spsr_el2\n"
        "mrs %2, elr_el2\n"
        "1: at s1e1r, %3\n"
        "isb\n"
        "b 9f\n"
        "2: msr spsr_el2, %1\n"
        "msr elr_el2, %2\n"
        "mov %w0, %4\n"
        "9: .pushsection __kvm_ex_table, \"a\"\n"
        ".align 3\n"
        ".long (1b - .), (2b - .)\n"
        ".popsection\n"
        : "+r"(err), "=&r"(spsr), "=&r"(elr)
        : "r"(far), "i"(-14));
    return err;
}
@@@ end
