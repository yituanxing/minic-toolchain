@@@ {"id": "a9ba9d96dd988d9e", "kind": "shared", "newline": true}
set -Eeuo pipefail
: "${MINIC_CC:?exact minic-cc required}"
d=$(mktemp -d);trap 'rm -rf "$d"' EXIT
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-gs-tied-alu-gcc-native.sh", "shared": "a9ba9d96dd988d9e"}
#!/usr/bin/env bash
# Original Linux this_cpu_ptr GS-relative arithmetic with GNU "0" tied
# register input and "m" displacement, real per-CPU segment memory.
# 5 ALU ops x 32/64-bit, GNU/GAS/native differential and strict negatives.
cat >"$d/source.i" <<'SRC'
extern unsigned long gs_offset_long;
extern unsigned int gs_offset_int;
#define ALU64(name,opcode) \
unsigned long mini_##name##64(unsigned long seed) { \
    unsigned long out; \
    asm(opcode " %%gs:%1,%0" : "=r"(out) : "m"(gs_offset_long), "0"(seed)); \
    return out; \
}
#define ALU32(name,opcode) \
unsigned int mini_##name##32(unsigned int seed) { \
    unsigned int out; \
    asm(opcode "l %%gs:%1,%0" : "=r"(out) : "m"(gs_offset_int), "0"(seed)); \
    return out; \
}
ALU64(add, "add") ALU64(sub, "sub") ALU64(and, "and")
ALU64(or, "or") ALU64(xor, "xor")
ALU32(add, "add") ALU32(sub, "sub") ALU32(and, "and")
ALU32(or, "or") ALU32(xor, "xor")
unsigned long mini_ptr(const void *ptr) {
    unsigned long result;
    asm ("add %%gs:%1,%0" : "=r"(result) : "m"(gs_offset_long),"0"(ptr));
    return result;
}
SRC
# Feed an already macro-expanded C translation unit to MiniC, exactly as GNU
# Kbuild .i inputs. GNU preprocessor is an oracle, not a C fallback.
gcc -E -P -x c "$d/source.i" -o "$d/source.pp.i"
sed 's/mini_/gnu_/g' "$d/source.pp.i" >"$d/gnu.c"
cat >"$d/main.c" <<'SRC'
#include <asm/prctl.h>
#include <sys/syscall.h>
#include <unistd.h>
unsigned long gs_offset_long=0x51239fUL;
unsigned int gs_offset_int=0x39127u;
#define ONE64(name) extern unsigned long mini_##name##64(unsigned long); \
 extern unsigned long gnu_##name##64(unsigned long);
#define ONE32(name) extern unsigned int mini_##name##32(unsigned int); \
 extern unsigned int gnu_##name##32(unsigned int);
ONE64(add) ONE64(sub) ONE64(and) ONE64(or) ONE64(xor)
ONE32(add) ONE32(sub) ONE32(and) ONE32(or) ONE32(xor)
extern unsigned long mini_ptr(const void *),gnu_ptr(const void *);
int main(void) {
    unsigned long seed=0x51f69a52de88UL;
    unsigned int seed32=0x76aab431U;
    if(syscall(SYS_arch_prctl,ARCH_SET_GS,0L)) return 7;
#define CHECK64(name) if(mini_##name##64(seed)!=gnu_##name##64(seed)) return 8;
#define CHECK32(name) if(mini_##name##32(seed32)!=gnu_##name##32(seed32)) return 9;
    CHECK64(add) CHECK64(sub) CHECK64(and) CHECK64(or) CHECK64(xor)
    CHECK32(add) CHECK32(sub) CHECK32(and) CHECK32(or) CHECK32(xor)
    if(mini_ptr((const void*)0x20000000UL)!=gnu_ptr((const void*)0x20000000UL))
        return 10;
    return 42;
}
SRC
gcc -O0 -c "$d/gnu.c" -o "$d/gnu.o"
"$MINIC_CC" --target=x86_64-linux -S "$d/source.pp.i" -o "$d/mini.s"
gcc -c -x assembler "$d/mini.s" -o "$d/mini.o"
gcc -static -O0 -no-pie "$d/main.c" "$d/gnu.o" "$d/mini.o" -o "$d/oracle"
set +e
timeout 45s "$d/oracle" >"$d/run.out" 2>"$d/run.err";rc=$?
set -e
if ((rc!=42));then
 echo "X86_GS_TIED_ALU=FAIL native_source_GNU_vs_MiniC rc=$rc" >&2
 cat "$d/run.err" >&2;exit 1
fi
cat >"$d/bad.i" <<'SRC'
unsigned long illegal(unsigned long x) {
 unsigned long out;
 asm("add %%gs:%1,%0; int3":"=r"(out):"m"(x),"0"(x));
 return out;
}
SRC
if "$MINIC_CC" --target=x86_64-linux -S "$d/bad.i" -o "$d/bad.s" 2>"$d/bad.err";then
 echo "X86_GS_TIED_ALU=FAIL extra ISA admitted" >&2;exit 1
fi
test ! -e "$d/bad.s"
echo "X86_GS_TIED_ALU=PASS ISA_forms=10 tied_pointer=1 real_GS_segment=1 native_GNU_oracle=1 unsupported_rejected=1"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-prefetchw-alt-gcc-native.sh", "shared": "a9ba9d96dd988d9e"}
#!/usr/bin/env bash
# The frozen Linux 6.6.143 GNU ALTERNATIVE prefetchw() template, not an
# invented prefetch instruction: both real ELF patching sections required.
cat >"$d/source.i" <<'SRC'
__attribute__((noinline)) void mini_linux_prefetchw(const void *x) {
 asm __inline volatile(
  "# ALT: oldnstr\n"
  "661:\n\t" "prefetcht0 %P1" "\n662:\n"
  "# ALT: padding\n"
  ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")) > 0) * "
  "((" "665""1""f-""664""1""f" ")-(" "662b-661b" ")),0x90\n"
  "663" ":\n"
  ".pushsection .altinstructions,\"a\"\n"
  " .long 661b - .\n"
  " .long " "664""1""f - .\n"
  " .4byte " "( 6*32+ 8)" "\n"
  " .byte " "663""b-661b" "\n"
  " .byte " "665""1""f-664""1""f" "\n"
  ".popsection\n"
  ".pushsection .altinstr_replacement, \"ax\"\n"
  "# ALT: replacement " "1" "\n"
  "664""1"":\n\t" "prefetchw %P1" "\n"
  "665""1" ":\n"
  ".popsection\n"
  : : "i"(0), "m"(*(const char*)x));
}
SRC
sed 's/mini_linux_prefetchw/gnu_linux_prefetchw/g' "$d/source.i" >"$d/gnu.i"
cat >"$d/main.c" <<'SRC'
extern void mini_linux_prefetchw(const void *);
extern void gnu_linux_prefetchw(const void *);
int main(void) {
 static unsigned char buffer[256] __attribute__((aligned(64)));
 for(int i=0;i<1000;++i){
   buffer[i%256]=(unsigned char)i;
   gnu_linux_prefetchw(buffer+(i%128));
   mini_linux_prefetchw(buffer+(i%128));
 }
 return 42;
}
SRC
gcc -O0 -fno-pie -c -x c "$d/gnu.i" -o "$d/gnu.o"
"$MINIC_CC" --target=x86_64-linux -S "$d/source.i" -o "$d/mini.s"
gcc -c -x assembler "$d/mini.s" -o "$d/mini.o"
for name in .altinstructions .altinstr_replacement;do
 readelf -SW "$d/mini.o" | grep -Fq "$name"
 readelf -SW "$d/gnu.o" | grep -Fq "$name"
done
grep -Fq 'prefetcht0 (%r10)' "$d/mini.s"
grep -Fq 'prefetchw (%r10)' "$d/mini.s"
grep -Fq '6641:' "$d/mini.s"
gcc -static -O0 -no-pie "$d/main.c" "$d/gnu.o" "$d/mini.o" -o "$d/joint.elf"
set +e
timeout 45s "$d/joint.elf" >"$d/stdout" 2>"$d/stderr";rc=$?
set -e
if ((rc!=42));then
 echo "X86_LINUX_PREFETCHW_ALT=FAIL rc=$rc" >&2
 cat "$d/stderr" >&2;exit 1
fi
sed 's/prefetchw %P1/prefetchnta %P1/' "$d/source.i" >"$d/bad-instruction.i"
sed 's/( 6\*32+ 8)/( 6*32+ 9)/' "$d/source.i" >"$d/bad-feature.i"
for form in instruction feature;do
 if "$MINIC_CC" --target=x86_64-linux -S "$d/bad-$form.i" -o "$d/bad-$form.s" 2>"$d/bad-$form.err";then
   echo "X86_LINUX_PREFETCHW_ALT=FAIL accepted unsafe_$form" >&2;exit 1
 fi
 test ! -e "$d/bad-$form.s"
done
echo "X86_LINUX_PREFETCHW_ALT=PASS GNU_6_6_143_SOURCE=1 native_PF0_and_PREFETCHW=1 ELF_alt_sections=2 GCC_link_runtime=1 strict_negatives=2"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-zero-operand-barrier-gcc-native.sh", "shared": "a9ba9d96dd988d9e"}
#!/usr/bin/env bash
# Native GNU Linux arch/x86/include asm/barrier.h effects, not C fences.
# CC/memory-clobber flags are preserved; unknown forms remain rejected.
cat >"$d/source.i" <<'SRC'
__attribute__((noinline)) int kernel_ordering(int n) {
    asm volatile("lock; addl $0,-4(%%rsp)" ::: "memory", "cc");
    asm volatile("mfence" ::: "memory");
    asm volatile("lfence" ::: "memory");
    asm volatile("sfence" ::: "memory");
    asm volatile("pause");
    asm volatile("rep; nop");
    return n+40;
}
int main(void) { return kernel_ordering(2); }
SRC
gcc -O0 -static -x c "$d/source.i" -o "$d/gnu"
"$MINIC_CC" --target=x86_64-linux -S "$d/source.i" -o "$d/mini.s"
gcc -static -x assembler "$d/mini.s" -o "$d/mini"
for needle in 'lock; addl $0, -4(%rsp)' 'mfence' 'lfence' 'sfence' 'pause' 'rep; nop'; do
  grep -Fq "$needle" "$d/mini.s"
done
set +e
timeout 45s "$d/gnu" >"$d/gnu.out" 2>"$d/gnu.err";a=$?
timeout 45s "$d/mini" >"$d/mini.out" 2>"$d/mini.err";b=$?
set -e
if (( a!=42 || b!=42 )) ||
   ! cmp -s "$d/gnu.out" "$d/mini.out" ||
   ! cmp -s "$d/gnu.err" "$d/mini.err";then
 echo "X86_HARDWARE_BARRIERS=FAIL gnu=$a minic=$b" >&2; exit 1
fi
cat >"$d/bad-extra.i" <<'SRC'
int main(void){asm volatile("lock; addl $0,-4(%%rsp); int3" ::: "memory","cc");return 42;}
SRC
cat >"$d/bad-offset.i" <<'SRC'
int main(void){asm volatile("lock; addl $0,-8(%%rsp)" ::: "memory","cc");return 42;}
SRC
cat >"$d/bad-clobber.i" <<'SRC'
int main(void){asm volatile("mfence" ::: "cc");return 42;}
SRC
for bad in extra offset clobber;do
 if "$MINIC_CC" --target=x86_64-linux -S "$d/bad-$bad.i" -o "$d/bad-$bad.s" 2>"$d/bad-$bad.err";then
  echo "X86_HARDWARE_BARRIERS=FAIL unsafe_source_accepted=$bad" >&2;exit 1
 fi
 test ! -e "$d/bad-$bad.s"
done
echo "X86_HARDWARE_BARRIERS=PASS actual_ISA_forms=6 GNU_GAS_link_native=1 compiler_cc_and_memory=1 negatives=3"
@@@ end
