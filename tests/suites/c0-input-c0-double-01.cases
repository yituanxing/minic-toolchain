{
    return 9.0 - 2.5;
}

double multiply_values(void)
{
    return 1.5 * 4.0;
}

double divide_values(void)
{
    return 9.0 / 4.0;
}

double nan_value(void)
{
    return 0.0 / 0.0;
}

int main(void)
{
    return 0;
}
