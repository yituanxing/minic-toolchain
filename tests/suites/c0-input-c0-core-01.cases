@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core-late-live-closure.c"}
/* Linux-shaped Core reachability: an inline-ASM mnemonic shares a spelling
 * with an otherwise unreferenced static-inline function (cf. Linux wrmsr).
 * Core ASM symbol analysis conservatively exposes nop; lowering that body
 * exposes late_tail in a second reachability round. GCC does not conservatively
 * promote source functions named by ISA mnemonics, so its compile/link oracle
 * uses a `used` hint while the MiniC case exercises late discovery. */
#ifdef GNU_KEEP_ASM_REFERENCED_STATIC
#define GNU_KEEP __attribute__((used))
#else
#define GNU_KEEP
#endif

static int __attribute__((noinline)) late_tail(void) {
    return 39;
}

static inline GNU_KEEP int nop(void) {
    return late_tail() + 3;
}

extern int unresolved_dead_function(void);
static inline int unrelated_dead(void) {
    return unresolved_dead_function();
}

int main(void) {
    /* As in Linux's x86 wrmsr helper, the source graph does not reference
     * the C function whose assembler spelling equals this ISA mnemonic. */
    __asm__ volatile("nop");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_aggregate_boundary_m30.c"}
typedef unsigned long core_m30_u64;
typedef unsigned int core_m30_u32;

struct CoreM30Pair {
    long a;
    long b;
};

struct CoreM30One {
    long a;
};

static void core_m30_set_pair(struct CoreM30Pair *p, long a, long b) {
    p->a = a;
    p->b = b;
}

struct CoreM30Pair core_m30_pair_add(struct CoreM30Pair lhs, struct CoreM30Pair rhs) {
    struct CoreM30Pair delta;

    core_m30_set_pair(&delta, lhs.a + rhs.a, lhs.b + rhs.b);
    return delta;
}

struct CoreM30Pair core_m30_return_param(struct CoreM30Pair value) {
    return value;
}

long core_m30_after_record(struct CoreM30Pair value, long tail) {
    return value.a + value.b + tail;
}

long core_m30_scalar_record_scalar(long head, struct CoreM30Pair value, long tail) {
    return head + value.a + value.b + tail;
}

long core_m30_one_chunk(struct CoreM30One value, long tail) {
    return value.a + tail;
}

static core_m30_u32 core_m30_iter_div(core_m30_u64 dividend,
                                      core_m30_u32 divisor,
                                      core_m30_u64 *remainder) {
    core_m30_u32 ret = 0U;

    while (dividend >= divisor) {
        __asm__("" : "+rm"(dividend));
        dividend -= divisor;
        ret++;
    }
    *remainder = dividend;
    return ret;
}

void core_m30_add_ns(struct CoreM30Pair *value, core_m30_u64 ns) {
    value->a += core_m30_iter_div((core_m30_u64)value->b + ns, 1000000000U, &ns);
    value->b = (long)ns;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_aggregate_boundary_m30_runtime.c"}
#include <stdio.h>

struct CoreM30Pair {
    long a;
    long b;
};

struct CoreM30One {
    long a;
};

extern struct CoreM30Pair core_m30_pair_add(struct CoreM30Pair, struct CoreM30Pair);
extern struct CoreM30Pair core_m30_return_param(struct CoreM30Pair);
extern long core_m30_after_record(struct CoreM30Pair, long);
extern long core_m30_scalar_record_scalar(long, struct CoreM30Pair, long);
extern long core_m30_one_chunk(struct CoreM30One, long);
extern void core_m30_add_ns(struct CoreM30Pair *, unsigned long);

int main(void) {
    static const struct CoreM30Pair left[] = {
        {0L, 0L},
        {1L, 2L},
        {-7L, 13L},
        {123456789L, -987654321L},
    };
    static const struct CoreM30Pair right[] = {
        {3L, 4L},
        {-5L, 8L},
        {1000L, -2000L},
        {-111111111L, 222222222L},
    };
    static const long tails[] = {5L, -9L, 77L, 12345L};
    static const unsigned long ns_values[] = {1UL, 250000000UL, 900000000UL, 1500000000UL};
    unsigned int i;

    for (i = 0U; i < 4U; ++i) {
        struct CoreM30Pair sum = core_m30_pair_add(left[i], right[i]);
        struct CoreM30Pair roundtrip = core_m30_return_param(left[i]);
        struct CoreM30One one = {left[i].a};
        struct CoreM30Pair time_value = {100L + (long)i, 900000000L - (long)i * 100000000L};

        printf("A %u %ld %ld\n", i, sum.a, sum.b);
        printf("R %u %ld %ld\n", i, roundtrip.a, roundtrip.b);
        printf("P %u %ld %ld %ld\n",
               i,
               core_m30_after_record(left[i], tails[i]),
               core_m30_scalar_record_scalar(tails[i], left[i], -tails[i]),
               core_m30_one_chunk(one, tails[i]));
        core_m30_add_ns(&time_value, ns_values[i]);
        printf("N %u %ld %ld\n", i, time_value.a, time_value.b);
    }
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_asm_empty_rk_immediate.c"}
/* A register-or-small-immediate operand on an empty GNU template is still
 * a compiler ordering effect. It must not be stolen by nonempty ASM baking. */
void core_asm_empty_rk_immediate(void) {
    __asm__ __volatile__("" : : "rK"(0));
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_asm_goto_escaped_percent.c"}
/* An already-resolved GNU i operand and a literal percent escape share one
 * template. Only %0 is replaced by Core; %%0 must reach GAS as literal %0. */
int core_asm_goto_escaped_percent(void) {
    __asm__ goto(
        "j %l[yes]\n\t"
        ".ascii \"%%0\"\n\t"
        ".word %0\n\t"
        : : "i"(33) : : yes);
    return 0;
yes:
    return 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_asm_nonvolatile_rk_output.c"}
/* GNU output-bearing asm is an observable value producer even when the
 * source statement itself is not volatile. */
int core_asm_nonvolatile_rk_output(void) {
    int result;
    __asm__("addi %0, zero, %1" : "=r"(result) : "rK"(0));
    return result;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_asm_zero_stride_immediate.c"}
/* GNU accepts zero-size records as an extension. An indexed symbolic ASM
 * immediate over that layout must reject instead of dividing by stride 0. */
struct Empty { };
static struct Empty objects[2];
void core_asm_zero_stride_immediate(void) {
    __asm__ volatile(".dword %0" : : "i"(&objects[1]));
}
