#include <stdint.h>
#include <stdio.h>

struct core_m15_node {
    struct core_m15_node *next;
    struct core_m15_node *prev;
};

void *core_m15_void_add(void *base, long index);
int *core_m15_int_add(int *base, long index);
int *core_m15_int_add_commuted(long index, int *base);
void core_m15_list_poison(struct core_m15_node *entry);

int main(void) {
    int values[8] = {0};
    struct core_m15_node node = {0};
    char *byte_base = (char *)&values[2];

    core_m15_list_poison(&node);
    printf("%td %td %td %lu %lu\n",
           (char *)core_m15_void_add(byte_base, 3) - byte_base,
           core_m15_int_add(&values[4], -2) - &values[4],
           core_m15_int_add_commuted(3, &values[1]) - &values[1],
           (unsigned long)(uintptr_t)node.next,
           (unsigned long)(uintptr_t)node.prev);
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_postfix_update_m24.c"}
unsigned int core_m24_postdec_value(unsigned int *value) {
    return (*value)--;
}

unsigned int core_m24_countdown(unsigned int words) {
    unsigned int count = 0;
    while (words--) {
        count++;
    }
    return count;
}

unsigned short *core_m24_pointer_increment(unsigned short *pointer) {
    pointer++;
    return pointer;
}

unsigned short *core_m24_pointer_decrement(unsigned short *pointer) {
    pointer--;
    return pointer;
}

static void core_m24_touch(unsigned short *pointer) {
    *pointer = *pointer;
}

void core_m24_swab16_shape(unsigned short *buf, unsigned int words) {
    while (words--) {
        core_m24_touch(buf);
        buf++;
    }
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_postfix_update_m24_runtime.c"}
extern unsigned int core_m24_postdec_value(unsigned int *);
extern unsigned int core_m24_countdown(unsigned int);
extern unsigned short *core_m24_pointer_increment(unsigned short *);
extern unsigned short *core_m24_pointer_decrement(unsigned short *);
extern void core_m24_swab16_shape(unsigned short *, unsigned int);

int main(void) {
    unsigned int value = 9;
    unsigned short data[4] = {1, 2, 3, 4};
    if (core_m24_postdec_value(&value) != 9 || value != 8)
        return 1;
    if (core_m24_countdown(7) != 7)
        return 2;
    if (core_m24_pointer_increment(&data[1]) != &data[2])
        return 3;
    if (core_m24_pointer_decrement(&data[2]) != &data[1])
        return 4;
    core_m24_swab16_shape(data, 4);
    if (data[0] != 1 || data[1] != 2 || data[2] != 3 || data[3] != 4)
        return 5;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_provisional_record_union_init.c"}
#include "core/core_type.h"

#include <stddef.h>
#include <stdint.h>
#include <string.h>

/* A provisional incomplete RECORD is published before importing recursive
 * fields. A first-member-only union initializer leaves its field_count and
 * is_complete storage unspecified. Exercise the real CoreType arena. */
static int check_one(MinicCoreTypeContext *context, int union_record) {
    MinicCoreType type;
    MinicCoreTypeId id;
    const MinicCoreType *stored;
    (void)memset(&type, 0, sizeof(type));
    type.kind = MINIC_CORE_TYPE_RECORD;
    type.value.record.is_union = union_record != 0;
    if (type.value.record.fields != NULL ||
        type.value.record.field_count != 0U ||
        type.value.record.is_complete ||
        type.value.record.has_nondefault_layout_policy) return 1;
    if (!minic_core_type_register(context, &type, &id)) return 2;
    stored = minic_core_type_get(context, id);
    if (stored == NULL || stored->kind != MINIC_CORE_TYPE_RECORD ||
        stored->value.record.is_union != (union_record != 0) ||
        stored->value.record.is_complete ||
        stored->value.record.fields != NULL ||
        stored->value.record.field_count != 0U) return 3;
    return 0;
}

int main(void) {
    MinicCoreTypeContext context;
    int first, second;
    minic_core_type_context_initialize(&context);
    first = check_one(&context, 0);
    second = check_one(&context, 1);
    minic_core_type_context_destroy(&context);
    return first != 0 ? first : second;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_qualified_pointer_negative_const.c"}
/* Negative: an aligned pointer-to-const volatile record must never become a
 * mutable pointer just because both record views have identical byte layout. */
typedef struct Guid { unsigned char bytes[16]; } Guid;
typedef Guid AlignedGuid __attribute__((aligned(4)));

AlignedGuid *invalid_drop_pointee_cv(const volatile AlignedGuid *input) {
    AlignedGuid *result = input;
    return result;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_qualified_pointer_negative_nominal.c"}
/* Negative: two distinct nominal record tags with identical layouts do not
 * become interchangeable merely because their pointer ABIs are both 64-bit. */
typedef struct First { unsigned long value; } First;
typedef struct Second { unsigned long value; } Second;

First *invalid_record_identity(Second *input) {
    First *result = input;
    return result;
}
