@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_literal_branch_guard.c"}
/* Genuine GNU Linux typecheck idiom: the statement-expression's last
 * integer literal is the tested value, even though it owns local objects.
 * C-level side effects before a literal condition must still execute. */
static volatile unsigned long observed;

int literal_guard(unsigned short value) {
    do {
        extern void __compiletime_assert_typecheck(void)
            __attribute__((error("typecheck is a compile-time fact")));
        if (!(!(!({ unsigned short a; typeof(value) b;
                    (void)(&a == &b); 1; }))))
            __compiletime_assert_typecheck();
    } while (0);
    if ((observed += value, 1))
        return (int)observed + 3;
    return -99;
}

int literal_false(unsigned short value) {
    if ((observed += value, 0))
        return -99;
    return (int)observed;
}

int nonliteral_branch(int value) {
    return value < 0 ? 37 : 43;
}

int main(void) {
    return literal_guard(7) != 10 || literal_false(11) != 18 ||
           nonliteral_branch(-3) != 37 || nonliteral_branch(9) != 43;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/core_literal_rhs_snapshot_elision.c"}
/* A literal RHS cannot invalidate the already-evaluated Core SSA value of
 * the LHS. Dynamic RHS expressions must retain their existing snapshot path.
 * Test source-level effects and cross-width conversions against GNU -O2. */
static volatile int minic_literal_reads;
static volatile int minic_dynamic_left;
static volatile int minic_dynamic_right;

static int left_value(void)
{
    ++minic_dynamic_left;
    return 17;
}

static int right_value(void)
{
    ++minic_dynamic_right;
    return 4;
}

static long long literal_chain(long long value)
{
    return ((value + 5LL) ^ 3LL) - 12LL;
}

int main(void)
{
    int value = 0;
    int dynamic_result;
    void *ptr = &value;
    minic_literal_reads = 9;
    if ((minic_literal_reads + 7) != 16)
        return 1;
    if (minic_literal_reads != 9)
        return 2;
    if (literal_chain(10LL) != 0LL)
        return 3;
    if ((0x5au & 15U) != 10U || (0x5au | 5U) != 95U)
        return 4;
    if (!(ptr != 0) || ptr == 0)
        return 5;
    if (((unsigned long long)1 << 33) + 7ULL != 8589934599ULL)
        return 6;
    dynamic_result = left_value() + right_value();
    if (dynamic_result != 21 ||
        minic_dynamic_left != 1 || minic_dynamic_right != 1)
        return 7;
    return 0;
}
@@@ end
