        __compiletime_assert_strong_function_null();
    if ((void *)0 == (int (*)(void))definite_hook)
        __compiletime_assert_strong_function_null();
    return definite_hook();
}

int weak_designator_guard(void) {
    return optional_weak_hook == (void *)0 ? 5 : 13;
}

