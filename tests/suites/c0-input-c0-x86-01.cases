@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_gnu_vector_size_copy.c"}
/* Linux arch/x86/kvm/hyperv.c style 16-byte vector storage assignment.
 * This is storage only: no SSE arithmetic, value-return, or vector call ABI. */
typedef unsigned int u32;
typedef unsigned long long u64;
typedef u32 sse128_t __attribute__((vector_size(16)));

union kvm_xmm {
    sse128_t vec;
    u64 words[2];
};

struct kvm_state {
    unsigned char pad;
    union kvm_xmm xmm;
    unsigned int tail;
};

static union kvm_xmm source, destination;
static struct kvm_state nested;

struct hyperv_hc {
    sse128_t xmm[1];
};

static u64 hyperv_mask(struct hyperv_hc *hc) {
    /* Mirrors the blocking Linux arch/x86/kvm/hyperv.c expression shape. */
    return ({
        union kvm_xmm flush;
        flush.vec = hc->xmm[0];
        flush.words[0];
    });
}

int main(void) {
    struct hyperv_hc hyperv;
    source.words[0] = 0x0123456789abcdefULL;
    source.words[1] = 0xfedcba9876543210ULL;
    destination.vec = source.vec;
    if (destination.words[0] != source.words[0] ||
        destination.words[1] != source.words[1]) return 1;

    source.words[0] = 0x1122334455667788ULL;
    source.words[1] = 0x8877665544332211ULL;
    nested.xmm.vec = source.vec;
    if (nested.xmm.words[0] != source.words[0] ||
        nested.xmm.words[1] != source.words[1]) return 2;
    destination.vec = nested.xmm.vec;
    if (destination.words[0] != source.words[0] ||
        destination.words[1] != source.words[1]) return 3;
    hyperv.xmm[0] = source.vec;
    if (hyperv_mask(&hyperv) != source.words[0]) return 4;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_gnu_vector_size_movdqa.c"}
/* Exact Linux arch/x86/kvm/fpu.h movdqa GNU memory constraints.
 * The kernel compiles -mno-sse: only explicit asm may touch XMM. */
typedef unsigned int u32;
typedef unsigned long long u64;
typedef u32 __attribute__((vector_size(16))) sse128_t;
union kvm_xmm_image { sse128_t vec; u64 words[2]; u32 lanes[4]; };

#define DECLARE_KVM_XMM(N) \
    __attribute__((noinline)) void kvm_write_xmm##N(const sse128_t *p) { \
        asm("movdqa %0, %%xmm" #N :: "m"(*p)); \
    } \
    __attribute__((noinline)) void kvm_read_xmm##N(sse128_t *p) { \
        asm("movdqa %%xmm" #N ", %0" : "=m"(*p)); \
    }

DECLARE_KVM_XMM(0)
DECLARE_KVM_XMM(1)
DECLARE_KVM_XMM(2)
DECLARE_KVM_XMM(3)
DECLARE_KVM_XMM(4)
DECLARE_KVM_XMM(5)
DECLARE_KVM_XMM(6)
DECLARE_KVM_XMM(7)
DECLARE_KVM_XMM(8)
DECLARE_KVM_XMM(9)
DECLARE_KVM_XMM(10)
DECLARE_KVM_XMM(11)
DECLARE_KVM_XMM(12)
DECLARE_KVM_XMM(13)
DECLARE_KVM_XMM(14)
DECLARE_KVM_XMM(15)

/* A normal scalar/union write of all 16 bytes is required in addition to
 * direct XMM memory transfer. C by-value vector CALL is deliberately absent. */
int main(void) {
    union kvm_xmm_image a, b;
    a.words[0] = 0x123456789abcdef0ULL;
    a.words[1] = 0xfedcba9876543210ULL;
    b.words[0] = 0;
    b.words[1] = 0;
    kvm_write_xmm0(&a.vec);
    kvm_read_xmm0(&b.vec);
    if (b.words[0] != a.words[0] || b.words[1] != a.words[1])
        return 1;
    b.words[0] = 0;
    b.words[1] = 0;
    kvm_write_xmm15(&a.vec);
    kvm_read_xmm15(&b.vec);
    return b.words[0] != a.words[0] || b.words[1] != a.words[1];
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_gnu_vector_size_storage.c"}
/* Linux 6.6 arch/x86/kvm/fpu.h:8 -- GNU fixed vector *storage* with
 * explicit -mno-sse kernel flags. No SIMD arithmetic or call ABI inferred. */
typedef unsigned int u32;
typedef u32 __attribute__((vector_size(16))) sse128_t;
typedef u32 __attribute__((__vector_size__(8))) sse64_t;

_Static_assert(sizeof(sse128_t) == 16, "KVM XMM image must be 16 bytes");
_Static_assert(_Alignof(sse128_t) == 16, "movdqa requires 16-byte alignment");
_Static_assert(sizeof(sse64_t) == 8, "distinct GNU vector width");
_Static_assert(_Alignof(sse64_t) == 8, "8-byte vector alignment");

struct kvm_vector_wrapper {
    unsigned char marker;
    sse128_t state;
    unsigned char tail;
};
_Static_assert(__builtin_offsetof(struct kvm_vector_wrapper, state) == 16,
               "vector field alignment");
_Static_assert(sizeof(struct kvm_vector_wrapper) == 48,
               "vector member controls struct stride");

union kvm_vector_image {
    sse128_t vec;
    unsigned long long as_u64[2];
    u32 as_u32[4];
};
_Static_assert(sizeof(union kvm_vector_image) == 16, "union full XMM image");
_Static_assert(_Alignof(union kvm_vector_image) == 16, "union XMM alignment");

unsigned long kvm_vector_storage_signature(void) {
    return (unsigned long)(sizeof(struct kvm_vector_wrapper) +
                           __builtin_offsetof(struct kvm_vector_wrapper, state) +
                           _Alignof(union kvm_vector_image));
}
@@@ end
