@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_reachable_vma_assert.c"}
/* Minimal exact GNU-preprocessed Linux 6.6.143 VDSO vma.i branch shape:
 * get_random_u32_below() has a __builtin_constant_p early-return, followed
 * by a compiletime-assert body that is unreachable for a variable ceil.
 * The x86 emitter must not preserve this unreachable unresolved reference. */
typedef unsigned int u32;

u32 __get_random_u32_below(u32 ceil) {
    return ceil + 4U;
}

static inline __attribute__((__gnu_inline__)) __attribute__((__unused__))
u32 get_random_u32_below(u32 ceil)
{
    if (!__builtin_constant_p(ceil))
        return __get_random_u32_below(ceil);
    do {
        __attribute__((__noreturn__)) extern void __compiletime_assert_80(void)
            __attribute__((__error__("get_random_u32_below() must take ceil > 0")));
        if (!(!(!ceil))) __compiletime_assert_80();
    } while (0);
    if (ceil <= 1)
        return 0;
    return 7;
}

int main(int argc, char **argv) {
    (void)argv;
    return get_random_u32_below((u32)argc) == (u32)argc + 4U ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_security_function_attributes.c"}
/* Native Linux x86 function-security annotations have target-specific code
 * generation semantics. Preserve exact spellings and fail closed when the
 * policy is not one of MiniC's explicitly qualified fallback forms. */
#if defined(REJECT_NOCF_ARGUMENT)
__attribute__((nocf_check(1))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_INDIRECT_THUNK)
__attribute__((__indirect_branch__("thunk"))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_INDIRECT_THUNK_EXTERN)
__attribute__((__indirect_branch__("thunk-extern"))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_INDIRECT_NUMBER)
__attribute__((__indirect_branch__(0))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_TARGET_VECTOR)
__attribute__((__target__("avx2"))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_TARGET_ABI)
__attribute__((__target__("general-regs-only"))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_TARGET_NUMBER)
__attribute__((__target__(42))) int x86_rejected(int n) { return n; }
#elif defined(REJECT_TARGET_MIXED)
__attribute__((__target__("bmi2,avx2"))) int x86_rejected(int n) { return n; }
#else
__attribute__((nocf_check)) int x86_no_endbr(int n) { return n + 1; }
__attribute__((__indirect_branch__("keep")))
int x86_keep_branch(int (*callback)(int), int n) { return callback(n); }
__attribute__((__target__("bmi2")))
int x86_bmi2_fallback(int n) { return n * 13; }
/* Zstd's actual Linux 6.6 BMI2_TARGET_ATTRIBUTE, not a synthesized option. */
__attribute__((__target__("lzcnt,bmi,bmi2")))
int x86_zstd_bmi2_fallback(int n) { return n * 7; }
__attribute__((__target__("default")))
int x86_default_fallback(int n) { return n ^ 13; }
int x86_security_probe(int n) {
    return x86_keep_branch(x86_no_endbr, n) + x86_bmi2_fallback(n) +
           x86_zstd_bmi2_fallback(n) + x86_default_fallback(n);
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_sysv_12byte_record.c"}
/* SysV AMD64: an all-INTEGER 12-byte record occupies two GP eightbytes,
 * but the second contains only four valid object bytes.  These functions
 * deliberately cross the translation-unit ABI boundary in both directions. */
typedef unsigned int u32;
typedef unsigned long long u64;

typedef struct ThreeWords {
    u32 words[3];
} ThreeWords;

typedef struct ThreeFields {
    u32 first;
    u32 second;
    u32 third;
} ThreeFields;

extern ThreeWords gnu_three_words(u32 a, u32 b, u32 c);
extern u64 gnu_five_plus_three(u64 a, u64 b, u64 c, u64 d, u64 e,
                                ThreeWords value);

ThreeWords minic_three_words(ThreeWords value) {
    value.words[0] += 2U;
    value.words[1] += 3U;
    value.words[2] += 5U;
    return value;
}

ThreeFields minic_three_fields(ThreeFields value) {
    value.first += 7U;
    value.second += 11U;
    value.third += 13U;
    return value;
}

/* Five integer arguments consume all but one SysV GP register, so the
 * indivisible two-eightbyte record must occupy two outgoing stack slots. */
u64 minic_five_plus_three(u64 a, u64 b, u64 c, u64 d, u64 e,
                          ThreeWords value) {
    return a + b + c + d + e + value.words[0] * 7ULL +
           value.words[1] * 11ULL + value.words[2] * 13ULL;
}

u64 minic_call_gnu(void) {
    ThreeWords input = gnu_three_words(41U, 43U, 47U);
    ThreeWords output = minic_three_words(input);
    return gnu_five_plus_three(3ULL, 5ULL, 7ULL, 11ULL, 13ULL, output);
}

ThreeWords minic_indirect_three_words(ThreeWords (*fn)(ThreeWords),
                                     ThreeWords value) {
    return fn(value);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_sysv_12byte_record_driver.c"}
/* GNU side of the cross-compiler ABI oracle.  The same driver must pass
 * when the subject is GNU-built and when it is MiniC-built. */
typedef unsigned int u32;
typedef unsigned long long u64;

typedef struct ThreeWords {
    u32 words[3];
} ThreeWords;

typedef struct ThreeFields {
    u32 first;
    u32 second;
    u32 third;
} ThreeFields;

_Static_assert(sizeof(ThreeWords) == 12U, "SysV 12-byte record size");
_Static_assert(_Alignof(ThreeWords) == 4U, "SysV 12-byte record alignment");
_Static_assert(sizeof(ThreeFields) == 12U, "SysV 12-byte field record size");

extern ThreeWords minic_three_words(ThreeWords value);
extern ThreeFields minic_three_fields(ThreeFields value);
extern u64 minic_five_plus_three(u64, u64, u64, u64, u64, ThreeWords);
extern u64 minic_call_gnu(void);
extern ThreeWords minic_indirect_three_words(ThreeWords (*fn)(ThreeWords),
                                              ThreeWords value);

ThreeWords gnu_three_words(u32 a, u32 b, u32 c) {
    ThreeWords result = {{a, b, c}};
    return result;
}

u64 gnu_five_plus_three(u64 a, u64 b, u64 c, u64 d, u64 e,
                         ThreeWords value) {
    return a + b + c + d + e + value.words[0] * 7ULL +
           value.words[1] * 11ULL + value.words[2] * 13ULL;
}

int main(void) {
    ThreeWords input = {{17U, 19U, 23U}};
    ThreeWords output;
    ThreeFields fields = {17U, 19U, 23U};
    ThreeFields result_fields;
    struct WithCanary {
        ThreeWords value;
        u32 guard;
    } protected_result = {{{0U, 0U, 0U}}, 0xBADC0FFEU};

    output = minic_three_words(input);
    if (output.words[0] != 19U || output.words[1] != 22U ||
        output.words[2] != 28U)
        return 1;
    result_fields = minic_three_fields(fields);
    if (result_fields.first != 24U || result_fields.second != 30U ||
        result_fields.third != 36U)
        return 6;
    if (minic_five_plus_three(2ULL, 3ULL, 5ULL, 7ULL, 11ULL, input) !=
        gnu_five_plus_three(2ULL, 3ULL, 5ULL, 7ULL, 11ULL, input))
        return 2;
    if (minic_call_gnu() != gnu_five_plus_three(3ULL, 5ULL, 7ULL, 11ULL,
                                               13ULL, minic_three_words(
                                                   gnu_three_words(41U, 43U, 47U))))
        return 3;
    output = minic_indirect_three_words(minic_three_words, input);
    if (output.words[0] != 19U || output.words[1] != 22U ||
        output.words[2] != 28U)
        return 4;
    protected_result.value = minic_three_words(input);
    if (protected_result.guard != 0xBADC0FFEU ||
        protected_result.value.words[2] != 28U)
        return 5;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_sysv_integer_record_tree.c"}
/* One- and two-GPR SysV aggregate ABI classification must agree for nested
 * unions, arrays, integer bit-fields and ordinary aligned scalar members.
 * The driver is built independently by GCC; return and argument registers
 * therefore cannot be silently changed by recompiling both call ends. */
typedef struct { unsigned int lo; unsigned int hi; } OneGP;
typedef union { unsigned long all; OneGP parts; } TwoHalf;
typedef struct { TwoHalf first; unsigned long second; } TwoGP;
typedef struct { unsigned long items[2]; } ArrayTwoGP;
typedef struct __attribute__((packed)) { unsigned int lo:3, hi:29; } PackedBitGP;

__attribute__((noinline)) OneGP x86_one_roundtrip(OneGP value) {
    value.lo += 3U;
    value.hi ^= 0x5a5aU;
    return value;
}

__attribute__((noinline)) TwoGP x86_two_roundtrip(TwoGP value) {
    value.first.parts.lo ^= 0x1234U;
    value.second += 0x101U;
    return value;
}

__attribute__((noinline)) ArrayTwoGP x86_array_roundtrip(ArrayTwoGP value) {
    value.items[0] += 17UL;
    value.items[1] ^= 0x12345678UL;
    return value;
}

__attribute__((noinline)) PackedBitGP x86_bit_roundtrip(PackedBitGP value) {
    value.lo ^= 3U;
    value.hi += 23U;
    return value;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_sysv_integer_record_tree_driver.c"}
/* GCC oracle caller for x86_sysv_integer_record_tree.c. GNU's ABI
 * classification is independent of the MiniC-compiled callee. */
typedef struct { unsigned int lo; unsigned int hi; } OneGP;
typedef union { unsigned long all; OneGP parts; } TwoHalf;
typedef struct { TwoHalf first; unsigned long second; } TwoGP;
typedef struct { unsigned long items[2]; } ArrayTwoGP;
typedef struct __attribute__((packed)) { unsigned int lo:3, hi:29; } PackedBitGP;

extern OneGP x86_one_roundtrip(OneGP);
extern TwoGP x86_two_roundtrip(TwoGP);
extern ArrayTwoGP x86_array_roundtrip(ArrayTwoGP);
extern PackedBitGP x86_bit_roundtrip(PackedBitGP);

int main(void) {
    OneGP a = {13U, 0xaabbccddU};
    TwoGP b;
    ArrayTwoGP c = {{19UL, 0x11223344UL}};
    PackedBitGP d = {5U, 0x4321U};
    b.first.parts.lo = 0xabcdef89U;
    b.first.parts.hi = 0x01234567U;
    b.second = 0x99887766UL;
    a = x86_one_roundtrip(a);
    b = x86_two_roundtrip(b);
    c = x86_array_roundtrip(c);
    d = x86_bit_roundtrip(d);
    if (a.lo != 16U || a.hi != (0xaabbccddU ^ 0x5a5aU)) return 1;
    if (b.first.parts.lo != (0xabcdef89U ^ 0x1234U) ||
        b.first.parts.hi != 0x01234567U ||
        b.second != 0x99887867UL) return 2;
    if (c.items[0] != 36UL || c.items[1] != (0x11223344UL ^ 0x12345678UL)) return 3;
    if (d.lo != (5U ^ 3U) || d.hi != 0x4338U) return 4;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_typed_eight_legacy_abi.c"}
/* Eight independent x86 Linux ASM source families, including the immutable
 * GNU ELF records in .tracedata and .altinstructions. Privileged/special ISA
 * functions exist for GNU AS, but only user-safe functions are executed. */
typedef unsigned long u64;
typedef unsigned long size_t;
typedef unsigned int u32;
typedef _Bool bool;

void checked_pm_trace(u64 *a, u64 *b) {
    void *pa, *pb;
    asm volatile(" movq $1f,%0\n"
        ".section .tracedata,\"a\"\n"
        "1:\t.word %c1\n\t"
        " .quad %c2\n"
        ".previous"
        : "=r"(pa) : "i"(598), "i"("drivers/base/power/main.c"));
    asm volatile(" movq $1f,%0\n"
        ".section .tracedata,\"a\"\n"
        "1:\t.word %c1\n\t"
        " .quad %c2\n"
        ".previous"
        : "=r"(pb) : "i"(1629), "i"("drivers/base/power/main.c"));
    *a=(u64)pa;
    *b=(u64)pb;
}
void checked_movntdqa(void *dst, const void *src) {
    asm("movntdqa (%0), %%xmm0\nmovups %%xmm0, (%1)\n"
        :: "r"(src), "r"(dst) : "memory");
}
unsigned long checked_pvclock(unsigned long now, unsigned long fraction) {
    unsigned long lo, hi;
    asm("mulq %[mul_frac]; shrd $32, %[hi], %[lo]"
        : [lo] "=a"(lo), [hi] "=d"(hi)
        : "0"(now), [mul_frac] "rm"(fraction));
    return lo;
}
register unsigned long current_stack_pointer asm("rsp");
unsigned int preempt_counter;
void __SCT__preempt_schedule(void) { preempt_counter += 3U; }
void __SCT__preempt_schedule_notrace(void) { preempt_counter += 5U; }
void checked_preempt(void) {
    asm volatile("call __SCT__preempt_schedule" : "+r"(current_stack_pointer));
}
void checked_preempt_notrace(void) {
    asm volatile("call __SCT__preempt_schedule_notrace" : "+r"(current_stack_pointer));
}
u64 checked_ipv6(const u64 *src, const u64 *dst, u64 input) {
    u64 result;
    asm("addq (%[saddr]),%[sum]\n\t"
        "adcq 8(%[saddr]),%[sum]\n\t"
        "adcq (%[daddr]),%[sum]\n\t"
        "adcq 8(%[daddr]),%[sum]\n\t"
        "adcq $0,%[sum]\n"
        : [sum] "=r"(result)
        : "[sum]"(input), [saddr] "r"(src), [daddr] "r"(dst));
    return result;
}
int checked_boot_compare(const void *a, const void *b, size_t length) {
    bool diff;
    asm("repe; cmpsb\n\t/* output condition code nz */\n"
        : "=@ccnz"(diff), "+D"(a), "+S"(b), "+c"(length));
    return diff;
}
struct OldTv { long sec; long usec; };
struct Timezone { int minutes; int dst; };
long checked_vdso_syscall(struct OldTv *tv, struct Timezone *tz) {
    long ret;
    asm("syscall" : "=a"(ret)
        : "0"(96), "D"(tv), "S"(tz) : "memory");
    return ret;
}
unsigned int checked_cpunode(void) {
    unsigned int p;
    asm volatile(
        "# ALT: oldnstr\n"
        "661:\n\tlsl %[seg],%[p]\n"
        "662:\n# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b)) > 0) * "
        "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n"
        ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n .long 6641f - .\n"
        " .4byte (16*32+22)\n"
        " .byte 663b-661b\n .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n"
        "6641:\n\t.byte 0xf3,0x0f,0xc7,0xf8\n"
        "6651:\n.popsection\n"
        : [p] "=a"(p) : "i"(0), [seg] "r"(15*8+3));
    return p;
}
int main(void) {
    u64 src[2] = {0, 0}, dst[2] = {0, 0};
    unsigned char a[8] = {0, 1, 2, 3, 4, 5, 6, 7};
    unsigned char b[8] = {0, 1, 2, 3, 4, 5, 6, 7};
    struct OldTv tv = {0};
    struct Timezone tz = {0};
    if (checked_ipv6(src, dst, 42) != 42) return 1;
    if (checked_boot_compare(a, b, 8) != 0) return 2;
    if (checked_pvclock(0x100000000UL, 1UL) != 1UL) return 3;
    checked_preempt();
    checked_preempt_notrace();
    if (preempt_counter != 8U) return 4;
    if (checked_vdso_syscall(&tv, &tz) != 0) return 5;
    if (tv.sec <= 0) return 6;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_typed_five_legacy_abi.c"}
/* Five x86 Linux Source -> Core -> Machine ASM families.  GNU and MiniC
 * both compile this .i, with all physical ISA/ELF effects still present. */
struct __attribute__((aligned(16))) X86FxSaveArea {
    unsigned char bytes[512];
};
static struct X86FxSaveArea fx32, fx64;
static unsigned long identity_source = 42UL;

static void do_fences(void) {
    __asm__ volatile("lock; addl $0,-4(%%rsp)" ::: "memory", "cc");
    __asm__ volatile("mfence" ::: "memory");
    __asm__ volatile("lfence" ::: "memory");
    __asm__ volatile("sfence" ::: "memory");
    __asm__ volatile("pause");
    __asm__ volatile("rep; nop");
    __asm__ volatile("fninit");
}

static void do_fxsave(void) {
    __asm__ volatile("fxsave %0" : "+m"(fx32));
    __asm__ volatile("fxsaveq %[fx]" : [fx] "=m"(fx64));
}

static unsigned long get_here(void) {
    unsigned long here;
    __asm__("lea 0(%%rip), %0" : "=r"(here));
    return here;
}

static unsigned int get_rights(void) {
    unsigned short selector = 0U;
    unsigned int rights;
    __asm__ volatile(
        "lar %[old_ss], %[ar]\n\t"
        "jz 1f\n\t"
        "xorl %[ar], %[ar]\n\t"
        "1:"
        : [ar] "=r"(rights) : [old_ss] "rm"(selector));
    return rights;
}

static void read_identity(void) {
    __asm__ volatile("mov %[address], %%r9" :
                     : [address] "g"(identity_source) : "r9", "memory");
}

int main(void) {
    do_fences();
    do_fxsave();
    read_identity();
    (void)get_rights();
    return get_here() != 0UL && identity_source == 42UL ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_typed_machine_qualification_gaps.c"}
/* x86 target-owned GNU MXCSR and ORC-unwind qualification regression. */
typedef unsigned int u32;
typedef unsigned long u64;

#if defined(NEGATIVE_MXCSR_REGISTER)
void probe(u32 *value) {
    u32 result;
    __asm__ __volatile__("stmxcsr %0" : "=r" (result));
    *value = result;
}
#elif defined(NEGATIVE_MXCSR_WIDTH)
void probe(u64 *value) {
    __asm__ __volatile__("stmxcsr %0" : "=m" (*value));
}
#elif defined(NEGATIVE_MXCSR_CLOBBER)
void probe(u32 *value) {
    __asm__ __volatile__("stmxcsr %0" : "=m" (*value) : : "cc");
}
#elif defined(NEGATIVE_MXCSR_SUFFIX)
void probe(u32 *value) {
    __asm__ __volatile__("stmxcsr %0; cli" : "=m" (*value));
}
#elif defined(NEGATIVE_UNWIND_MEMORY)
void probe(u64 *a, u64 *b, u64 *c) {
    __asm__ __volatile__("lea (%%rip), %0\n\tmov %%rsp, %1\n\tmov %%rbp, %2"
                         : "=m" (*a), "=r" (*b), "=r" (*c));
}
#elif defined(NEGATIVE_UNWIND_CLOBBER)
void probe(u64 *a, u64 *b, u64 *c) {
    __asm__ __volatile__("lea (%%rip), %0\n\tmov %%rsp, %1\n\tmov %%rbp, %2"
                         : "=r" (*a), "=r" (*b), "=r" (*c) : : "memory");
}
#elif defined(NEGATIVE_UNWIND_SUFFIX)
void probe(u64 *a, u64 *b, u64 *c) {
    __asm__ __volatile__("lea (%%rip), %0\n\tmov %%rsp, %1\n\tmov %%rbp, %2\n\tcli"
                         : "=r" (*a), "=r" (*b), "=r" (*c));
}
#else
void probe_mxcsr_store(u32 *value) {
    __asm__ __volatile__("stmxcsr %0" : "=m" (*value));
}
void probe_mxcsr_load(const u32 *value) {
    __asm__ __volatile__("ldmxcsr %0" : : "m" (*value));
}
void probe_mxcsr_store_named(u32 *value) {
    __asm__ __volatile__("stmxcsr %[val]" : [val] "=m" (*value));
}
void probe_unwind(u64 *a, u64 *b, u64 *c) {
    __asm__ __volatile__("lea (%%rip), %0\n\tmov %%rsp, %1\n\tmov %%rbp, %2"
                         : "=r" (*a), "=r" (*b), "=r" (*c));
}
#endif
