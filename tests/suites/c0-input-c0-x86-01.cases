@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_pat_clflushopt_alternative.c"}
/* Original Linux 6.6.143 arch/x86/include/asm/special_insns.h ALT owner:
 * selector 9*32+23, actual cache flush and 66-prefix CLFLUSHOPT replacement. */
#ifndef PAT_CLFLUSHOPT_UNUSED_IMM
#define PAT_CLFLUSHOPT_UNUSED_IMM 0
#endif

static void clflushopt(volatile void *p)
{
    asm volatile (
        "# ALT: oldnstr\n" "661:\n\t"
        ".byte 0x3e; clflush %P0"
        "\n662:\n" "# ALT: padding\n"
        ".skip -(((6651f-6641f)-(662b-661b)) > 0) * "
        "((6651f-6641f)-(662b-661b)),0x90\n"
        "663:\n" ".pushsection .altinstructions,\"a\"\n"
        " .long 661b - .\n" " .long 6641f - .\n"
        " .4byte (9*32+23)\n"
        " .byte 663b-661b\n" " .byte 6651f-6641f\n"
        ".popsection\n"
        ".pushsection .altinstr_replacement, \"ax\"\n"
        "# ALT: replacement 1\n" "6641:\n\t"
        ".byte 0x66; clflush %P0"
        "\n6651:\n" ".popsection\n"
        : "+m" (*(volatile char *)p) : "i" (PAT_CLFLUSHOPT_UNUSED_IMM));
}

int main(void)
{
    char cacheline[128] = { 0 };
    cacheline[13] = 42;
    clflushopt(&cacheline[13]);
    return cacheline[13];
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_raid6_avx2_native_gnu.c"}
/* AVX2 RAID6: load two aligned 32-byte vectors and non-temporally XOR.
 * All work is real YMM hardware ASM; no C SIMD intrinsic/auto-vectorizer. */
static unsigned char a[32] __attribute__((aligned(32)));
static unsigned char b[32] __attribute__((aligned(32)));
static unsigned char r[32] __attribute__((aligned(32)));

int main(void) {
    int i;
    for (i = 0; i != 32; ++i) {
        a[i] = (unsigned char)(i * 17 + 9);
        b[i] = (unsigned char)(i * 7 + 21);
    }
    asm volatile("vmovdqa %0,%%ymm0\n\t"
                 "vmovdqa %1,%%ymm1\n\t"
                 "vpxor %%ymm1,%%ymm0,%%ymm0\n\t"
                 "vmovntdq %%ymm0,%2"
                 : : "m" (a[0]), "m" (b[0]), "m" (r[0]));
    asm volatile("sfence" : : : "memory");
    for (i = 0; i != 32; ++i)
        if (r[i] != (unsigned char)(a[i] ^ b[i])) return 1;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_raid6_avx512_native_gnu.c"}
/* AVX512 RAID6: 64-byte ZMM load/XOR/non-temporal store plus real K1
 * predicate generation. Distinguishes true AVX512 hardware from pretending
 * that a parsed template already implements SIMD. */
static unsigned char a[64] __attribute__((aligned(64)));
static unsigned char b[64] __attribute__((aligned(64)));
static unsigned char r[64] __attribute__((aligned(64)));

int main(void) {
    int i;
    for (i = 0; i != 64; ++i) {
        a[i] = (unsigned char)(i * 13 + 7);
        b[i] = (unsigned char)(i * 11 + 19);
    }
    asm volatile("vmovdqa64 %0,%%zmm0\n\t"
                 "vmovdqa64 %1,%%zmm1\n\t"
                 "vpcmpgtb %%zmm0,%%zmm1,%%k1\n\t"
                 "vpmovm2b %%k1,%%zmm2\n\t"
                 "vpxorq %%zmm1,%%zmm0,%%zmm0\n\t"
                 "vmovntdq %%zmm0,%2"
                 : : "m" (a[0]), "m" (b[0]), "m" (r[0]));
    asm volatile("sfence" : : : "memory");
    for (i = 0; i != 64; ++i)
        if (r[i] != (unsigned char)(a[i] ^ b[i])) return 1;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_raid6_simd_native_gnu.c"}
/* Linux RAID6-style fixed XMM registers. GNU basic asm spells %xmm,
 * extended asm must spell %%xmm; the source memory operand is an address,
 * even though the declared C lvalue is only one byte wide. */
static unsigned char a[32] __attribute__((aligned(16))) = {
    0x15, 0x27, 0x39, 0x4b, 0x5d, 0x6f, 0x71, 0x83,
    0x95, 0xa7, 0xb9, 0xcb, 0xdd, 0xef, 0xf1, 0x03
};
static unsigned char b[32] __attribute__((aligned(16))) = {
    0x24, 0x18, 0x64, 0x50, 0x8c, 0x78, 0xb4, 0xa0,
    0xdc, 0xc8, 0x14, 0x00, 0x3c, 0x28, 0x54, 0x40
};
static unsigned char r[32] __attribute__((aligned(16)));

int main(void) {
    int i;
    asm volatile("pxor %xmm0,%xmm0");
    asm volatile("movdqa %0,%%xmm0" : : "m" (a[0]));
    asm volatile("movdqa %0,%%xmm1" : : "m" (b[0]));
    asm volatile("pxor %xmm1,%xmm0");
    asm volatile("movdqa %%xmm0,%0" : "=m" (r[0]));
    for (i = 0; i != 16; ++i)
        if (r[i] != (unsigned char)(a[i] ^ b[i])) return 1;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_raid6_simd_reject.c"}
/* Each form must fail in MiniC's target-owned hardware ASM admission.
 * These are not permitted to borrow a generic parse-only or scalar path. */
static unsigned char bytes[64] __attribute__((aligned(64)));
void reject(void) {
#if BAD_FORM == 1
    asm volatile("vaddps %ymm0,%ymm1,%ymm2"); /* unknown RAID6 opcode */
#elif BAD_FORM == 2
    asm volatile("movdqa %9,%%xmm0" : : "m" (bytes[0]));
#elif BAD_FORM == 3
    asm volatile("movdqa %%xmm0,%0" : "=r" (bytes[0]));
#elif BAD_FORM == 4
    asm volatile("vmovdqa64 %%zmm31,%0" : "=m" (bytes[0]));
#elif BAD_FORM == 5
    asm volatile("syscall %xmm0");
#endif
}
