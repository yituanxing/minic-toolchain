@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_p2_change_bit_xor.c"}
/* Exact GNU Linux 6.6.143 arch_change_bit() x86-64 ASM source form.
 * The constant branch must be an atomic LOCK XOR of the selected byte, with
 * a real .smp_locks patch record. It is NOT an OR/AND, barrier, or plain XOR.
 */
static inline __attribute__((__gnu_inline__)) __attribute__((__always_inline__)) void
linux_arch_change_bit(long nr, volatile unsigned long *addr)
{
    if (__builtin_constant_p(nr)) {
        asm volatile(".pushsection .smp_locks,\"a\"\n"
                     ".balign 4\n"
                     ".long 671f - .\n"
                     ".popsection\n"
                     "671:\n\tlock; xorb %b1,%0"
                     : "+m" (*(volatile char *)((void *)addr + (nr >> 3)))
                     : "iq" (1 << (nr & 7)));
    } else {
        asm volatile(".pushsection .smp_locks,\"a\"\n"
                     ".balign 4\n"
                     ".long 671f - .\n"
                     ".popsection\n"
                     "671:\n\tlock; btcq %1,%0"
                     : : "m" (*(volatile long *)addr), "Ir" (nr) : "memory");
    }
}

void x86_p2_change_fixed(volatile unsigned long *addr)
{
    linux_arch_change_bit(9, addr);
}

void x86_p2_change_variable(long nr, volatile unsigned long *addr)
{
    linux_arch_change_bit(nr, addr);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_p2_change_bit_xor_driver.c"}
#include <pthread.h>
#include <stddef.h>

extern void x86_p2_change_fixed(volatile unsigned long *addr);
extern void x86_p2_change_variable(long nr, volatile unsigned long *addr);

static volatile unsigned long word;

static void *change_fixed_concurrently(void *unused)
{
    size_t i;
    (void)unused;
    for (i = 0; i < 20001; ++i)
        x86_p2_change_fixed(&word);
    return NULL;
}

int main(void)
{
    pthread_t threads[6];
    size_t i;

    x86_p2_change_fixed(&word);
    if (word != (1UL << 9)) return 1;
    x86_p2_change_fixed(&word);
    if (word != 0UL) return 2;
    x86_p2_change_variable(31, &word);
    if (word != (1UL << 31)) return 3;
    x86_p2_change_variable(63, &word);
    if (word != ((1UL << 31) | (1UL << 63))) return 4;
    x86_p2_change_variable(31, &word);
    x86_p2_change_variable(63, &word);
    if (word != 0UL) return 5;
    x86_p2_change_variable(9, &word);
    x86_p2_change_fixed(&word);
    if (word != 0UL) return 6;

    /* Six odd-parity writers all toggle bit 9. If LOCK XOR were reduced to
     * ordinary non-atomic read/modify/write, lost toggles would be exposed. */
    for (i = 0; i < sizeof(threads) / sizeof(threads[0]); ++i)
        if (pthread_create(&threads[i], NULL, change_fixed_concurrently, NULL))
            return 7;
    for (i = 0; i < sizeof(threads) / sizeof(threads[0]); ++i)
        if (pthread_join(threads[i], NULL)) return 8;
    return word == 0UL ? 0 : 9;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_p2_kvm_asm_followups.c"}
/* GNU-only source oracle for original Linux 6.6.143 arch/x86/kvm/x86.i:
 * div_frac():64365, record_steal_time():65105-65126. No MiniC PASS claim.
 * These are real x86 integer-division, exchange and extable contracts. */
#include <stdint.h>

struct __large_struct {
    unsigned long buf[100];
};

uint32_t x86_p2_kvm_div_frac(uint32_t dividend, uint32_t divisor)
{
    uint32_t quotient, remainder;
    asm("divl %2"
        : "=a" (quotient), "=d" (remainder)
        : "rm" (divisor), "0" (0), "1" ((uint32_t)dividend));
    return quotient;
}

/* In memory-operand XCHG, x86 implicitly performs an atomic exchange even
 * without an explicit LOCK prefix. The early-clobber `+&r` errno must not
 * overlap the byte source or address. The extable is real fault metadata. */
int x86_p2_kvm_clear_steal_preempted(volatile unsigned char *address,
                                     unsigned char *previous)
{
    unsigned char old = 0;
    int err = -14;
    asm volatile("1: xchgb %0, %2\n"
                 "xor %1, %1\n"
                 "2:\n"
                 " .pushsection \"__ex_table\",\"a\"\n"
                 " .balign 4\n"
                 " .long (1b) - .\n"
                 " .long (2b) - .\n"
                 " .long 3\n"
                 " .popsection\n"
                 : "+q" (old), "+&r" (err), "+m" (*address));
    if (err) return err;
    *previous = old;
    return 0;
}

/* Exact exception-fixup asm-goto shape in record_steal_time(): the fault
 * target is operand %l2, not a direct jump. A kernel fixup handler consults
 * the __ex_table relocation; user-space cannot exercise the fault path. */
int x86_p2_kvm_put_user_byte(unsigned char value,
                             volatile unsigned char *address)
{
    asm goto("\n"
             "1:\tmovb %0,%1\n"
             " .pushsection \"__ex_table\",\"a\"\n"
             " .balign 4\n"
             " .long (1b) - .\n"
             " .long (%l2) - .\n"
             " .long 3\n"
             " .popsection\n"
             : : "iq" (value), "m" (*(struct __large_struct *)address)
             : : fault);
    return 0;
fault:
    return -14;
}

int x86_p2_kvm_get_user_byte(volatile unsigned char *address,
                             unsigned char *value)
{
    unsigned char read_value;
    asm volatile goto("\n"
                      "1:\tmovb %[umem],%[output]\n"
                      " .pushsection \"__ex_table\",\"a\"\n"
                      " .balign 4\n"
                      " .long (1b) - .\n"
                      " .long (%l2) - .\n"
                      " .long 3\n"
                      " .popsection\n"
                      : [output] "=q" (read_value)
                      : [umem] "m" (*(struct __large_struct *)address)
                      : : fault);
    *value = read_value;
    return 0;
fault:
    return -14;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_p2_kvm_asm_followups_driver.c"}
#include <stdint.h>

extern uint32_t x86_p2_kvm_div_frac(uint32_t dividend, uint32_t divisor);
extern int x86_p2_kvm_clear_steal_preempted(volatile unsigned char *address,
                                            unsigned char *previous);
extern int x86_p2_kvm_put_user_byte(unsigned char value,
                                    volatile unsigned char *address);
extern int x86_p2_kvm_get_user_byte(volatile unsigned char *address,
                                    unsigned char *value);

int main(void)
{
    static const uint32_t inputs[][2] = {
        {0, 1}, {1, 3}, {2, 3}, {3, 4}, {6, 7}, {100, 101},
        {65535, 65536}, {0x7fffffffU, 0x80000000U},
        {0xfffffffeU, 0xffffffffU}
    };
    volatile unsigned char memory = 0x5a;
    unsigned char previous = 0, loaded = 0;
    unsigned int index;

    for (index = 0; index < sizeof(inputs) / sizeof(inputs[0]); ++index) {
        const uint32_t dividend = inputs[index][0];
        const uint32_t divisor = inputs[index][1];
        const uint32_t exact = (uint32_t)(((uint64_t)dividend << 32) / divisor);
        if (x86_p2_kvm_div_frac(dividend, divisor) != exact) return 1;
    }
    if (x86_p2_kvm_clear_steal_preempted(&memory, &previous)) return 2;
    if (previous != 0x5a || memory != 0) return 3;
    if (x86_p2_kvm_put_user_byte(0x83, &memory)) return 4;
    if (memory != 0x83) return 5;
    if (x86_p2_kvm_get_user_byte(&memory, &loaded)) return 6;
    if (loaded != 0x83) return 7;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_paravirt_patch_site.c"}
/* The x86 Linux runtime rewrites paravirt inline-asm sites with a 5-byte
 * CALL rel32. The emitted 771..772 span must therefore be at least 5 bytes
 * even if MiniC selects a 3-byte register-indirect memory CALL. */
struct pv_ops_type {
    struct { void (*safe_halt)(void); } irq;
};

static int callback_count;
static void callback(void) { ++callback_count; }
struct pv_ops_type pv_ops = { .irq = { .safe_halt = callback } };
register unsigned long current_stack_pointer __asm__("rsp");

void pv_call(void) {
    unsigned long edi = 0, esi = 0, edx = 0, ecx = 0;
    asm volatile(
        "771:\n\t"
        "999:\n\t"
        ".pushsection .discard.retpoline_safe\n\t"
        ".long 999b\n\t"
        ".popsection\n\t"
        "call *%[paravirt_opptr];\n"
        "772:\n"
        ".pushsection .parainstructions,\"a\"\n"
        " .balign 8\n"
        " .quad 771b\n"
        " .byte %c[paravirt_typenum]\n"
        " .byte 772b-771b\n"
        " .balign 8\n"
        ".popsection\n"
        : "=D" (edi), "=S" (esi), "=d" (edx), "=c" (ecx),
          "+r" (current_stack_pointer)
        : [paravirt_typenum] "i" (1),
          [paravirt_opptr] "m" (pv_ops.irq.safe_halt)
        : "memory", "cc", "rax", "r8", "r9", "r10", "r11");
}

int main(void) {
    pv_call();
    return callback_count == 1 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_put_user_pointer.c"}
/* The real Linux robust-list and alternate-signal-stack writers pass a
 * pointer through RAX to the private __put_user_8 helper. Their GNU asm is
 * intentionally not a normal SysV call: RCX is the user address/error and
 * RSP is an explicit +r operand. Keep the actual ABI and pointer payload. */
typedef unsigned long uintptr_t;
register uintptr_t current_stack_pointer asm("rsp");

__asm__(
    ".text\n"
    ".globl __put_user_8\n"
    "__put_user_8:\n"
    "  movq %rax, (%rcx)\n"
    "  movabsq $0x123456789abcdef0, %rbx\n"
    "  xorl %ecx, %ecx\n"
    "  ret\n"
    ".globl __put_user_nocheck_8\n"
    ".set __put_user_nocheck_8, __put_user_8\n");

static int write_robust_ptr(void **user, void *value) {
    int err;
    void *address = user;
    register void *physical_value asm("%rax") = value;
    asm volatile("call __put_user_%c[size]"
                 : "=c"(err), "+r"(current_stack_pointer)
                 : "0"(address), "r"(physical_value),
                   [size] "i"(sizeof(*user))
                 : "ebx");
    return err;
}

static int write_sigaltstack_ptr(void **user, void *value) {
    int err;
    void *address = user;
    register void *physical_value asm("%rax") = value;
    asm volatile("call __put_user_nocheck_%c[size]"
                 : "=c"(err), "+r"(current_stack_pointer)
                 : "0"(address), "r"(physical_value),
                   [size] "i"(sizeof(*user))
                 : "ebx");
    return err;
}

int main(void) {
    int first = 17;
    long second = 0x12345678L;
    void *slot_a = (void *)0;
    void *slot_b = (void *)0;
    int status_a = write_robust_ptr(&slot_a, &first);
    int status_b = write_sigaltstack_ptr(&slot_b, &second);
    return status_a == 0 && status_b == 0 &&
           slot_a == &first && slot_b == &second ? 42 : 1;
}
@@@ end
