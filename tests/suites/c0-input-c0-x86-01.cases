@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_futex_extable_atomic.c"}
/* The complete original Linux 6.6.143 futex GNU exception-table macro.
 * The type-17 handler changes its designated physical output register on
 * EFAULT, while the ordinary success path uses real atomic x86 operations. */
#define FUTEX_SMP_LOCK \
    ".pushsection .smp_locks,\"a\"\n" \
    ".balign 4\n" \
    ".long 671f - .\n" \
    ".popsection\n" \
    "671:\n\tlock; "

#define FUTEX_EX_TABLE(source, target, output) \
    " .pushsection \"__ex_table\",\"a\"\n" \
    " .balign 4\n" \
    " .long (" source ") - .\n" \
    " .long (" target ") - .\n" \
    ".macro extable_type_reg type:req reg:req\n" \
    ".set .Lfound, 0\n" \
    ".set .Lregnr, 0\n" \
    ".irp rs,rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15\n" \
    ".ifc \\reg, %%\\rs\n" \
    ".set .Lfound, .Lfound+1\n" \
    ".long \\type + (.Lregnr << 8)\n" \
    ".endif\n" \
    ".set .Lregnr, .Lregnr+1\n" \
    ".endr\n" \
    ".set .Lregnr, 0\n" \
    ".irp rs,eax,ecx,edx,ebx,esp,ebp,esi,edi,r8d,r9d,r10d,r11d,r12d,r13d,r14d,r15d\n" \
    ".ifc \\reg, %%\\rs\n" \
    ".set .Lfound, .Lfound+1\n" \
    ".long \\type + (.Lregnr << 8)\n" \
    ".endif\n" \
    ".set .Lregnr, .Lregnr+1\n" \
    ".endr\n" \
    ".if (.Lfound != 1)\n" \
    ".error \"extable_type_reg: bad register argument\"\n" \
    ".endif\n" \
    ".endm\n" \
    "extable_type_reg reg=" output ", type=(17 | ((-14) << 16)) \n" \
    ".purgem extable_type_reg\n" \
    " .popsection\n"

static int futex_cmpxchg(unsigned int *uaddr, unsigned int oldval,
                         unsigned int newval, unsigned int *previous)
{
    int ret = 0;
    unsigned int result;
    asm volatile("\n1:\t" FUTEX_SMP_LOCK "cmpxchgl %3, %2\n"
                 "2:\n" FUTEX_EX_TABLE("1b", "2b", "%0")
        : "+r" (ret), "=a" (result), "+m" (*uaddr)
        : "r" (newval), "1" (oldval) : "memory");
    *previous = result;
    return ret;
}

static int futex_xchg(unsigned int *uaddr, int next, int *previous)
{
    int oldval = 0, ret;
    asm volatile("1:\t" "xchgl %0, %2\n" "2:\n"
                 FUTEX_EX_TABLE("1b", "2b", "%1")
        : "=r" (oldval), "=r" (ret), "+m" (*uaddr)
        : "0" (next), "1" (0));
    *previous = oldval;
    return ret;
}

static int futex_xadd(unsigned int *uaddr, int next, int *previous)
{
    int oldval = 0, ret;
    asm volatile("1:\t" FUTEX_SMP_LOCK "xaddl %0, %2\n"
                 "2:\n" FUTEX_EX_TABLE("1b", "2b", "%1")
        : "=r" (oldval), "=r" (ret), "+m" (*uaddr)
        : "0" (next), "1" (0));
    *previous = oldval;
    return ret;
}

static int futex_or(unsigned int *uaddr, int mask, int *previous)
{
    int oldval = 0, ret, temporary;
    asm volatile("1:\tmovl %2, %0\n"
                 "2:\tmovl %0, %3\n"
                 "\torl %4, %3\n"
                 "3:\t" FUTEX_SMP_LOCK "cmpxchgl %3, %2\n"
                 "\tjnz\t2b\n4:\n"
                 FUTEX_EX_TABLE("1b", "4b", "%1")
                 FUTEX_EX_TABLE("3b", "4b", "%1")
        : "=&a" (oldval), "=&r" (ret), "+m" (*uaddr), "=&r" (temporary)
        : "r" (mask), "1" (0));
    *previous = oldval;
    return ret;
}

static int futex_and(unsigned int *uaddr, int mask, int *previous)
{
    int oldval = 0, ret, temporary;
    asm volatile("1:\tmovl %2, %0\n"
                 "2:\tmovl %0, %3\n"
                 "\tandl %4, %3\n"
                 "3:\t" FUTEX_SMP_LOCK "cmpxchgl %3, %2\n"
                 "\tjnz\t2b\n4:\n"
                 FUTEX_EX_TABLE("1b", "4b", "%1")
                 FUTEX_EX_TABLE("3b", "4b", "%1")
        : "=&a" (oldval), "=&r" (ret), "+m" (*uaddr), "=&r" (temporary)
        : "r" (mask), "1" (0));
    *previous = oldval;
    return ret;
}

static int futex_xor(unsigned int *uaddr, int mask, int *previous)
{
    int oldval = 0, ret, temporary;
    asm volatile("1:\tmovl %2, %0\n"
                 "2:\tmovl %0, %3\n"
                 "\txorl %4, %3\n"
                 "3:\t" FUTEX_SMP_LOCK "cmpxchgl %3, %2\n"
                 "\tjnz\t2b\n4:\n"
                 FUTEX_EX_TABLE("1b", "4b", "%1")
                 FUTEX_EX_TABLE("3b", "4b", "%1")
        : "=&a" (oldval), "=&r" (ret), "+m" (*uaddr), "=&r" (temporary)
        : "r" (mask), "1" (0));
    *previous = oldval;
    return ret;
}

int main(void)
{
    unsigned int value = 17, previous = 0;
    int old = 0;
    if (futex_cmpxchg(&value, 17, 42, &previous) ||
        previous != 17 || value != 42) return 1;
    if (futex_cmpxchg(&value, 17, 99, &previous) ||
        previous != 42 || value != 42) return 2;
    if (futex_xchg(&value, 11, &old) || old != 42 || value != 11) return 3;
    if (futex_xadd(&value, 5, &old) || old != 11 || value != 16) return 4;
    if (futex_or(&value, 64, &old) || old != 16 || value != 80) return 5;
    if (futex_and(&value, 64, &old) || old != 80 || value != 64) return 6;
    if (futex_xor(&value, 106, &old) || old != 64 || value != 42) return 7;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_global_plan_abi.c"}
/* Differential object-layout oracle for the shared GlobalEmissionPlan.
 * One TU exercises ELF metadata, scalar IEEE754 data, relocations and
 * recursive C aggregate initialization without target instruction tricks. */
int global_anchor = 37;
static __attribute__((used)) float global_float = 1.25f;
static __attribute__((used)) double global_double = -2.5;
static __attribute__((used)) int *global_pointer = &global_anchor;

__attribute__((used, section(".bss.minic.global"))) int named_bss_zero;
__attribute__((used, section(".bssish.minic.global"))) int named_bssish_zero;

static int global_function(int value) { return value + 5; }
struct NestedReloc {
    int *pointer;
    int (*call)(int);
    double fraction;
};
struct OuterReloc {
    struct NestedReloc nested;
    const char *name;
};
static __attribute__((used)) struct OuterReloc global_nested = {
    { &global_anchor, global_function, 2.25 }, "nested"
};

static __attribute__((used)) const char *global_pointer_grid[2][2] = {
    { "first", "second" }, { "third", 0 }
};

struct FlexibleGlobal {
    const char *name;
    int values[];
};
static __attribute__((used)) struct FlexibleGlobal global_flexible = {
    "flexible", { 11, 13, 17 }
};

int main(void) {
    return global_anchor == 37 && global_float == 1.25f &&
           global_double == -2.5 && global_pointer == &global_anchor &&
           named_bss_zero == 0 && named_bssish_zero == 0 &&
           global_nested.nested.pointer == &global_anchor &&
           global_nested.nested.call(5) == 10 &&
           global_nested.nested.fraction == 2.25 &&
           global_nested.name[0] == 'n' &&
           global_pointer_grid[0][0][0] == 'f' &&
           global_pointer_grid[1][0][0] == 't' &&
           global_pointer_grid[1][1] == 0 &&
           global_flexible.name[0] == 'f' &&
           global_flexible.values[0] == 11 &&
           global_flexible.values[2] == 17 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_gnu_function_pointer_array_param.c"}
/* Linux arch/x86/kvm/vmx/vmx.i:58019:
 * nested_vmx_hardware_setup(int (*exit_handlers[])(struct kvm_vcpu *));
 * An array parameter of function pointers adjusts to pointer-to-function-
 * pointer, without leaving an ownerless incomplete array descriptor. */
typedef int (*exit_handler_t)(int);

extern int invoke_handlers(int (*exit_handlers[])(int), int value);

__attribute__((noinline))
int invoke_handlers(int (*exit_handlers[])(int), int value) {
    return exit_handlers[1](value);
}

__attribute__((noinline))
int invoke_typedef_handlers(exit_handler_t exit_handlers[], int value) {
    return exit_handlers[0](value);
}
@@@ end
