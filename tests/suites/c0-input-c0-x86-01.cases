@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_cmpxchg16b_atomic.c"}
/* Real Linux arch_try_cmpxchg128 contract: ZF, 16-byte memory, RDX:RAX,
 * RBX:RCX, and the .smp_locks PREL32 patch site are inseparable. */
typedef unsigned __int128 u128;
typedef unsigned long u64;
typedef _Bool bool;
union halves { u128 full; struct { u64 low, high; }; };

static bool cmpxchg128(volatile u128 *ptr, u128 *oldp, u128 desired) {
    union halves old_pair = { .full = *oldp };
    union halves new_pair = { .full = desired };
    bool swapped;
    asm volatile(".pushsection .smp_locks,\"a\"\n"
                 ".balign 4\n"
                 ".long 671f - .\n"
                 ".popsection\n"
                 "671:\n\tlock; cmpxchg16b %[ptr]"
                 "\n\t/* output condition code e*/\n"
                 : "=@cce"(swapped), [ptr] "+m"(*ptr),
                   "+a"(old_pair.low), "+d"(old_pair.high)
                 : "b"(new_pair.low), "c"(new_pair.high)
                 : "memory");
    if (!swapped) *oldp = old_pair.full;
    return swapped;
}

int main(void) {
    volatile u128 cell __attribute__((aligned(16))) = (u128)7UL;
    u128 expected = (u128)7UL;
    u128 desired = ((u128)0x123456789abcdef0UL << 64) | (u128)11UL;
    if (!cmpxchg128(&cell, &expected, desired) || cell != desired ||
        expected != (u128)7UL)
        return 1;
    expected = (u128)3UL;
    if (cmpxchg128(&cell, &expected, (u128)9UL) ||
        cell != desired || expected != desired)
        return 2;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_kvm_hypercall_full_abi.c"}
/* Linux 6.6.143 arch/x86/include/asm/kvm_para.h: the actual five-argument
 * alternative site and the one-through-four argument ABI siblings. This is
 * a privileged-instruction compile/ELF test, never executed in user mode. */
#define KVM_ALT_VMCALL                                                  \
    "# ALT: oldnstr\n"                                                 \
    "661:\n\t" "vmcall" "\n662:\n"                                    \
    "# ALT: padding\n"                                                 \
    ".skip -(((" "665""1""f-""664""1""f" ")-(" "662b-661b"          \
    ")) > 0) * " "((" "665""1""f-""664""1""f" ")-(" "662b-661b"    \
    ")),0x90\n"                                                        \
    "663" ":\n"                                                        \
    ".pushsection .altinstructions,\"a\"\n"                         \
    " .long 661b - .\n"                                                \
    " .long " "664""1""f - .\n"                                       \
    " .4byte " "( 8*32+15)" "\n"                                      \
    " .byte " "663""b-661b" "\n"                                      \
    " .byte " "665""1""f-""664""1""f" "\n"                           \
    ".popsection\n"                                                    \
    ".pushsection .altinstr_replacement, \"ax\"\n"                 \
    "# ALT: replacement " "1" "\n"                                    \
    "664""1"":\n\t" "vmmcall" "\n"                                 \
    "665""1" ":\n"                                                   \
    ".popsection\n"

long linux_kvm_alt0(unsigned int nr) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr) : "memory");
    return ret;
}
long linux_kvm_alt1(unsigned int nr, unsigned long p1) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr), "b"(p1) : "memory");
    return ret;
}
long linux_kvm_alt2(unsigned int nr, unsigned long p1, unsigned long p2) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2) : "memory");
    return ret;
}
long linux_kvm_alt3(unsigned int nr, unsigned long p1, unsigned long p2,
                    unsigned long p3) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2),
                 "d"(p3) : "memory");
    return ret;
}
long linux_kvm_alt4(unsigned int nr, unsigned long p1, unsigned long p2,
                    unsigned long p3, unsigned long p4) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2),
                 "d"(p3), "S"(p4) : "memory");
    return ret;
}
long linux_kvm_sev_direct0(unsigned int nr) {
    long ret;
    asm volatile("vmmcall" : "=a"(ret) : "a"(nr) : "memory");
    return ret;
}
long linux_kvm_sev_direct3(unsigned int nr, unsigned long p1,
                           unsigned long p2, unsigned long p3) {
    long ret;
    asm volatile("vmmcall" : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2),
                 "d"(p3) : "memory");
    return ret;
}
