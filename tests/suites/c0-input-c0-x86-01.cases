@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_x86_linux_kvm_hypercall_abi.c"}
#include "x86_linux_kvm_hypercall_full_abi.c"

/* A fifth argument exists in the GNU constraints, but must be physical RSI.
 * RDI is a valid GCC constraint and must NOT silently satisfy this contract. */
long linux_kvm_wrong_fifth_register(unsigned int nr, unsigned long p1,
                                   unsigned long p2, unsigned long p3,
                                   unsigned long p4) {
    long ret;
    asm volatile(KVM_ALT_VMCALL : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2),
                 "d"(p3), "D"(p4) : "memory");
    return ret;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_x86_linux_kvm_hypercall_memory.c"}
#include "x86_linux_kvm_hypercall_full_abi.c"

/* The direct AMD form is a compiler memory barrier in the Linux source.
 * An unrelated CC clobber cannot claim the identical memory effect. */
long linux_kvm_sev_missing_memory(unsigned int nr, unsigned long p1,
                                  unsigned long p2, unsigned long p3) {
    long ret;
    asm volatile("vmmcall" : "=a"(ret) : "a"(nr), "b"(p1), "c"(p2),
                 "d"(p3) : "cc");
    return ret;
}
@@@ end
