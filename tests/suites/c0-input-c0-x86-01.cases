@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_head_inline_section_probe.c"}
static __attribute__((always_inline)) inline unsigned long probe_helper(unsigned long input) {
    return (input + 7UL) ^ (input << 3);
}

__attribute__((section(".head.text")))
unsigned long probe_early(void) {
    return probe_helper(17UL);
}

__attribute__((section(".init.text")))
unsigned long probe_later(void) {
    return probe_helper(17UL);
}

__attribute__((section(".head.text")))
unsigned long probe_early_again(void) {
    return probe_helper(17UL);
}

static __attribute__((section(".special.text"), always_inline)) inline
unsigned long probe_explicit(unsigned long input) {
    return input * 3UL;
}

__attribute__((section(".head.text")))
unsigned long probe_explicit_owner(void) {
    return probe_explicit(13UL);
}

/* The leaf call is a single shared source-AST expression. Both specialized
 * middle callers must get a local leaf clone even when the leaf's literal
 * argument does not acquire new transitive integer facts. */
static __attribute__((always_inline)) inline unsigned long
probe_nested_leaf(unsigned long input) {
    return (input * 5UL) + 2UL;
}

static __attribute__((always_inline)) inline unsigned long
probe_nested_middle(unsigned long input) {
    return probe_nested_leaf(11UL) + input;
}

__attribute__((section(".head.text")))
unsigned long probe_nested_early(void) {
    return probe_nested_middle(3UL);
}

__attribute__((section(".init.text")))
unsigned long probe_nested_later(void) {
    return probe_nested_middle(3UL);
}

/* Linux overflow.h: the _Bool call only gains its range-specialized clone
 * after the integer and symbolic passes. A sectioned integer clone of the
 * enclosing helper has no Boolean parameter facts, but still needs the
 * late-created Boolean callee duplicated into its own section. */
static inline _Bool probe_overflow_expected(_Bool overflow) {
    return __builtin_expect(!!overflow, 0);
}

static inline unsigned long probe_overflow_product(unsigned long n,
                                                   unsigned long size) {
    unsigned long bytes;
    if (__builtin_expect(!!probe_overflow_expected(
            __builtin_mul_overflow(n, size, &bytes)), 0))
        return ~0UL;
    return bytes;
}

static inline unsigned long probe_overflow_wrapper(unsigned long n) {
    return probe_overflow_product(n, 2UL);
}

__attribute__((section(".head.text")))
unsigned long probe_overflow_early(void) {
    return probe_overflow_wrapper(3UL);
}

__attribute__((section(".init.text")))
unsigned long probe_overflow_later(void) {
    return probe_overflow_wrapper(3UL);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_kbuild_mitigations.c"}
/* Original GNU Linux x86-64 Kbuild mitigation shapes: direct, indirect and
 * label-address control flow. Link/run through external thunk definitions. */
static int minic_x86_add_five(int x) { return x + 5; }

int minic_x86_indirect_call(int (*fn)(int), int x) {
    return fn(x);
}

int minic_x86_computed_goto(int x) {
    static void *const labels[2] = { &&left, &&right };
    goto *labels[x & 1];
left:
    return x + 10;
right:
    return x + 20;
}

int main(void) {
    return minic_x86_indirect_call(minic_x86_add_five, 7) != 12 ||
           minic_x86_computed_goto(0) != 10 ||
           minic_x86_computed_goto(1) != 21;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_kernel_head_link_address.c"}
/* x86's pre-page-table .head.text needs the link-time kernel VMA for a
 * C global address; regular code and PIE code must keep their own policy. */
unsigned long kernel_link_address_probe_anchor = 0x195ac3UL;

__attribute__((section(".head.text"), noinline))
unsigned long kernel_head_link_address_probe(void) {
    return (unsigned long)&kernel_link_address_probe_anchor;
}

__attribute__((noinline))
unsigned long kernel_regular_link_address_probe(void) {
    return (unsigned long)&kernel_link_address_probe_anchor;
}

/* The opposite .head.text case: the kernel runs here before the high-half
 * virtual mapping exists. A descriptor actually written via a C lvalue, and
 * subsequently passed to a helper, needs its displaced RIP-relative address.
 * Returning an address as link-time arithmetic above remains absolute. */
struct kernel_head_probe_desc {
    unsigned short limit;
    unsigned long address;
} __attribute__((packed));

struct kernel_head_probe_desc kernel_head_direct_descriptor;
extern void kernel_head_direct_data_consumer(struct kernel_head_probe_desc *);

__attribute__((section(".head.text"), noinline))
void kernel_head_direct_global_probe(unsigned long value) {
    kernel_head_direct_descriptor.address = value;
    kernel_head_direct_data_consumer(&kernel_head_direct_descriptor);
}

/* One symbol now has both address roles inside the SAME .head.text function.
 * Physical data writes must use displaced RIP-relative addressing while
 * pointer-to-integer arithmetic must retain the original link VMA. The
 * opposite evaluation orders prevent a producer-order workaround. */
volatile unsigned long kernel_head_mixed_global;

__attribute__((section(".head.text"), noinline))
unsigned long kernel_head_mixed_store_then_vma(unsigned long value) {
    kernel_head_mixed_global = value;
    return (unsigned long)&kernel_head_mixed_global;
}

__attribute__((section(".head.text"), noinline))
unsigned long kernel_head_mixed_vma_then_store(unsigned long value) {
    unsigned long vma = (unsigned long)&kernel_head_mixed_global;
    kernel_head_mixed_global = value;
    return vma;
}

/* An unannotated static helper inherits the address role of its only caller.
 * Linux head64.c has exactly this layout: startup_64_setup_env in .head.text
 * calls startup_64_load_idt in ordinary .text, which passes a global's link
 * VMA into fixup_pointer(ptr, physbase). The helper's global address must
 * remain absolute, even though the machine code executes before paging. */
unsigned long kernel_head_helper_target;
static __attribute__((noinline)) unsigned long
kernel_head_fixup_pointer(unsigned long *pointer, unsigned long physbase) {
    return (unsigned long)pointer -
           (unsigned long)&kernel_link_address_probe_anchor + physbase;
}
static __attribute__((noinline)) unsigned long
kernel_head_only_helper(unsigned long physbase) {
    return kernel_head_fixup_pointer(&kernel_head_helper_target, physbase);
}
__attribute__((section(".head.text"), noinline))
unsigned long kernel_head_helper_entry(unsigned long physbase) {
    return kernel_head_only_helper(physbase);
}

/* The same static helper reached from both normal and early code cannot
 * inherit the head-only role. It keeps ordinary .text PC-relative lowering. */
static __attribute__((noinline)) unsigned long kernel_head_shared_helper(void) {
    return (unsigned long)&kernel_head_helper_target;
}
__attribute__((section(".head.text"), noinline))
unsigned long kernel_head_shared_entry(void) {
    return kernel_head_shared_helper();
}
__attribute__((noinline))
unsigned long kernel_head_shared_normal(void) {
    return kernel_head_shared_helper();
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_kernel_head_link_address_driver.c"}
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>

extern unsigned long kernel_link_address_probe_anchor;
extern unsigned long kernel_head_link_address_probe(void);
extern unsigned long kernel_regular_link_address_probe(void);
struct kernel_head_probe_desc {
    unsigned short limit;
    unsigned long address;
} __attribute__((packed));
extern struct kernel_head_probe_desc kernel_head_direct_descriptor;
extern void kernel_head_direct_global_probe(unsigned long value);
extern volatile unsigned long kernel_head_mixed_global;
extern unsigned long kernel_head_mixed_store_then_vma(unsigned long);
extern unsigned long kernel_head_mixed_vma_then_store(unsigned long);
extern unsigned long kernel_head_helper_target;
extern unsigned long kernel_head_helper_entry(unsigned long);
extern unsigned long kernel_head_shared_entry(void);
extern unsigned long kernel_head_shared_normal(void);
static int head_direct_consumer_ok;

void kernel_head_direct_data_consumer(struct kernel_head_probe_desc *desc) {
    head_direct_consumer_ok = (desc == &kernel_head_direct_descriptor &&
                               desc->address == 0x19ac321UL);
}

/* The early function and its data are displaced by an identical amount.
 * PC-relative stores must therefore update the cloned physical object, but
 * VMA arithmetic must still produce the ORIGINAL link-time object address.
 * Merely executing the functions at their normal link location would not
 * distinguish the two representations. */
static int check_displaced_mixed_use(
    unsigned long (*function)(unsigned long), unsigned long value) {
    const uintptr_t code = (uintptr_t)(void *)function;
    const uintptr_t data = (uintptr_t)&kernel_head_mixed_global;
    const uintptr_t begin = code < data ? code : data;
    const uintptr_t code_end = code + 256U;
    const uintptr_t data_end = data + sizeof(unsigned long);
    const uintptr_t end = code_end > data_end ? code_end : data_end;
    const size_t span = (size_t)(end - begin);
    unsigned char *copy;
    uintptr_t relocated_address;
    unsigned long (*relocated)(unsigned long);
    unsigned long result, cloned_data = 0U;
    int ok;
    if (span > (1U << 20)) return 0;
    copy = mmap(NULL, span, PROT_READ | PROT_WRITE | PROT_EXEC,
                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (copy == MAP_FAILED) return 0;
    memcpy(copy + (code - begin), (const void *)code, 256U);
    kernel_head_mixed_global = 0x7733UL;
    relocated_address = (uintptr_t)(copy + (code - begin));
    memcpy(&relocated, &relocated_address, sizeof(relocated));
    result = relocated(value);
    memcpy(&cloned_data, copy + (data - begin), sizeof(cloned_data));
    ok = result == (unsigned long)data && cloned_data == value &&
         kernel_head_mixed_global == 0x7733UL;
    if (munmap(copy, span) != 0) return 0;
    return ok;
}

int main(void) {
    void *page = mmap(NULL, 4096, PROT_READ | PROT_WRITE | PROT_EXEC,
                      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    unsigned long (*relocated)(void);
    unsigned long linked = (unsigned long)&kernel_link_address_probe_anchor;
    if (page == MAP_FAILED) return 4;
    if (kernel_head_link_address_probe() != linked ||
        kernel_regular_link_address_probe() != linked) return 5;
    kernel_head_direct_global_probe(0x19ac321UL);
    if (!head_direct_consumer_ok ||
        kernel_head_direct_descriptor.address != 0x19ac321UL) return 8;
    if (!check_displaced_mixed_use(
            kernel_head_mixed_store_then_vma, 0x195ac3UL)) return 9;
    if (!check_displaced_mixed_use(
            kernel_head_mixed_vma_then_store, 0x8f71UL)) return 10;
    if (kernel_head_helper_entry(0x2000UL) !=
            (unsigned long)&kernel_head_helper_target - linked + 0x2000UL ||
        kernel_head_shared_entry() != (unsigned long)&kernel_head_helper_target ||
        kernel_head_shared_normal() != (unsigned long)&kernel_head_helper_target)
        return 11;
    /* The displacement-to-RIP representation is wrong for this function:
     * a relocated copy must still produce the original link-time symbol VMA. */
    memcpy(page, (const void *)(uintptr_t)&kernel_head_link_address_probe, 256);
    memcpy(&relocated, &page, sizeof(relocated));
    if (relocated() != linked) return 6;
    if (munmap(page, 4096) != 0) return 7;
    printf("%lx\n", linked);
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_kvm_movdqa_reject.c"}
/* KVM's exact vector_size(16) 16-byte aligned MOVDQA contract is not
 * permitted to admit byte-sized memory, another vector width, or unsupported
 * registers/constraints. All cases are intentional MiniC failures. */
typedef unsigned int u32;
typedef u32 __attribute__((vector_size(16))) v128;
typedef u32 __attribute__((vector_size(8))) v64;
static unsigned char scalar[16] __attribute__((aligned(16)));
void reject(void) {
#if BAD_FORM == 1
    asm("movdqa %%xmm0,%0" : "=m"(scalar[0]));
#elif BAD_FORM == 2
    v64 wrong;
    asm("movdqa %%xmm0,%0" : "=m"(wrong));
#elif BAD_FORM == 3
    v128 right;
    asm("movdqa %%xmm16,%0" : "=m"(right));
#elif BAD_FORM == 4
    v128 right;
    asm("movdqa %%xmm0,%0" : "=r"(right));
#elif BAD_FORM == 5
    const v128 right = {0, 0, 0, 0};
    asm("movdqa %%xmm0,%0" : "=m"(right));
#endif
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_kvm_original_fpu_owner.c"}
/* Compile the UNMODIFIED Linux 6.6.143 arch/x86/kvm/fpu.h through a tiny
 * kernel-API shim: neither the vector typedef nor the 32 XMM asm patterns
 * are pasted/reimplemented here. LINUX_SRC is supplied by the harness. */
typedef unsigned int u32;
typedef unsigned long long u64;
extern void abort(void);
#define CONFIG_X86_64 1
#define BUG() abort()
#define fpregs_lock() ((void)0)
#define fpregs_unlock() ((void)0)
#define fpregs_assert_state_consistent() ((void)0)
#define TIF_NEED_FPU_LOAD 0
#define test_thread_flag(flag) 0
#define switch_fpu_return() ((void)0)
#include "arch/x86/kvm/fpu.h"

/* Variable-index helpers force all 16 register arms in the original source
 * to stay eligible; dynamic runtime below checks actual XMM0 and XMM15. */
__attribute__((noinline)) void kvm_original_write(int reg, const sse128_t *p) {
    _kvm_write_sse_reg(reg, p);
}
__attribute__((noinline)) void kvm_original_read(int reg, sse128_t *p) {
    _kvm_read_sse_reg(reg, p);
}

int main(void) {
    __sse128_u input, output;
    input.as_u64[0] = 0x123456789abcdef0ULL;
    input.as_u64[1] = 0xfedcba9876543210ULL;
    output.as_u64[0] = 0;
    output.as_u64[1] = 0;
    kvm_original_write(0, &input.vec);
    kvm_original_read(0, &output.vec);
    if (output.as_u64[0] != input.as_u64[0] ||
        output.as_u64[1] != input.as_u64[1]) return 1;
    output.as_u64[0] = 0;
    output.as_u64[1] = 0;
    kvm_original_write(15, &input.vec);
    kvm_original_read(15, &output.vec);
    if (output.as_u64[0] != input.as_u64[0] ||
        output.as_u64[1] != input.as_u64[1]) return 2;
    /* Linux hyperv.c and fpu.h use this exact GNU statement-expression
     * union transport, which must preserve both 64-bit lanes with -mno-sse. */
    if (sse128_lo(input.vec) != input.as_u64[0] ||
        sse128_hi(input.vec) != input.as_u64[1]) return 3;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_linux_cmpxchg16b_alt.c"}
/* Original Linux 6.6 x86 per-CPU CMPXCHG16B alternative: the emulation
 * branch executes a private kernel call, while the replacement uses GS.
 * Assemble/inspect the ELF patch metadata, never execute this in user mode. */
typedef unsigned __int128 u128;
typedef unsigned long u64;
union halves { u128 full; struct { u64 low, high; }; };

void __update_cpu_freelist_fast(volatile u128 *per_cpu,
                                u128 *oldp, u128 desired) {
    union halves old = {.full = *oldp};
    union halves next = {.full = desired};
    asm volatile("# ALT: oldnstr\n"
                 "661:\n\tleaq %P[var], %%rsi; call this_cpu_cmpxchg16b_emu\n"
                 "662:\n"
                 "# ALT: padding\n"
                 ".skip -(((6651f-6641f)-(662b-661b)) > 0) * "
                     "((6651f-6641f)-(662b-661b)),0x90\n"
                 "663:\n"
                 ".pushsection .altinstructions,\"a\"\n"
                 " .long 661b - .\n"
                 " .long 6641f - .\n"
                 " .4byte ( 4*32+13)\n"
                 " .byte 663b-661b\n"
                 " .byte 6651f-6641f\n"
                 ".popsection\n"
                 ".pushsection .altinstr_replacement, \"ax\"\n"
                 "# ALT: replacement 1\n"
                 "6641:\n\tcmpxchg16b %%gs:%[var]\n"
                 "6651:\n.popsection\n"
                 : [var] "+m"(*per_cpu), "+a"(old.low), "+d"(old.high)
                 : "b"(next.low), "c"(next.high)
                 : "memory", "rsi");
    *oldp = old.full;
}
