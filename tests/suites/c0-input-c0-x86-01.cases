@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_typed_six_legacy_abi.c"}
/* R5: six Source -> Core -> typed Machine ASM families, plus the original
 * overlapping eight-operand CPUID that MUST remain on the legacy verifier.
 * Privileged instructions and TPAUSE are GNU-AS-only, never run in user mode. */
typedef unsigned int u32;
static u32 flags;
static volatile unsigned long cache_line;
static unsigned short selector;

void checked_verw(void) {
    asm volatile("verw %[ds]" :: [ds] "m"(selector) : "cc");
}
void privileged_invlpg(unsigned long address) {
    asm volatile("invlpg (%0)" :: "r"(address) : "memory");
}
void checked_clflush(volatile unsigned long *address) {
    asm volatile("clflush %0" : "+m"(*address));
}
unsigned long checked_delay_mul(unsigned long loops, unsigned long multiplier) {
    int scratch;
    asm("mull %%edx" : "=d"(loops), "=&a"(scratch)
        : "1"(loops), "0"(multiplier));
    return loops;
}
unsigned long checked_delay_wait(unsigned long loops) {
    asm volatile("test %0,%0\n\tjz 3f\n\tjmp 1f\n\t"
                 ".align 16\n1:\tjmp 2f\n\t.align 16\n"
                 "2:\tdec %0\n\tjnz 2b\n3:\tdec %0\n"
        : "+a"(loops));
    return loops;
}
void checked_tpause(u32 ecx, u32 edx, u32 eax) {
    asm volatile("tpause %%ecx\n" :: "c"(ecx), "d"(edx), "a"(eax));
}
void privileged_halt(void) {
    asm volatile("hlt");
}
void checked_movnti(unsigned long value) {
    asm("movntiq %1, %0" : "=m"(cache_line) : "r"(value));
}
void checked_set_bit(u32 n) {
    asm volatile("btsl %1,%0" : "+m"(flags) : "Ir"(n));
}
void checked_cpuid_six(u32 id, u32 count, u32 *a, u32 *b, u32 *c, u32 *d) {
    asm volatile("cpuid" : "=a"(*a), "=b"(*b), "=c"(*c), "=d"(*d)
        : "0"(id), "2"(count));
}
void checked_cpuid_eight(u32 *a, u32 *b, u32 *c, u32 *d) {
    /* Historically accepted by generic qualified() with 8 Core bindings.
     * BOOT_FLAGS typed ID must never intercept this valid older shape. */
    asm("cpuid" : "=a"(*a), "=b"(*b), "=c"(*c), "=d"(*d)
        : "0"(*a), "1"(*b), "2"(*c), "3"(*d));
}

int main(void) {
    u32 first[4] = {0, 0, 0, 0};
    u32 second[4] = {0, 0, 0, 0};
    unsigned int i;
    checked_cpuid_six(0, 0, &first[0], &first[1], &first[2], &first[3]);
    checked_cpuid_eight(&second[0], &second[1], &second[2], &second[3]);
    for (i = 0; i < 4; ++i)
        if (first[i] != second[i]) return 1;
    checked_set_bit(3);
    if (flags != 8) return 2;
    checked_movnti(42);
    asm volatile("mfence" ::: "memory");
    if (cache_line != 42) return 3;
    checked_clflush(&cache_line);
    if (checked_delay_mul(0xffffffffUL, 0xffffffffUL) !=
        0xfffffffeUL) return 4;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_va_cursor_source_basic_runtime.c"}
typedef __builtin_va_list MiniVa;

extern int vsnprintf(char *, unsigned long, const char *, MiniVa);

static int consume(MiniVa cursor) {
    return __builtin_va_arg(cursor, int);
}

static int from_source(unsigned int named, ...) {
    MiniVa cursor;
    MiniVa duplicate;
    char text[16];
    int result;
    __builtin_va_start(cursor, named);
    if (consume(cursor) != 71) return 1;
    __builtin_va_copy(duplicate, cursor);
    if (__builtin_va_arg(duplicate, int) != 82) return 2;
    if (__builtin_va_arg(cursor, int) != 82) return 3;
    result = vsnprintf(text, sizeof(text), "%d", cursor);
    __builtin_va_end(duplicate);
    __builtin_va_end(cursor);
    if (result != 2 || text[0] != '9' || text[1] != '3' || text[2] != 0)
        return 4;
    return 0;
}

int main(void) {
    MiniVa cursor;
    if (sizeof(cursor) != 24U || sizeof(MiniVa) != 24U) return 5;
    if ((char *)(&cursor + 1) - (char *)&cursor != 24) return 6;
    return from_source(1U, 71, 82, 93);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_va_cursor_source_object_runtime.c"}
/* x86-64 SysV source-object vs internal vararg-tag regression.
 * GNU __builtin_va_list is an array[1] of a 24-byte struct, not a pointer.
 * Run with host GCC and MiniC native; the latter must match GCC or reject
 * explicitly while the real source representation is being introduced. */
typedef __builtin_va_list MiniVa;

extern int vsnprintf(char *, unsigned long, const char *, MiniVa);

struct EmbeddedVa {
    unsigned char prefix;
    MiniVa cursor;
    unsigned char suffix;
};

static MiniVa global_cursor;
static MiniVa pair_of_cursors[2];

/* Parameters of typedef'd array va_list are adjusted to state pointers.
 * The callee must advance the caller's actual cursor object, not a local
 * pointer proxy. va_copy also accepts an adjusted parameter as its source. */
static int consume_one(MiniVa cursor) {
    return __builtin_va_arg(cursor, int);
}

static int copy_from_parameter(MiniVa cursor) {
    MiniVa independent;
    int value;
    __builtin_va_copy(independent, cursor);
    value = __builtin_va_arg(independent, int);
    __builtin_va_end(independent);
    return value;
}

static int exercise_parameter_decay(unsigned int fixed, ...) {
    MiniVa cursor;
    int observed;
    __builtin_va_start(cursor, fixed);
    observed = consume_one(cursor);
    if (observed != 11) return 3;
    if (copy_from_parameter(cursor) != 12) return 4;
    if (__builtin_va_arg(cursor, int) != 12) return 5;
    if (__builtin_va_arg(cursor, int) != 13) return 6;
    __builtin_va_end(cursor);
    return 0;
}

static int format_remaining(unsigned int fixed, ...) {
    MiniVa current;
    MiniVa copy;
    char buffer[32];
    int length;

    __builtin_va_start(current, fixed);
    if (__builtin_va_arg(current, int) != 41) return 1;
    __builtin_va_copy(copy, current);
    length = vsnprintf(buffer, sizeof(buffer), "%d/%ld", copy);
    __builtin_va_end(copy);
    __builtin_va_end(current);
    if (length != 5 || buffer[0] != '7' || buffer[1] != '/' ||
        buffer[2] != '9' || buffer[3] != '0' || buffer[4] != '0' ||
        buffer[5] != '\0') return 2;
    return 0;
}

int main(void) {
    MiniVa local;
    struct EmbeddedVa container;
    if (sizeof(MiniVa) != 24U || sizeof(local) != 24U ||
        sizeof(global_cursor) != 24U) return 10;
    if (sizeof(pair_of_cursors) != 48U || sizeof(container) != 40U ||
        sizeof(container.cursor) != 24U) return 11;
    if ((char *)(&local + 1) - (char *)&local != 24) return 12;
    if (format_remaining(9U, 41, 7, 900L) != 0) return 20;
    if (exercise_parameter_decay(4U, 11, 12, 13) != 0) return 21;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_variadic_no_sse.c"}
#include <stdarg.h>

/* Linux early exception handlers invoke integer-only variadic functions
 * before CR4.OSFXSR makes even an unused XMM spill legal. */
__attribute__((noinline))
unsigned long minic_x86_integer_varargs(unsigned long fixed, ...) {
    va_list args;
    unsigned long first, second;
    va_start(args, fixed);
    first = va_arg(args, unsigned long);
    second = va_arg(args, unsigned long);
    va_end(args);
    return fixed + first * 3UL + second;
}

#ifdef MINIC_X86_TEST_FLOAT_VARARGS
__attribute__((noinline))
double minic_x86_float_varargs(unsigned long fixed, ...) {
    va_list args;
    double first;
    va_start(args, fixed);
    first = va_arg(args, double);
    va_end(args);
    return first + (double)fixed;
}
#endif

int main(void) {
    if (minic_x86_integer_varargs(2UL, 7UL, 11UL) != 34UL)
        return 1;
#ifdef MINIC_X86_TEST_FLOAT_VARARGS
    if (minic_x86_float_varargs(2UL, 3.5) != 5.5)
        return 2;
#endif
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_vdso_hidden_unused.c"}
/* A Linux vDSO translation unit may declare more hidden externs than its
 * emitted functions actually use.  An unused hidden declaration must not
 * become an undefined ELF symbol merely because it was parsed. */
extern long vdso_hidden_unused_data __attribute__((visibility("hidden")));
extern long vdso_hidden_required_data __attribute__((visibility("hidden")));
extern long vdso_default_preemptible_data;
__attribute__((visibility("hidden")))
extern long vdso_hidden_required_function(long);

long minic_x86_vdso_hidden_probe(long input) {
    long (*function)(long) = vdso_hidden_required_function;
    return vdso_hidden_required_data + vdso_default_preemptible_data +
           function(input);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/x86_vdso_hidden_unused_owner.c"}
long vdso_hidden_required_data = 37;
long vdso_default_preemptible_data = 2;

long vdso_hidden_required_function(long input) {
    return input + 3;
}

extern long minic_x86_vdso_hidden_probe(long);

int main(void) {
    return minic_x86_vdso_hidden_probe(0) == 42 ? 0 : 1;
}
@@@ end
