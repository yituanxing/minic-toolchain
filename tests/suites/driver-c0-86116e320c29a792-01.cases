@@@ {"id": "86116e320c29a792", "kind": "shared", "newline": true}
set -Eeuo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
minic=${MINIC_CC:-"$root/build/release/bin/minic-cc"}
host_cc=${HOST_CC:-cc}
@@@ end
@@@ {"head_lines": 5, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loongarch-indirect-record-return-qemu.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# LP64D large-record RESULT, not merely by-reference aggregate arguments.
# The original LoongArch ELF psABI says that an indirect result consumes $a0,
# shifts named GP parameters to $a1+, and RETURNS the buffer pointer in $a0.
# GNU-produced callers and callees are the independent binary ABI oracle.
cross_cc=${LOONGARCH64_CC:-loongarch64-linux-gnu-gcc-13}
cross_qemu=${QEMU_LOONGARCH64:-qemu-loongarch64}
mini_source="$root/tests/compiler/c0/aarch64_indirect_record_return_minic.c"
gnu_source="$root/tests/compiler/c0/aarch64_indirect_record_return_gnu.c"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fail() { printf '%s\n' "LOONGARCH64_SRET=FAIL $*" >&2; exit 1; }
contains() {
    if ! grep -Eq -- "$1" "$2"; then
        fail "assembly proof missing: $1"
    fi
}
reject() {
    local name=$1 source=$2
    if "$minic" --target=loongarch64-linux -S "$source" -o "$work/$name.s" \
         >"$work/$name.out" 2>"$work/$name.err"; then
        fail "unsafe aggregate ABI accepted: $name"
    fi
    test ! -e "$work/$name.s" || fail "partial output left: $name"
}

test -x "$minic" || fail "MiniC executable missing: $minic"
test -s "$mini_source" || fail 'missing C callee fixture'
test -s "$gnu_source" || fail 'missing GNU caller fixture'

"$host_cc" -E -P -std=gnu11 -x c "$mini_source" -o "$work/mini.i"
"$minic" --target=loongarch64-linux -S "$work/mini.i" -o "$work/mini.s" \
    || fail 'original MiniC large-result compilation'
test -s "$work/mini.s" || fail 'empty LP64D assembly'
for symbol in minic_three minic_four minic_eighteen minic_nested_three \
              minic_nested_eighteen minic_branch_three minic_ten_arguments \
              minic_nested_record minic_seventeen minic_sixty_four \
              minic_2048 minic_nested_2048 minic_dynamic_three \
              minic_roundtrip_eighteen minic_record_argument_and_result \
              minic_two_gnu_returns minic_direct_return_gnu_result minic_bits; do
    contains "^${symbol}:$" "$work/mini.s"
done

# Callee preserves hidden $a0; return must copy precisely the declared
# object extent, then leave the ORIGINAL destination in $a0. The selected
# MachineIR byte-copy loop uses T2=source, T1=destination, T3=count and
# target CFG block labels; these are physical instructions, not source ASM.
contains '^  st\.d \$a0, \$(sp|s0|t3),' "$work/mini.s"
contains '^  ld\.d \$a0, \$(sp|s0|t3),' "$work/mini.s"
contains '^  move \$t1, \$a0$' "$work/mini.s"
contains '^  ld\.bu \$t0, \$t2, 0$' "$work/mini.s"
contains '^  st\.b \$t0, \$t1, 0$' "$work/mini.s"
contains '^  bnez \$t0, \.Lminic_mir_[[:alnum:]_]+$' "$work/mini.s"
contains '^  li\.d \$t3, 17$' "$work/mini.s"
contains '^  li\.d \$t3, 24$' "$work/mini.s"
contains '^  li\.d \$t3, 32$' "$work/mini.s"
contains '^  li\.d \$t3, 40$' "$work/mini.s"
contains '^  li\.d \$t3, 64$' "$work/mini.s"
contains '^  li\.d \$t3, 144$' "$work/mini.s"
contains '^  li\.d \$t3, 2048$' "$work/mini.s"
contains '^  addi\.d \$a0, \$sp, [0-9]+$' "$work/mini.s"
contains '^  addi\.d \$a0, \$s0, [0-9]+$' "$work/mini.s"
contains '^  bl gnu_make_three$' "$work/mini.s"
contains '^  bl gnu_make_eighteen$' "$work/mini.s"
contains '^  bl gnu_tap$' "$work/mini.s"

# The same Core result_object and LoongArch hidden $a0 plan are now used for
# direct and indirect record-return calls. The old negative gate rejected
# working code and caused CI to fail even after successful -S emission.
printf '%s\n' \
  'struct Large { unsigned long words[3]; };' \
  'extern struct Large (*factory)(unsigned long);' \
  'struct Large call_factory(unsigned long x) { return factory(x); }' \
  >"$work/indirect.c"
"$host_cc" -E -P -x c "$work/indirect.c" -o "$work/indirect.i"
"$minic" --target=loongarch64-linux -S "$work/indirect.i" \
    -o "$work/indirect.s" || fail 'indirect callee aggregate result rejected'
contains '^call_factory:$' "$work/indirect.s"
contains '^  st\.d \$a0, \$(sp|s0|t3),' "$work/indirect.s"
contains '^  ld\.d \$a0, \$(sp|s0|t3),' "$work/indirect.s"
contains '^  jirl \$ra, \$t2, 0$' "$work/indirect.s"

# The bounded ABI copy is deliberately 17..2048 bytes. Never silently
# truncate a 2049-byte result, and never leave a partial .s on rejection.
printf '%s\n' \
  'struct TooLarge { unsigned char bytes[2049]; };' \
  'struct TooLarge too_large(void) {' \
  '  struct TooLarge v; v.bytes[0] = 1; v.bytes[2048] = 2; return v;' \
  '}' >"$work/too-large.c"
"$host_cc" -E -P -x c "$work/too-large.c" -o "$work/too-large.i"
reject too-large "$work/too-large.i"
printf '%s\n' 'LOONGARCH64_SRET_SOURCE=PASS hidden_a0=1 explicit_a1=1 dynamic_frame=1 sizes=17..2048 indirect_positive=1 overlimit_negative=1'

if ! command -v "$cross_cc" >/dev/null 2>&1 ||
   ! command -v "$cross_qemu" >/dev/null 2>&1; then
    if [[ ${MINIC_REQUIRE_LOONG_SRET:-0} == 1 ]]; then
        fail 'required LoongArch64 GNU GAS/QEMU toolchain absent'
    fi
    printf '%s\n' 'LOONGARCH64_SRET_RUNTIME=SKIP GNU cross tools/QEMU missing'
    exit 0
fi

# Use GNU target preprocessing for BOTH the reference and mixed ABI run.
"$cross_cc" -E -P -std=gnu11 -x c "$mini_source" -o "$work/target-mini.i"
"$minic" --target=loongarch64-linux -S "$work/target-mini.i" -o "$work/target-mini.s" \
    || fail 'LoongArch-target preprocessing/compilation'
"$cross_cc" -std=gnu11 -O2 -static "$mini_source" "$gnu_source" \
    -o "$work/gnu.elf" || fail 'GNU reference static link'
"$cross_cc" -std=gnu11 -O2 -c "$gnu_source" \
    -o "$work/gnu.o" || fail 'GNU caller/callee object'
"$cross_cc" -static -x assembler "$work/target-mini.s" -x none "$work/gnu.o" \
    -o "$work/mini.elf" || fail 'MiniC/GNU mixed static link'

set +e
timeout 45s "$cross_qemu" "$work/gnu.elf" >"$work/gnu.out" 2>"$work/gnu.err"
gnu_status=$?
timeout 45s "$cross_qemu" "$work/mini.elf" >"$work/mini.out" 2>"$work/mini.err"
mini_status=$?
set -e
if [[ $gnu_status -ne 42 || $mini_status -ne 42 ]]; then
    printf '%s\n' "GNU=$gnu_status MiniC=$mini_status" >&2
    sed -n '1,14p' "$work/gnu.err" >&2
    sed -n '1,14p' "$work/mini.err" >&2
    fail 'GNU/GNU and GNU/MiniC runtime ABI differ'
fi
cmp "$work/gnu.out" "$work/mini.out" || fail 'mixed stdout mismatch'
cmp "$work/gnu.err" "$work/mini.err" || fail 'mixed stderr mismatch'
printf '%s\n' 'LOONGARCH64_SRET_RUNTIME=PASS GNU_AS=1 GNU_static=2 QEMU=2 mixed_ABI=1 sizes=17,24,32,40,64,144,2048'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-loongarch64-record-chunk-native-word.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# LP64D whole machine-word record ingress/return must use exact-width native
# frame transport; GNU packed/partial tails still require byte transport.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$host_cc" -E -P -std=gnu11 -x c \
    "$root/tests/compiler/c0/loongarch64_record_chunk_native_word.c" \
    -o "$work/word.i"
"$minic" --target=loongarch64-linux -S "$work/word.i" -o "$work/word.s"

body() {
    awk -v symbol="$1" \
        '$0 == symbol ":" { inside=1; next }
         inside && /^\.size / { exit }
         inside { print }' "$work/word.s"
}
for symbol in loong_word_echo loong_pair_echo; do
    body "$symbol" | grep -Eq '^  st\.d \$t0, \$sp, [08]$'
    body "$symbol" | grep -Eq '^  ld\.d \$a[01], \$sp, [08]$'
    if body "$symbol" | grep -Eq '^  (st\.b|ld\.bu) '; then
        echo "LOONGARCH64_RECORD_CHUNK=FAIL unexpected_byte_transport=$symbol" >&2
        exit 1
    fi
done
# The frame-owned seven-byte argument tail is now addressed directly via
# SP, not a redundant copied T2 base. Keep exact byte index 6 and forbid
# any whole-word frame access in this partial-tail function below.
body loong_tail_echo | grep -Eq '^  st\.b \$t0, \$sp, 6$'
body loong_tail_echo | grep -Eq '^  ld\.bu \$t0, \$sp, 6$'
if body loong_tail_echo | grep -Eq '^  (st\.d|ld\.d) .*\$sp,'; then
    echo 'LOONGARCH64_RECORD_CHUNK=FAIL overread_or_overwrite_partial_tail' >&2
    exit 1
fi
echo 'LOONGARCH64_RECORD_CHUNK=PASS full_word=2 full_pair=2 partial_tail=7 source_assembly_only=1'
@@@ end
@@@ {"head_lines": 5, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-asm-goto-output-frontier.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# GCC supports GNU asm goto with output operands. MiniC's frontend must
# preserve this source fact even before target-specific usercopy exception
# table machine semantics have been implemented. Fail at Core, NOT by
# dropping the output or rejecting a valid source grammar production.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_ASM_GOTO_OUTPUT=FAIL $*" >&2; exit 1; }

cat >"$work/goto.c" <<'SRC'
int original_usercopy_read(const int *address) {
    int value = 0;
    __asm__ volatile goto(
        "1: movl %[memory],%[output]\n"
        ".pushsection __ex_table,\"a\"\n"
        ".balign 4\n"
        ".long (1b) - .\n"
        ".long (%l[fault]) - .\n"
        ".popsection\n"
        : [output] "=r"(value)
        : [memory] "m"(*address)
        :
        : fault);
    return value;
fault:
    return -1;
}
SRC
"$host_cc" -E -P -std=gnu11 -x c "$work/goto.c" -o "$work/goto.i"
"$host_cc" -std=gnu11 -c "$work/goto.c" -o "$work/gnu.o" \
    || fail 'GNU GCC does not accept reference asm goto form'
if "$minic" --target=x86_64-linux -S "$work/goto.i" \
       -o "$work/mini.s" >"$work/stdout" 2>"$work/stderr"; then
    fail 'unsupported exception-table asm goto emitted without Core semantics'
fi
test ! -e "$work/mini.s" || fail 'failed Core left partial x86 assembly'
grep -Eq "Core IR does not yet support function 'original_usercopy_read'" \
    "$work/stderr" || {
    sed -n '1,25p' "$work/stderr" >&2
    fail 'source grammar failed before typed Core refusal'
}
if grep -E 'GNU asm goto currently requires no outputs|parsed AST contract failed' \
      "$work/stderr"; then
    fail 'old invalid source-grammar/AST barrier still active'
fi
printf '%s\n' 'X86_ASM_GOTO_OUTPUT_SOURCE=PASS GNU_parse=1 outputs_preserved=1 labels_preserved=1 Core_fail_closed=1 GNU_exception_table=1'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-debug-register-implicit-volatile.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# GNU write-only extended ASM is implicitly volatile. Linux 6.6.143 DR0-DR7
# source admission must retain all twelve exact privileged x86 machine forms.
# These are assembly-only probes; never execute debug-register instructions.
fixture="$root/tests/target/x86_64_linux_debug_register_smoke.c"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_DEBUG_REGISTER_VOLATILE=FAIL $*" >&2; exit 1; }

"$host_cc" -std=gnu11 -c "$fixture" -o "$work/gcc.o" \
    || fail 'GNU GCC rejected reference twelve-form source'
"$host_cc" -std=gnu11 -E -P -x c "$fixture" -o "$work/positive.i"
"$minic" --target=x86_64-linux -S "$work/positive.i" \
    -o "$work/positive.s" >"$work/stdout" 2>"$work/stderr" \
    || { sed -n '1,15p' "$work/stderr" >&2; fail 'qualified GNU forms rejected'; }
as --64 "$work/positive.s" -o "$work/positive.o" \
    || fail 'GNU assembler rejected privileged instructions'
objdump -d "$work/positive.o" >"$work/objdump"
for reg in 0 1 2 3 6 7; do
    grep -Eq "mov[[:space:]]+%db${reg},%rax" "$work/objdump" \
        || fail "debug register ${reg} read missing"
    grep -Eq "mov[[:space:]]+%rax,%db${reg}" "$work/objdump" \
        || fail "debug register ${reg} write missing"
done

reject() {
    local label=$1
    local target=${2:-x86_64-linux}
    "$host_cc" -std=gnu11 -E -P -x c "$work/$label.c" -o "$work/$label.i"
    if "$minic" --target="$target" -S "$work/$label.i" \
            -o "$work/$label.s" >"$work/$label.stdout" 2>"$work/$label.stderr"; then
        fail "$label was admitted despite invalid target contract"
    fi
    test ! -e "$work/$label.s" || fail "$label emitted partial assembler"
}
sed 's/asm("mov %0, %%db0" :: "r"(v));/asm("mov %0, %%db4" :: "r"(v));/' \
    "$fixture" >"$work/invalid_dr.c"
reject invalid_dr
sed 's/asm("mov %0, %%db0" :: "r"(v));/asm("mov %0, %%db0" :: "r"(v) : "memory");/' \
    "$fixture" >"$work/unapproved_clobber.c"
reject unapproved_clobber
sed 's/asm("mov %%db0, %0" : "=r"(v));/asm volatile("mov %%db0, %0" : "=r"(v));/' \
    "$fixture" >"$work/invalid_read_volatile.c"
reject invalid_read_volatile
cp "$fixture" "$work/wrong_target.c"
reject wrong_target aarch64-linux

printf '%s\n' 'X86_DEBUG_REGISTER_VOLATILE=PASS GNU_as=1 forms=12 source_rejections=4'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-gen-endbr-machine.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# Linux 6.6.143 IBT gen_endbr: preserve source-qualified early-clobber u32,
# target physical output capture, and fail-closed template/constraint checks.
fixture="$root/tests/target/x86_64_linux_gen_endbr.c"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_LINUX_GEN_ENDBR=FAIL $*" >&2; exit 1; }

"$host_cc" -std=gnu11 -c "$fixture" -o "$work/gnu.o" \
    || fail 'GNU GCC rejects reference gen_endbr'
"$host_cc" -std=gnu11 -E -P -x c "$fixture" -o "$work/positive.i"
"$minic" --target=x86_64-linux -fcf-protection=branch \
    -S "$work/positive.i" -o "$work/positive.s" \
    >"$work/stdout" 2>"$work/stderr" \
    || { sed -n '1,15p' "$work/stderr" >&2; fail 'qualified target form rejected'; }
as --64 "$work/positive.s" -o "$work/positive.o" \
    || fail 'GNU assembler rejected gen_endbr'
objdump -d "$work/positive.o" >"$work/objdump"
grep -Eq 'mov[[:space:]]+\$0x5e1f00c,%eax' "$work/objdump" \
    || fail 'original complement immediate not materialized'
grep -Eq 'not[[:space:]]+%eax' "$work/objdump" \
    || fail 'original NOT not materialized'

reject() {
    local label=$1
    local target=${2:-x86_64-linux}
    "$host_cc" -std=gnu11 -E -P -x c "$work/$label.c" -o "$work/$label.i"
    if "$minic" --target="$target" -S "$work/$label.i" \
         -o "$work/$label.s" >"$work/$label.stdout" 2>"$work/$label.stderr"; then
        fail "$label admitted invalid GNU target form"
    fi
    test ! -e "$work/$label.s" || fail "$label left partial assembler"
}
sed 's/0xfa1e0ff3/0xfa1e0ff2/' "$fixture" >"$work/non_template.c"
reject non_template
sed 's/"=&r"(endbr)/"=r"(endbr)/' "$fixture" >"$work/non_early.c"
reject non_early
sed 's/"=&r"(endbr)/"=&r"(endbr) : : "cc"/' "$fixture" \
    >"$work/wrong_clobber.c"
reject wrong_clobber
cp "$fixture" "$work/wrong_target.c"
reject wrong_target aarch64-linux
printf '%s\n' 'X86_LINUX_GEN_ENDBR=PASS GNU_as=1 complement_not=1 negative_qualified=4'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-inline-native-save-fl.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# A GNU always-inline zero-arg wrapper may return one locally captured x86
# flags snapshot. Preserve narrow source-ASM ownership and fail closed for
# changes to the original local/return/template/clobber contract.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_LINUX_INLINE_SAVE_FL=FAIL $*" >&2; exit 1; }
fixture="$root/tests/target/x86_64_linux_save_flags_inline.c"

"$host_cc" -E -P -std=gnu11 -x c "$fixture" -o "$work/positive.i"
"$host_cc" -std=gnu11 -c "$fixture" -o "$work/gcc.o" \
    || fail 'GNU GCC rejected original contract'
"$minic" --target=x86_64-linux -S "$work/positive.i" -o "$work/positive.s" \
    >"$work/positive.stdout" 2>"$work/positive.stderr" \
    || { sed -n '1,30p' "$work/positive.stderr" >&2; fail 'qualified Core inline refused'; }
as --64 "$work/positive.s" -o "$work/positive.o" \
    || fail 'GNU assembler rejected emitted flags snapshot'
if nm -u "$work/positive.o" | grep -Eq 'native_save_fl|arch_local_save_flags'; then
    fail 'GNU extern inline emitted unresolved non-inline symbol'
fi
objdump -d "$work/positive.o" >"$work/positive.objdump"
grep -Eq '[[:space:]]pushf([[:space:]]|$)' "$work/positive.objdump" \
    || fail 'qualified flags snapshot missing pushf'
grep -Eq '[[:space:]]pop[[:space:]]' "$work/positive.objdump" \
    || fail 'qualified flags snapshot missing pop'

assert_rejected() {
    local label=$1
    "$host_cc" -E -P -std=gnu11 -x c "$work/$label.c" \
        -o "$work/$label.i" || fail "$label preprocessing failed"
    if "$minic" --target=x86_64-linux -S "$work/$label.i" \
            -o "$work/$label.s" >"$work/$label.stdout" 2>"$work/$label.stderr"; then
        fail "$label unexpectedly passed narrow source-ASM admission"
    fi
    test ! -e "$work/$label.s" \
        || fail "$label left partially emitted assembler after rejection"
    grep -Eq 'Core IR does not yet support|cannot select complete typed MachineIR' \
        "$work/$label.stderr" \
        || { sed -n '1,30p' "$work/$label.stderr" >&2; fail "$label failed before expected Core/target boundary"; }
}

sed 's/unsigned long flags;/unsigned long flags; unsigned long second;/' \
    "$fixture" >"$work/two_locals.c"
assert_rejected two_locals

sed 's/return flags;/return 42;/' "$fixture" >"$work/other_return.c"
assert_rejected other_return

sed 's/pushf ; pop %0/pushfq ; pop %0/' "$fixture" >"$work/non_template.c"
assert_rejected non_template

sed 's/"memory");/"cc");/' "$fixture" >"$work/wrong_clobber.c"
assert_rejected wrong_clobber

printf '%s\n' 'X86_LINUX_INLINE_SAVE_FL=PASS qualified_gnu_inline=1 GNU_as=1 source_rejection=4 unresolved_inline=0'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-loadsegment-extable.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# Linux loadsegment() is a finite five-form privileged target family. Preserve
# the original three-word ELF exception-table record and its two PC32 fixups.
# These selector writes are never executed in userspace.
fixture="$root/tests/target/x86_64_linux_segment_load_extable.c"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_LOADSEG_EXTABLE=FAIL $*" >&2; exit 1; }

"$host_cc" -std=gnu11 -c "$fixture" -o "$work/gnu.o" \
    || fail 'GNU GCC rejected original selector source'
"$host_cc" -std=gnu11 -E -P -x c "$fixture" -o "$work/positive.i"
"$minic" --target=x86_64-linux -S "$work/positive.i" -o "$work/positive.s" \
    >"$work/stdout" 2>"$work/stderr" \
    || { sed -n '1,15p' "$work/stderr" >&2; fail 'qualified source rejected'; }
as --64 "$work/positive.s" -o "$work/positive.o" \
    || fail 'GNU assembler rejected selector fixups'
objdump -d "$work/positive.o" >"$work/objdump"
for selector in fs gs ds es ss; do
    # objdump disassembles the segment-register MOV operand as `%eax` even
    # though GNU source and the physical machine binding are 16-bit `%ax`.
    grep -Eq "mov[[:space:]]+%eax,%${selector}" "$work/objdump" \
        || fail "missing 16-bit ${selector} hardware write"
done
readelf -Wr "$work/positive.o" >"$work/relocs"
grep -Eq "Relocation section '.rela__ex_table'.*10 entries" "$work/relocs" \
    || fail 'expected 5 records with 2 relocations each'
test "$(rg -c 'R_X86_64_PC32' "$work/relocs")" -eq 10 \
    || fail 'wrong exception table PC32 relocation count'
readelf -x __ex_table "$work/positive.o" >"$work/extable"
test "$(rg -o '05000000' "$work/extable" | wc -l)" -eq 5 \
    || fail 'missing five type-5 exception records'

reject() {
    local label=$1
    local target=${2:-x86_64-linux}
    "$host_cc" -std=gnu11 -E -P -x c "$work/$label.c" -o "$work/$label.i"
    if "$minic" --target="$target" -S "$work/$label.i" \
            -o "$work/$label.s" >"$work/$label.stdout" 2>"$work/$label.stderr"; then
        fail "$label invalid selector form was admitted"
    fi
    test ! -e "$work/$label.s" || fail "$label left partially emitted ASM"
}
sed 's/long 5/long 17/' "$fixture" >"$work/wrong_fixup.c"
reject wrong_fixup
sed 's/"rm"(selector)/"r"(selector)/' "$fixture" >"$work/wrong_constraint.c"
reject wrong_constraint
sed 's/"memory");/"cc");/' "$fixture" >"$work/wrong_clobber.c"
reject wrong_clobber
cp "$fixture" "$work/wrong_target.c"
reject wrong_target aarch64-linux
printf '%s\n' 'X86_LOADSEG_EXTABLE=PASS variants=5 GNU_as=1 R_X86_64_PC32=10 type5=5 rejects=4'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-msabi-record-abi.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# GNU Linux EFI function-pointer ABI is part of the TYPE, not a diagnostic
# attribute. Parsing declarations must not accidentally authorize SysV CALL.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() { printf '%s\n' "X86_MSABI_FIELD=FAIL $*" >&2; exit 1; }
preprocess() {
    "$host_cc" -E -P -std=gnu11 -x c "$work/$1.c" -o "$work/$1.i"
}
test -x "$minic" || fail 'MiniC compiler missing'

# Two function pointer fields share the same machine-size record slot but
# DIFFER in ABI type identity. An unrelated default SysV declaration of the
# same callback is not retroactively converted to MS x64.
cat >"$work/declarations.c" <<'SRC'
typedef unsigned long efi_status_t;
typedef efi_status_t efi_get_time_t(unsigned long, void *);
struct EfiServices {
    efi_get_time_t __attribute__((ms_abi)) *get_time;
    efi_get_time_t *sysv_time;
};
struct EFI32 { efi_get_time_t __attribute__((ms_abi)) *get_time; };
extern struct EfiServices firmware;
unsigned long table_bytes(void) { return sizeof(struct EfiServices); }
unsigned long plain_bytes(void) { return sizeof(struct EFI32); }
unsigned long get_sysv_slot(void) { return sizeof(firmware.sysv_time); }
SRC
preprocess declarations
"$host_cc" -std=gnu11 -Wall -Wextra -Werror -c "$work/declarations.c" \
    -o "$work/declarations-gnu.o" || fail 'GNU rejected reference fixture'
"$minic" --target=x86_64-linux -S "$work/declarations.i" \
    -o "$work/declarations.s" || fail 'MiniC rejected well-typed EFI table'
test -s "$work/declarations.s" || fail 'missing positive assembly'
"$host_cc" -c "$work/declarations.s" -o "$work/declarations-minic.o" \
    || fail 'GNU AS rejected target assembly'

# A parameter may put __attribute__((ms_abi)) BEFORE the pointer `*`, as in
# Linux EFI's efi_call_acpi_prm_handler declaration. Preserve its identity.
cat >"$work/parameter.c" <<'SRC'
typedef unsigned long efi_status_t;
efi_status_t efi_call_handler(
    efi_status_t (__attribute__((ms_abi)) *handler)(unsigned long, void *),
    unsigned long address, void *context);
unsigned long handler_size(void) { return sizeof(void *); }
SRC
preprocess parameter
"$host_cc" -std=gnu11 -Wall -Wextra -Werror -c "$work/parameter.c" \
    -o "$work/parameter-gnu.o" || fail 'GNU rejected parenthesized form'
"$minic" --target=x86_64-linux -S "$work/parameter.i" \
    -o "$work/parameter.s" || fail 'MiniC rejected parenthesized form'

# A supported fixed-scalar MS ABI function-pointer CALL now has a genuine
# Win64 register/stack plan (including the mandatory 32-byte home area).
cat >"$work/call.c" <<'SRC'
typedef long efi_callback_t(long, long);
struct Table { efi_callback_t __attribute__((ms_abi)) *callback; };
long ms_scalar_indirect_call(struct Table *tab) { return tab->callback(11, 22); }
SRC
preprocess call
"$host_cc" -std=gnu11 -Wall -Wextra -Werror -c "$work/call.c" \
    -o "$work/call-gnu.o" || fail 'GNU reference does not accept call form'
"$minic" --target=x86_64-linux -S "$work/call.i" -o "$work/call.s" ||
    fail 'MiniC rejected supported fixed-scalar indirect MS ABI call'
grep -F 'subq $32, %rsp' "$work/call.s" >/dev/null ||
    fail 'MS ABI indirect call omitted 32-byte shadow space'
grep -F 'call *%r11' "$work/call.s" >/dev/null ||
    fail 'MS ABI indirect call omitted target register'

cat >"$work/direct-declaration.c" <<'SRC'
extern __attribute__((ms_abi)) long efi_direct(long address);
long call_efi_direct(void) { return efi_direct(7); }
SRC
preprocess direct-declaration
"$minic" --target=x86_64-linux -S "$work/direct-declaration.i" \
    -o "$work/direct-declaration.s" ||
    fail 'MiniC rejected supported MS ABI direct call declaration'
grep -F 'subq $32, %rsp' "$work/direct-declaration.s" >/dev/null ||
    fail 'MS ABI direct call omitted 32-byte shadow space'

# MS ABI fixed-scalar definitions now have real Win64 ingress and callee
# nonvolatile preservation, not an implicit SysV function body.
cat >"$work/direct.c" <<'SRC'
__attribute__((ms_abi)) long efi_direct(long address) { return address + 1; }
long call_efi_direct(void) { return efi_direct(7); }
SRC
preprocess direct
"$host_cc" -std=gnu11 -Wall -Wextra -Werror -c "$work/direct.c" \
    -o "$work/direct-gnu.o" || fail 'GNU rejected direct MS ABI source'
"$minic" --target=x86_64-linux -S "$work/direct.i" -o "$work/direct.s" ||
    fail 'MiniC rejected supported scalar MS ABI definition'
grep -F 'movq %rcx, %rax' "$work/direct.s" >/dev/null ||
    fail 'MS ABI definition omitted RCX incoming argument'
grep -F 'movq %rdi,' "$work/direct.s" >/dev/null ||
    fail 'MS ABI definition omitted RDI nonvolatile save'
grep -F 'movdqu %xmm6,' "$work/direct.s" >/dev/null ||
    fail 'MS ABI definition omitted XMM6 nonvolatile save'

# A pure type declaration using the x86-only ABI attribute may not be
# treated as a portable pointer on LP64D/AAPCS64 (where it is meaningless).
preprocess declarations
for target in aarch64-linux loongarch64-linux; do
    if "$minic" --target="$target" -S "$work/declarations.i" \
        -o "$work/foreign-${target}.s" >"$work/foreign.out" 2>"$work/foreign.err"; then
        fail "ms_abi silently admitted by foreign target: $target"
    fi
    test ! -e "$work/foreign-${target}.s" || fail 'foreign partial output'
done

printf '%s\n' 'X86_MSABI_FIELD=PASS GNU_decl=2 MiniC_GNU_AS=2 typed_table=1 parenthesized_parameter=1 direct_call=1 indirect_call=1 definition_admit=1 foreign_target_reject=2'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/run-rv64i-linux-softarith-runtime.sh", "shared": "86116e320c29a792"}
#!/usr/bin/env bash
# The real Linux 2064-owner RV64I compiler emits the historical libgcc ABI.
# Link its untouched generated object against strictly I-only upstream GNU /
# LLVM software arithmetic providers, as the RV32I Linux Kbuild path does.
fixture="$root/tests/compiler/c0/riscv64i_freestanding_integer_ops.c"
builder="$root/tests/compiler/c0/build-rv64-gcc-runtime.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$host_cc" -std=gnu11 -O0 -Wall -Wextra "$fixture" -o "$work/host"
if "$work/host"; then rc=0; else rc=$?; fi
test "$rc" -eq 42 || {
    echo "RV64I_SOFTARITH=FAIL host_reference_rc=$rc expected=42" >&2
    exit 1
}
"$host_cc" -std=gnu11 -E -P -DRISCV_GUEST=1 -x c "$fixture" \
    -o "$work/original-gnu.i"
"$minic" --target=riscv64-linux -march=rv64i -mabi=lp64 \
    -S "$work/original-gnu.i" -o "$work/minic-rv64i.s"
test -s "$work/minic-rv64i.s"
for symbol in __muldi3 __udivdi3 __umoddi3 __divdi3 __moddi3 __multi3; do
    grep -Fq "call $symbol" "$work/minic-rv64i.s" || {
        echo "RV64I_SOFTARITH=FAIL historical_abi_missing=$symbol" >&2
        exit 2
    }
done

if [[ ${MINIC_RV64_SOFTARITH_SOURCE_ONLY:-0} == 1 ]]; then
    echo 'RV64I_SOFTARITH_SOURCE=PASS original_GNU_i=1 MiniC_S=1 hosted_libgcc_ABI=6 host_runtime=42'
    exit 0
fi

for tool in riscv64-linux-gnu-gcc riscv64-linux-gnu-as \
            riscv64-linux-gnu-ld riscv64-linux-gnu-ar \
            riscv64-linux-gnu-nm riscv64-linux-gnu-readelf \
            riscv64-linux-gnu-objdump qemu-riscv64; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "RV64I_SOFTARITH=FAIL missing_required_tool=$tool" >&2
        exit 3
    }
done
test -f "$builder" || {
    echo "RV64I_SOFTARITH=FAIL missing_upstream_builder=$builder" >&2
    exit 4
}
mkdir -p "$work/runtime"
if ! bash "$builder" "$work/runtime" >"$work/runtime-build.log" 2>&1; then
    echo 'RV64I_SOFTARITH=FAIL original_GNU_LLVM_runtime_build' >&2
    tail -n 70 "$work/runtime-build.log" >&2
    exit 5
fi
mapfile -t objects <"$work/runtime/rv64-runtime-objects.rsp"
test "${#objects[@]}" -ge 3 || {
    echo 'RV64I_SOFTARITH=FAIL empty_provider_object_set' >&2
    exit 6
}
for obj in "${objects[@]}"; do
    test -s "$obj"
    riscv64-linux-gnu-readelf -h "$obj" | grep -Eq 'Class:[[:space:]]+ELF64'
    riscv64-linux-gnu-readelf -h "$obj" | grep -Eq 'Machine:[[:space:]]+RISC-V'
    riscv64-linux-gnu-readelf -A "$obj" | grep -Eq 'Tag_RISCV_arch:.*rv64i'
done
# ELF e_flags must advertise LP64 soft-float with neither C nor floating
# register ABI: no 16-bit/compressed instructions can hide in this archive.
python3 - "${objects[@]}" <<'PY'
import pathlib, struct, sys
for name in sys.argv[1:]:
    data = pathlib.Path(name).read_bytes()
    if (data[:6] != b'\x7fELF\x02\x01' or
            struct.unpack_from('<H', data, 18)[0] != 243):
        raise SystemExit('RV64I_SOFTARITH=FAIL non_ELF64_little_RISCV ' + name)
    flags = struct.unpack_from('<I', data, 48)[0]
    if flags & 0x7:
        raise SystemExit(f'RV64I_SOFTARITH=FAIL ISA_or_LP64_ABI_flags {name} {flags:#x}')
PY
# Link with the *same archive* created by the established runtime-rv64i
# Makefile target. This must not turn into a second hand-maintained provider.
runtime_archive="$work/runtime/build/runtime/riscv64/rv64i-lp64/libminic-rt.a"
test -s "$runtime_archive"
riscv64-linux-gnu-nm -g --defined-only "$runtime_archive" > "$work/symbols.txt"
for symbol in __muldi3 __udivdi3 __umoddi3 __divdi3 __moddi3 __multi3; do
    grep -Eq "[[:space:]]${symbol}$" "$work/symbols.txt" || {
        echo "RV64I_SOFTARITH=FAIL missing_provider=$symbol" >&2
        exit 7
    }
done
# M arithmetic is forbidden even inside the external runtime archive.
riscv64-linux-gnu-objdump -d "$runtime_archive" > "$work/runtime.dis"
if grep -Eq '^[[:space:]]*[[:xdigit:]]+:[[:space:]]+[[:xdigit:]]+[[:space:]]+(mul|mulw|mulh|mulhu|mulhsu|div|divu|divw|divuw|rem|remu|remw|remuw)[[:space:]]' "$work/runtime.dis"; then
    echo 'RV64I_SOFTARITH=FAIL M_extension_instruction_in_runtime' >&2
    exit 8
fi

riscv64-linux-gnu-as -march=rv64i -mabi=lp64 \
    "$work/minic-rv64i.s" -o "$work/minic-rv64i.o"
riscv64-linux-gnu-ld -m elf64lriscv --no-relax -static -e _start \
    -o "$work/guest.elf" "$work/minic-rv64i.o" "$runtime_archive"
python3 - "$work/guest.elf" <<'PY'
import pathlib, struct, sys
data = pathlib.Path(sys.argv[1]).read_bytes()
if (data[:6] != b'\x7fELF\x02\x01' or
        struct.unpack_from('<H', data, 18)[0] != 243 or
        struct.unpack_from('<I', data, 48)[0] & 0x7):
    raise SystemExit('RV64I_SOFTARITH=FAIL linked_ELF64_RV64I_LP64_ABI')
PY
if riscv64-linux-gnu-nm -u "$work/guest.elf" | grep -q .; then
    echo 'RV64I_SOFTARITH=FAIL unresolved_GNU_link_symbols' >&2
    riscv64-linux-gnu-nm -u "$work/guest.elf" >&2
    exit 9
fi
if timeout 30s qemu-riscv64 "$work/guest.elf"; then rc=0; else rc=$?; fi
test "$rc" -eq 42 || {
    echo "RV64I_SOFTARITH=FAIL original_MiniC_GNU_LD_QEMU_exit=$rc expected=42" >&2
    exit 10
}
echo "RV64I_SOFTARITH_RUNTIME=PASS providers=GNU_libgcc_14.2.0,LLVM_compiler_rt_19.1.7 archive_objects=${#objects[@]} ISA=rv64i ABI=lp64 helper_ABI=6 GNU_LD=PASS QEMU=42 extra_linux_C_owners=0"
@@@ end
