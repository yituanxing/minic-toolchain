@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_const_pointer_member_assignment.c"}
struct Box {
    int value;
};

int write_box(const struct Box *box)
{
    box->value = 3;
    return 0;
}

int main(void)
{
    struct Box box;

    return write_box(&box);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/invalid_const_pointer_parameter_reassignment.c"}
int replace(int * const value, int *replacement)
{
    value = replacement;
    return 0;
}

int main(void)
{
    int first;
    int second;

    return replace(&first, &second);
}
@@@ end
