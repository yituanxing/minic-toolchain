@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/void_cast_discard.c"}
static int counter;

static int bump(void) {
    counter += 1;
    return counter;
}

int main(void) {
    (void)0;
    (void)bump();
    return counter == 1 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/void_pointer_local.c"}
static int is_null(void *pointer) {
    return pointer == (void *)0;
}

int main(void) {
    void *pointer = (void *)0;
    const void *constant_pointer = pointer;
    return is_null(pointer) && constant_pointer == (void *)0 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/void_typedef.c"}
