@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_integer_aggregate_return.c"}
struct pair64 {
    long first;
    long second;
};

static struct pair64 add_pair(struct pair64 lhs, struct pair64 rhs) {
    struct pair64 result;

    result.first = lhs.first + rhs.first;
    result.second = lhs.second + rhs.second;
    return result;
}

static struct pair64 forward_pair(struct pair64 lhs, struct pair64 rhs) {
    return add_pair(lhs, rhs);
}

int main(void) {
    return 0;
}

struct triple64 {
    long first;
    long second;
    long third;
};

static struct triple64 make_triple(long base) {
    struct triple64 result;

    result.first = base;
    result.second = base + 1;
    result.third = base + 2;
    return result;
}

static struct triple64 forward_triple(long base) {
    return make_triple(base);
}

static void cleanup_triple(struct triple64 *value) {
    value->third += 1;
}

static long cleanup_triple_call(long base) {
    struct triple64 value __attribute__((cleanup(cleanup_triple))) = make_triple(base);

    return value.first + value.second + value.third;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_lp64_softfloat_record_call.c"}
/* LP64 base integer psABI: even records with FP leaves travel through the
 * integer aggregate ABI. Both direct and SSA-pointer calls return records
 * in a0/a1, while LP64D must reject until FP-record flattening exists. */
typedef struct OneFloat { float f; } OneFloat;
typedef struct OneDouble { double d; } OneDouble;

__attribute__((noinline)) OneFloat echo_float(OneFloat value) {
    return value;
}
__attribute__((noinline)) OneDouble echo_double(OneDouble value) {
    return value;
}

OneFloat direct_float(OneFloat value) {
    return echo_float(value);
}
OneDouble direct_double(OneDouble value) {
    return echo_double(value);
}
OneFloat indirect_float(OneFloat value, OneFloat (*callee)(OneFloat)) {
    return callee(value);
}
OneDouble indirect_double(OneDouble value, OneDouble (*callee)(OneDouble)) {
    return callee(value);
}

int main(void) {
    OneFloat f = {3.25f};
    OneDouble d = {6.5};
    OneFloat x = direct_float(f);
    OneDouble y = direct_double(d);
    OneFloat z = indirect_float(x, echo_float);
    OneDouble w = indirect_double(y, echo_double);
    const unsigned char *expected_float = (const unsigned char *)&f;
    const unsigned char *expected_double = (const unsigned char *)&d;
    const unsigned char *direct_float_bytes = (const unsigned char *)&x;
    const unsigned char *direct_double_bytes = (const unsigned char *)&y;
    const unsigned char *indirect_float_bytes = (const unsigned char *)&z;
    const unsigned char *indirect_double_bytes = (const unsigned char *)&w;
    unsigned long i;
    /* Byte-wise validation uses only RV64I integer instructions, so strict
     * -march=rv64i need not synthesize unsupported FP comparison opcodes. */
    for (i = 0UL; i < sizeof(f); ++i)
        if (expected_float[i] != direct_float_bytes[i] ||
            expected_float[i] != indirect_float_bytes[i]) return 1;
    for (i = 0UL; i < sizeof(d); ++i)
        if (expected_double[i] != direct_double_bytes[i] ||
            expected_double[i] != indirect_double_bytes[i]) return 2;
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_packed_wide_alignment.c"}
/* Target-independent Core LOAD/STORE may point at misaligned 16-byte
 * int128/long-double members.  RV64 must split into guarded 8-byte words
 * with bytewise fallback, not assume the physical member's type alignment. */
struct __attribute__((packed)) PackedWide {
    char lead;
    __int128 value;
    long double fp;
};

__int128 packed_wide_read(const struct PackedWide *p) { return p->value; }
void packed_wide_write(struct PackedWide *p, __int128 x) { p->value = x; }
long double packed_long_double_read(const struct PackedWide *p) { return p->fp; }
void packed_long_double_write(struct PackedWide *p, long double x) { p->fp = x; }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_record_load_irregular.c"}
/* The RV64 Core RECORD_LOAD fallback must copy every byte of a record.
 * Sizes 3/5/6/7 previously loaded only the first byte into a wider slot. */
struct three { unsigned char b[3]; };
struct five { unsigned char b[5]; };
struct six { unsigned char b[6]; };
struct seven { unsigned char b[7]; };
struct nine { unsigned char b[9]; };
struct fifteen { unsigned char b[15]; };

struct three load_three(const struct three *p) { return *p; }
struct five load_five(const struct five *p) { return *p; }
struct six load_six(const struct six *p) { return *p; }
struct seven load_seven(const struct seven *p) { return *p; }
struct nine load_nine(const struct nine *p) { return *p; }
struct fifteen load_fifteen(const struct fifteen *p) { return *p; }
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_record_load_packed.c"}
/* RECORD_LOAD must preserve each byte of a packed record even when its
 * nominal size matches a native word-width load/store.  The GCC packed
 * attribute makes each record align to one byte; a caller may pass an odd
 * address without violating that C type's alignment contract. */
struct __attribute__((packed)) packed_two { unsigned char data[2]; };
struct __attribute__((packed)) packed_four { unsigned char data[4]; };
struct __attribute__((packed)) packed_eight { unsigned char data[8]; };

_Static_assert(_Alignof(struct packed_two) == 1, "packed_two alignment");
_Static_assert(_Alignof(struct packed_four) == 1, "packed_four alignment");
_Static_assert(_Alignof(struct packed_eight) == 1, "packed_eight alignment");

struct packed_two load_packed_two(const struct packed_two *p) { return *p; }
struct packed_four load_packed_four(const struct packed_four *p) { return *p; }
struct packed_eight load_packed_eight(const struct packed_eight *p) { return *p; }

/* Exercise a load with an extra addressable one-byte local. The frame
 * planner, not source declaration order, chooses the snapshot offset. */
struct packed_four load_packed_four_with_local(const struct packed_four *p) {
    volatile unsigned char guard = p->data[0];
    (void)guard;
    return *p;
}

/* Natural aligned records use the same fallback because the Core load pointer
 * currently has no transferable proof of its actual runtime alignment. */
struct natural_two { unsigned short value; };
struct natural_four { unsigned int value; };
struct natural_eight { unsigned long long value; };

struct natural_two load_natural_two(const struct natural_two *p) { return *p; }
struct natural_four load_natural_four(const struct natural_four *p) { return *p; }
struct natural_eight load_natural_eight(const struct natural_eight *p) { return *p; }

/* The member's type is naturally four-aligned, but its address is not:
 * the containing packed record places it at byte offset one. */
struct __attribute__((packed)) packed_outer_four {
    unsigned char prefix;
    struct natural_four member;
};
struct natural_four load_natural_field_packed(const struct packed_outer_four *p) {
    return p->member;
}

/* The first one-byte by-value parameter may place the second packed record
 * at an odd frame offset. This exercises incoming register scatter, outgoing
 * register gather and return-value aggregate marshalling. */
struct packed_one { unsigned char data[1]; } __attribute__((packed));
struct packed_two mix_after_one_two(struct packed_one first, struct packed_two value) {
    value.data[0] = first.data[0];
    return value;
}
struct packed_four mix_after_one_four(struct packed_one first, struct packed_four value) {
    value.data[0] = first.data[0];
    return value;
}
struct packed_eight mix_after_one_eight(struct packed_one first, struct packed_eight value) {
    value.data[0] = first.data[0];
    return value;
}

struct packed_four call_after_one_four(struct packed_one first, struct packed_four value) {
    return mix_after_one_four(first, value);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_union_fp_abi_consumer.c"}
/* MC-059: independent consumer TU. Exit 42 means all ABI checks passed. */
union U64 { double d; unsigned long long bits; };
union OnlyFP { double d; };
struct Nested { unsigned long long tag; union U64 data; };
struct Array { union U64 items[2]; };

extern union U64 abi_echo(union U64);
extern unsigned long long abi_bits(union U64);
extern struct Nested abi_nested(struct Nested);
extern struct Array abi_array(struct Array);
extern union OnlyFP abi_only_fp(union OnlyFP);
extern double abi_scalar(double);

int main(void) {
    union U64 u;
    struct Nested n;
    struct Array a;
    union OnlyFP fp;
    u.bits = 0x123456789abcdef0ULL;
    if (abi_echo(u).bits != u.bits) return 1;
    if (abi_bits(u) != u.bits) return 2;
    n.tag = 0x1020304050607080ULL;
    n.data.bits = 0xfedcba9876543210ULL;
    n = abi_nested(n);
    if (n.tag != 0x1020304050607080ULL ||
        n.data.bits != 0xfedcba9876543210ULL) return 3;
    a.items[0].bits = 0x1122334455667788ULL;
    a.items[1].bits = 0x8877665544332211ULL;
    a = abi_array(a);
    if (a.items[0].bits != 0x1122334455667788ULL ||
        a.items[1].bits != 0x8877665544332211ULL) return 4;
    fp.d = 6.5;
    if (abi_only_fp(fp).d != 6.5) return 5;
    if (abi_scalar(1.25) != 3.25) return 6;
    return 42;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_union_fp_abi_provider.c"}
/* MC-059: independent producer TU for GNU/MiniC ABI interoperability. */
union U64 { double d; unsigned long long bits; };
union OnlyFP { double d; };
struct Nested { unsigned long long tag; union U64 data; };
struct Array { union U64 items[2]; };

union U64 abi_echo(union U64 x) { return x; }
unsigned long long abi_bits(union U64 x) { return x.bits; }
struct Nested abi_nested(struct Nested x) { return x; }
struct Array abi_array(struct Array x) { return x; }
union OnlyFP abi_only_fp(union OnlyFP x) { return x; }
double abi_scalar(double x) { return x + 2.0; }
@@@ end
