@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-rv64-coretype-abi.c"}
#include "core/core_type.h"
#include "target/riscv64/abi.h"

#include <stdio.h>
#include <string.h>

#define CHECK(c) do { \
    if (!(c)) { \
        (void)fprintf(stderr, "RV64_CORETYPE_ABI=FAIL line=%d expr=%s\n", \
                      __LINE__, #c); \
        return 1; \
    } \
} while (0)

static bool register_integer(MinicCoreTypeContext *types, unsigned int bits,
                             MinicCoreTypeId *id) {
    MinicCoreType type = {0};
    type.kind = MINIC_CORE_TYPE_INTEGER;
    type.has_layout = true;
    type.size = bits / 8U;
    type.alignment = bits == 128U ? 16U : type.size;
    type.value.integer.bit_width = bits;
    type.value.integer.is_signed = true;
    return minic_core_type_register(types, &type, id);
}

static bool register_float(MinicCoreTypeContext *types,
                           MinicCoreFloatFormat format, size_t size,
                           MinicCoreTypeId *id) {
    MinicCoreType type = {0};
    type.kind = MINIC_CORE_TYPE_FLOAT;
    type.has_layout = true;
    type.size = size;
    type.alignment = size;
    type.value.floating.format = format;
    return minic_core_type_register(types, &type, id);
}

static bool register_record(MinicCoreTypeContext *types, MinicCoreTypeId field_type,
                            size_t size, bool is_union, MinicCoreTypeId *id) {
    MinicCoreRecordField field = {0};
    MinicCoreType type = {0};
    field.type_id = field_type;
    field.alignment = 8U;
    type.kind = MINIC_CORE_TYPE_RECORD;
    type.has_layout = true;
    type.size = size;
    type.alignment = 8U;
    type.value.record.is_complete = true;
    type.value.record.is_union = is_union;
    type.value.record.fields = &field;
    type.value.record.field_count = 1U;
    return minic_core_type_register(types, &type, id);
}

int main(void) {
    MinicCoreTypeContext types;
    MinicCoreTypeId i32, i64, i128, f64, ext, fp_record, fp_union, big_record;
    MinicRiscv64AbiValue value;
    MinicRiscv64AbiCursor cursor;
    MinicRiscv64AbiArgumentLocation location;
    MinicCoreType type = {0};
    MinicCoreTypeId pointer;

    minic_core_type_context_initialize(&types);
    CHECK(register_integer(&types, 32U, &i32));
    CHECK(register_integer(&types, 64U, &i64));
    CHECK(register_integer(&types, 128U, &i128));
    CHECK(register_float(&types, MINIC_CORE_FLOAT_BINARY64, 8U, &f64));
    CHECK(register_float(&types, MINIC_CORE_FLOAT_BINARY128, 16U, &ext));
    CHECK(register_record(&types, f64, 16U, false, &fp_record));
    CHECK(register_record(&types, f64, 16U, true, &fp_union));
    CHECK(register_record(&types, i64, 24U, false, &big_record));

    type.kind = MINIC_CORE_TYPE_POINTER;
    type.has_layout = true;
    type.size = 8U;
    type.alignment = 8U;
    type.value.pointer.pointee = big_record;
    CHECK(minic_core_type_register(&types, &type, &pointer));

    CHECK(minic_riscv64_abi_classify_core_value_profile(&types, i32, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_INTEGER &&
          value.storage_size == 4U && value.slot_count == 1U);
    CHECK(minic_riscv64_abi_classify_core_value_profile(&types, pointer, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_INTEGER);
    CHECK(minic_riscv64_abi_classify_core_value_profile(&types, f64, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_FLOAT && value.slot_count == 1U);
    CHECK(minic_riscv64_abi_classify_core_value_profile(&types, i128, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_WIDE_SCALAR && value.slot_count == 2U);
    CHECK(minic_riscv64_abi_classify_core_value_profile(&types, ext, true, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_WIDE_SCALAR);

    /* ABI reject: real FP struct needs unimplemented FPR flattening. A
     * union containing the same FP member takes integer convention. */
    CHECK(!minic_riscv64_abi_classify_core_value_profile(
        &types, fp_record, false, &value));
    CHECK(minic_riscv64_abi_classify_core_value_profile(
        &types, fp_record, true, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_AGGREGATE && value.slot_count == 2U);
    CHECK(minic_riscv64_abi_classify_core_value_profile(
        &types, fp_union, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_AGGREGATE && value.slot_count == 2U);
    CHECK(minic_riscv64_abi_classify_core_value_profile(
        &types, big_record, false, &value));
    CHECK(value.kind == MINIC_RISCV64_ABI_VALUE_INDIRECT && value.storage_size == 24U);
    CHECK(!minic_riscv64_abi_classify_core_value_profile(
        &types, MINIC_CORE_TYPE_INVALID, false, &value));

    CHECK(minic_riscv64_abi_cursor_initialize_for_core_return_profile(
        &types, big_record, false, &cursor, &value));
    CHECK(cursor.integer_register_count == 1U &&
          value.kind == MINIC_RISCV64_ABI_VALUE_INDIRECT);
    CHECK(minic_riscv64_abi_place_core_argument(
        &types, i64, true, &cursor, &location));
    CHECK(location.integer_register_begin == 1U &&
          location.integer_register_count == 1U);

    minic_riscv64_abi_cursor_initialize(&cursor);
    cursor.integer_register_count = 1U;
    CHECK(minic_riscv64_abi_place_core_argument(
        &types, i128, false, &cursor, &location));
    CHECK(location.integer_register_begin == 2U &&
          location.integer_register_count == 2U &&
          cursor.integer_register_count == 4U);
    minic_riscv64_abi_cursor_initialize(&cursor);
    CHECK(minic_riscv64_abi_place_core_argument(
        &types, f64, true, &cursor, &location));
    CHECK(location.floating_register_begin == 0U &&
          location.floating_register_count == 1U);
    minic_riscv64_abi_cursor_initialize(&cursor);
    cursor.lp64_soft_float = true;
    CHECK(minic_riscv64_abi_place_core_argument(
        &types, f64, true, &cursor, &location));
    CHECK(location.integer_register_count == 1U &&
          location.floating_register_count == 0U);

    /* Invalid contexts/types never fall back to C DataLayout. */
    CHECK(!minic_riscv64_abi_place_core_argument(
        &types, MINIC_CORE_TYPE_INVALID, true, &cursor, &location));
    minic_core_type_context_destroy(&types);
    (void)puts("RV64_CORETYPE_ABI=PASS LP64 LP64D union_fp_reject wide_pair hidden_result");
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_checked_overflow_math_oracle.c"}
/* Independent GNU-native arithmetic oracle for the RISC-V LP64 typed
 * checked-overflow selector. This validates the exact selected predicates,
 * modulo result and separate stored-value/SSA-boolean semantics over all
 * four 32/64-bit signednesses. It does NOT replace GNU RV64 ELF/QEMU tests. */
#include <inttypes.h>
#include <limits.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>

static uint64_t seed = UINT64_C(0x9e3779b97f4a7c15);
static uint64_t random_word(void) {
    seed ^= seed << 13;
    seed ^= seed >> 7;
    seed ^= seed << 17;
    return seed;
}

static bool check_signed32(int32_t a, int32_t b) {
    int32_t actual;
    int64_t wide;
    bool flag;

    wide = (int64_t)a + (int64_t)b;
    flag = __builtin_add_overflow(a, b, &actual);
    if (actual != (int32_t)wide || flag !=
        (wide != (int64_t)(int32_t)wide)) return false;
    wide = (int64_t)a - (int64_t)b;
    flag = __builtin_sub_overflow(a, b, &actual);
    if (actual != (int32_t)wide || flag !=
        (wide != (int64_t)(int32_t)wide)) return false;
    wide = (int64_t)a * (int64_t)b;
    flag = __builtin_mul_overflow(a, b, &actual);
    return actual == (int32_t)wide && flag ==
        (wide != (int64_t)(int32_t)wide);
}

static bool check_unsigned32(uint32_t a, uint32_t b) {
    uint32_t actual;
    uint64_t wide;
    bool flag;

    wide = (uint64_t)a + (uint64_t)b;
    flag = __builtin_add_overflow(a, b, &actual);
    if (actual != (uint32_t)wide || flag != (wide > UINT32_MAX))
        return false;
    flag = __builtin_sub_overflow(a, b, &actual);
    if (actual != a - b || flag != (a < b)) return false;
    wide = (uint64_t)a * (uint64_t)b;
    flag = __builtin_mul_overflow(a, b, &actual);
    return actual == (uint32_t)wide && flag == (wide > UINT32_MAX);
}

static bool check_signed64(int64_t a, int64_t b) {
    const uint64_t lhs = (uint64_t)a, rhs = (uint64_t)b;
    const uint64_t add = lhs + rhs, sub = lhs - rhs;
    const uint64_t low_product =
        (uint64_t)((unsigned __int128)lhs * (unsigned __int128)rhs);
    const __int128 full_product = (__int128)a * (__int128)b;
    int64_t actual;
    bool flag, predicted;

    predicted = ((~(lhs ^ rhs) & (lhs ^ add)) >> 63) != 0U;
    flag = __builtin_add_overflow(a, b, &actual);
    if ((uint64_t)actual != add || flag != predicted) return false;
    predicted = (((lhs ^ rhs) & (lhs ^ sub)) >> 63) != 0U;
    flag = __builtin_sub_overflow(a, b, &actual);
    if ((uint64_t)actual != sub || flag != predicted) return false;
    /* Multiplication first writes the low product, then checks the inverse
     * division when b!=0, with the INT64_MIN/-1 exceptional pair admitted. */
    predicted = b != 0 && ((a == INT64_MIN && b == -1) ||
        ((int64_t)low_product / b != a));
    flag = __builtin_mul_overflow(a, b, &actual);
    return (uint64_t)actual == low_product && flag == predicted &&
        flag == (full_product > INT64_MAX || full_product < INT64_MIN);
}

static bool check_unsigned64(uint64_t a, uint64_t b) {
    const uint64_t add = a + b, sub = a - b;
    const unsigned __int128 full_product =
        (unsigned __int128)a * (unsigned __int128)b;
    const uint64_t low_product = (uint64_t)full_product;
    uint64_t actual;
    bool flag;

    flag = __builtin_add_overflow(a, b, &actual);
    if (actual != add || flag != (add < a)) return false;
    flag = __builtin_sub_overflow(a, b, &actual);
    if (actual != sub || flag != (a < b)) return false;
    flag = __builtin_mul_overflow(a, b, &actual);
    return actual == low_product && flag ==
        (b != 0U && low_product / b != a) &&
        flag == (full_product > UINT64_MAX);
}

int main(void) {
    static const uint64_t edges[] = {
        UINT64_C(0), UINT64_C(1), UINT64_C(2), UINT64_C(3),
        UINT64_C(0x7fffffff), UINT64_C(0x80000000),
        UINT64_C(0xffffffff), UINT64_C(0x100000000),
        UINT64_C(0x7fffffffffffffff), UINT64_C(0x8000000000000000),
        UINT64_C(0xffffffff00000000), UINT64_MAX
    };
    size_t i, j, checked = 0U;
    for (i = 0U; i < sizeof(edges) / sizeof(edges[0]) + 10000U; ++i) {
        const uint64_t a = i < sizeof(edges) / sizeof(edges[0]) ?
            edges[i] : random_word();
        for (j = 0U; j < sizeof(edges) / sizeof(edges[0]) + 12U; ++j) {
            const uint64_t b = j < sizeof(edges) / sizeof(edges[0]) ?
                edges[j] : random_word();
            if (!check_signed32((int32_t)a, (int32_t)b) ||
                !check_unsigned32((uint32_t)a, (uint32_t)b) ||
                !check_signed64((int64_t)a, (int64_t)b) ||
                !check_unsigned64(a, b)) {
                fprintf(stderr, "RV64_CHECKED_MATH=FAIL a=%" PRIx64
                    " b=%" PRIx64 "\n", a, b);
                return 1;
            }
            checked += 4U;
        }
    }
    printf("RV64_CHECKED_MATH=PASS combinations=%zu 32_64=1 signed_unsigned=1 add_sub_mul=1\n",
           checked);
    return 0;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_global_plan_abi.c"}
/* Target-independent C oracle for RV64 GlobalEmissionPlan migration.
 * Keep each definition externally visible to ELF inspection even if a
 * compiler proves the runtime checks at compile time. */
int rv64_plan_anchor = 37;
static __attribute__((used)) unsigned char rv64_plan_byte = 255;
static __attribute__((used)) float rv64_plan_float = 1.25f;
static __attribute__((used)) double rv64_plan_double = -2.5;
static __attribute__((used)) int *rv64_plan_pointer = &rv64_plan_anchor;
static __attribute__((used)) int rv64_plan_zero_tail[5] = {11, 13};
static __attribute__((used)) int rv64_plan_tentative[4];

__attribute__((used, section(".bss.minic.rv64.plan"))) int rv64_plan_named_bss;
__attribute__((used, section(".bssish.minic.rv64.plan"))) int rv64_plan_named_data;

static int rv64_plan_add(int value) { return value + 5; }
struct Rv64PlanNested {
    int *pointer;
    int (*call)(int);
    double fraction;
};
struct Rv64PlanOuter {
    struct Rv64PlanNested nested;
    const char *name;
};
static __attribute__((used)) struct Rv64PlanOuter rv64_plan_nested = {
    {&rv64_plan_anchor, rv64_plan_add, 2.25}, "nested"
};

static __attribute__((used)) const char *rv64_plan_pointer_grid[2][2] = {
    {"first", "second"}, {"third", 0}
};

struct Rv64PlanFlexible {
    const char *name;
    int values[];
};
static __attribute__((used)) struct Rv64PlanFlexible rv64_plan_flexible = {
    "flexible", {11, 13, 17}
};

struct Rv64PlanBitfield {
    unsigned int low : 6;
    unsigned int high : 10;
    unsigned short marker;
};
static __attribute__((used)) struct Rv64PlanBitfield rv64_plan_bitfield = {
    37, 777, 0x1234
};

int main(void) {
    return rv64_plan_anchor == 37 && rv64_plan_byte == 255 &&
        rv64_plan_float == 1.25f && rv64_plan_double == -2.5 &&
        rv64_plan_pointer == &rv64_plan_anchor &&
        rv64_plan_zero_tail[0] == 11 && rv64_plan_zero_tail[1] == 13 &&
        rv64_plan_zero_tail[4] == 0 && rv64_plan_tentative[3] == 0 &&
        rv64_plan_named_bss == 0 && rv64_plan_named_data == 0 &&
        rv64_plan_nested.nested.pointer == &rv64_plan_anchor &&
        rv64_plan_nested.nested.call(5) == 10 &&
        rv64_plan_nested.nested.fraction == 2.25 &&
        rv64_plan_nested.name[0] == 'n' &&
        rv64_plan_pointer_grid[0][0][0] == 'f' &&
        rv64_plan_pointer_grid[1][0][0] == 't' &&
        rv64_plan_pointer_grid[1][1] == 0 &&
        rv64_plan_flexible.name[0] == 'f' &&
        rv64_plan_flexible.values[0] == 11 &&
        rv64_plan_flexible.values[2] == 17 &&
        rv64_plan_bitfield.low == 37 &&
        rv64_plan_bitfield.high == 777 &&
        rv64_plan_bitfield.marker == 0x1234 ? 42 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv64_hardfloat_ninth_fixed.c"}
/* RV64 LP64D: fa0..fa7 contain only the first eight named FP arguments.
 * A ninth named FP argument is passed in the first available integer
 * register, NOT rejected or silently placed onto the stack. */
double ninth(double a0, double a1, double a2, double a3,
             double a4, double a5, double a6, double a7,
             double a8) { return a8; }

double tenth_mixed(unsigned long tag, double a0, double a1,
                   double a2, double a3, double a4, double a5,
                   double a6, double a7, double a8, double a9) {
    (void)tag;
    (void)a8;
    return a9;
}

double spill_mixed(unsigned long a, unsigned long b, unsigned long c,
                   unsigned long d, unsigned long e, unsigned long f,
                   unsigned long g, unsigned long h,
                   double a0, double a1, double a2, double a3,
                   double a4, double a5, double a6, double a7,
                   double a8) { (void)h; return a8; }

float ninth_float(double a0, double a1, double a2, double a3,
                  double a4, double a5, double a6, double a7,
                  float a8) { return a8; }

extern double (*indirect_ninth)(double, double, double, double, double,
                                double, double, double, double);

double call_ninth(double x) {
    return ninth(x,x,x,x,x,x,x,x,x);
}

double call_tenth_mixed(double x) {
    return tenth_mixed(17UL,x,x,x,x,x,x,x,x,x,x);
}

double call_spill_mixed(double x) {
    return spill_mixed(1UL,2UL,3UL,4UL,5UL,6UL,7UL,8UL,
                       x,x,x,x,x,x,x,x,x);
}

float call_ninth_float(double x, float y) {
    return ninth_float(x,x,x,x,x,x,x,x,y);
}

double call_indirect_ninth(double x) {
    return indirect_ninth(x,x,x,x,x,x,x,x,x);
}

/* F/D availability must not reclassify integer ALU operations. The selected
 * RV64I machine backend always lowers MUL/DIV/REM through typed GNU runtime
 * calls, independent of the psABI used for floating arguments. */
unsigned int int32_arithmetic(unsigned int left, unsigned int right) {
    return left * right + left / right + left % right;
}

long int64_arithmetic(long left, long right) {
    return left * right + left / right + left % right;
}

/* psABI binary128 is a pair of GPR words even with LP64D enabled. Both
 * direct and indirect calls must preserve the complete 16-byte payload. */
extern long double gnu_binary128(void);
extern long double (*binary128_pointer)(void);

long double call_binary128_direct(void) {
    return gnu_binary128();
}

long double call_binary128_indirect(void) {
    return binary128_pointer();
}

long double passthrough_binary128(long double value) {
    return value;
}
@@@ end
