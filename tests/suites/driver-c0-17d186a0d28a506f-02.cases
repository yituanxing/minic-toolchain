        grep -F '__compiletime_assert_0' "$work/$output.s" >/dev/null
        printf '%s\n' 'PASS compiler/c0/block_scope_extern_function_attributes scope=block linkage=extern prefix=noreturn suffix=error direct-call-resolved=1'
        ;;
