@@@ {"id": "17d186a0d28a506f", "kind": "shared", "newline": true}
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
minic=${MINIC:-"$root/build/debug/bin/minic"}
host_cc=${HOST_CC:-${CC:-cc}}
@@@ end
@@@ {"head_lines": 2, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/run-compile-only-case.sh", "shared": "17d186a0d28a506f"}
#!/bin/sh
# Shared positive compile-only oracle: preserve the former per-case flags and work paths.
if [ "$#" -ne 1 ]; then
    echo "usage: $0 CASE" >&2
    echo "Run a case registered in this driver." >&2
    exit 2
fi
# Historical source/assembly drivers: share the preparation, retain the oracle bodies.
_c0_family=
case "$1" in
    anonymous-record-field-types) _c0_family=1; _c0_work='compiler-c0-anonymous-record-field-types'; _c0_src='tests/compiler/c0/anonymous_record_field_type.c'; _c0_input='anonymous_record_field_type.i'; _c0_output='anonymous_record_field_type.s' ;;
    compound-assignment-full) _c0_family=1; _c0_work='compiler-c0-compound-assignment-full'; _c0_src='tests/compiler/c0/compound_assignment_full.c'; _c0_input='compound_assignment_full.i'; _c0_output='compound_assignment_full.s' ;;
    enum-constant-expressions) _c0_family=1; _c0_work='compiler-c0-enum-constant-expressions'; _c0_src='tests/compiler/c0/enum_constant_expression.c'; _c0_input='enum_constant_expression.i'; _c0_output='enum_constant_expression.s' ;;
    flexible-array-members) _c0_family=1; _c0_work='compiler-c0-flexible-array-members'; _c0_src='tests/compiler/c0/flexible_array_member.c'; _c0_input='flexible_array_member.i'; _c0_output='flexible_array_member.s' ;;
    function-designator-calls) _c0_family=1; _c0_work='compiler-c0-function-designator-call'; _c0_src='tests/compiler/c0/function_designator_call.c'; _c0_input='function_designator_call.i'; _c0_output='function_designator_call.s' ;;
    integer-constant-bitwise) _c0_family=1; _c0_work='compiler-c0-integer-constant-bitwise'; _c0_src='tests/compiler/c0/integer_constant_bitwise.c'; _c0_input='integer_constant_bitwise.i'; _c0_output='integer_constant_bitwise.s' ;;
    packed-record-layout) _c0_family=1; _c0_work='compiler-c0-packed-record-layout'; _c0_src='tests/compiler/c0/packed_record_layout.c'; _c0_input='packed_record_layout.i'; _c0_output='packed_record_layout.s' ;;
    static-local-record-initializers) _c0_family=1; _c0_work='compiler-c0-static-local-record-initializer'; _c0_src='tests/compiler/c0/static_local_record_initializer.c'; _c0_input='static_local_record_initializer.i'; _c0_output='static_local_record_initializer.s' ;;
    static-record-arrays) _c0_family=1; _c0_work='compiler-c0-static-record-array'; _c0_src='tests/compiler/c0/static_record_array.c'; _c0_input='static_record_array.i'; _c0_output='static_record_array.s' ;;
    builtin-clzll) _c0_family=2; _c0_work='compiler-c0-builtin-clzll'; _c0_src='tests/compiler/c0/builtin_clzll.c'; _c0_input='builtin_clzll.i'; _c0_output='builtin_clzll.s' ;;
    builtin-unary-family) _c0_family=2; _c0_work='compiler-c0-builtin-unary-family'; _c0_src='tests/compiler/c0/builtin_unary_family.c'; _c0_input='builtin_unary_family.i'; _c0_output='builtin_unary_family.s' ;;
    external-record-compound-literal) _c0_family=2; _c0_work='compiler-c0-external-record-compound-literal'; _c0_src='tests/compiler/c0/external_record_compound_literal.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    function-parameter-adjustment) _c0_family=2; _c0_work='compiler-c0-function-parameter-adjustment'; _c0_src='tests/compiler/c0/function_parameter_adjustment.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    function-pointer-qualifiers) _c0_family=2; _c0_work='compiler-c0-function-pointer-qualifiers'; _c0_src='tests/compiler/c0/function_pointer_qualifiers.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    gnu-incomplete-record-function-signature) _c0_family=2; _c0_work='compiler-c0-gnu-incomplete-record-function-signature'; _c0_src='tests/compiler/c0/gnu_incomplete_record_function_signature.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    gnu-omitted-conditional) _c0_family=2; _c0_work='compiler-c0-gnu-omitted-conditional'; _c0_src='tests/compiler/c0/gnu_omitted_conditional.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    gnu-record-compound-literal) _c0_family=2; _c0_work='compiler-c0-gnu-record-compound-literal'; _c0_src='tests/compiler/c0/gnu_record_compound_literal.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    conditional-null-pointer-constant) _c0_family=3; _c0_work='compiler-c0-conditional-null-pointer'; _c0_src='tests/compiler/c0/conditional_null_pointer_constant.c'; _c0_input=''; _c0_output='conditional_null_pointer_constant.s' ;;
    deferred-declarator-attributes) _c0_family=3; _c0_work='compiler-c0-deferred-declarator-attributes'; _c0_src='tests/compiler/c0/deferred_declarator_attributes.c'; _c0_input=''; _c0_output='deferred_declarator_attributes.s' ;;
    pragma-pack-record-layout) _c0_family=3; _c0_work='compiler-c0-pragma-pack'; _c0_src='tests/compiler/c0/pragma_pack_record_layout.c'; _c0_input=''; _c0_output='pragma_pack.s' ;;
    preprocessed-line-markers) _c0_family=3; _c0_work='compiler-c0-preprocessed-line-markers'; _c0_src='tests/compiler/c0/preprocessed_line_markers.i'; _c0_input=''; _c0_output='preprocessed_line_markers.s' ;;
    static-global-object-section) _c0_family=3; _c0_work='compiler-c0-static-global-object-section'; _c0_src='tests/compiler/c0/static_global_object_section.c'; _c0_input=''; _c0_output='static_global_object_section.s' ;;
    static-mixed-symbol-relocations) _c0_family=3; _c0_work='compiler-c0-static-mixed-symbol-relocations'; _c0_src='tests/compiler/c0/static_mixed_symbol_relocations.c'; _c0_input=''; _c0_output='static_mixed_symbol_relocations.s' ;;
    static-object-address-relocation) _c0_family=3; _c0_work='compiler-c0-static-object-address'; _c0_src='tests/compiler/c0/static_object_address_relocation.c'; _c0_input=''; _c0_output='static_object_address_relocation.s' ;;
    expression-statements) _c0_family=4; _c0_work='compiler-c0-expression-statements'; _c0_src='tests/programs/c0/expression_statement.c'; _c0_input='expression_statement.i'; _c0_output='expression_statement.s' ;;
    long-types) _c0_family=4; _c0_work='compiler-c0-long-types'; _c0_src='tests/compiler/c0/long_type_specifiers.c'; _c0_input='long_type_specifiers.i'; _c0_output='long_type_specifiers.s' ;;
    pointer-qualifications) _c0_family=4; _c0_work='compiler-c0-pointer-qualifications'; _c0_src='tests/compiler/c0/pointer_qualification.c'; _c0_input='pointer_qualification.i'; _c0_output='pointer_qualification.s' ;;
    static-functions) _c0_family=4; _c0_work='compiler-c0-static-functions'; _c0_src='tests/compiler/c0/static_functions.c'; _c0_input='static_functions.i'; _c0_output='static_functions.s' ;;
    switch-control-flow) _c0_family=4; _c0_work='compiler-c0-switch-control-flow'; _c0_src='tests/programs/c0/switch_control_flow.c'; _c0_input='switch_control_flow.i'; _c0_output='switch_control_flow.s' ;;
    unsigned-char-layout) _c0_family=4; _c0_work='compiler-c0-unsigned-char-layout'; _c0_src='tests/programs/c0/unsigned_char_layout.c'; _c0_input='unsigned_char_layout.i'; _c0_output='unsigned_char_layout.s' ;;
    gnu-auto-type-local) _c0_family=5; _c0_work='compiler-c0-gnu-auto-type-local'; _c0_src='tests/compiler/c0/gnu_auto_type_local.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    gnu-object-alignment-attribute) _c0_family=5; _c0_work='compiler-c0-gnu-object-alignment-attribute'; _c0_src='tests/compiler/c0/gnu_object_alignment_attribute.c'; _c0_input='input.i'; _c0_output='output.s' ;;
    pointer-arithmetic) _c0_family=5; _c0_work='compiler-c0-pointer-arithmetic'; _c0_src='tests/programs/c0/pointer_aggregate_arithmetic.c'; _c0_input='pointer_aggregate_arithmetic.i'; _c0_output='pointer_aggregate_arithmetic.s' ;;
    static-local-arrays) _c0_family=5; _c0_work='compiler-c0-static-local-arrays'; _c0_src='tests/programs/c0/static_local_array.c'; _c0_input='static_local_array.i'; _c0_output='static_local_array.s' ;;
    pointer-array-typed-null) _c0_family=6; _c0_work='compiler-c0-pointer-array-typed-null'; _c0_src='tests/compiler/c0/pointer_array_typed_null.c'; _c0_input=''; _c0_output='positive.s' ;;
    predefined-func-name) _c0_family=6; _c0_work='compiler-c0-predefined-func-name'; _c0_src='tests/programs/c0/predefined_func_name.c'; _c0_input=''; _c0_output='positive.s' ;;
    static-zero-declaration-list) _c0_family=6; _c0_work='compiler-c0-static-zero-declaration-list'; _c0_src='tests/compiler/c0/static_zero_declaration_list.c'; _c0_input=''; _c0_output='positive.s' ;;
esac
if [ -n "$_c0_family" ]; then
    _c0_case=$1
    set --
    case "$_c0_family" in
        1)
            work=${BUILD_DIR:-"$root/build/debug"}/tests/$_c0_work
            rm -rf "$work"
            mkdir -p "$work"
            "$host_cc" -E -P -x c "$root/$_c0_src" -o "$work/$_c0_input"
            "$minic" -S "$work/$_c0_input" -o "$work/$_c0_output"
            ;;
        2)
            work=${BUILD_DIR:-"$root/build/debug"}/tests/$_c0_work
            rm -rf "$work"
            mkdir -p "$work"
            "$host_cc" -E -P -std=gnu11 -x c "$root/$_c0_src" -o "$work/$_c0_input"
            "$minic" -S "$work/$_c0_input" -o "$work/$_c0_output"
            ;;
        3)
            work=${BUILD_DIR:-"$root/build/debug"}/tests/$_c0_work
            rm -rf "$work"
            mkdir -p "$work"
            "$minic" -S "$root/$_c0_src" -o "$work/$_c0_output"
            ;;
        4)
            work=${BUILD_DIR:-"$root/build/debug"}/tests/$_c0_work
            mkdir -p "$work"
            "$host_cc" -E -P -x c "$root/$_c0_src" -o "$work/$_c0_input"
            "$minic" -S "$work/$_c0_input" -o "$work/$_c0_output"
            ;;
        5)
            build_dir=${BUILD_DIR:-"$root/build/debug"}
            work="$build_dir/tests/$_c0_work"
            mkdir -p "$work"
            "$host_cc" -E -P -x c "$root/$_c0_src" -o "$work/$_c0_input"
            "$minic" -S "$work/$_c0_input" -o "$work/$_c0_output"
            ;;
        6)
            build_dir=${BUILD_DIR:-"$root/build/debug"}
            work="$build_dir/tests/$_c0_work"
            mkdir -p "$work"
            "$minic" -S "$root/$_c0_src" -o "$work/$_c0_output"
            ;;
    esac
    case "$_c0_case" in
        anonymous-record-field-types)
# Core register assignment is not part of the layout contract. Require the
# actual member offset and unsigned-halfword load/store, regardless of whether
# the lowered address/value currently lives in a0, t0, or t1.
awk '$1 == "addi" && $2 == $3 && $4 == "2" { found = 1 }
     END { exit !found }' "$work/anonymous_record_field_type.s"
grep -E '^[[:space:]]+lhu[[:space:]]+[[:alnum:]]+,[[:space:]]*0\([[:alnum:]]+\)$' \
    "$work/anonymous_record_field_type.s" >/dev/null
grep -E '^[[:space:]]+sh[[:space:]]+[[:alnum:]]+,[[:space:]]*0\([[:alnum:]]+\)$' \
    "$work/anonymous_record_field_type.s" >/dev/null
printf '%s\n' 'PASS compiler/c0/anonymous_record_field_type nested-struct-in-union=1 layout=4 delta-offset=2'
            ;;
        compound-assignment-full)
test "$(grep -c -F '  call next_slot' "$work/compound_assignment_full.s")" -eq 1
grep -F '  slli a0, a0, 2' "$work/compound_assignment_full.s" >/dev/null
grep -F '  and a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  or a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  xor a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  sllw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  srlw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  sraw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  mulw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  subw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  divu a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  div a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  remw a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  remu a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  rem a0, t0, a0' "$work/compound_assignment_full.s" >/dev/null
grep -F '  fadd.d ft0, ft0, ft1' "$work/compound_assignment_full.s" >/dev/null
grep -F '  fsub.d ft0, ft0, ft1' "$work/compound_assignment_full.s" >/dev/null
grep -F '  fmul.d ft0, ft0, ft1' "$work/compound_assignment_full.s" >/dev/null
grep -F '  fdiv.d ft0, ft0, ft1' "$work/compound_assignment_full.s" >/dev/null
grep -F '  fcvt.d.w ft1, a0' "$work/compound_assignment_full.s" >/dev/null
printf '%s\n' 'PASS compiler/c0/compound_assignment_full integer=+=,-=,*=,/=,%=,&=,|=,^=,<<=,>>= shift-right=signed+unsigned pointer=+,- double=+=,-=,*=,/= mixed-int-rhs=1 lvalue-evaluation=once'
            ;;
        enum-constant-expressions)
test -s "$work/enum_constant_expression.s"

grep -F '  li a0, 256' "$work/enum_constant_expression.s" >/dev/null
grep -F '  li a0, 264' "$work/enum_constant_expression.s" >/dev/null

cat >"$work/nonconstant.c" <<'EOF'
extern int runtime_value;
enum Invalid {
    INVALID_ENUM_VALUE = runtime_value ? 1 : 2,
};
EOF
"$host_cc" -E -P -x c "$work/nonconstant.c" -o "$work/nonconstant.i"
if "$minic" -S "$work/nonconstant.i" -o "$work/nonconstant.s" \
    >"$work/nonconstant.stdout" 2>"$work/nonconstant.stderr"; then
    printf '%s\n' 'FAIL compiler/c0/enum_constant_expression: runtime initializer accepted' >&2
    exit 1
fi
grep -F 'enum initializer must be an integer constant expression' \
    "$work/nonconstant.stderr" >/dev/null

printf '%s\n' \
    'PASS compiler/c0/enum_constant_expression typed-ast-consteval=1 arithmetic=1 prior-enumerator=1 relational=1 logical=1 conditional=linux-shape short-circuit=1 runtime=reject'
            ;;
        flexible-array-members)
# Field offset is the ABI invariant; the chosen address register is not.
awk '$1 == "addi" && $2 == $3 && $4 == "3" { found = 1 }
     END { exit !found }' "$work/flexible_array_member.s"
printf '%s\n' 'PASS compiler/c0/flexible_array_member packed-size=3 payload-offset=3'


"$host_cc" -E -P -x c \
    "$root/tests/compiler/c0/static_nested_flexible_array_initializer.c" \
    -o "$work/static_nested_flexible_array_initializer.i"
"$minic" -S \
    "$work/static_nested_flexible_array_initializer.i" \
    -o "$work/static_nested_flexible_array_initializer.s"
grep -F '.size nested_fam_rows, 64' \
    "$work/static_nested_flexible_array_initializer.s" >/dev/null
grep -F '.dword .Lminic_string_' \
    "$work/static_nested_flexible_array_initializer.s" >/dev/null
printf '%s\n' 'PASS compiler/c0/static_nested_flexible_array_initializer linux-wrapper zero-slot-fam + relocation'

"$host_cc" -E -P -x c \
    "$root/tests/compiler/c0/static_record_flexible_array_initializer.c" \
    -o "$work/static_record_flexible_array_initializer.i"
"$minic" -S \
    "$work/static_record_flexible_array_initializer.i" \
    -o "$work/static_record_flexible_array_initializer.s"
grep -F '.dword init_namespace' \
    "$work/static_record_flexible_array_initializer.s" >/dev/null
printf '%s\n' 'PASS compiler/c0/static_record_flexible_array_initializer aggregate-tail+relocation'

expect_failure() {
    name=$1
    expected=$2
    "$host_cc" -E -P -x c "$root/tests/compiler/c0/$name.c" -o "$work/$name.i"
    if "$minic" -S "$work/$name.i" -o "$work/$name.s" \
        >"$work/$name.stdout" 2>"$work/$name.stderr"; then
        printf '%s\n' "FAIL compiler/c0/$name: compilation unexpectedly succeeded" >&2
        exit 1
    fi
    grep -F "$expected" "$work/$name.stderr" >/dev/null
    printf '%s\n' "PASS compiler/c0/$name"
}

expect_failure invalid_flexible_array_not_last \
    'flexible array member must be the last record field'
expect_failure invalid_union_flexible_array \
    'flexible array member is not allowed in union'
            ;;
        function-designator-calls)
test "$(grep -c -F '  jalr ra, t0, 0' "$work/function_designator_call.s")" -eq 2

cat >"$work/local-shadows-function.c" <<'EOF'
struct Request;
void complete(int value);

static void invoke(struct Request *rq, void (*complete)(struct Request *rq))
{
    complete(rq);
}

struct Request { int value; };
EOF
"$host_cc" -E -P -std=gnu11 -x c "$work/local-shadows-function.c" \
    -o "$work/local-shadows-function.i"
"$minic" -S "$work/local-shadows-function.i" -o "$work/local-shadows-function.s"
grep -F 'invoke:' "$work/local-shadows-function.s" >/dev/null
grep -F '  jalr ' "$work/local-shadows-function.s" >/dev/null

printf '%s\n' 'PASS compiler/c0/function_designator_call pointer-call=1 dereferenced-function-designator=1 local-shadows-global-function=1 RV64=jalr'
            ;;
        integer-constant-bitwise)
grep -F '.type bitwise_table, @object' "$work/integer_constant_bitwise.s" >/dev/null
grep -F '  .byte 10' "$work/integer_constant_bitwise.s" >/dev/null
grep -F '  .byte 7' "$work/integer_constant_bitwise.s" >/dev/null
grep -F '  .byte 255' "$work/integer_constant_bitwise.s" >/dev/null
grep -F '  .byte 2' "$work/integer_constant_bitwise.s" >/dev/null
grep -F '  .byte 8' "$work/integer_constant_bitwise.s" >/dev/null
test "$(grep -Fc '  .byte 0' "$work/integer_constant_bitwise.s")" -eq 3
sed -n '/^octal_permission:/,/^\.size/p' "$work/integer_constant_bitwise.s" | grep -F '  .word 420' >/dev/null
printf '%s\n' 'PASS compiler/c0/integer_constant_bitwise shifts=<<,>> bitwise=&,^,| unary=~,! bound=8 zero-fill=3 octal=0644->420'
            ;;
        packed-record-layout)
grep -F '.size sample, 4' "$work/packed_record_layout.s" >/dev/null
grep -F '.size suffix_sample, 4' "$work/packed_record_layout.s" >/dev/null
grep -F '.size forward_sample, 3' "$work/packed_record_layout.s" >/dev/null
# Core now materializes the field address in a temporary before writing the
# return register. Assert the layout offsets and machine access width without
# coupling this regression to the allocator's choice of a0 versus t0/t1.
grep -E '^[[:space:]]+addi [[:alnum:]]+, [[:alnum:]]+, 1$' "$work/packed_record_layout.s" >/dev/null
grep -E '^[[:space:]]+addi [[:alnum:]]+, [[:alnum:]]+, 3$' "$work/packed_record_layout.s" >/dev/null
# A packed field at byte offset one has no halfword-alignment proof. The
# typed MachineIR path must reconstruct the 16-bit value from two byte loads
# instead of relying on the old emitter's unsafe unaligned `lhu`.
awk '
    /^read_second:/ { in_function=1; next }
    /^\.size read_second,/ { in_function=0 }
    in_function && $1 == "lbu" && $3 ~ /^0\(/ { byte0=1 }
    in_function && $1 == "lbu" && $3 ~ /^1\(/ { byte1=1 }
    in_function && $1 == "slli" && $4 == "8" { shift8=1 }
    in_function && ($1 == "lh" || $1 == "lhu") { unsafe=1 }
    END { exit !(byte0 && byte1 && shift8 && !unsafe) }
' "$work/packed_record_layout.s"
printf '%s\n' 'PASS compiler/c0/packed_record_layout placement=prefix+suffix forward-definition=1 size=4 offsets=0,1,3 bytewise_unaligned=1'
            ;;
        static-local-record-initializers)
grep -F '.type __minic_static_local_' "$work/static_local_record_initializer.s" >/dev/null
grep -F '  .word 7' "$work/static_local_record_initializer.s" >/dev/null
awk '
    $1 == ".word" && $2 == "7" { seen_kind = 1; next }
    seen_kind && !seen_first && $1 == ".zero" { zero_bytes += $2; next }
    seen_kind && !seen_first && $1 == ".word" && $2 == "0" {
        zero_bytes += 4; next
    }
    seen_kind && $1 == ".word" && $2 == "-1" { seen_first = 1; next }
    END { exit !(seen_kind && seen_first && zero_bytes == 12) }
' "$work/static_local_record_initializer.s"
grep -F '  .word -1' "$work/static_local_record_initializer.s" >/dev/null
grep -F '  .word -2' "$work/static_local_record_initializer.s" >/dev/null
grep -F '  .dword 1' "$work/static_local_record_initializer.s" >/dev/null
printf '%s\n' 'PASS compiler/c0/static_local_record_initializer enum=7 nested-zero=12 signed=-1,-2 compound-literal=1 designated-nested=1 anonymous-union-first=1 empty-record=1 shared-owner=1 target-layout=rv64'
            ;;
        static-record-arrays)
grep -Fx '.section .rodata' "$work/static_record_array.s" >/dev/null
grep -F '.type priority, @object' "$work/static_record_array.s" >/dev/null
grep -F '.size priority, 6' "$work/static_record_array.s" >/dev/null
grep -F '  .byte 10' "$work/static_record_array.s" >/dev/null
grep -F '  .byte 6' "$work/static_record_array.s" >/dev/null
