        require_file_literals "$work/static_preformed_array_zero.s" '.type plain_mask, @object' '.size plain_mask, 16' '.type percpu_mask, @object'
        grep -Fx '.section .data..percpu' "$work/static_preformed_array_zero.s" >/dev/null
