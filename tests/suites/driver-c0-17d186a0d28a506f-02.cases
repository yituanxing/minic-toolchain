        if "$minic" -S "$work/nonmember.i" -o "$work/nonmember.s" >"$work/nonmember.stdout" 2>"$work/nonmember.stderr"; then
            echo 'FAIL transparent union non-member argument unexpectedly compiled' >&2
            exit 1
