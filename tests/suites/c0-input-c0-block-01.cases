@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/block_scope_extern_function_typedef.c"}
/* Original Linux AArch64: typedef is already a function, not a function
 * pointer object. Its block-scope extern must keep the canonical symbol
 * and ABI prototype without inventing a function-valued storage object. */
typedef void (ttbr_replace_func)(unsigned long);
typedef unsigned long (read_counter_func)(void);

unsigned long select_replacer(unsigned long value) {
    extern ttbr_replace_func idmap_cpu_replace_ttbr1;
    extern read_counter_func read_counter;
    ttbr_replace_func *replace = idmap_cpu_replace_ttbr1;
    replace(value);
    return read_counter();
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/block_scope_extern_multi_declarator.c"}
extern char __init_begin[4];
extern char __init_end[4];

unsigned long span(void) {
    extern char __init_begin[], __init_end[];
    return (unsigned long)&__init_end - (unsigned long)&__init_begin;
}

int main(void) {
    return span() == 4 ? 0 : 1;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/block_scope_extern_object.c"}
unsigned long first(unsigned long pfn)
{
    extern unsigned long zero_pfn;
    extern unsigned long zero_pfn;
    return pfn == zero_pfn;
}

unsigned long second(void)
{
    extern unsigned long zero_pfn;
    return zero_pfn;
}

unsigned long before_promotion(void)
{
    extern unsigned long promoted;
    return promoted;
}

extern unsigned long promoted;

unsigned long after_promotion(void)
{
    return promoted;
}

/* Linux arch/loongarch/mm/cache.c declares a weak external object inside
 * a function. The GNU attribute belongs to the object symbol, not to a
 * function declaration or to the local block's storage. */
unsigned long weak_external_address(void)
{
    extern char __attribute__((__weak__)) except_vec_cex;
    return (unsigned long)&except_vec_cex;
}
