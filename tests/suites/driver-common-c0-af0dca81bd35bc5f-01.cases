@@@ {"id": "af0dca81bd35bc5f", "kind": "shared", "newline": true}
set -Eeuo pipefail
cc_bin=$1
test -x "$cc_bin"
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-gnu-nested-record-qualifier-5isa.sh", "shared": "af0dca81bd35bc5f"}
#!/usr/bin/env bash
# A record-rvalue member loses only its outer value qualifier. The pointee's
# const survives, and volatile nested scalar members remain memory accesses.
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
positive="$repo/tests/compiler/c0/gnu_nested_record_member_qualifier_abi.c"
negative="$repo/tests/compiler/c0/invalid_gnu_nested_record_member_pointee_const.c"
negative_volatile="$repo/tests/compiler/c0/invalid_gnu_nested_record_volatile_rvalue_address.c"
gcc -E -P -std=gnu11 "$positive" -o "$d/positive.i"
gcc -E -P -std=gnu11 "$negative" -o "$d/negative.i"
gcc -E -P -std=gnu11 "$negative_volatile" -o "$d/negative-volatile.i"
for target in riscv32-linux riscv64-linux x86_64-linux aarch64-linux loongarch64-linux; do
 "$cc_bin" --target="$target" -S "$d/positive.i" -o "$d/$target.s"
 test -s "$d/$target.s"
 if "$cc_bin" --target="$target" -S "$d/negative.i" -o "$d/invalid-$target.s" >/dev/null 2>&1; then
  echo "FAIL $target wrote through nested const pointee" >&2
  exit 1
 fi
 test ! -e "$d/invalid-$target.s"
 if "$cc_bin" --target="$target" -S "$d/negative-volatile.i" -o "$d/invalid-volatile-$target.s" >/dev/null 2>&1; then
  echo "FAIL $target took address of nested volatile record rvalue" >&2
  exit 1
 fi
 test ! -e "$d/invalid-volatile-$target.s"
done
if gcc -std=gnu11 -fsyntax-only "$negative" >/dev/null 2>&1; then
 echo 'FAIL GNU accepted nested const pointee write' >&2
 exit 1
fi
if gcc -std=gnu11 -fsyntax-only "$negative_volatile" >/dev/null 2>&1; then
 echo 'FAIL GNU accepted nested volatile record rvalue address' >&2
 exit 1
fi
gcc -O0 -fno-pie -no-pie -x c "$d/positive.i" -o "$d/gnu-native"
gcc -O0 -fno-pie -no-pie -S -x c "$d/positive.i" -o "$d/gnu.s"
# Runtime equality alone cannot prove that volatile member loads survived:
# both lowering paths must retain at least two explicit scalar memory reads
# in the dedicated `read_nested_volatile_twice` function.
for compiler in gnu x86_64-linux; do
 awk '
  /^read_nested_volatile_twice:/ { in_fn=1; next }
  in_fn && /^[.]size[[:space:]]+read_nested_volatile_twice/ { in_fn=0 }
  in_fn && /movl[[:space:]]+[^#]*\([^)]*\),[[:space:]]*%e[a-z][a-z]/ { reads++ }
  END { exit (reads >= 2 ? 0 : 1) }
 ' "$d/$compiler.s"
done
gcc -fno-pie -no-pie -x assembler "$d/x86_64-linux.s" -o "$d/minic-native"
"$d/gnu-native"
"$d/minic-native"
echo 'MINIC_GNU_NESTED_RECORD_QUALIFIERS=PASS ISA=5 GNU_NATIVE=1 nested_pointer_pointee_const=1 volatile_member_reads=2 negatives=2x5'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-gnu-zero-array-nested-record-5isa.sh", "shared": "af0dca81bd35bc5f"}
#!/usr/bin/env bash
# Linux Renesas CPG uses `common[N]` followed by explicitly empty `drp[0]`.
# The GNU [0] extension consumes no initializer slots, storage or ELF relocs.
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
positive="$repo/tests/compiler/c0/gnu_zero_array_nested_record_global.c"
negative="$repo/tests/compiler/c0/invalid_gnu_zero_array_nonempty_record_global.c"
gcc -E -P -std=gnu11 "$positive" -o "$d/positive.i"
gcc -E -P -std=gnu11 "$negative" -o "$d/negative.i"
for target in riscv32-linux riscv64-linux x86_64-linux aarch64-linux loongarch64-linux; do
 "$cc_bin" --target="$target" -S "$d/positive.i" -o "$d/$target.s"
 test -s "$d/$target.s"
 if "$cc_bin" --target="$target" -S "$d/negative.i" -o "$d/negative-$target.s" >/dev/null 2>&1; then
  echo "FAIL $target accepted excess elements of zero-length record array" >&2
  exit 1
 fi
 test ! -e "$d/negative-$target.s"
done
if gcc -std=gnu11 -Wall -Wextra -Werror -fsyntax-only "$negative" >/dev/null 2>&1; then
 echo 'FAIL GNU did not warn about excess [0] record initializer' >&2
 exit 1
fi
gcc -O0 -fno-pie -no-pie -x c "$d/positive.i" -o "$d/gnu-native"
gcc -O0 -fno-pie -fno-pic -S -x c "$d/positive.i" -o "$d/gnu.s"
gcc -c -x assembler "$d/gnu.s" -o "$d/gnu.o"
gcc -c -x assembler "$d/x86_64-linux.s" -o "$d/minic.o" 2>"$d/gas-warnings.log"
for compiler in gnu minic; do
 test "$(readelf -rW "$d/$compiler.o" | grep -c 'R_X86_64_64')" = 4
done
gcc -fno-pie -no-pie -x assembler "$d/x86_64-linux.s" -o "$d/minic-native"
"$d/gnu-native"
"$d/minic-native"
echo 'MINIC_GNU_ZERO_ARRAY_NESTED_RECORD=PASS ISA=5 GNU_NATIVE=1 common=2 drp=0 reloc=4 negative_excess=5'
@@@ end
@@@ {"head_lines": 3, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-kexec-crash-regs.sh", "shared": "af0dca81bd35bc5f"}
#!/usr/bin/env bash
# GNU Linux 6.6 kexec crash_setup_regs: 16 exact live-GPR `=m` snapshots,
# plus the architectural flags snapshot. Never substitute a C register read.
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
printf 'typedef unsigned long u64;\nvoid mini_snapshot(u64 *p) {\n u64 rip;\n' >"$d/regs.i"
for reg in rbx rcx rdx rsi rdi rbp rax rsp r8 r9 r10 r11 r12 r13 r14 r15; do
 printf ' asm volatile("movq %%%%%s,%%0" : "=m"(*p));\n' "$reg" >>"$d/regs.i"
done
printf ' asm volatile("pushfq; popq %%0" : "=m"(*p));\n' >>"$d/regs.i"
printf '%s\n' ' asm("lea 0(%%rip),%0" : "=r"(rip));' ' *p=rip;' '}' >>"$d/regs.i"
sed 's/mini_/gnu_/g' "$d/regs.i" >"$d/gnu.c"
gcc -S -O0 -x c "$d/gnu.c" -o "$d/gnu.s"
gcc -c -x assembler "$d/gnu.s" -o "$d/gnu.o"
"$cc_bin" --target=x86_64-linux -S "$d/regs.i" -o "$d/mini.s"
gcc -c -x assembler "$d/mini.s" -o "$d/mini.o"
for reg in rbx rcx rdx rsi rdi rbp rax rsp r8 r9 r10 r11 r12 r13 r14 r15; do
 for compiler in gnu mini; do
  if ! grep -Eq "[[:space:]]movq[[:space:]]+%${reg}," "$d/$compiler.s"; then
   echo "FAIL missing GNU physical register $reg from $compiler" >&2
   exit 1
  fi
 done
done
for compiler in gnu mini; do
 grep -Eq '[[:space:]]pushfq' "$d/$compiler.s"
 grep -Eq '[[:space:]]popq[[:space:]]' "$d/$compiler.s"
 grep -Eq '[[:space:]]lea[q]?[[:space:]]+0?\(%rip\),' "$d/$compiler.s"
done
# Materializing the destination address must not destroy R10/R11 before
# reading the register being captured.
grep -Fq 'movq %r10, (%r11)' "$d/mini.s"
grep -Fq 'movq %r11, (%r10)' "$d/mini.s"
sed 's/movq %%rbx,%0/movq %%rbx,%0; hlt/' "$d/regs.i" >"$d/bad-inject.i"
sed 's/unsigned long u64/unsigned int u64/' "$d/regs.i" >"$d/bad-width.i"
sed 's/: "=m"(\*p));/: "=m"(*p) : : "memory");/' \
 "$d/regs.i" >"$d/bad-clobber.i"
sed 's/asm volatile("movq %%rbx/asm("movq %%rbx/' \
 "$d/regs.i" >"$d/bad-volatility.i"
sed 's/lea 0(%%rip),%0/lea 0(%%rip),%0; hlt/' \
 "$d/regs.i" >"$d/bad-rip-inject.i"
sed 's/"=r"(rip)/"=m"(rip)/' \
 "$d/regs.i" >"$d/bad-rip-constraint.i"
for case in bad-inject bad-width bad-clobber bad-volatility bad-rip-inject bad-rip-constraint; do
 if "$cc_bin" --target=x86_64-linux -S "$d/$case.i" \
    -o "$d/$case.s" >/dev/null 2>&1; then
  echo "FAIL accepted unsafe crash-register snapshot $case" >&2
  exit 1
 fi
 test ! -e "$d/$case.s"
done
echo 'MINIC_X86_LINUX_KEXEC_CRASH_REGS=PASS GNU_GAS=1 GPR=16 RFLAGS=pushfq_popq RIP=lea R10_R11=preserved negative=6'
@@@ end
@@@ {"head_lines": 4, "kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/probe-x86-linux-pm-tracedata-elf.sh", "shared": "af0dca81bd35bc5f"}
#!/usr/bin/env bash
# Linux x86 PM_TRACE_RESUME's exact GNU extended-asm template is not just a
# pointer assignment: it publishes ten-byte records in ELF .tracedata with
# absolute relocations to the compile-time __FILE__ string.
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
cat >"$d/mini.i" <<'SRC'
typedef unsigned long u64;
void mini_resume(u64 *a, u64 *b) {
 void *pa, *pb;
 asm volatile(" movq $1f,%0\n"
              ".section .tracedata,\"a\"\n"
              "1:\t.word %c1\n\t"
              " .quad %c2\n"
              ".previous"
              : "=r"(pa) : "i"(598), "i"("drivers/base/power/main.c"));
 asm volatile(" movq $1f,%0\n"
              ".section .tracedata,\"a\"\n"
              "1:\t.word %c1\n\t"
              " .quad %c2\n"
              ".previous"
              : "=r"(pb) : "i"(1629), "i"("drivers/base/power/main.c"));
 *a=(u64)pa; *b=(u64)pb;
}
SRC
sed 's/mini_/gnu_/g' "$d/mini.i" >"$d/gnu.c"
gcc -S -O2 -fno-pie -fno-pic -x c "$d/gnu.c" -o "$d/gnu.s"
gcc -c -x assembler "$d/gnu.s" -o "$d/gnu.o"
"$cc_bin" --target=x86_64-linux -S "$d/mini.i" -o "$d/mini.s"
gcc -c -x assembler "$d/mini.s" -o "$d/mini.o"
for compiler in gnu mini; do
 readelf -SW "$d/$compiler.o" | grep -Eq '\] \.tracedata[[:space:]]+PROGBITS.*000014'
 readelf -SW "$d/$compiler.o" | grep -Eq '\] \.rela.tracedata[[:space:]]+RELA'
 test "$(readelf -rW "$d/$compiler.o" | grep -c 'R_X86_64_64.*\.rodata')" = 2
 test "$(readelf -rW "$d/$compiler.o" | grep -c 'R_X86_64_32S.*\.tracedata')" = 2
 objcopy --dump-section .tracedata="$d/$compiler.tracedata" "$d/$compiler.o"
 test "$(stat -c %s "$d/$compiler.tracedata")" = 20
 first=$(od -An -tu2 -j0 -N2 "$d/$compiler.tracedata" | tr -d ' ')
 second=$(od -An -tu2 -j10 -N2 "$d/$compiler.tracedata" | tr -d ' ')
 test "$first:$second" = '598:1629'
 # Each .quad has a relocation, never an immediate counterfeit pointer.
 test "$(od -An -tu8 -j2 -N8 "$d/$compiler.tracedata" | tr -d ' ')" = 0
 test "$(od -An -tu8 -j12 -N8 "$d/$compiler.tracedata" | tr -d ' ')" = 0
done
sed 's/: "=r"(pa) : "i"(598)/: "=r"(pa) : "r"(598)/' "$d/mini.i" >"$d/bad-line.i"
sed 's/: "=r"(pa) : "i"(598)/: "=m"(pa) : "i"(598)/' "$d/mini.i" >"$d/bad-output.i"
sed 's/asm volatile(" movq/asm(" movq/' "$d/mini.i" >"$d/bad-volatile.i"
sed 's/"i"("drivers\/base\/power\/main.c"));/"i"("drivers\/base\/power\/main.c") : "memory");/' "$d/mini.i" >"$d/bad-clobber.i"
for case in bad-line bad-output bad-volatile bad-clobber; do
 if "$cc_bin" --target=x86_64-linux -S "$d/$case.i" -o "$d/$case.s" >/dev/null 2>&1; then
  echo "FAIL accepted unsafe PM_TRACE_RESUME template $case" >&2
  exit 1
 fi
 test ! -e "$d/$case.s"
done
echo 'MINIC_X86_LINUX_PM_TRACEDATA_ELF=PASS GNU_GAS=1 records=2 bytes=20 reloc64=2 text32S=2 negative=4'
@@@ end
