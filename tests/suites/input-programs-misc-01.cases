static int matches_double_bytes(unsigned char *bytes, int byte5, int byte6, int byte7) {
    if ((bytes[0] != 0) || (bytes[1] != 0) || (bytes[2] != 0) || (bytes[3] != 0) ||
        (bytes[4] != 0)) {
