@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/variadic_direct_call.c"}
int verify_variadic(int tag, ...);

int main(void) {
    char small;
    long wide;
    int value;
    float approximate;
    double precise;

    small = 7;
    wide = 1234;
    value = 29;
    approximate = 1.25f;
    precise = 2.5;
    return verify_variadic(5,
                           11,
                           small,
                           wide,
                           &value,
                           precise,
                           approximate,
                           61,
                           62,
                           63,
                           64,
                           65,
                           66,
                           67,
                           68,
                           69,
                           70,
                           71,
                           72,
                           73,
                           74);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/variadic_direct_call_helper.c"}
#include <stdarg.h>

int verify_variadic(int tag, ...) {
    va_list arguments;
    int first;
    int promoted_char;
    long wide;
    int *pointer;
    double precise;
    double promoted_float;
    int expected;

    va_start(arguments, tag);
    first = va_arg(arguments, int);
    promoted_char = va_arg(arguments, int);
    wide = va_arg(arguments, long);
    pointer = va_arg(arguments, int *);
    precise = va_arg(arguments, double);
    promoted_float = va_arg(arguments, double);

    if (tag != 5 || first != 11 || promoted_char != 7 || wide != 1234 || pointer == 0 ||
        *pointer != 29 || precise != 2.5 || promoted_float != 1.25) {
        va_end(arguments);
        return 1;
    }
    for (expected = 61; expected <= 74; ++expected) {
        if (va_arg(arguments, int) != expected) {
            va_end(arguments);
            return 2;
        }
    }
    va_end(arguments);
    return 0;
}
@@@ end
