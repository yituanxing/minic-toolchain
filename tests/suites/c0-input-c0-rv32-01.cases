@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_gnu_di_earlyclobber_pair.c"}
/* GNU RISC-V RV32 `=&r` on a DI lvalue occupies two consecutive GPRs.
 * Linux's get_user dispatch contains this exact +r / =&r / m shape.
 * The source `lw` sets only the low word: upper output bits are not defined
 * by the source ASM and must never be invented by the backend. */
unsigned long long rv32_di_pair_load(const unsigned int *memory) {
    unsigned long error = 0;
    unsigned long long value;
    __asm__ __volatile__("lw %1, %2" : "+r" (error), "=&r" (value)
        : "m" (*memory) : "memory");
    return value;
}

/* The lvalue transport must also handle unaligned C destinations; the
 * generated source assembly is still the original literal instruction. */
struct __attribute__((packed)) rv32_pair_slot {
    unsigned char padding;
    unsigned long long value;
};

void rv32_di_pair_unaligned(struct rv32_pair_slot *slot,
    const unsigned int *memory) {
    unsigned long error = 0;
    __asm__ __volatile__("lw %1, %2" : "+r" (error),
        "=&r" (slot->value) : "m" (*memory) : "memory");
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_packed_scalar_alignment.c"}
/* GNU packed members are valid C lvalues even when their natural machine
 * width exceeds the enclosing record's alignment.  Scalar loads/stores must
 * never depend on the CPU's optional unaligned access behavior. */
struct __attribute__((packed)) PackedScalars {
    unsigned char prefix;
    short narrow;
    unsigned int word;
    unsigned long long wide;
    double fp;
};

short packed_read_short(const struct PackedScalars *p) { return p->narrow; }
unsigned int packed_read_word(const struct PackedScalars *p) { return p->word; }
unsigned long long packed_read_wide(const struct PackedScalars *p) { return p->wide; }
double packed_read_double(const struct PackedScalars *p) { return p->fp; }
void packed_write_short(struct PackedScalars *p, short v) { p->narrow = v; }
void packed_write_word(struct PackedScalars *p, unsigned int v) { p->word = v; }
void packed_write_wide(struct PackedScalars *p, unsigned long long v) { p->wide = v; }
void packed_write_double(struct PackedScalars *p, double v) { p->fp = v; }

struct NaturalScalars { unsigned int word; unsigned long long wide; };
unsigned int natural_local_fast_path(void) {
    struct NaturalScalars object;
    object.word = 79U;
    return object.word;
}

#ifndef MINIC_PROBE_NO_MAIN
int main(void) {
    struct PackedScalars object;
    object.prefix = 0x5AU;
    packed_write_short(&object, (short)-1234);
    packed_write_word(&object, 0xA98F1234U);
    packed_write_wide(&object, 0x7766554433221100ULL);
    packed_write_double(&object, 3.75);
    if (object.prefix != 0x5AU ||
        packed_read_short(&object) != (short)-1234 ||
        packed_read_word(&object) != 0xA98F1234U ||
        packed_read_wide(&object) != 0x7766554433221100ULL ||
        packed_read_double(&object) != 3.75 ||
        natural_local_fast_path() != 79U)
        return 1;
    return 0;
}
#endif
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_scalar_shift_u64_count.c"}
/* RV32 Linux BPF authentic owners use i64 shift counts for i32 scalars.
 * A scalar result must not be mistaken for a two-register i64 operand. */
unsigned int rv32_shift_left_u64_count(unsigned int lhs,
    unsigned long long count) {
    return lhs << count;
}

unsigned int rv32_shift_right_u64_count(unsigned int lhs,
    unsigned long long count) {
    return lhs >> count;
}

int rv32_shift_right_i64_count(int lhs, long long count) {
    return lhs >> count;
}

unsigned short rv32_shift_right_narrow_u64_count(unsigned short lhs,
    unsigned long long count) {
    return (unsigned short)(lhs >> count);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_u64_compound_or_store.c"}
/* RV32 Linux 6.6.143 virtio_pci_modern_dev.c::vp_modern_get_features
 * regression.  VIRTIO_F_VERSION_1 is bit 32, not bit 0; losing the
 * compound-assignment writeback makes a modern PCI virtio device appear
 * to lack this mandatory feature even when its high feature register is 1.
 *
 * Compile this exact GNU-preprocessed C both with GNU C and MiniC C, then
 * link the resulting ELF32 objects to the same GNU-built driver and run
 * both under actual qemu-riscv32 (run-rv32-u64-compound-or-store.sh).
 */

typedef unsigned int rv32_u32;
typedef unsigned long long rv32_u64;
typedef rv32_u64 (*rv32_feature_fn)(rv32_u32, rv32_u32);

rv32_u64 rv32_virtio_feature_rmw(rv32_u32 low, rv32_u32 high) {
    rv32_u64 features = low;
    features |= ((rv32_u64)high << 32);
    return features;
}

rv32_u64 rv32_virtio_feature_explicit(rv32_u32 low, rv32_u32 high) {
    rv32_u64 features = low;
    features = features | ((rv32_u64)high << 32);
    return features;
}

/* Indirect 64-bit return tests the caller-side RV32 a0/a1 ABI independently
 * of the 64-bit OR-and-writeback logic in the function above. */
rv32_u64 rv32_virtio_feature_indirect(rv32_feature_fn read_features,
                                      rv32_u32 low, rv32_u32 high) {
    return read_features(low, high);
}

int rv32_virtio_has_version_1(rv32_u32 low, rv32_u32 high) {
    return !!(rv32_virtio_feature_rmw(low, high) & (1ULL << 32));
}

/* Faithful transport-feature copy from Linux 6.6.143 virtio.c::
 * virtio_dev_probe(): i walks [VIRTIO_TRANSPORT_F_START=28,
 * VIRTIO_TRANSPORT_F_END=41), and __virtio_set_bit() performs a 64-bit
 * compound OR into a struct member.  This is a separate failure surface
 * from vp_modern_get_features() itself. */
struct rv32_virtio_device {
    rv32_u32 canary;
    rv32_u64 features;
};

rv32_u64 rv32_virtio_negotiated_transport(rv32_u32 low, rv32_u32 high) {
    struct rv32_virtio_device dev;
    rv32_u64 device_features = rv32_virtio_feature_rmw(low, high);
    unsigned int i;
    dev.canary = 0x45671234U;
    dev.features = 0;
    for (i = 28; i < 41; ++i)
        if (device_features & (1ULL << i))
            dev.features |= 1ULL << i;
    if (dev.canary != 0x45671234U)
        return 0xffffffffffffffffULL;
    return dev.features;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_variadic_record_abi_alignment.c"}
/* RV32 psABI: an unnamed two-word argument requires an even-numbered GPR
 * pair only if its ABI alignment is 8 bytes. Size 8 is not sufficient. */
typedef struct { unsigned int low, high; } Pair32;
typedef struct __attribute__((packed)) {
    unsigned int low, high;
} PackedPair32;
typedef struct {
    unsigned int low, high;
} __attribute__((aligned(8))) AlignedPair32;

_Static_assert(sizeof(Pair32) == 8 && _Alignof(Pair32) == 4,
               "natural pair has 4-byte alignment");
_Static_assert(sizeof(PackedPair32) == 8 && _Alignof(PackedPair32) == 1,
               "packed pair has 1-byte alignment");
_Static_assert(sizeof(AlignedPair32) == 8 && _Alignof(AlignedPair32) == 8,
               "overaligned pair has 8-byte alignment");

unsigned int accept_pair(unsigned int tag, ...);

unsigned int call_natural(Pair32 pair) {
    return accept_pair(1U, pair, 0x51U);
}
unsigned int call_packed(PackedPair32 pair) {
    return accept_pair(2U, pair, 0x52U);
}
unsigned int call_aligned(AlignedPair32 pair) {
    return accept_pair(3U, pair, 0x53U);
}
unsigned int call_wide_scalar(unsigned long long value) {
    return accept_pair(4U, value, 0x54U);
}

/* Pack-1 and pack-8 C types also exercise CoreObject layout, independent
 * of the register-pair selection. In the callee the second parameter may
 * occupy a frame offset of one byte. */
typedef struct __attribute__((packed)) { unsigned char value; } OneByte;
PackedPair32 return_after_byte(OneByte lead, PackedPair32 pair) {
    pair.low += lead.value;
    return pair;
}
PackedPair32 call_after_byte(OneByte lead, PackedPair32 pair) {
    return return_after_byte(lead, pair);
}

/* The direct Core callee signature and the Core function definition must
 * agree on variadicness. RV32 saves the unnamed a-registers in the callee's
 * variadic register area, but must not do so for an ordinary definition. */
unsigned int take_variadic(unsigned int named, ...) {
    __builtin_va_list args;
    unsigned int tail;
    __builtin_va_start(args, named);
    tail = __builtin_va_arg(args, unsigned int);
    __builtin_va_end(args);
    return named + tail;
}

unsigned int take_fixed(unsigned int named, unsigned int tail) {
    return named + tail;
}

unsigned int call_take_variadic(void) {
    return take_variadic(7U, 35U);
}

unsigned int call_take_fixed(void) {
    return take_fixed(7U, 35U);
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_wide_branch_condition.c"}
/* A Core conditional branch may consume a 64-bit integer on RV32 ILP32.
 * The truth value must combine both stored words.  In particular, a value
 * with only bit 32 set is true, and a masked-off high word is false.
 */
typedef unsigned int U32;
typedef unsigned long long U64;

int rv32_wide_branch_value(U32 low, U32 high) {
    U64 value = (((U64)high) << 32) | (U64)low;
    if (value) return 1;
    return 0;
}

int rv32_wide_branch_mask(U32 low, U32 high,
                          U32 mask_low, U32 mask_high) {
    U64 value = (((U64)high) << 32) | (U64)low;
    U64 mask = (((U64)mask_high) << 32) | (U64)mask_low;
    if (value & mask) return 1;
    return 0;
}

int rv32_wide_branch_ternary(U32 low, U32 high) {
    U64 value = (((U64)high) << 32) | (U64)low;
    return value ? 17 : 23;
}
@@@ end
@@@ {"kind": "case", "mode": "100644", "newline": true, "path": "tests/compiler/c0/rv32_wide_variadic_machine_ci.c"}
/* Host-preprocessed Core/Machine smoke for the RV32 zlib CI's mandatory
 * variadic preflight. GNU's <stdarg.h> maps these four operations to exactly
 * these builtin forms for the ILP32 target. The paired 64-bit constants and
 * two-word comparisons must survive typed MachineIR whole-function lowering. */
int rv32_ci_vwide(int fixed, ...) {
    __builtin_va_list ap;
    unsigned long long big;
    double dbl;
    int tail;
    __builtin_va_start(ap, fixed);
    big = __builtin_va_arg(ap, unsigned long long);
    dbl = __builtin_va_arg(ap, double);
    tail = __builtin_va_arg(ap, int);
    __builtin_va_end(ap);
    return fixed == 3 && big == 0x1122334455667788ULL &&
           dbl == 6.5 && tail == 9 ? 47 : 0;
}

int rv32_ci_vwide_spilled(int a, int b, int c, int d, int e,
                         int f, int g, ...) {
    __builtin_va_list ap;
    unsigned long long big;
    int tail;
    __builtin_va_start(ap, g);
    big = __builtin_va_arg(ap, unsigned long long);
    tail = __builtin_va_arg(ap, int);
    __builtin_va_end(ap);
    return a + b + c + d + e + f + g == 28 &&
           big == 0x123456789abcdef0ULL && tail == 9 ? 48 : 0;
}
@@@ end
