+                      "MINIC_INLINE_SYMBOLIC_SPECIALIZATION_V0 direct=%zu transitive=%zu functions=%zu\n",
+                      initial_clone_count,
+                      transitive_clone_count,
+                      program->function_count);
+    }
+    return true;
+}
