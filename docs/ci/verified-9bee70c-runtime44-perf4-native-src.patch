+static void minic_inline_boolean_copy_existing_facts(
+    const MinicFunction *current,
+    size_t parameter_count,
+    bool *integer_known,
+    uint64_t *integer_bits,
+    bool *symbolic_known,
+    MinicExpressionId *symbolic_expression,
+    bool *boolean_range_known) {
+    size_t i;
