+        if (minic_type_is_pointer(base->type)) {
+            base_ok = core_inline_asm_symbolic_address_depth(
+                context,
+                expression->value.member.base,
+                symbol,
+                &base_addend,
+                depth + 1U);
+        } else {
+            base_ok = core_inline_asm_symbolic_lvalue_address(
+                context,
+                expression->value.member.base,
+                symbol,
+                &base_addend,
